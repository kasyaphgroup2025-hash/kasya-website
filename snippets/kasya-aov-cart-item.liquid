<article
  class="kasya-aov-cart__item"
  data-kasya-aov-cart-item
  data-line="{{ item.index | plus: 1 }}"
  data-key="{{ item.key }}"
>
  <a class="kasya-aov-cart__item-media" href="{{ item.url }}" tabindex="-1" aria-hidden="true">
    {%- if item.image -%}
      <img
        src="{{ item.image | image_url: width: 220 }}"
        alt="{{ item.image.alt | default: item.product.title | escape }}"
        loading="lazy"
        width="110"
        height="132"
        class="kasya-aov-cart__item-image"
      >
    {%- else -%}
      <span class="kasya-aov-cart__item-image kasya-aov-cart__item-image--placeholder"></span>
    {%- endif -%}
  </a>

  <div class="kasya-aov-cart__item-content">
    <div class="kasya-aov-cart__item-topline">
      <a class="kasya-aov-cart__item-title" href="{{ item.url }}">{{ item.product.title | escape }}</a>
      <button
        type="button"
        class="kasya-aov-cart__item-remove"
        data-kasya-aov-cart-remove
        data-line="{{ item.index | plus: 1 }}"
        data-key="{{ item.key }}"
        aria-label="Remove {{ item.product.title | escape }}"
      >
        <span aria-hidden="true">×</span>
      </button>
    </div>

    {%- unless item.product.has_only_default_variant -%}
      <p class="kasya-aov-cart__item-variant">
        {%- for option in item.options_with_values -%}
          {{ option.value }}{% unless forloop.last %} | {% endunless %}
        {%- endfor -%}
      </p>
    {%- endunless -%}

    {%- if item.variant.sku != blank -%}
      <p class="kasya-aov-cart__item-sku">SKU: {{ item.variant.sku }}</p>
    {%- endif -%}

    <div class="kasya-aov-cart__item-bottomline">
      <div class="kasya-aov-cart__quantity" aria-label="Quantity controls for {{ item.product.title | escape }}">
        <button
          type="button"
          class="kasya-aov-cart__quantity-button"
          data-kasya-aov-cart-decrease
          data-line="{{ item.index | plus: 1 }}"
          data-key="{{ item.key }}"
          aria-label="Decrease quantity for {{ item.product.title | escape }}"
        >
          -
        </button>
        <span class="kasya-aov-cart__quantity-value" data-kasya-aov-cart-quantity>{{ item.quantity }}</span>
        <button
          type="button"
          class="kasya-aov-cart__quantity-button"
          data-kasya-aov-cart-increase
          data-line="{{ item.index | plus: 1 }}"
          data-key="{{ item.key }}"
          aria-label="Increase quantity for {{ item.product.title | escape }}"
        >
          +
        </button>
      </div>

      <div class="kasya-aov-cart__item-price">
        {%- if item.original_line_price != item.final_line_price -%}
          <s>{{ item.original_line_price | money }}</s>
          <strong>{{ item.final_line_price | money }}</strong>
        {%- else -%}
          <span>{{ item.final_line_price | money }}</span>
        {%- endif -%}
      </div>
    </div>
  </div>
</article>
