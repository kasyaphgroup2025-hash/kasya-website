<link rel="stylesheet" href="{{ 'component-search.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'component-mega-menu.css' | asset_url }}" media="print" onload="this.media='all'">

<noscript>{{ 'component-mega-menu.css' | asset_url | stylesheet_tag }}</noscript>
<noscript>{{ 'component-search.css' | asset_url | stylesheet_tag }}</noscript>

{%- liquid
  assign mobile_drawer_font = section.settings.mobile_drawer_font
  assign mobile_drawer_font_medium = mobile_drawer_font | font_modify: 'weight', '500'
-%}

{%- if has_localization -%}
  <script src="{{ 'localization-form.js' | asset_url }}" defer="defer"></script> 
{%- endif -%}
{%-liquid
  if has_transparent 
   render 'header-assets-transparent', text_color_transparent: text_color_transparent
  endif
-%}
<style>
  {%- liquid
    echo mobile_drawer_font | font_face: font_display: 'swap'
    if mobile_drawer_font_medium and mobile_drawer_font_medium != mobile_drawer_font
      echo mobile_drawer_font_medium | font_face: font_display: 'swap'
    endif
  -%}

  .menu-drawer {
    --mobile-drawer-font-family: {{ mobile_drawer_font.family }}, {{ mobile_drawer_font.fallback_families }};
  }

  .header-top {
    --disclosure-direction: 0.5rem;
    border-bottom: 1px solid rgb(var(--color-foreground), 0.05);
  }

  .header-announcement {
    min-height: 3.8rem;
    overflow: hidden;
  }

  .header-announcement__rotator {
    position: relative;
    display: block;
    height: 3.8rem;
    overflow: hidden;
  }

  .header-announcement__message {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.6rem 1.5rem;
    color: rgb(var(--color-foreground));
    font-size: 1.2rem;
    line-height: 1.35;
    letter-spacing: 0.04rem;
    text-align: center;
    opacity: 0;
    transform: translateY(100%);
    transition: transform 500ms cubic-bezier(0.22, 1, 0.36, 1), opacity 350ms ease;
    pointer-events: none;
  }

  .header-announcement__message.is-active {
    opacity: 1;
    transform: translateY(0);
  }

  .header-announcement__message.is-exiting {
    opacity: 0;
    transform: translateY(-100%);
  }

  @media screen and (max-width: 749px) {
    .header-announcement,
    .header-announcement__rotator {
      min-height: 4.4rem;
      height: 4.4rem;
    }

    .header-announcement__message {
      padding-inline: 1.2rem;
      font-size: 1.1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .header-announcement__message {
      transition: opacity 150ms ease;
      transform: none;
    }

    .header-announcement__message.is-active,
    .header-announcement__message.is-exiting {
      transform: none;
    }
  }

  .menu-drawer-container {
    display: flex;
  }

  .header__heading-logo {
    max-width: min(100%, {{ section.settings.logo_width_mobile }}px);
  }

  .header__icons {
    column-gap: 1rem;
  }

  .list-menu {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .list-menu--inline {
    display: inline-flex;
    flex-wrap: wrap;
    column-gap: 0.5rem;
  }

  summary.list-menu__item {
    padding-inline-end: 2.7rem;
  }

  .list-menu__item:not(.header__menu-item--top) {
    line-height: calc(1 + 0.3 / var(--font-body-scale));
  }

  .list-menu__item--link {
    text-decoration: none;
    padding-bottom: 1rem;
    padding-top: 1rem;
    line-height: calc(1 + 0.8 / var(--font-body-scale));
  }

  .predictive-search-loading-icon {
    display: none;
  }

  .header__toggle-nav-button {
    width: 0rem;
    padding: 0;
    background: none;
    border: none;
  }

  {% if request.page_type == 'collection' %}
    .header__heading-logo.show-in-transparent {
      display: none;
    }
  {% endif %}

  @media screen and (min-width: 750px) {
    .list-menu__item--link {
      padding-bottom: 0.6rem;
      padding-top: 0.6rem;
    }
  }
  {%- if section.settings.logo_width != section.settings.logo_width_mobile -%}
    @media screen and (min-width: 990px) {
      .header__heading-logo {
        max-width: min(100%, {{ section.settings.logo_width }}px);
      }
    }
  {%- endif -%}
  @media screen and (min-width: 1200px) {
    .list-menu--inline {
      column-gap: 1rem;
    }
  }
</style>
<style>
  {%-liquid
    assign top_total_location = total_location
    if section.settings.show_country_language_selector_drawer_mobile
      assign top_total_location = 0
    endif
  -%}
  @media screen and (max-width: 989px) {
    .header__heading-link {
      {%- if section.settings.mobile_logo_position == 'center' -%}
        text-align: center;
      {%- else -%}
        margin-inline-start: 1rem;  
      {%- endif -%}  
    }
    {%- if section.settings.show_store_information_blocks_on_mobile and store_information_blocks.size > 0 -%}
      {%-liquid
        assign store_information_full_on_mobile = false
        assign store_information_center_on_mobile = false
        if store_information_blocks.size > 1 or top_total_location != 1
          assign store_information_full_on_mobile = true
        endif

        if store_information_blocks.size == 1 and top_total_location != 1
          assign store_information_center_on_mobile = true
        endif
      -%}
      {%- if store_information_full_on_mobile or store_information_center_on_mobile -%}
        {%- if store_information_full_on_mobile -%}
          .header__store-information {
            min-width: 100%;
          }
          {%- if top_total_location > 0 -%}
            .header__store-information__list {
              padding: 0.5rem 0 0;
            }
          {%- endif -%}
        {%- endif -%}
        {%- if store_information_center_on_mobile -%}
          .header__store-information__list {
            justify-content: center;
          }
        {%- endif -%}  
      {%- endif -%} 
      {%- if store_information_blocks.size == 1 and top_total_location == 1 -%}
        .header-top__content {
          flex-wrap: nowrap;
          gap: 0.5rem;
        }
        .header__localization {
          justify-content: flex-end;
        }
      {%- endif -%}
    {%- endif -%}
  }
  .header {
    --header-template-areas: 'left-icon heading icons';
    {%- case section.settings.mobile_logo_position -%}
    {%- when 'center' -%}
      --header-template-columns: 1fr auto 1fr;  
    {%- when 'left' -%}
      --header-template-columns: auto auto 1fr;    
    {%- endcase -%}  
  }
  {%- if section.settings.show_store_information_blocks_on_mobile and store_information_blocks.size == 1 and top_total_location == 2 -%}
    @media screen and (min-width: 750px) and (max-width: 989px) {
      .header__store-information {
        min-width: auto;
      }
      .header__store-information__list {
        justify-content: flex-start;
        padding: 1.3rem 0;
      }
      .header-top__content {
        flex-wrap: nowrap;
        gap: 0.5rem;
      }
      .header__localization {
        justify-content: flex-end;
      }
    }
  {%- endif -%}  
  @media screen and (min-width: 990px) {
    .header {
      {%- case section.settings.logo_position -%}
      {%- when 'top-left' -%}
        --header-template-areas: 'heading icons icons' 'navigation navigation navigation';  
        --header-template-columns: auto repeat(2, 1fr);
        padding-top: 1.5rem;
      {%- when 'middle-left-navigation-left' -%}
        --header-template-areas: 'heading navigation icons';
        --header-template-columns: auto 1fr auto;
        padding-top: 1rem;
        padding-bottom: 1rem;
      {%- when 'middle-left-navigation-center' -%}
        --header-template-areas: 'heading navigation icons';
        --header-template-columns: auto 1fr auto;  
        padding-top: 1rem;
        padding-bottom: 1rem;
      {%- when 'center-drawer' -%}
        --header-template-areas: 'navigation heading icons';
        --header-template-columns: 1fr auto 1fr;
        padding-top: 1rem;
        padding-bottom: 1rem;    
      {%- when 'middle-center' -%}
        --header-template-areas: 'navigation heading icons';
        --header-template-columns: 1fr auto 1fr;
        padding-top: 1rem;
        padding-bottom: 1rem;      
      {%- endcase -%}
    }

    .header.header--kasya-desktop {
      --header-template-areas: 'heading heading' 'navigation icons';
      --header-template-columns: minmax(0, 1fr) auto;
      position: relative;
      width: 100%;
      padding-top: 2.2rem;
      padding-bottom: 1.2rem;
      background: #ffffff !important;
      color: #111111;
    }

    .header--kasya-desktop .header__inner {
      align-items: center;
      row-gap: 1.8rem;
    }

    .header--kasya-desktop .header__heading {
      z-index: 3;
      width: 100%;
      justify-content: center;
      justify-self: center;
    }

    .header--kasya-desktop .header__heading-link {
      justify-content: center;
      margin: 0;
    }

    .header--kasya-desktop .header__heading-logo {
      filter: none !important;
    }

    .header--kasya-desktop .header__inline-menu {
      align-self: center;
      justify-self: start;
      margin: 0;
    }

    .header--kasya-desktop .header__inline-menu nav {
      margin: 0;
    }

    .header--kasya-desktop .header__inline-menu .list-menu--inline {
      gap: clamp(1.8rem, 2.25vw, 3.6rem);
    }

    .header--kasya-desktop .header__inline-menu .header__menu-item--top,
    .header--kasya-desktop .header__inline-menu summary.header__menu-item--top {
      min-height: 4.4rem;
      padding-block: 1rem;
      color: #111111;
      font-family: var(--font-body-family);
      font-size: 1.2rem;
      font-style: var(--font-body-style);
      font-weight: 500;
      letter-spacing: 0.09em;
      line-height: 1.2;
      text-transform: uppercase;
    }

    .header--kasya-desktop .header__icons {
      grid-column: auto;
      width: auto;
      justify-content: flex-end;
      justify-self: end;
      column-gap: 0.8rem;
      color: #111111;
    }

    .header--kasya-desktop .header__desktop-account,
    .header--kasya-desktop .header__desktop-compare {
      display: none !important;
    }

    .header--kasya-desktop .header__icon {
      --color-foreground: 17, 17, 17;
      --color-link: 17, 17, 17;
      color: #111111;
    }

    .header--kasya-desktop .header__icon--search {
      width: 4rem;
      height: 4rem;
    }

    .header--kasya-desktop .header__icon--cart {
      min-height: 4.4rem;
      margin-inline-start: 0;
    }

    .header--kasya-desktop .header__cart-inner {
      gap: 1rem;
    }

    .header--kasya-desktop .header__cart-total {
      min-width: 6.8rem;
      align-items: flex-start;
      row-gap: 0.4rem;
    }

    .header--kasya-desktop .header__cart-total__label {
      color: rgba(17, 17, 17, 0.62);
      font-size: 1rem;
      font-weight: 400;
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }

    .header--kasya-desktop .header__cart-total__price {
      color: #111111;
      font-size: 1.25rem;
      font-weight: 500;
    }

    .header--kasya-desktop .header__count-bubble {
      background: #111111;
      color: #ffffff;
    }

    {%- if section.settings.logo_position == 'top-left' -%}
      .header__inner {
        row-gap: 1.5rem;
      }
      .header__heading {
        z-index: 3;
      }
      .header__icons {
        grid-column: 2/4;
        width: 100%;
        justify-content: flex-end;
      }
      .header__search {
        flex-grow: 1;
      }
      .search--header {
        justify-content: flex-end;
      }
      .search__input--header {
        {% unless section.settings.expand_search_box %}
          width: min(50rem, 100%);
        {% else %}
          width: 100%;
        {% endunless %}  
      }
    {%- endif -%}
    {%- if section.settings.logo_position == 'middle-left-navigation-left' -%}
      .header__inline-menu {
        margin-inline-start: 2.8rem;
      }
    {%- endif -%}    
    {%- if section.settings.logo_position == 'top-left' and menu_labels.size > 0 -%}
      .header__menu-labels ul {
        column-gap: 2.5rem;
      }
    {%- endif -%} 
    {%- if section.settings.logo_position == 'middle-left-navigation-center' -%}
      .header__inline-menu {
        justify-self: center;
        align-self: center;
      }
    {%- endif -%}
    {%- if section.settings.logo_position == 'center-drawer' -%}
      .header__left-icons {
        margin-inline-start: -1rem;
      }
    {%- endif -%}

    .header__inline-menu,
    .header__inline-menu nav,
    .header__inline-menu .list-menu--inline {
      min-width: 0;
    }

    .header__inline-menu .list-menu--inline {
      display: flex;
      flex-wrap: nowrap;
      align-items: center;
      gap: clamp(1.8rem, 2.2vw, 2.8rem);
    }

    .header__inline-menu .list-menu--inline > li {
      flex: 0 0 auto;
      white-space: nowrap;
    }

    .header__inline-menu .header__menu-item--top,
    .header__inline-menu summary.header__menu-item--top {
      display: inline-flex;
      align-items: center;
      justify-content: flex-start;
      gap: 0.6rem;
      padding-inline: 0;
      white-space: nowrap;
    }

    .header__inline-menu summary.header__menu-item--top {
      padding-inline-end: 0;
    }

    .header__inline-menu .header__menu-item--top .icon-caret {
      position: static !important;
      inset: auto !important;
      flex: 0 0 auto;
      width: 1.4rem;
      height: 1.4rem;
      margin: 0 0 0 0.2rem;
      transform: none !important;
      color: currentColor;
    }

    .mega-menu__content,
    .header__submenu,
    .list-menu--disclosure {
      --color-background: 255, 255, 255;
      --color-foreground: 0, 0, 0;
      background: #ffffff !important;
      color: #000000 !important;
    }

    .mega-menu__content a,
    .mega-menu__content .link,
    .mega-menu__content .list-menu__item,
    .mega-menu__content .mega-menu__link,
    .mega-menu__content .header-menu__link-sub,
    .header__submenu a,
    .header__submenu .link,
    .header__submenu .list-menu__item,
    .list-menu--disclosure a,
    .list-menu--disclosure .list-menu__item {
      color: #000000 !important;
    }

    .mega-menu__content a:hover,
    .mega-menu__content .list-menu__item:hover,
    .header__submenu a:hover,
    .header__submenu .list-menu__item:hover,
    .list-menu--disclosure a:hover,
    .list-menu--disclosure .list-menu__item:hover,
    .mega-menu__content a[aria-current='page'],
    .header__submenu a[aria-current='page'] {
      color: #000000 !important;
      opacity: 0.72;
    }
  }
</style>
{%- if section.settings.enable_customer_support_region -%}
  <script src="{{ 'details-accordion.js' | asset_url }}" defer="defer"></script>
{%- endif -%}  
<script src="{{ 'details-disclosure.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'details-modal.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'mobile-menu-accordion.js' | asset_url }}" defer="defer"></script>
{%- if section.settings.enable_sticky_header -%}
  <script src="{{ 'sticky-header.js' | asset_url }}" defer="defer"></script>
{%- endif -%}
