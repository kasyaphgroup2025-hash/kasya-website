<shoppable-reels-popup id="shoppable-reels-popup">
  <div class="reels-popup">
    <div class="reels-popup__buttons reels-popup__buttons--actions flex flex-column">
      <button type="button" class="popup-close reels-popup__button" aria-label="{{ 'accessibility.close' | t }}">{% render 'icon-close' %}</button>
      <button type="button" class="reels-collapse reels-popup__button">
