{%- liquid
  assign display_item = top_item | default: pants_item
  assign set_color = display_item.properties._set_color | default: 'Jane'
  assign set_total = 0
  assign set_complete = true

  if top_item
    assign set_total = set_total | plus: top_item.final_line_price
  else
    assign set_complete = false
  endif

  if pants_item
    assign set_total = set_total | plus: pants_item.final_line_price
  else
    assign set_complete = false
  endif
-%}

<tr
  id="{% if in_drawer %}CartDrawer{% else %}Cart{% endif %}-JaneSet-{{ set_id | handleize }}"
  class="cart-item jane-set-cart-item"
  data-jane-set-id="{{ set_id | escape }}"
>
  <td class="cart-item__media">
    {%- if display_item.image -%}
      <div class="cart-item__image-container media media--square">
        <img
          src="{{ display_item.image | image_url: width: 300 }}"
          class="cart-item__image"
          alt="{{ set_color | append: ' Jane Set' | escape }}"
          loading="lazy"
          width="100"
          height="100"
        >
      </div>
    {%- endif -%}
  </td>

  <td class="cart-item__details{% if in_drawer %} cart-item__details--drawer{% endif %}">
    <p class="cart-item__name {% if in_drawer %}h6{% else %}h4{% endif %} font-heading-bold">
      {{ set_color }} Jane Set
    </p>

    {%- if top_item -%}
      <p class="product-option margin0">
        {{ set_color }} Blouse: {{ top_item.properties._top_size }}
      </p>
      {%- if top_item.sku != blank -%}
        <p class="product-option light margin0">SKU: {{ top_item.sku }}</p>
      {%- endif -%}
    {%- endif -%}

    {%- if pants_item -%}
      <p class="product-option margin0">
        {{ set_color }} Pants: {{ pants_item.properties._pants_size }}
      </p>
      {%- if pants_item.sku != blank -%}
        <p class="product-option light margin0">SKU: {{ pants_item.sku }}</p>
      {%- endif -%}
    {%- endif -%}

    {%- unless set_complete -%}
      <p class="jane-set-cart-item__warning" role="alert">
        Incomplete Jane Set detected. It is being removed from your cart.
      </p>
    {%- endunless -%}
  </td>

  <td class="cart-item__quantity">
    <span class="product-option">Qty: 1</span>
    <jane-set-remove-button
      data-top-key="{{ top_item.key | escape }}"
      data-pants-key="{{ pants_item.key | escape }}"
      data-incomplete="{% unless set_complete %}true{% else %}false{% endunless %}"
    >
      <button type="button" class="link tap-area-icon" aria-label="Remove {{ set_color }} Jane Set">
        {% render 'icon-remove' %}
      </button>
    </jane-set-remove-button>
  </td>

  <td class="{% if in_drawer %}cart-drawer__item-total {% endif %}cart-item__totals">
    <span class="price price--end">
      {%- render 'price-format', price: set_total -%}
    </span>
  </td>

  {%- unless in_drawer -%}
    <td class="small-hide medium-hide">
      <jane-set-remove-button
        data-top-key="{{ top_item.key | escape }}"
        data-pants-key="{{ pants_item.key | escape }}"
        data-incomplete="false"
      >
        <button type="button" class="link tap-area-icon" aria-label="Remove {{ set_color }} Jane Set">
          {% render 'icon-remove' %}
        </button>
      </jane-set-remove-button>
    </td>
  {%- endunless -%}

  <td class="cart-item__error hidden" role="alert">
    <small class="cart-item__error-text"></small>
  </td>
</tr>
