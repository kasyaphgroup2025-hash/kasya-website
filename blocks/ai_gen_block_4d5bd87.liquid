{% doc %}
  @prompt
    Create me a contact information on our website include working ours of our support / time / contact number / email address 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-contact-info-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.padding_top }}px {{ block.settings.padding_horizontal }}px {{ block.settings.padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-contact-info-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
  }

  .ai-contact-info-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 {{ block.settings.heading_spacing }}px;
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-contact-info-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.grid_gap }}px;
    margin-top: {{ block.settings.content_spacing }}px;
  }

  .ai-contact-info-item-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.item_gap }}px;
    padding: {{ block.settings.item_padding }}px;
    background-color: {{ block.settings.item_background }};
    border-radius: {{ block.settings.item_border_radius }}px;
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-contact-info-icon-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    color: {{ block.settings.icon_color }};
    {% if block.settings.text_alignment == 'center' %}
      margin: 0 auto;
    {% elsif block.settings.text_alignment == 'right' %}
      margin-left: auto;
    {% endif %}
  }

  .ai-contact-info-label-{{ ai_gen_id }} {
    font-size: {{ block.settings.label_size }}px;
    font-weight: 600;
    color: {{ block.settings.label_color }};
    margin: 0;
  }

  .ai-contact-info-value-{{ ai_gen_id }} {
    font-size: {{ block.settings.value_size }}px;
    color: {{ block.settings.value_color }};
    margin: 0;
    line-height: 1.6;
  }

  .ai-contact-info-value-{{ ai_gen_id }} a {
    color: {{ block.settings.link_color }};
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .ai-contact-info-value-{{ ai_gen_id }} a:hover {
    color: {{ block.settings.link_hover_color }};
    text-decoration: underline;
  }

  @media screen and (max-width: 989px) {
    .ai-contact-info-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_tablet }}, 1fr);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-contact-info-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_top | times: 0.7 }}px {{ block.settings.padding_horizontal | times: 0.7 }}px {{ block.settings.padding_bottom | times: 0.7 }}px;
    }

    .ai-contact-info-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
    }

    .ai-contact-info-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.8 }}px;
    }
  }
{% endstyle %}

<div class="ai-contact-info-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-contact-info-container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2 class="ai-contact-info-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
    {% endif %}

    <div class="ai-contact-info-grid-{{ ai_gen_id }}">
      {% if block.settings.show_phone %}
        <div class="ai-contact-info-item-{{ ai_gen_id }}">
          <svg class="ai-contact-info-icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          <p class="ai-contact-info-label-{{ ai_gen_id }}">{{ block.settings.phone_label }}</p>
          <p class="ai-contact-info-value-{{ ai_gen_id }}">
            {% if block.settings.phone_number != blank %}
              <a href="tel:{{ block.settings.phone_number | replace: ' ', '' }}">{{ block.settings.phone_number }}</a>
            {% else %}
              +63 123 456 7890
            {% endif %}
          </p>
        </div>
      {% endif %}

      {% if block.settings.show_email %}
        <div class="ai-contact-info-item-{{ ai_gen_id }}">
          <svg class="ai-contact-info-icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          <p class="ai-contact-info-label-{{ ai_gen_id }}">{{ block.settings.email_label }}</p>
          <p class="ai-contact-info-value-{{ ai_gen_id }}">
            {% if block.settings.email_address != blank %}
              <a href="mailto:{{ block.settings.email_address }}">{{ block.settings.email_address }}</a>
            {% else %}
              support@kasyaph.com
            {% endif %}
          </p>
        </div>
      {% endif %}

      {% if block.settings.show_hours %}
        <div class="ai-contact-info-item-{{ ai_gen_id }}">
          <svg class="ai-contact-info-icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <p class="ai-contact-info-label-{{ ai_gen_id }}">{{ block.settings.hours_label }}</p>
          <div class="ai-contact-info-value-{{ ai_gen_id }}">
            {% if block.settings.working_hours != blank %}
              {{ block.settings.working_hours }}
            {% else %}
              <p>Monday - Friday: 9:00 AM - 6:00 PM</p>
              <p>Saturday: 10:00 AM - 4:00 PM</p>
              <p>Sunday: Closed</p>
            {% endif %}
          </div>
        </div>
      {% endif %}

      {% if block.settings.show_support_time %}
        <div class="ai-contact-info-item-{{ ai_gen_id }}">
          <svg class="ai-contact-info-icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
          <p class="ai-contact-info-label-{{ ai_gen_id }}">{{ block.settings.support_time_label }}</p>
          <div class="ai-contact-info-value-{{ ai_gen_id }}">
            {% if block.settings.support_time != blank %}
              {{ block.settings.support_time }}
            {% else %}
              <p>Response time: Within 24 hours</p>
              <p>Timezone: Asia/Manila (GMT+8)</p>
            {% endif %}
          </div>
        </div>
      {% endif %}
    </div>
  </div>
</div>

