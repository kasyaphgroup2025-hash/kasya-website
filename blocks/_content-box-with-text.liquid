<div class="flex-grow-1 flex justify-desktop spacing-style border-style flex-column custom-gap custom-gap-desktop{% if block.settings.background %} gradient{% endif %}" style="
  --justify-desktop:{{ block.settings.stack_alignment }};
  align-self: normal;
  {% render 'spacing-style', local_settings: block.settings %}
  {% render 'border-override', local_settings: block.settings %}
  {% render 'background-style', local_settings: block.settings %}
  --custom-gap: {{ block.settings.gap_mobile }}px;
  --custom-gap-desktop: {{ block.settings.gap_desktop }}px;
" {{ block.shopify_attributes }}>
  {%- content_for 'blocks' -%}
</div>
{% schema %}
{
  "name": "t:names.content_box",
  "tag": null,
  "blocks": [
    {
      "type": "_basic-group"
    }
  ],
  "settings": [
    {
      "type": "select",
      "id": "stack_alignment",
      "options": [
        {
          "value": "flex-start",
          "label": "t:sections.image-with-text.settings.desktop_content_position.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.image-with-text.settings.desktop_content_position.options__2.label"
        },
        {
          "value": "flex-end",
          "label": "t:sections.image-with-text.settings.desktop_content_position.options__3.label"
        },
        {
          "value": "space-between",
          "label": "t:options.spread_out"
        }
      ],
      "default": "center",
      "label": "t:settings.stack_alignment_on_desktop",
      "info": "t:info.stack_alignment_content_box_with_text"
    },
    {
      "type": "header",
      "content": "t:content.gap"
    },
    {
      "type": "range",
      "id": "gap_desktop",
      "label": "t:settings.on_desktop",
      "info": "t:info.also_apply_to_tablets",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 35
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "label": "t:settings.on_mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 10
    },
    {
      "type": "header",
      "content": "t:content.borders"
    },
    {
      "type": "select",
      "id": "border",
      "label": "t:settings.style",
      "options": [
        {
          "value": "none",
          "label": "t:options.none"
        },
        {
          "value": "solid",
          "label": "t:options.solid"
        },
        {
          "value": "dashed",
          "label": "t:options.dashed"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:settings.thickness",
      "default": 1,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "t:settings.border_opacity",
      "default": 100,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "t:settings.border_radius",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 10
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "checkbox",
      "id": "background",
      "label": "t:settings.custom_background",
      "default": false
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "alpha": true,
      "default": "#00000026",
      "visible_if": "{{ block.settings.background }}"
    },
    {
      "type": "color_background",
      "id": "gradient_background",
      "label": "t:settings_schema.colors.settings.gradient_background.label",
      "visible_if": "{{ block.settings.background }}"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:options.top",
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:options.bottom",
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:options.left",
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:options.right",
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 15
    }
  ],
  "presets": [
    {
      "name": "t:names.content_box",
      "category": "t:categories.layout"
    }
  ]
}
{% endschema %}