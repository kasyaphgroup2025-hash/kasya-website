{%-liquid
  assign should_display = true
  assign has_content = false
  if block.settings.media_type == 'image'
    if block.settings.image != blank
      assign has_content = true
    endif
  else
    if block.settings.video != nil
      assign has_content = true
    endif
  endif
  if has_content == false and request.design_mode == false
    if request.page_type == 'product' or request.page_type == 'collection' or request.page_type == 'page' or request.page_type == 'blog' or request.page_type == 'article'
      assign should_display = false
    endif
  endif
-%}
{%- if should_display -%}
  {% capture block_style %}
    {% render 'border-override', local_settings: block.settings %}
    {%- if block.settings.media_type == 'video' -%}
      {%-liquid
        assign video_ratio = '16 / 9'
        if block.settings.video != nil
          assign video_ratio = block.settings.video.aspect_ratio
        endif  
      %}
      --aspect-ratio: {{ video_ratio }};
      {%- if section.settings.slide_height == 'adapt' or section.settings.slide_height_mobile == 'adapt-mobile' -%}
        --aspect-ratio-mobile: {{ video_ratio }};
        --aspect-ratio-desktop: {{ video_ratio }};
      {%- endif -%} 
    {%- else -%}
      {%- if section.settings.slide_height == 'adapt' or section.settings.slide_height_mobile == 'adapt-mobile' -%}
        {%- if block.settings.image != blank -%}
          --aspect-ratio-desktop: {{ block.settings.image.aspect_ratio }};
          {%- if section.settings.slide_height_mobile == 'adapt-mobile' -%}
            {%- if block.settings.image_mobile != blank -%}
              --aspect-ratio-mobile: {{ block.settings.image_mobile.aspect_ratio }};
            {%- else -%}
              --aspect-ratio-mobile: {{ block.settings.image.aspect_ratio }};
            {%- endif -%}
          {%- endif -%}
        {%- else -%}
          --aspect-ratio-desktop: 1;
          --aspect-ratio-mobile: 1;
        {%- endif -%}
      {%- endif -%}
    {%- endif -%}  
  {% endcapture %}
  <div class="por border-style rich-slideshow__slide slider__slide grid__item overflow-hidden"
    style="{{ block_style }}"
    id="Slide-{{ section.id }}-{{ block.id }}"
    aria-roledescription="{{ 'sections.slideshow.slide' | t }}"
    role="group"
    tabindex="-1"
    {{ block.shopify_attributes }}
  >
    <div class="db overflow-hidden rich-slideshow__media h100{% unless has_content %} placeholder{% endunless %}">
      {%- if block.settings.media_type == 'image' -%}
        {%- render 'image', block: block, wrapper_class: 'w100 h100', inherit_ratio: true -%}
      {%- else -%}
        {%- if block.settings.video != nil -%}
          {% render 'video',
            video_from_url: false,
            video: block.settings.video,
            video_autoplay: false,
            enable_sound: false,
            video_loop: true,
            enable_controls: false,
            no_need_button: true,
            video_class: 'parallax-ele',
            playing_class: 'video--background'
          %}
        {%- else -%}
          {{ 'collection-apparel-2' | placeholder_svg_tag: 'placeholder-svg placeholder aspect-ratio w100 h100' }}  
        {%- endif -%}  
      {%- endif -%}
    </div>
    
    {%- content_for 'block', type: '_content-box', id: 'group-content-banner', parent_id: block.id, use_appear_animate: false -%}

    {%- if block.settings.media_type == 'image' and block.settings.link != blank -%}
      <a
        href="{{ block.settings.link }}"
        class="banner__full-link w100 h100"
      ></a>
    {%- endif -%}
  </div>
  <!--RICH_SLIDESHOW_ITEM-->
{%- endif -%}
{% schema %}
{
  "name": "t:names.slide",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "media_type",
      "label": "t:settings.media_type",
      "options": [
        {
          "value": "image",
          "label": "t:options.image"
        },
        {
          "value": "video",
          "label": "t:options.video"
        }
      ],
      "default": "image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:settings.image",
      "visible_if": "{{ block.settings.media_type == 'image' }}"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "t:settings.mobile_image",
      "visible_if": "{{ block.settings.media_type == 'image' }}"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:settings.link",
      "visible_if": "{{ block.settings.media_type == 'image' }}"
    },
    {
      "type": "video",
      "id": "video",
      "label": "t:sections.video.settings.video_hosted.label",
      "visible_if": "{{ block.settings.media_type == 'video' }}"
    },
    {
      "type": "header",
      "content": "t:content.borders"
    },
    {
      "type": "select",
      "id": "border",
      "label": "t:settings.style",
      "options": [
        {
          "value": "none",
          "label": "t:options.none"
        },
        {
          "value": "solid",
          "label": "t:options.solid"
        },
        {
          "value": "dashed",
          "label": "t:options.dashed"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:settings.thickness",
      "default": 1,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "t:settings.border_opacity",
      "default": 100,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "t:settings.border_radius",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 10
    }
  ],
  "presets": [
    {
      "name": "t:names.image",
      "category": "t:categories.banners",
      "settings": {
        "media_type": "image"
      },
      "blocks": {
        "group-content-banner": {
          "type": "_content-box",
          "static": true,
          "blocks": {
            "basic-group": {
              "type": "_basic-group",
              "blocks": {
                "heading": {
                  "type": "text",
                  "settings": {
                    "html_tag": "h1",
                    "text": "Heading"
                  }
                },
                "rich-text": {
                  "type": "rich-text"
                },
                "button": {
                  "type": "button"
                }
              },
              "block_order": ["heading", "rich-text", "button"]
            }
          },
          "block_order": ["basic-group"]
        }
      }
    },
    {
      "name": "t:names.video",
      "category": "t:categories.banners",
      "settings": {
        "media_type": "video"
      },
      "blocks": {
        "group-content-banner": {
          "type": "_content-box",
          "static": true,
          "blocks": {
            "basic-group": {
              "type": "_basic-group",
              "blocks": {
                "heading": {
                  "type": "text",
                  "settings": {
                    "html_tag": "h1",
                    "text": "Heading"
                  }
                },
                "rich-text": {
                  "type": "rich-text"
                },
                "button": {
                  "type": "button"
                }
              },
              "block_order": ["heading", "rich-text", "button"]
            }
          },
          "block_order": ["basic-group"]
        }
      }
    }
  ]
}
{% endschema %}