{% doc %}
  @prompt
    Create a clean, minimal section highlighting our new color release of our Wideleg Pants.
    
    Design style: soft neutral background (#F2EDE7), modern, airy spacing, premium boutique look. No harsh shadows, no clutter.
    
    Section Layout:
    1. Title: “New Color Drop: Wideleg Pants”
    2. Subtext: “Your everyday comfort pants, now in a new timeless shade.”
    3. Large product image on the left (mobile: image on top).
    4. On the right side: product name, short description, color name, price, and “Shop Now” button.
    5. Add a small text row below: “Available in sizes S to 3XL — breathable, flowy, and flattering for all bodies.”
    6. Button Style: rounded corners, minimal, neutral tone (dark gray #2E2E2E).
    7. Ensure mobile layout is clean and stacked with enough breathing space.
    
    Overall vibe: Elegant, calm, wearable fashion — not loud or graphic-heavy.
    
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-product-feature-{{ ai_gen_id }} {
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding_desktop }}px 20px;
  }

  .ai-product-feature-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
  }

  .ai-product-feature-header-{{ ai_gen_id }} {
    text-align: {{ block.settings.text_alignment }};
    margin-bottom: {{ block.settings.header_spacing }}px;
  }

  .ai-product-feature-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0 0 12px 0;
    font-weight: 400;
    letter-spacing: 0.5px;
  }

  .ai-product-feature-subtext-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtext_size }}px;
    color: {{ block.settings.text_color }};
    opacity: 0.8;
    margin: 0;
    line-height: 1.6;
  }

  .ai-product-feature-content-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: {{ block.settings.content_gap }}px;
    align-items: center;
  }

  .ai-product-feature-image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    position: relative;
  }

  .ai-product-feature-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-product-feature-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 3 / 4;
    background-color: #e5e5e5;
    border-radius: {{ block.settings.image_border_radius }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-product-feature-image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-product-feature-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    font-size: 14px;
    color: #666;
    text-align: center;
  }

  .ai-product-feature-details-{{ ai_gen_id }} {
    padding: 0 {{ block.settings.details_padding }}px;
  }

  .ai-product-feature-product-name-{{ ai_gen_id }} {
    font-size: {{ block.settings.product_name_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0 0 16px 0;
    font-weight: 500;
    letter-spacing: 0.3px;
  }

  .ai-product-feature-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.text_color }};
    opacity: 0.75;
    line-height: 1.7;
    margin: 0 0 20px 0;
  }

  .ai-product-feature-color-name-{{ ai_gen_id }} {
    font-size: {{ block.settings.color_name_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0 0 16px 0;
    font-style: italic;
    opacity: 0.85;
  }

  .ai-product-feature-price-{{ ai_gen_id }} {
    font-size: {{ block.settings.price_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0 0 24px 0;
    font-weight: 500;
  }

  .ai-product-feature-button-{{ ai_gen_id }} {
    display: inline-block;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_text_size }}px;
    transition: all 0.3s ease;
    border: none;
    cursor: pointer;
    letter-spacing: 0.5px;
  }

  .ai-product-feature-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
    color: {{ block.settings.button_hover_text_color }};
  }

  .ai-product-feature-footer-{{ ai_gen_id }} {
    margin-top: {{ block.settings.footer_spacing }}px;
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-product-feature-footer-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.footer_text_size }}px;
    color: {{ block.settings.text_color }};
    opacity: 0.7;
    margin: 0;
    line-height: 1.6;
  }

  @media screen and (max-width: 749px) {
    .ai-product-feature-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding_mobile }}px 16px;
    }

    .ai-product-feature-content-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.mobile_gap }}px;
    }

    .ai-product-feature-details-{{ ai_gen_id }} {
      padding: 0;
    }

    .ai-product-feature-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.8 }}px;
    }

    .ai-product-feature-product-name-{{ ai_gen_id }} {
      font-size: {{ block.settings.product_name_size | times: 0.85 }}px;
    }

    .ai-product-feature-button-{{ ai_gen_id }} {
      width: 100%;
      text-align: center;
    }
  }
{% endstyle %}

<div class="ai-product-feature-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-product-feature-container-{{ ai_gen_id }}">
    {% if block.settings.title != blank or block.settings.subtext != blank %}
      <div class="ai-product-feature-header-{{ ai_gen_id }}">
        {% if block.settings.title != blank %}
          <h2 class="ai-product-feature-title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
        {% endif %}
        {% if block.settings.subtext != blank %}
          <p class="ai-product-feature-subtext-{{ ai_gen_id }}">{{ block.settings.subtext }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class="ai-product-feature-content-{{ ai_gen_id }}">
      <div class="ai-product-feature-image-wrapper-{{ ai_gen_id }}">
        {% if block.settings.product_image %}
          <img
            src="{{ block.settings.product_image | image_url: width: 1200 }}"
            alt="{{ block.settings.product_image.alt | escape }}"
            class="ai-product-feature-image-{{ ai_gen_id }}"
            loading="lazy"
            width="{{ block.settings.product_image.width }}"
            height="{{ block.settings.product_image.height }}"
          >
        {% else %}
          <div class="ai-product-feature-image-placeholder-{{ ai_gen_id }}">
            {{ 'product-1' | placeholder_svg_tag }}
            <div class="ai-product-feature-empty-state-{{ ai_gen_id }}">
              Add product image
            </div>
          </div>
        {% endif %}
      </div>

      <div class="ai-product-feature-details-{{ ai_gen_id }}">
        {% if block.settings.product_name != blank %}
          <h3 class="ai-product-feature-product-name-{{ ai_gen_id }}">{{ block.settings.product_name }}</h3>
        {% endif %}

        {% if block.settings.product_description != blank %}
          <div class="ai-product-feature-description-{{ ai_gen_id }}">{{ block.settings.product_description }}</div>
        {% endif %}

        {% if block.settings.color_name != blank %}
          <p class="ai-product-feature-color-name-{{ ai_gen_id }}">{{ block.settings.color_name }}</p>
        {% endif %}

        {% if block.settings.price != blank %}
          <p class="ai-product-feature-price-{{ ai_gen_id }}">{{ block.settings.price }}</p>
        {% endif %}

        {% if block.settings.button_text != blank %}
          <a
            href="{{ block.settings.button_link }}"
            class="ai-product-feature-button-{{ ai_gen_id }}"
          >
            {{ block.settings.button_text }}
          </a>
        {% endif %}
      </div>
    </div>

    {% if block.settings.footer_text != blank %}
      <div class="ai-product-feature-footer-{{ ai_gen_id }}">
        <p class="ai-product-feature-footer-text-{{ ai_gen_id }}">{{ block.settings.footer_text }}</p>
      </div>
    {% endif %}
  </div>
</div>

