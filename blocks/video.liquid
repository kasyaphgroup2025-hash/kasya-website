{%-liquid
  assign video_ratio = '16 / 9'
  assign has_content = false
  if block.settings.source == 'uploaded'
    if block.settings.video != nil
      assign has_content = true
    endif
  elsif block.settings.video_url != nil    
      assign has_content = true
  endif
  if block.settings.source == 'uploaded'
    if block.settings.aspect_ratio == 'portrait'
      assign video_ratio = '4 / 5'
    elsif block.settings.aspect_ratio == 'square'
      assign video_ratio = '1 / 1'  
    elsif block.settings.aspect_ratio == 'adapt'
      if block.settings.video != nil
        assign video_ratio = block.settings.video.aspect_ratio
      elsif block.settings.cover_image != blank
        assign video_ratio = block.settings.cover_image.aspect_ratio
      endif  
    endif
  endif
%}
{%- if has_content or request.design_mode -%}
  {% capture video_style %}
    {% render 'spacing-style', local_settings: block.settings %}
    {% render 'border-override', local_settings: block.settings %}
    --size-style-width-desktop:{{ block.settings.width_desktop }}%;
    --size-style-width-tablet:{{ block.settings.width_tablet }}%;
    --size-style-width-mobile:{{ block.settings.width_mobile }}%;
    --aspect-ratio: {{ video_ratio }};
  {% endcapture %}

  <div class="spacing-style size-style size-style--tablet border-style" style="{{ video_style }}" {{ block.shopify_attributes }}>
    {% if block.settings.source == 'uploaded' %}
      {% render 'video',
        video_from_url: false,
        video: block.settings.video,
        video_autoplay: block.settings.video_autoplay,
        enable_sound: block.settings.enable_sound,
        video_loop: block.settings.video_loop,
        enable_controls: block.settings.enable_controls,
        preview_image: block.settings.cover_image
      %}
    {% else %}
      {% render 'video',
        video_from_url: true,
        video: block.settings.video_url.id,
        video_type: block.settings.video_url.type,
        video_autoplay: block.settings.video_autoplay,
        enable_sound: block.settings.enable_sound,
        video_loop: block.settings.video_loop,
        enable_controls: block.settings.enable_controls,
        video_alt: block.settings.alt,
        preview_image: block.settings.cover_image
      %}
    {% endif %}
  </div>
  {{ 'video-section.css' | asset_url | stylesheet_tag }}
  {{ 'component-deferred-media.css' | asset_url | stylesheet_tag }}
{%- endif -%}
{% schema %}
{
  "name": "t:names.video",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "source",
      "label": "t:settings.source",
      "options": [
        {
          "value": "uploaded",
          "label": "t:options.video_uploaded"
        },
        {
          "value": "url",
          "label": "t:options.video_external_url"
        }
      ],
      "default": "uploaded"
    },
    {
      "type": "video",
      "id": "video",
      "label": "t:sections.video.settings.video_hosted.label",
      "visible_if": "{{ block.settings.source == 'uploaded' }}"
    },
    {
      "type": "video_url",
      "id": "video_url",
      "label": "t:sections.video.settings.video_url.label",
      "info": "t:sections.video.settings.video_url.info",
      "accept": ["youtube", "vimeo"],
      "default": "https://www.youtube.com/watch?v=_9VUPq3SxOc",
      "visible_if": "{{ block.settings.source == 'url' }}"
    },
    {
      "type": "checkbox",
      "id": "video_autoplay",
      "label": "t:sections.video.settings.autoplay.label",
      "info": "t:info.video_autoplay",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "enable_sound",
      "label": "t:settings.enable_sound",
      "info": "t:info.sound_not_work_on_vimeo",
      "default": false,
      "visible_if": "{{ block.settings.video_autoplay == false }}"
    },
    {
      "type": "checkbox",
      "id": "video_loop",
      "label": "t:sections.video.settings.enable_video_looping.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_controls",
      "label": "t:sections.video.settings.enable_controls.label",
      "default": false
    },
    {
      "type": "image_picker",
      "id": "cover_image",
      "label": "t:sections.video.settings.cover_image.label",
      "visible_if": "{{ block.settings.video_autoplay == false }}"
    },
    {
      "type": "text",
      "id": "alt",
      "label": "t:settings.video_alt_text",
      "info": "t:info.video_alt_text",
      "visible_if": "{{ block.settings.source == 'url' }}"
    },
    {
      "type": "header",
      "content": "t:content.size"
    },
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "t:settings.aspect_ratio",
      "visible_if": "{{ block.settings.source == 'uploaded' }}",
      "options": [
        {
          "value": "adapt",
          "label": "t:options.auto"
        },
        {
          "value": "square",
          "label": "t:sections.all.image_ratio.option_2.label"
        },
        {
          "value": "portrait",
          "label": "t:sections.all.image_ratio.option_3.label"
        },
        {
          "value": "landscape",
          "label": "t:sections.all.image_ratio.option_4.label"
        }
      ],
      "default": "adapt"
    },
    {
      "type": "range",
      "id": "width_desktop",
      "label": "t:settings.width_desktop",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "width_tablet",
      "label": "t:settings.width_tablet",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "width_mobile",
      "label": "t:settings.width_mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100
    },
    {
      "type": "header",
      "content": "t:content.borders"
    },
    {
      "type": "select",
      "id": "border",
      "label": "t:settings.style",
      "options": [
        {
          "value": "none",
          "label": "t:options.none"
        },
        {
          "value": "solid",
          "label": "t:options.solid"
        },
        {
          "value": "dashed",
          "label": "t:options.dashed"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:settings.thickness",
      "default": 1,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "t:settings.border_opacity",
      "default": 100,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "t:settings.border_radius",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 10
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:options.top",
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:options.bottom",
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:options.left",
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:options.right",
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:names.video",
      "category": "t:categories.basic"
    }
  ]
}
{% endschema %}