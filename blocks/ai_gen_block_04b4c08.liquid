{% doc %}
  @prompt
    Design a full-page 11.11 MEGA SALE section for a fashion brand.
    The layout should look high-energy and premium, inspired by Shopee 11.11 aesthetics but with a fashion-magazine twist — elegant yet exciting.
    
    Color palette:
    Deep red → orange gradient background with gold accents. Add glowing confetti, ribbons, and light streaks in the background for motion and hype.
    
    Header area:
    
    Big headline: ‘11.11 MEGA SALE’ in bold serif font with golden glow.
    
    Subtext: “One Day. Infinite Deals. Shop your favorites before they vanish.”
    
    Add an animated countdown timer (days, hours, minutes, seconds).
    
    Include a glowing CTA button: ‘SHOP NOW’ (white text, red-to-orange hover).
    
    Product grid area:
    
    Show 25+ products from selected collections (5 per row desktop, 2 per row mobile).
    
    Each card includes product image, title, price, discount badge (e.g., ‘50% OFF’), and Add to Cart button.
    
    Show working color swatches + size selectors that disable Add to Cart until both are chosen.
    
    No quantity field.
    
    On hover: card glows softly orange with a sparkle effect.
    
    Badges / ribbons:
    
    Add festive ribbon tags like ‘HOT DEAL’, ‘LIMITED OFFER’, ‘PAYDAY EXCLUSIVE’.
    
    Style ribbons in red-orange gradient with gold borders.
    
    Layout details:
    
    Keep layout clean but packed with movement — subtle glowing animations, floating ribbons, and confetti behind text.
    
    Add subtle blur + depth for a 3D magazine look.
    
    Use elegant serif fonts for titles (Cinzel, Playfair Display) and modern sans-serif for buttons/text.
    
    Responsiveness & flow:
    
    On mobile: 2 items per row, big CTA button at bottom.
    
    Ensure Add to Cart, color, and size variants work perfectly (disable until selected).
    
    Keep mini cart active for fast checkout.
    
    End the section with a closing banner:
    “Sale Ends Tonight at Midnight ⏰” — glowing orange text with confetti burst behind it.”
    
    💥 Optional follow-up prompt (kung gusto mo may galaw):
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-mega-sale-{{ ai_gen_id }} {
    position: relative;
    background: linear-gradient(135deg, #8B0000 0%, #DC143C 50%, #FF4500 100%);
    padding: 60px 20px;
    overflow: hidden;
    min-height: 100vh;
  }

  .ai-mega-sale-bg-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    overflow: hidden;
  }

  .ai-mega-sale-confetti-{{ ai_gen_id }} {
    position: absolute;
    width: 10px;
    height: 10px;
    background: {{ block.settings.confetti_color }};
    opacity: 0.8;
    animation: ai-mega-sale-float-{{ ai_gen_id }} 4s infinite ease-in-out;
  }

  @keyframes ai-mega-sale-float-{{ ai_gen_id }} {
    0%, 100% { transform: translateY(0) rotate(0deg); opacity: 0; }
    10% { opacity: 0.8; }
    50% { transform: translateY(-100px) rotate(180deg); opacity: 0.8; }
    90% { opacity: 0.8; }
    100% { transform: translateY(-200px) rotate(360deg); opacity: 0; }
  }

  .ai-mega-sale-ribbon-{{ ai_gen_id }} {
    position: absolute;
    width: 200px;
    height: 40px;
    background: linear-gradient(135deg, #DC143C 0%, #FF4500 100%);
    border: 2px solid {{ block.settings.gold_accent }};
    opacity: 0.3;
    animation: ai-mega-sale-ribbon-float-{{ ai_gen_id }} 6s infinite ease-in-out;
  }

  @keyframes ai-mega-sale-ribbon-float-{{ ai_gen_id }} {
    0%, 100% { transform: translateX(0) rotate(0deg); }
    50% { transform: translateX(100px) rotate(10deg); }
  }

  .ai-mega-sale-container-{{ ai_gen_id }} {
    position: relative;
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    z-index: 2;
  }

  .ai-mega-sale-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 50px;
    filter: drop-shadow(0 0 20px rgba(255, 215, 0, 0.5));
  }

  .ai-mega-sale-title-{{ ai_gen_id }} {
    font-family: 'Playfair Display', serif;
    font-size: {{ block.settings.title_size }}px;
    font-weight: 700;
    color: #FFFFFF;
    text-shadow: 0 0 30px {{ block.settings.gold_accent }}, 0 0 60px {{ block.settings.gold_accent }};
    margin: 0 0 20px;
    letter-spacing: 2px;
  }

  .ai-mega-sale-subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_size }}px;
    color: #FFFFFF;
    margin: 0 0 40px;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.5);
  }

  .ai-mega-sale-countdown-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    gap: 20px;
    margin-bottom: 40px;
    flex-wrap: wrap;
  }

  .ai-mega-sale-countdown-item-{{ ai_gen_id }} {
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(10px);
    border: 2px solid {{ block.settings.gold_accent }};
    border-radius: 12px;
    padding: 20px;
    min-width: 100px;
    text-align: center;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
  }

  .ai-mega-sale-countdown-number-{{ ai_gen_id }} {
    font-size: 48px;
    font-weight: 700;
    color: {{ block.settings.gold_accent }};
    display: block;
    text-shadow: 0 0 20px {{ block.settings.gold_accent }};
  }

  .ai-mega-sale-countdown-label-{{ ai_gen_id }} {
    font-size: 14px;
    color: #FFFFFF;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-top: 8px;
  }

  .ai-mega-sale-cta-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 60px;
  }

  .ai-mega-sale-button-{{ ai_gen_id }} {
    display: inline-block;
    padding: 18px 50px;
    background: linear-gradient(135deg, #DC143C 0%, #FF4500 100%);
    color: #FFFFFF;
    font-size: 20px;
    font-weight: 700;
    text-decoration: none;
    border-radius: 50px;
    border: 2px solid {{ block.settings.gold_accent }};
    box-shadow: 0 0 30px rgba(255, 215, 0, 0.5);
    transition: all 0.3s ease;
    text-transform: uppercase;
    letter-spacing: 2px;
  }

  .ai-mega-sale-button-{{ ai_gen_id }}:hover {
    background: linear-gradient(135deg, #FF4500 0%, #DC143C 100%);
    transform: translateY(-3px);
    box-shadow: 0 0 50px rgba(255, 215, 0, 0.8);
  }

  .ai-mega-sale-products-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.products_per_row }}, 1fr);
    gap: {{ block.settings.product_gap }}px;
    margin-bottom: 60px;
  }

  .ai-mega-sale-product-card-{{ ai_gen_id }} {
    background: rgba(255, 255, 255, 0.95);
    border-radius: 16px;
    overflow: hidden;
    position: relative;
    transition: all 0.3s ease;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
  }

  .ai-mega-sale-product-card-{{ ai_gen_id }}:hover {
    transform: translateY(-8px);
    box-shadow: 0 0 40px rgba(255, 140, 0, 0.6), 0 8px 30px rgba(0, 0, 0, 0.3);
  }

  .ai-mega-sale-product-badge-{{ ai_gen_id }} {
    position: absolute;
    top: 15px;
    right: 15px;
    background: linear-gradient(135deg, #DC143C 0%, #FF4500 100%);
    color: #FFFFFF;
    padding: 8px 16px;
    border-radius: 25px;
    font-weight: 700;
    font-size: 14px;
    border: 2px solid {{ block.settings.gold_accent }};
    z-index: 3;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
  }

  .ai-mega-sale-product-ribbon-{{ ai_gen_id }} {
    position: absolute;
    top: 15px;
    left: -5px;
    background: linear-gradient(135deg, #DC143C 0%, #FF4500 100%);
    color: #FFFFFF;
    padding: 6px 20px 6px 15px;
    font-weight: 700;
    font-size: 12px;
    border: 2px solid {{ block.settings.gold_accent }};
    z-index: 3;
    clip-path: polygon(0 0, 100% 0, 95% 50%, 100% 100%, 0 100%);
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .ai-mega-sale-product-image-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-top: 125%;
    overflow: hidden;
    background: #f5f5f5;
  }

  .ai-mega-sale-product-image-{{ ai_gen_id }} img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-mega-sale-product-info-{{ ai_gen_id }} {
    padding: 20px;
  }

  .ai-mega-sale-product-title-{{ ai_gen_id }} {
    font-size: 16px;
    font-weight: 600;
    color: #121212;
    margin: 0 0 12px;
    min-height: 40px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .ai-mega-sale-product-price-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 15px;
  }

  .ai-mega-sale-price-current-{{ ai_gen_id }} {
    font-size: 24px;
    font-weight: 700;
    color: #DC143C;
  }

  .ai-mega-sale-price-original-{{ ai_gen_id }} {
    font-size: 18px;
    color: #94a3b8;
    text-decoration: line-through;
  }

  .ai-mega-sale-variants-{{ ai_gen_id }} {
    margin-bottom: 15px;
  }

  .ai-mega-sale-variant-label-{{ ai_gen_id }} {
    font-size: 13px;
    font-weight: 600;
    color: #121212;
    margin-bottom: 8px;
    display: block;
  }

  .ai-mega-sale-color-swatches-{{ ai_gen_id }} {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 12px;
  }

  .ai-mega-sale-color-swatch-{{ ai_gen_id }} {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: 2px solid #e5e7eb;
    cursor: pointer;
    transition: all 0.2s ease;
    position: relative;
  }

  .ai-mega-sale-color-swatch-{{ ai_gen_id }}:hover,
  .ai-mega-sale-color-swatch-{{ ai_gen_id }}.active {
    border-color: #DC143C;
    transform: scale(1.1);
  }

  .ai-mega-sale-color-swatch-{{ ai_gen_id }}.active::after {
    content: '✓';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    color: #FFFFFF;
    font-size: 14px;
    font-weight: 700;
    text-shadow: 0 0 3px rgba(0, 0, 0, 0.5);
  }

  .ai-mega-sale-size-options-{{ ai_gen_id }} {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .ai-mega-sale-size-option-{{ ai_gen_id }} {
    padding: 8px 16px;
    border: 2px solid #e5e7eb;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 600;
    color: #121212;
    transition: all 0.2s ease;
    background: #FFFFFF;
  }

  .ai-mega-sale-size-option-{{ ai_gen_id }}:hover,
  .ai-mega-sale-size-option-{{ ai_gen_id }}.active {
    border-color: #DC143C;
    background: #DC143C;
    color: #FFFFFF;
  }

  .ai-mega-sale-size-option-{{ ai_gen_id }}.disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .ai-mega-sale-add-to-cart-{{ ai_gen_id }} {
    width: 100%;
    padding: 14px;
    background: #000000;
    color: #FFFFFF;
    border: none;
    border-radius: 8px;
    font-size: 16px;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.3s ease;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .ai-mega-sale-add-to-cart-{{ ai_gen_id }}:hover:not(:disabled) {
    background: #DC143C;
    transform: translateY(-2px);
  }

  .ai-mega-sale-add-to-cart-{{ ai_gen_id }}:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .ai-mega-sale-footer-{{ ai_gen_id }} {
    text-align: center;
    padding: 40px 20px;
    background: rgba(0, 0, 0, 0.3);
    backdrop-filter: blur(10px);
    border-radius: 20px;
    border: 2px solid {{ block.settings.gold_accent }};
  }

  .ai-mega-sale-footer-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.footer_text_size }}px;
    font-weight: 700;
    color: {{ block.settings.gold_accent }};
    text-shadow: 0 0 30px {{ block.settings.gold_accent }};
    margin: 0;
    letter-spacing: 2px;
  }

  @media screen and (max-width: 989px) {
    .ai-mega-sale-products-{{ ai_gen_id }} {
      grid-template-columns: repeat(3, 1fr);
    }

    .ai-mega-sale-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.title_size }}px * 0.7);
    }

    .ai-mega-sale-countdown-number-{{ ai_gen_id }} {
      font-size: 36px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-mega-sale-products-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.products_per_row_mobile }}, 1fr);
    }

    .ai-mega-sale-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.title_size }}px * 0.5);
    }

    .ai-mega-sale-subtitle-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.subtitle_size }}px * 0.8);
    }

    .ai-mega-sale-countdown-item-{{ ai_gen_id }} {
      min-width: 70px;
      padding: 15px;
    }

    .ai-mega-sale-countdown-number-{{ ai_gen_id }} {
      font-size: 28px;
    }

    .ai-mega-sale-button-{{ ai_gen_id }} {
      padding: 14px 35px;
      font-size: 16px;
    }
  }
{% endstyle %}

<mega-sale-{{ ai_gen_id }} class="ai-mega-sale-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-mega-sale-bg-{{ ai_gen_id }}">
    {% for i in (1..30) %}
      {% assign left = i | times: 3 | modulo: 100 %}
      {% assign delay = i | times: 0.1 %}
      <div class="ai-mega-sale-confetti-{{ ai_gen_id }}" style="left: {{ left }}%; animation-delay: {{ delay }}s;"></div>
    {% endfor %}
    
    {% for i in (1..5) %}
      {% assign top = i | times: 15 | modulo: 80 %}
      {% assign delay = i | times: 0.5 %}
      <div class="ai-mega-sale-ribbon-{{ ai_gen_id }}" style="top: {{ top }}%; animation-delay: {{ delay }}s;"></div>
    {% endfor %}
  </div>

  <div class="ai-mega-sale-container-{{ ai_gen_id }}">
    <div class="ai-mega-sale-header-{{ ai_gen_id }}">
      <h1 class="ai-mega-sale-title-{{ ai_gen_id }}">{{ block.settings.main_title }}</h1>
      <p class="ai-mega-sale-subtitle-{{ ai_gen_id }}">{{ block.settings.subtitle }}</p>
      
      <div class="ai-mega-sale-countdown-{{ ai_gen_id }}" data-end-date="{{ block.settings.countdown_end_date }}">
        <div class="ai-mega-sale-countdown-item-{{ ai_gen_id }}">
          <span class="ai-mega-sale-countdown-number-{{ ai_gen_id }}" data-days>00</span>
          <span class="ai-mega-sale-countdown-label-{{ ai_gen_id }}">Days</span>
        </div>
        <div class="ai-mega-sale-countdown-item-{{ ai_gen_id }}">
          <span class="ai-mega-sale-countdown-number-{{ ai_gen_id }}" data-hours>00</span>
          <span class="ai-mega-sale-countdown-label-{{ ai_gen_id }}">Hours</span>
        </div>
        <div class="ai-mega-sale-countdown-item-{{ ai_gen_id }}">
          <span class="ai-mega-sale-countdown-number-{{ ai_gen_id }}" data-minutes>00</span>
          <span class="ai-mega-sale-countdown-label-{{ ai_gen_id }}">Minutes</span>
        </div>
        <div class="ai-mega-sale-countdown-item-{{ ai_gen_id }}">
          <span class="ai-mega-sale-countdown-number-{{ ai_gen_id }}" data-seconds>00</span>
          <span class="ai-mega-sale-countdown-label-{{ ai_gen_id }}">Seconds</span>
        </div>
      </div>
    </div>

    <div class="ai-mega-sale-cta-{{ ai_gen_id }}">
      <a href="#products" class="ai-mega-sale-button-{{ ai_gen_id }}">{{ block.settings.cta_text }}</a>
    </div>

    <div id="products" class="ai-mega-sale-products-{{ ai_gen_id }}">
      {% if block.settings.product_collection != blank %}
        {% for product in block.settings.product_collection.products limit: block.settings.products_limit %}
          <div class="ai-mega-sale-product-card-{{ ai_gen_id }}" data-product-id="{{ product.id }}">
            {% if product.compare_at_price > product.price %}
              {% assign discount_percent = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price %}
              <div class="ai-mega-sale-product-badge-{{ ai_gen_id }}">{{ discount_percent }}% OFF</div>
            {% endif %}

            {% assign ribbon_index = forloop.index | modulo: 3 %}
            {% if ribbon_index == 1 %}
              <div class="ai-mega-sale-product-ribbon-{{ ai_gen_id }}">HOT DEAL</div>
            {% elsif ribbon_index == 2 %}
              <div class="ai-mega-sale-product-ribbon-{{ ai_gen_id }}">LIMITED</div>
            {% else %}
              <div class="ai-mega-sale-product-ribbon-{{ ai_gen_id }}">EXCLUSIVE</div>
            {% endif %}

            <div class="ai-mega-sale-product-image-{{ ai_gen_id }}">
              {% if product.featured_image %}
                <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.featured_image.alt | escape }}" loading="lazy">
              {% else %}
                {{ 'product-1' | placeholder_svg_tag }}
              {% endif %}
            </div>

            <div class="ai-mega-sale-product-info-{{ ai_gen_id }}">
              <h3 class="ai-mega-sale-product-title-{{ ai_gen_id }}">{{ product.title }}</h3>

              <div class="ai-mega-sale-product-price-{{ ai_gen_id }}">
                <span class="ai-mega-sale-price-current-{{ ai_gen_id }}">{{ product.price | money }}</span>
                {% if product.compare_at_price > product.price %}
                  <span class="ai-mega-sale-price-original-{{ ai_gen_id }}">{{ product.compare_at_price | money }}</span>
                {% endif %}
              </div>

              {% if product.has_only_default_variant == false %}
                <div class="ai-mega-sale-variants-{{ ai_gen_id }}">
                  {% for option in product.options_with_values %}
                    {% assign option_name_downcase = option.name | downcase %}
                    
                    {% if option_name_downcase contains 'color' or option_name_downcase contains 'colour' %}
                      <label class="ai-mega-sale-variant-label-{{ ai_gen_id }}">{{ option.name }}</label>
                      <div class="ai-mega-sale-color-swatches-{{ ai_gen_id }}" data-option-name="{{ option.name }}">
                        {% for value in option.values %}
                          {% assign color_value = value | downcase | replace: ' ', '-' %}
                          <div class="ai-mega-sale-color-swatch-{{ ai_gen_id }}" 
                               data-value="{{ value }}" 
                               style="background-color: {{ color_value }};"
                               title="{{ value }}"></div>
                        {% endfor %}
                      </div>
                    {% elsif option_name_downcase contains 'size' %}
                      <label class="ai-mega-sale-variant-label-{{ ai_gen_id }}">{{ option.name }}</label>
                      <div class="ai-mega-sale-size-options-{{ ai_gen_id }}" data-option-name="{{ option.name }}">
                        {% for value in option.values %}
                          <div class="ai-mega-sale-size-option-{{ ai_gen_id }}" data-value="{{ value }}">{{ value }}</div>
                        {% endfor %}
                      </div>
                    {% endif %}
                  {% endfor %}
                </div>
              {% endif %}

              <button class="ai-mega-sale-add-to-cart-{{ ai_gen_id }}" 
                      data-product-id="{{ product.id }}"
                      {% if product.has_only_default_variant == false %}disabled{% endif %}>
                Add to Cart
              </button>
            </div>
          </div>
        {% endfor %}
      {% else %}
        {% for i in (1..25) %}
          <div class="ai-mega-sale-product-card-{{ ai_gen_id }}">
            <div class="ai-mega-sale-product-badge-{{ ai_gen_id }}">50% OFF</div>
            <div class="ai-mega-sale-product-ribbon-{{ ai_gen_id }}">HOT DEAL</div>
            <div class="ai-mega-sale-product-image-{{ ai_gen_id }}">
              {{ 'product-1' | placeholder_svg_tag }}
            </div>
            <div class="ai-mega-sale-product-info-{{ ai_gen_id }}">
              <h3 class="ai-mega-sale-product-title-{{ ai_gen_id }}">Sample Product {{ i }}</h3>
              <div class="ai-mega-sale-product-price-{{ ai_gen_id }}">
                <span class="ai-mega-sale-price-current-{{ ai_gen_id }}">₱499</span>
                <span class="ai-mega-sale-price-original-{{ ai_gen_id }}">₱999</span>
              </div>
              <button class="ai-mega-sale-add-to-cart-{{ ai_gen_id }}" disabled>Add to Cart</button>
            </div>
          </div>
        {% endfor %}
      {% endif %}
    </div>

    <div class="ai-mega-sale-footer-{{ ai_gen_id }}">
      <p class="ai-mega-sale-footer-text-{{ ai_gen_id }}">{{ block.settings.footer_text }}</p>
    </div>
  </div>
</mega-sale-{{ ai_gen_id }}>

<script>
(function() {
  class MegaSale{{ ai_gen_id }} extends HTMLElement {
    constructor() {
      super();
      this.countdown = this.querySelector('.ai-mega-sale-countdown-{{ ai_gen_id }}');
      this.productCards = this.querySelectorAll('.ai-mega-sale-product-card-{{ ai_gen_id }}');
    }

    connectedCallback() {
      this.initCountdown();
      this.initProductVariants();
    }

    initCountdown() {
      if (!this.countdown) return;
      
      const endDate = this.countdown.dataset.endDate;
      if (!endDate) return;

      const updateCountdown = () => {
        const now = new Date().getTime();
        const end = new Date(endDate).getTime();
        const distance = end - now;

        if (distance < 0) {
          this.countdown.innerHTML = '<div class="ai-mega-sale-countdown-item-{{ ai_gen_id }}"><span class="ai-mega-sale-countdown-number-{{ ai_gen_id }}">ENDED</span></div>';
          return;
        }

        const days = Math.floor(distance / (1000 * 60 * 60 * 24));
        const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
        const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
        const seconds = Math.floor((distance % (1000 * 60)) / 1000);

        const daysEl = this.countdown.querySelector('[data-days]');
        const hoursEl = this.countdown.querySelector('[data-hours]');
        const minutesEl = this.countdown.querySelector('[data-minutes]');
        const secondsEl = this.countdown.querySelector('[data-seconds]');

        if (daysEl) daysEl.textContent = String(days).padStart(2, '0');
        if (hoursEl) hoursEl.textContent = String(hours).padStart(2, '0');
        if (minutesEl) minutesEl.textContent = String(minutes).padStart(2, '0');
        if (secondsEl) secondsEl.textContent = String(seconds).padStart(2, '0');
      };

      updateCountdown();
      setInterval(updateCountdown, 1000);
    }

    initProductVariants() {
      this.productCards.forEach(card => {
        const colorSwatches = card.querySelectorAll('.ai-mega-sale-color-swatch-{{ ai_gen_id }}');
        const sizeOptions = card.querySelectorAll('.ai-mega-sale-size-option-{{ ai_gen_id }}');
        const addToCartBtn = card.querySelector('.ai-mega-sale-add-to-cart-{{ ai_gen_id }}');
        
        let selectedColor = null;
        let selectedSize = null;

        const checkSelections = () => {
          const hasColorOptions = colorSwatches.length > 0;
          const hasSizeOptions = sizeOptions.length > 0;
          
          if (hasColorOptions && hasSizeOptions) {
            addToCartBtn.disabled = !(selectedColor && selectedSize);
          } else if (hasColorOptions) {
            addToCartBtn.disabled = !selectedColor;
          } else if (hasSizeOptions) {
            addToCartBtn.disabled = !selectedSize;
          } else {
            addToCartBtn.disabled = false;
          }
        };

        colorSwatches.forEach(swatch => {
          swatch.addEventListener('click', () => {
            colorSwatches.forEach(s => s.classList.remove('active'));
            swatch.classList.add('active');
            selectedColor = swatch.dataset.value;
            checkSelections();
          });
        });

        sizeOptions.forEach(option => {
          option.addEventListener('click', () => {
            if (option.classList.contains('disabled')) return;
            sizeOptions.forEach(o => o.classList.remove('active'));
            option.classList.add('active');
            selectedSize = option.dataset.value;
            checkSelections();
          });
        });

        addToCartBtn.addEventListener('click', () => {
          if (addToCartBtn.disabled) return;
          
          const productId = addToCartBtn.dataset.productId;
          
          fetch('/cart/add.js', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({
              id: productId,
              quantity: 1
            })
          })
          .then(response => response.json())
          .then(data => {
            window.location.href = '/cart';
          })
          .catch(error => {
            console.error('Error:', error);
          });
        });
      });
    }
  }

  customElements.define('mega-sale-{{ ai_gen_id }}', MegaSale{{ ai_gen_id }});
})();
</script>

