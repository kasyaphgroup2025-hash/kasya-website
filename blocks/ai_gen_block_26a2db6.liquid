{% doc %}
  @prompt
    Create a premium, collage-style landing page section for KasyaPH with a clear visual hierarchy.
    At the TOP, highlight the two NEW ITEMS as the main focus:
    
    – Silk Skirt (latest release)
    – Wideleg Pants in Teal (latest release)
    
    Make these two hero products appear large, centered, and visually dominant. Use soft lighting, minimalistic backgrounds, and elegant styling to emphasize fabric quality and newness.
    
    Underneath, create a clean collage-style product grid featuring our earlier bestsellers:
    
    – Wideleg Pants in Skintone
    – Wideleg Pants in Gray
    – Chelsea Dress
    – Celine Polo
    
    These items should be smaller and arranged like a neat collage, complementing the top hero section without overpowering it.
    
    Overall style: modern, boutique-inspired, clean, premium Philippine fashion aesthetic. Ensure the new items stand out at the top while the previous items support them visually at the bottom., can you make it clickable the pictures , Can you make 2 item in mobile view horizontal, can you remove the price
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-premium-collage-{{ ai_gen_id }} {
    padding: {{ block.settings.section_padding_top }}px 0 {{ block.settings.section_padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-premium-collage__container-{{ ai_gen_id }} {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-premium-collage__hero-section-{{ ai_gen_id }} {
    margin-bottom: {{ block.settings.hero_bottom_spacing }}px;
  }

  .ai-premium-collage__hero-title-{{ ai_gen_id }} {
    text-align: center;
    font-size: {{ block.settings.hero_title_size }}px;
    font-weight: 400;
    letter-spacing: 0.5px;
    margin-bottom: {{ block.settings.hero_title_spacing }}px;
    color: {{ block.settings.text_color }};
    text-transform: uppercase;
  }

  .ai-premium-collage__hero-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: {{ block.settings.hero_gap }}px;
    margin-bottom: 20px;
  }

  .ai-premium-collage__hero-item-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
    background-color: {{ block.settings.card_background }};
  }

  .ai-premium-collage__hero-link-{{ ai_gen_id }} {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .ai-premium-collage__hero-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: {{ block.settings.hero_image_ratio }}%;
    overflow: hidden;
  }

  .ai-premium-collage__hero-image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .ai-premium-collage__hero-link-{{ ai_gen_id }}:hover .ai-premium-collage__hero-image-{{ ai_gen_id }} {
    transform: scale(1.03);
  }

  .ai-premium-collage__hero-badge-{{ ai_gen_id }} {
    position: absolute;
    top: 16px;
    left: 16px;
    background-color: {{ block.settings.badge_background }};
    color: {{ block.settings.badge_text_color }};
    padding: 6px 14px;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 1px;
    text-transform: uppercase;
    border-radius: 2px;
    z-index: 2;
  }

  .ai-premium-collage__hero-content-{{ ai_gen_id }} {
    padding: 20px 16px;
    text-align: center;
  }

  .ai-premium-collage__hero-product-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.hero_product_title_size }}px;
    font-weight: 400;
    color: {{ block.settings.text_color }};
    letter-spacing: 0.3px;
  }

  .ai-premium-collage__divider-{{ ai_gen_id }} {
    width: 60px;
    height: 1px;
    background-color: {{ block.settings.divider_color }};
    margin: {{ block.settings.divider_spacing }}px auto;
  }

  .ai-premium-collage__bestsellers-section-{{ ai_gen_id }} {
    margin-top: {{ block.settings.bestsellers_top_spacing }}px;
  }

  .ai-premium-collage__bestsellers-title-{{ ai_gen_id }} {
    text-align: center;
    font-size: {{ block.settings.bestsellers_title_size }}px;
    font-weight: 400;
    letter-spacing: 0.5px;
    margin-bottom: {{ block.settings.bestsellers_title_spacing }}px;
    color: {{ block.settings.text_color }};
    text-transform: uppercase;
  }

  .ai-premium-collage__bestsellers-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: {{ block.settings.bestsellers_gap }}px;
  }

  .ai-premium-collage__bestseller-item-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
    background-color: {{ block.settings.card_background }};
  }

  .ai-premium-collage__bestseller-link-{{ ai_gen_id }} {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .ai-premium-collage__bestseller-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: {{ block.settings.bestseller_image_ratio }}%;
    overflow: hidden;
  }

  .ai-premium-collage__bestseller-image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .ai-premium-collage__bestseller-link-{{ ai_gen_id }}:hover .ai-premium-collage__bestseller-image-{{ ai_gen_id }} {
    transform: scale(1.03);
  }

  .ai-premium-collage__bestseller-content-{{ ai_gen_id }} {
    padding: 16px 12px;
    text-align: center;
  }

  .ai-premium-collage__bestseller-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.bestseller_title_size }}px;
    font-weight: 400;
    color: {{ block.settings.text_color }};
    letter-spacing: 0.2px;
  }

  .ai-premium-collage__placeholder-{{ ai_gen_id }} {
    background-color: #f5f5f5;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-premium-collage__placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 200px;
    max-height: 200px;
    opacity: 0.3;
  }

  .ai-premium-collage__empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    font-size: 13px;
    color: #999;
    text-align: center;
    pointer-events: none;
  }

  @media screen and (max-width: 989px) {
    .ai-premium-collage__bestsellers-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
    }

    .ai-premium-collage__hero-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.hero_title_size }}px * 0.8);
    }

    .ai-premium-collage__bestsellers-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.bestsellers_title_size }}px * 0.8);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-premium-collage__hero-grid-{{ ai_gen_id }} {
      gap: 16px;
    }

    .ai-premium-collage__bestsellers-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
    }

    .ai-premium-collage__hero-product-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.hero_product_title_size }}px * 0.9);
    }

    .ai-premium-collage__bestseller-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.bestseller_title_size }}px * 0.9);
    }

    .ai-premium-collage__hero-content-{{ ai_gen_id }} {
      padding: 14px 10px;
    }

    .ai-premium-collage__bestseller-content-{{ ai_gen_id }} {
      padding: 12px 8px;
    }
  }
{% endstyle %}

<div class="ai-premium-collage-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-premium-collage__container-{{ ai_gen_id }}">
    
    <div class="ai-premium-collage__hero-section-{{ ai_gen_id }}">
      {% if block.settings.hero_section_title != blank %}
        <h2 class="ai-premium-collage__hero-title-{{ ai_gen_id }}">{{ block.settings.hero_section_title }}</h2>
      {% endif %}

      <div class="ai-premium-collage__hero-grid-{{ ai_gen_id }}">
        {% for i in (1..2) %}
          {% liquid
            assign product_key = 'hero_product_' | append: i
            assign product = block.settings[product_key]
          %}
          
          <div class="ai-premium-collage__hero-item-{{ ai_gen_id }}">
            {% if product != blank %}
              <a href="{{ product.url }}" class="ai-premium-collage__hero-link-{{ ai_gen_id }}">
                {% if block.settings.show_new_badge %}
                  <div class="ai-premium-collage__hero-badge-{{ ai_gen_id }}">{{ block.settings.badge_text }}</div>
                {% endif %}

                <div class="ai-premium-collage__hero-image-wrapper-{{ ai_gen_id }}">
                  {% if product.featured_image %}
                    <img
                      src="{{ product.featured_image | image_url: width: 1000 }}"
                      alt="{{ product.featured_image.alt | escape }}"
                      loading="lazy"
                      width="{{ product.featured_image.width }}"
                      height="{{ product.featured_image.height }}"
                      class="ai-premium-collage__hero-image-{{ ai_gen_id }}"
                    >
                  {% endif %}
                </div>

                <div class="ai-premium-collage__hero-content-{{ ai_gen_id }}">
                  <h3 class="ai-premium-collage__hero-product-title-{{ ai_gen_id }}">
                    {{ product.title }}
                  </h3>
                </div>
              </a>
            {% else %}
              {% if block.settings.show_new_badge %}
                <div class="ai-premium-collage__hero-badge-{{ ai_gen_id }}">{{ block.settings.badge_text }}</div>
              {% endif %}

              <div class="ai-premium-collage__hero-image-wrapper-{{ ai_gen_id }}">
                <div class="ai-premium-collage__placeholder-{{ ai_gen_id }}">
                  {{ 'product-1' | placeholder_svg_tag }}
                  <div class="ai-premium-collage__empty-state-{{ ai_gen_id }}">
                    Add hero product {{ i }}
                  </div>
                </div>
              </div>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    </div>

    {% if block.settings.show_divider %}
      <div class="ai-premium-collage__divider-{{ ai_gen_id }}"></div>
    {% endif %}

    <div class="ai-premium-collage__bestsellers-section-{{ ai_gen_id }}">
      {% if block.settings.bestsellers_section_title != blank %}
        <h2 class="ai-premium-collage__bestsellers-title-{{ ai_gen_id }}">{{ block.settings.bestsellers_section_title }}</h2>
      {% endif %}

      <div class="ai-premium-collage__bestsellers-grid-{{ ai_gen_id }}">
        {% for i in (1..4) %}
          {% liquid
            assign product_key = 'bestseller_product_' | append: i
            assign product = block.settings[product_key]
          %}
          
          <div class="ai-premium-collage__bestseller-item-{{ ai_gen_id }}">
            {% if product != blank %}
              <a href="{{ product.url }}" class="ai-premium-collage__bestseller-link-{{ ai_gen_id }}">
                <div class="ai-premium-collage__bestseller-image-wrapper-{{ ai_gen_id }}">
                  {% if product.featured_image %}
                    <img
                      src="{{ product.featured_image | image_url: width: 600 }}"
                      alt="{{ product.featured_image.alt | escape }}"
                      loading="lazy"
                      width="{{ product.featured_image.width }}"
                      height="{{ product.featured_image.height }}"
                      class="ai-premium-collage__bestseller-image-{{ ai_gen_id }}"
                    >
                  {% endif %}
                </div>

                <div class="ai-premium-collage__bestseller-content-{{ ai_gen_id }}">
                  <h4 class="ai-premium-collage__bestseller-title-{{ ai_gen_id }}">
                    {{ product.title }}
                  </h4>
                </div>
              </a>
            {% else %}
              <div class="ai-premium-collage__bestseller-image-wrapper-{{ ai_gen_id }}">
                <div class="ai-premium-collage__placeholder-{{ ai_gen_id }}">
                  {{ 'product-1' | placeholder_svg_tag }}
                  <div class="ai-premium-collage__empty-state-{{ ai_gen_id }}">
                    Add bestseller {{ i }}
                  </div>
                </div>
              </div>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    </div>

  </div>
</div>

