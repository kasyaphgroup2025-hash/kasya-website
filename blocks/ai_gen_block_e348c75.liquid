{% doc %}
  @prompt
    A heading with an animated glowing effect "No Tricks. Just Treats for You." with paragraph "Celebrate Payday with hauntingly good deals — reach ₱1,500 for 10% OFF and for Free Shipping, and ₱2,500 for 15% OFF + Mystery Treat." Halloween style 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-halloween-banner-{{ ai_gen_id }} {
    padding: {{ block.settings.padding_top }}px 20px {{ block.settings.padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
    text-align: center;
    overflow: hidden;
    position: relative;
  }

  .ai-halloween-banner-{{ ai_gen_id }}::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: radial-gradient(circle at 20% 50%, {{ block.settings.glow_color_1 }} 0%, transparent 50%),
                radial-gradient(circle at 80% 50%, {{ block.settings.glow_color_2 }} 0%, transparent 50%);
    opacity: {{ block.settings.glow_opacity }};
    pointer-events: none;
    animation: ai-halloween-pulse-{{ ai_gen_id }} {{ block.settings.animation_speed }}s ease-in-out infinite;
  }

  @keyframes ai-halloween-pulse-{{ ai_gen_id }} {
    0%, 100% {
      opacity: {{ block.settings.glow_opacity }};
      transform: scale(1);
    }
    50% {
      opacity: {{ block.settings.glow_opacity | times: 1.5 | at_most: 1 }};
      transform: scale(1.1);
    }
  }

  .ai-halloween-banner__content-{{ ai_gen_id }} {
    position: relative;
    z-index: 1;
    max-width: {{ block.settings.content_width }}px;
    margin: 0 auto;
  }

  .ai-halloween-banner__heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 {{ block.settings.spacing }}px;
    font-weight: 700;
    line-height: 1.2;
    text-shadow: 0 0 {{ block.settings.text_glow_intensity }}px {{ block.settings.heading_glow_color }},
                 0 0 {{ block.settings.text_glow_intensity | times: 2 }}px {{ block.settings.heading_glow_color }},
                 0 0 {{ block.settings.text_glow_intensity | times: 3 }}px {{ block.settings.heading_glow_color }};
    animation: ai-halloween-glow-{{ ai_gen_id }} {{ block.settings.animation_speed }}s ease-in-out infinite;
  }

  @keyframes ai-halloween-glow-{{ ai_gen_id }} {
    0%, 100% {
      text-shadow: 0 0 {{ block.settings.text_glow_intensity }}px {{ block.settings.heading_glow_color }},
                   0 0 {{ block.settings.text_glow_intensity | times: 2 }}px {{ block.settings.heading_glow_color }},
                   0 0 {{ block.settings.text_glow_intensity | times: 3 }}px {{ block.settings.heading_glow_color }};
    }
    50% {
      text-shadow: 0 0 {{ block.settings.text_glow_intensity | times: 1.5 }}px {{ block.settings.heading_glow_color }},
                   0 0 {{ block.settings.text_glow_intensity | times: 3 }}px {{ block.settings.heading_glow_color }},
                   0 0 {{ block.settings.text_glow_intensity | times: 4.5 }}px {{ block.settings.heading_glow_color }};
    }
  }

  .ai-halloween-banner__paragraph-{{ ai_gen_id }} {
    font-size: {{ block.settings.paragraph_size }}px;
    color: {{ block.settings.paragraph_color }};
    margin: 0;
    line-height: 1.6;
  }

  @media screen and (max-width: 749px) {
    .ai-halloween-banner__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.7 }}px;
    }

    .ai-halloween-banner__paragraph-{{ ai_gen_id }} {
      font-size: {{ block.settings.paragraph_size | times: 0.85 }}px;
    }
  }
{% endstyle %}

<div class="ai-halloween-banner-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-halloween-banner__content-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2 class="ai-halloween-banner__heading-{{ ai_gen_id }}">
        {{ block.settings.heading }}
      </h2>
    {% endif %}

    {% if block.settings.paragraph != blank %}
      <div class="ai-halloween-banner__paragraph-{{ ai_gen_id }}">
        {{ block.settings.paragraph }}
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Halloween banner",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "No Tricks. Just Treats for You."
    },
    {
      "type": "richtext",
      "id": "paragraph",
      "label": "Paragraph",
      "default": "<p>Celebrate Payday with hauntingly good deals — reach ₱1,500 for 10% OFF and for Free Shipping, and ₱2,500 for 15% OFF + Mystery Treat.</p>"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 20,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Heading size",
      "default": 48
    },
    {
      "type": "range",
      "id": "paragraph_size",
      "min": 12,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "Paragraph size",
      "default": 16
    },
    {
      "type": "range",
      "id": "spacing",
      "min": 8,
      "max": 40,
      "step": 4,
      "unit": "px",
      "label": "Spacing between heading and paragraph",
      "default": 16
    },
    {
      "type": "range",
      "id": "content_width",
      "min": 400,
      "max": 1200,
      "step": 50,
      "unit": "px",
      "label": "Content width",
      "default": 900
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#0a0a0a"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading",
      "default": "#ff6b35"
    },
    {
      "type": "color",
      "id": "paragraph_color",
      "label": "Paragraph",
      "default": "#f5f5f5"
    },
    {
      "type": "header",
      "content": "Glow effect"
    },
    {
      "type": "color",
      "id": "heading_glow_color",
      "label": "Heading glow color",
      "default": "#ff6b35"
    },
    {
      "type": "range",
      "id": "text_glow_intensity",
      "min": 5,
      "max": 30,
      "step": 5,
      "unit": "px",
      "label": "Text glow intensity",
      "default": 10
    },
    {
      "type": "color",
      "id": "glow_color_1",
      "label": "Background glow 1",
      "default": "#ff6b35"
    },
    {
      "type": "color",
      "id": "glow_color_2",
      "label": "Background glow 2",
      "default": "#8b4513"
    },
    {
      "type": "range",
      "id": "glow_opacity",
      "min": 0,
      "max": 1,
      "step": 0.1,
      "label": "Background glow opacity",
      "default": 0.3
    },
    {
      "type": "range",
      "id": "animation_speed",
      "min": 2,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "Animation speed",
      "default": 3
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "Halloween banner"
    }
  ]
}
{% endschema %}
