

{%-liquid
  assign class = ''
  if block.settings.html_tag == 'p' and block.settings.enable_caption_style
    case block.settings.caption_size
    when 'small'
      assign class = 'caption-with-letter-spacing'
    when 'medium'
      assign class = 'caption-with-letter-spacing--medium'
    when 'large'
      assign class = 'caption-with-letter-spacing--large'
    endcase
  endif
-%}
{% render 'text', block: block, local_settings: block.settings, text: block.settings.text, class: class %}
{% schema %}
{
