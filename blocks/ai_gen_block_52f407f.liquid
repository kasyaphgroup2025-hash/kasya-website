{% doc %}
  @prompt
    Create a high-converting Black Friday landing page for KasyaPH. The theme is elegant Black Friday – sleek, modern, premium Filipino fashion. Background should use subtle black tones with minimal glowing accents (gold or silver light streaks), no heavy graphics. Focus on showcasing 10+ fashion collections only, no discounts or text-heavy sections. Make it look exclusive and luxurious.
    
    Layout direction: Grid-style or carousel blocks of collections. Each collection card must have collection image + name only, no price, no CTA except ‘Shop Collection’. Must look like VIP access to multiple drops. Maintain KasyaPH branding: for mature but stylish women. Use spacing and clean typography. Make products stand out. Keep the hero simple — headline only (‘Black Friday Exclusive Collections’) and subheading (‘Explore our best-selling drops this season’).
    
    Featured collections (placeholder names, replace with actual collections):
    
    Premiere Collection
    
    Radiance Collection
    
    Wideleg Pants Collection
    
    Skirt Selection
    
    Linen Blouse Series
    
    Silhouette Dress Line
    
    Signature Two-Piece Sets
    
    Holiday Essential Styles
    
    Everyday Premium Wear
    
    VIP Limited Release
    
    Visual style: Premium, minimalist, sophisticated. Avoid any bright colors – use neutral tones. The collections should be presented like a fashion gallery. No distracting elements. The goal is to make customers explore multiple collections and scroll deeper., Can you hide other collection if no product included 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-bf-collections-{{ ai_gen_id }} {
    background: {{ block.settings.background_color }};
    position: relative;
    overflow: hidden;
  }

  .ai-bf-collections-{{ ai_gen_id }}::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: {{ block.settings.accent_gradient }};
    opacity: {{ block.settings.accent_opacity | divided_by: 100.0 }};
    pointer-events: none;
    z-index: 1;
  }

  .ai-bf-collections__container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    padding: {{ block.settings.section_padding_top }}px 20px {{ block.settings.section_padding_bottom }}px;
    position: relative;
    z-index: 2;
  }

  .ai-bf-collections__hero-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: {{ block.settings.hero_spacing }}px;
  }

  .ai-bf-collections__headline-{{ ai_gen_id }} {
    font-size: {{ block.settings.headline_size }}px;
    font-weight: 300;
    letter-spacing: {{ block.settings.headline_spacing }}px;
    text-transform: uppercase;
    color: {{ block.settings.headline_color }};
    margin: 0 0 {{ block.settings.subheading_gap }}px;
    font-family: var(--font-heading-family);
  }

  .ai-bf-collections__subheading-{{ ai_gen_id }} {
    font-size: {{ block.settings.subheading_size }}px;
    font-weight: 300;
    color: {{ block.settings.subheading_color }};
    margin: 0;
    opacity: 0.9;
  }

  .ai-bf-collections__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.grid_gap }}px;
  }

  .ai-bf-collection-card-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.card_border_radius }}px;
    background: {{ block.settings.card_background }};
    transition: transform 0.4s ease, box-shadow 0.4s ease;
    cursor: pointer;
  }

  .ai-bf-collection-card-{{ ai_gen_id }}:hover {
    transform: translateY(-{{ block.settings.hover_lift }}px);
    box-shadow: 0 {{ block.settings.hover_shadow }}px {{ block.settings.hover_shadow | times: 2 }}px rgba(0, 0, 0, {{ block.settings.shadow_opacity | divided_by: 100.0 }});
  }

  .ai-bf-collection-card__link-{{ ai_gen_id }} {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .ai-bf-collection-card__image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: {{ block.settings.image_aspect_ratio }}%;
    overflow: hidden;
    background: {{ block.settings.image_placeholder_bg }};
  }

  .ai-bf-collection-card__image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .ai-bf-collection-card-{{ ai_gen_id }}:hover .ai-bf-collection-card__image-{{ ai_gen_id }} {
    transform: scale(1.05);
  }

  .ai-bf-collection-card__overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, {{ block.settings.overlay_opacity | divided_by: 100.0 }}), transparent);
    transition: opacity 0.4s ease;
  }

  .ai-bf-collection-card-{{ ai_gen_id }}:hover .ai-bf-collection-card__overlay-{{ ai_gen_id }} {
    opacity: 0.8;
  }

  .ai-bf-collection-card__content-{{ ai_gen_id }} {
    padding: {{ block.settings.card_padding }}px;
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-bf-collection-card__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    font-weight: {{ block.settings.title_weight }};
    letter-spacing: {{ block.settings.title_spacing }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 {{ block.settings.button_gap }}px;
    text-transform: uppercase;
  }

  .ai-bf-collection-card__button-{{ ai_gen_id }} {
    display: inline-block;
    padding: {{ block.settings.button_padding_v }}px {{ block.settings.button_padding_h }}px;
    background: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    border: 1px solid {{ block.settings.button_border_color }};
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: 400;
    letter-spacing: 1px;
    text-transform: uppercase;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .ai-bf-collection-card__button-{{ ai_gen_id }}:hover {
    background: {{ block.settings.button_hover_bg }};
    color: {{ block.settings.button_hover_text }};
    border-color: {{ block.settings.button_hover_border }};
  }

  .ai-bf-collection-card__placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: {{ block.settings.image_placeholder_bg }};
  }

  .ai-bf-collection-card__placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  @media screen and (max-width: 989px) {
    .ai-bf-collections__grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_tablet }}, 1fr);
    }

    .ai-bf-collections__headline-{{ ai_gen_id }} {
      font-size: {{ block.settings.headline_size | times: 0.7 }}px;
    }

    .ai-bf-collections__subheading-{{ ai_gen_id }} {
      font-size: {{ block.settings.subheading_size | times: 0.85 }}px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-bf-collections__grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
      gap: {{ block.settings.grid_gap | times: 0.7 }}px;
    }

    .ai-bf-collections__headline-{{ ai_gen_id }} {
      font-size: {{ block.settings.headline_size | times: 0.5 }}px;
    }

    .ai-bf-collections__subheading-{{ ai_gen_id }} {
      font-size: {{ block.settings.subheading_size | times: 0.75 }}px;
    }

    .ai-bf-collection-card__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.85 }}px;
    }

    .ai-bf-collections__container-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding_top | times: 0.6 }}px 16px {{ block.settings.section_padding_bottom | times: 0.6 }}px;
    }
  }
{% endstyle %}

<div class="ai-bf-collections-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-bf-collections__container-{{ ai_gen_id }}">
    <div class="ai-bf-collections__hero-{{ ai_gen_id }}">
      {% if block.settings.headline != blank %}
        <h1 class="ai-bf-collections__headline-{{ ai_gen_id }}">{{ block.settings.headline }}</h1>
      {% endif %}
      {% if block.settings.subheading != blank %}
        <p class="ai-bf-collections__subheading-{{ ai_gen_id }}">{{ block.settings.subheading }}</p>
      {% endif %}
    </div>

    <div class="ai-bf-collections__grid-{{ ai_gen_id }}">
      {% for i in (1..10) %}
        {% liquid
          assign collection_key = 'collection_' | append: i
          assign collection = block.settings[collection_key]
        %}

        {% if collection != blank and collection.products_count > 0 %}
          <div class="ai-bf-collection-card-{{ ai_gen_id }}">
            <a href="{{ collection.url }}" class="ai-bf-collection-card__link-{{ ai_gen_id }}">
              <div class="ai-bf-collection-card__image-wrapper-{{ ai_gen_id }}">
                {% if collection.featured_image %}
                  <img
                    src="{{ collection.featured_image | image_url: width: 800 }}"
                    alt="{{ collection.featured_image.alt | escape }}"
                    class="ai-bf-collection-card__image-{{ ai_gen_id }}"
                    loading="lazy"
                    width="800"
                    height="{{ 800 | times: block.settings.image_aspect_ratio | divided_by: 100 }}"
                  >
                {% else %}
                  <div class="ai-bf-collection-card__placeholder-{{ ai_gen_id }}">
                    {{ 'collection-1' | placeholder_svg_tag }}
                  </div>
                {% endif %}
                <div class="ai-bf-collection-card__overlay-{{ ai_gen_id }}"></div>
              </div>
              <div class="ai-bf-collection-card__content-{{ ai_gen_id }}">
                <h3 class="ai-bf-collection-card__title-{{ ai_gen_id }}">{{ collection.title }}</h3>
                <span class="ai-bf-collection-card__button-{{ ai_gen_id }}">{{ block.settings.button_text }}</span>
              </div>
            </a>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

