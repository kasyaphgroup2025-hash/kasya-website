{% doc %}
  @prompt
    Create a high-converting Black Friday landing page for KasyaPH. The theme is elegant Black Friday – sleek, modern, premium Filipino fashion. Background should use subtle black tones with minimal glowing accents (gold or silver light streaks), no heavy graphics. Focus on showcasing 10+ fashion collections only, no discounts or text-heavy sections. Make it look exclusive and luxurious.
    
    Layout direction: Grid-style or carousel blocks of collections. Each collection card must have collection image + name only, no price, no CTA except ‘Shop Collection’. Must look like VIP access to multiple drops. Maintain KasyaPH branding: for mature but stylish women. Use spacing and clean typography. Make products stand out. Keep the hero simple — headline only (‘Black Friday Exclusive Collections’) and subheading (‘Explore our best-selling drops this season’).
    
    Featured collections (placeholder names, replace with actual collections):
    
    Premiere Collection
    
    Radiance Collection
    
    Wideleg Pants Collection
    
    Skirt Selection
    
    Linen Blouse Series
    
    Silhouette Dress Line
    
    Signature Two-Piece Sets
    
    Holiday Essential Styles
    
    Everyday Premium Wear
    
    VIP Limited Release
    
    Visual style: Premium, minimalist, sophisticated. Avoid any bright colors – use neutral tones. The collections should be presented like a fashion gallery. No distracting elements. The goal is to make customers explore multiple collections and scroll deeper.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-bf-collections-{{ ai_gen_id }} {
    background: {{ block.settings.background_color }};
    position: relative;
    overflow: hidden;
  }

  .ai-bf-collections-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 1;
  }

  .ai-bf-collections-accent-{{ ai_gen_id }} {
    position: absolute;
    width: 600px;
    height: 2px;
    background: linear-gradient(90deg, transparent, {{ block.settings.accent_color }}, transparent);
    opacity: {{ block.settings.accent_opacity }};
    filter: blur(1px);
  }

  .ai-bf-collections-accent-{{ ai_gen_id }}:nth-child(1) {
    top: 15%;
    left: -100px;
    transform: rotate(-15deg);
  }

  .ai-bf-collections-accent-{{ ai_gen_id }}:nth-child(2) {
    top: 60%;
    right: -100px;
    transform: rotate(15deg);
  }

  .ai-bf-collections-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    padding: {{ block.settings.section_padding_top }}px 20px {{ block.settings.section_padding_bottom }}px;
    position: relative;
    z-index: 2;
  }

  .ai-bf-collections-hero-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: {{ block.settings.hero_spacing }}px;
  }

  .ai-bf-collections-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    font-weight: {{ block.settings.heading_weight }};
    color: {{ block.settings.heading_color }};
    margin: 0 0 {{ block.settings.heading_spacing }}px;
    letter-spacing: {{ block.settings.heading_letter_spacing }}px;
    text-transform: {{ block.settings.heading_transform }};
    line-height: 1.2;
  }

  .ai-bf-collections-subheading-{{ ai_gen_id }} {
    font-size: {{ block.settings.subheading_size }}px;
    color: {{ block.settings.subheading_color }};
    margin: 0;
    font-weight: 300;
    letter-spacing: 0.5px;
  }

  .ai-bf-collections-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.grid_gap }}px;
  }

  .ai-bf-collection-card-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.card_border_radius }}px;
    transition: transform 0.4s ease, box-shadow 0.4s ease;
    background: {{ block.settings.card_background }};
  }

  .ai-bf-collection-card-{{ ai_gen_id }}:hover {
    transform: translateY(-{{ block.settings.hover_lift }}px);
    box-shadow: 0 {{ block.settings.hover_shadow }}px {{ block.settings.hover_shadow | times: 2 }}px rgba(0, 0, 0, {{ block.settings.shadow_opacity }});
  }

  .ai-bf-collection-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: {{ block.settings.image_aspect_ratio }}%;
    overflow: hidden;
    background: #1a1a1a;
  }

  .ai-bf-collection-image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease, opacity 0.4s ease;
  }

  .ai-bf-collection-card-{{ ai_gen_id }}:hover .ai-bf-collection-image-{{ ai_gen_id }} {
    transform: scale({{ block.settings.image_zoom }});
    opacity: 0.9;
  }

  .ai-bf-collection-image-placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #1a1a1a 0%, #2a2a2a 100%);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-bf-collection-image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.2;
  }

  .ai-bf-collection-overlay-{{ ai_gen_id }} {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, {{ block.settings.overlay_opacity }}), transparent);
    padding: {{ block.settings.content_padding }}px;
    transition: background 0.4s ease;
  }

  .ai-bf-collection-card-{{ ai_gen_id }}:hover .ai-bf-collection-overlay-{{ ai_gen_id }} {
    background: linear-gradient(to top, rgba(0, 0, 0, {{ block.settings.overlay_opacity | plus: 0.1 }}), transparent);
  }

  .ai-bf-collection-name-{{ ai_gen_id }} {
    font-size: {{ block.settings.collection_name_size }}px;
    color: {{ block.settings.collection_name_color }};
    margin: 0 0 {{ block.settings.name_spacing }}px;
    font-weight: {{ block.settings.collection_name_weight }};
    letter-spacing: 1px;
    text-transform: {{ block.settings.collection_name_transform }};
  }

  .ai-bf-collection-link-{{ ai_gen_id }} {
    display: inline-block;
    color: {{ block.settings.link_color }};
    text-decoration: none;
    font-size: {{ block.settings.link_size }}px;
    font-weight: 400;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    position: relative;
    padding-bottom: 2px;
    transition: color 0.3s ease;
  }

  .ai-bf-collection-link-{{ ai_gen_id }}::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0;
    height: 1px;
    background: {{ block.settings.link_color }};
    transition: width 0.3s ease;
  }

  .ai-bf-collection-link-{{ ai_gen_id }}:hover::after {
    width: 100%;
  }

  @media screen and (max-width: 989px) {
    .ai-bf-collections-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_tablet }}, 1fr);
      gap: {{ block.settings.grid_gap | times: 0.8 }}px;
    }

    .ai-bf-collections-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.7 }}px;
    }

    .ai-bf-collections-subheading-{{ ai_gen_id }} {
      font-size: {{ block.settings.subheading_size | times: 0.85 }}px;
    }

    .ai-bf-collections-container-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding_top | times: 0.7 }}px 16px {{ block.settings.section_padding_bottom | times: 0.7 }}px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-bf-collections-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
      gap: {{ block.settings.grid_gap | times: 0.6 }}px;
    }

    .ai-bf-collections-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.5 }}px;
    }

    .ai-bf-collections-subheading-{{ ai_gen_id }} {
      font-size: {{ block.settings.subheading_size | times: 0.75 }}px;
    }

    .ai-bf-collection-name-{{ ai_gen_id }} {
      font-size: {{ block.settings.collection_name_size | times: 0.85 }}px;
    }

    .ai-bf-collection-link-{{ ai_gen_id }} {
      font-size: {{ block.settings.link_size | times: 0.85 }}px;
    }
  }
{% endstyle %}

<div class="ai-bf-collections-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.show_accents %}
    <div class="ai-bf-collections-overlay-{{ ai_gen_id }}">
      <div class="ai-bf-collections-accent-{{ ai_gen_id }}"></div>
      <div class="ai-bf-collections-accent-{{ ai_gen_id }}"></div>
    </div>
  {% endif %}

  <div class="ai-bf-collections-container-{{ ai_gen_id }}">
    <div class="ai-bf-collections-hero-{{ ai_gen_id }}">
      {% if block.settings.heading != blank %}
        <h1 class="ai-bf-collections-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h1>
      {% endif %}
      {% if block.settings.subheading != blank %}
        <p class="ai-bf-collections-subheading-{{ ai_gen_id }}">{{ block.settings.subheading }}</p>
      {% endif %}
    </div>

    <div class="ai-bf-collections-grid-{{ ai_gen_id }}">
      {% for i in (1..10) %}
        {% liquid
          assign collection_key = 'collection_' | append: i
          assign collection = block.settings[collection_key]
        %}

        {% if collection != blank %}
          <div class="ai-bf-collection-card-{{ ai_gen_id }}">
            <a href="{{ collection.url }}" class="ai-bf-collection-card-link-{{ ai_gen_id }}">
              <div class="ai-bf-collection-image-wrapper-{{ ai_gen_id }}">
                {% if collection.featured_image %}
                  <img
                    src="{{ collection.featured_image | image_url: width: 800 }}"
                    alt="{{ collection.featured_image.alt | escape }}"
                    width="800"
                    height="{{ 800 | times: block.settings.image_aspect_ratio | divided_by: 100 }}"
                    loading="lazy"
                    class="ai-bf-collection-image-{{ ai_gen_id }}"
                  >
                {% else %}
                  <div class="ai-bf-collection-image-placeholder-{{ ai_gen_id }}">
                    {{ 'collection-1' | placeholder_svg_tag }}
                  </div>
                {% endif %}
                <div class="ai-bf-collection-overlay-{{ ai_gen_id }}">
                  <h3 class="ai-bf-collection-name-{{ ai_gen_id }}">{{ collection.title }}</h3>
                  <span class="ai-bf-collection-link-{{ ai_gen_id }}">{{ block.settings.cta_text }}</span>
                </div>
              </div>
            </a>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

