{%- if block.settings.heading != blank -%}
  {%- capture tab_content -%}
    {%- content_for 'blocks' -%}
  {%- endcapture -%}
  {%-liquid
    assign should_display = request.design_mode
    unless should_display
      if tab_content != blank and tab_content != ''
        assign should_display = true
      endif
    endunless
  -%}
  {%- if should_display -%}
    {%- liquid
      assign suffix = section.id | append: '-' | append: block.id
    -%}
    <li>
      <button type="button" role="tab" id="tab-{{ suffix }}" aria-controls="panel-{{ suffix }}" class="tabs__item-label font-heading-bold light por db h4 tab-item-label tab-item-label--has-line unstyled-button" aria-selected="RICH_SELECTED_TAB_HOLDER"RICH_TAB_INDEX_HOLDER {{ block.shopify_attributes }}>{{ block.settings.heading }}</button>
    </li>
    <!--FLEXIBLE_TAB_SPLIT-->
    <div id="panel-{{ suffix }}" role="tabpanel" aria-labelledby="tab-{{ suffix }}" class="tabs__tab-content tabs__tab-content--{{ section.settings.tab_mode }} w100 tabs__tab-content-jsRICH_ACTIVE_CONTENT_HOLDER">
      {{- tab_content -}}
    </div>
    <!--FLEXIBLE_TAB_ITEM-->
  {%- endif -%}    
{%- endif -%}  
{% schema %}
{
  "name": "t:names.tab_item",
  "tag": null,
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.title",
      "default": "t:text_defaults.tab_title"
    }
  ],
  "presets": [
    {
      "name": "t:names.tab_item"
    }
  ]
}
{% endschema %}
