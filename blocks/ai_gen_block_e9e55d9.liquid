{% doc %}
  @prompt
    Create a clean, conversion-focused website section that combines Trust Badges and an FAQ in a single section.
    
    Layout requirements:
    
    Split the section into two columns on desktop
    
    Left side: Trust badges
    
    Right side: FAQ accordion
    
    On mobile view, stack vertically with:
    
    Trust badges displayed first
    
    FAQ accordion below
    
    Trust badge content:
    
    Secure checkout
    
    Cash on Delivery available
    
    Fast local shipping
    
    Easy returns
    
    Customer support assistance
    
    FAQ requirements:
    
    Use an accordion style for clarity and space efficiency
    
    Include common questions such as:
    
    Return policy
    
    Shipping time
    
    Order follow-up / delivery inquiries
    
    Accepted payment methods
    
    Clean typography, minimal icons, and ample spacing for readability
    
    Design style:
    
    Modern, minimal, and professional
    
    Neutral color palette
    
    Mobile-first spacing and tap-friendly accordion buttons
    
    Optimized for conversion and trust-building
    
    The section should look polished, balanced, and easy to scan on both desktop and mobile devices.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-trust-faq-section-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.padding_top }}px 20px {{ block.settings.padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-trust-faq-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
  }

  .ai-trust-faq-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr;
    gap: {{ block.settings.column_gap }}px;
  }

  @media screen and (min-width: 750px) {
    .ai-trust-faq-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr 1fr;
    }
  }

  .ai-trust-badges-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.badge_spacing }}px;
  }

  .ai-trust-badge-{{ ai_gen_id }} {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    padding: {{ block.settings.badge_padding }}px;
    background-color: {{ block.settings.badge_background }};
    border-radius: {{ block.settings.badge_border_radius }}px;
    transition: transform 0.2s ease;
  }

  .ai-trust-badge-{{ ai_gen_id }}:hover {
    transform: translateY(-2px);
  }

  .ai-trust-badge-icon-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: {{ block.settings.icon_color }};
  }

  .ai-trust-badge-icon-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
  }

  .ai-trust-badge-content-{{ ai_gen_id }} {
    flex-grow: 1;
  }

  .ai-trust-badge-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.badge_title_size }}px;
    font-weight: 600;
    color: {{ block.settings.text_color }};
    margin: 0 0 4px 0;
    line-height: 1.3;
  }

  .ai-trust-badge-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.badge_description_size }}px;
    color: {{ block.settings.text_color_secondary }};
    margin: 0;
    line-height: 1.5;
  }

  .ai-faq-section-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.faq_spacing }}px;
  }

  .ai-faq-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.faq_heading_size }}px;
    font-weight: 700;
    color: {{ block.settings.text_color }};
    margin: 0 0 {{ block.settings.faq_spacing }}px 0;
    line-height: 1.2;
  }

  .ai-faq-item-{{ ai_gen_id }} {
    border: 1px solid {{ block.settings.faq_border_color }};
    border-radius: {{ block.settings.faq_border_radius }}px;
    overflow: hidden;
    background-color: {{ block.settings.faq_background }};
  }

  .ai-faq-question-{{ ai_gen_id }} {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: {{ block.settings.faq_padding }}px;
    background: none;
    border: none;
    text-align: left;
    cursor: pointer;
    font-size: {{ block.settings.faq_question_size }}px;
    font-weight: 600;
    color: {{ block.settings.text_color }};
    transition: background-color 0.2s ease;
    gap: 16px;
    min-height: 48px;
  }

  .ai-faq-question-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.faq_hover_background }};
  }

  .ai-faq-question-text-{{ ai_gen_id }} {
    flex-grow: 1;
    line-height: 1.4;
  }

  .ai-faq-icon-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: 20px;
    height: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: {{ block.settings.icon_color }};
    transition: transform 0.3s ease;
  }

  .ai-faq-icon-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
  }

  .ai-faq-item-{{ ai_gen_id }}.active .ai-faq-icon-{{ ai_gen_id }} {
    transform: rotate(180deg);
  }

  .ai-faq-answer-{{ ai_gen_id }} {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease, padding 0.3s ease;
  }

  .ai-faq-item-{{ ai_gen_id }}.active .ai-faq-answer-{{ ai_gen_id }} {
    max-height: 500px;
    padding: 0 {{ block.settings.faq_padding }}px {{ block.settings.faq_padding }}px;
  }

  .ai-faq-answer-content-{{ ai_gen_id }} {
    font-size: {{ block.settings.faq_answer_size }}px;
    color: {{ block.settings.text_color_secondary }};
    line-height: 1.6;
  }

  @media screen and (max-width: 749px) {
    .ai-trust-faq-section-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_top_mobile }}px 16px {{ block.settings.padding_bottom_mobile }}px;
    }

    .ai-trust-faq-grid-{{ ai_gen_id }} {
      gap: {{ block.settings.column_gap_mobile }}px;
    }

    .ai-faq-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.faq_heading_size | times: 0.85 }}px;
    }

    .ai-trust-badge-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.badge_title_size | times: 0.9 }}px;
    }

    .ai-faq-question-{{ ai_gen_id }} {
      font-size: {{ block.settings.faq_question_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

