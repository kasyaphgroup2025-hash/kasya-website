    Can you make me a customer review but in halloween style 4 customer review , can you make a black background must be black and orange blue just make it halloween style and carousel stype also in mobile view , can you make black background like halloween style or violet something, can you make black and orange blue also the title 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-halloween-reviews-{{ ai_gen_id }} {
    padding: 60px 20px;
    background: #000000;
    position: relative;
    overflow: hidden;
  }

  .ai-halloween-reviews-{{ ai_gen_id }}::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-image: 
      radial-gradient(circle at 20% 30%, rgba(255, 140, 0, 0.15) 0%, transparent 50%),
      radial-gradient(circle at 80% 70%, rgba(0, 123, 255, 0.15) 0%, transparent 50%);
    pointer-events: none;
  }

  .ai-halloween-reviews-container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }

  .ai-halloween-reviews-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 50px;
  }

  .ai-halloween-reviews-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 15px;
    font-weight: 700;
    text-shadow: 0 0 20px rgba(255, 140, 0, 0.8), 0 0 40px rgba(0, 123, 255, 0.5);
  }

  .ai-halloween-reviews-subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_size }}px;
    color: {{ block.settings.subtitle_color }};
    margin: 0;
    text-shadow: 0 0 10px rgba(255, 140, 0, 0.5);
  }

  .ai-halloween-carousel-wrapper-{{ ai_gen_id }} {
    position: relative;
    padding: 0 60px;
  }

  .ai-halloween-reviews-carousel-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 30px;
    transition: transform 0.5s ease;
  }

  .ai-halloween-review-card-{{ ai_gen_id }} {
    background: {{ block.settings.card_background }};
    border: 2px solid {{ block.settings.card_border_color }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: 30px;
    position: relative;
    transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
    box-shadow: 0 4px 20px rgba(255, 140, 0, 0.3), 0 0 30px rgba(0, 123, 255, 0.2);
    min-height: 300px;
  }

  .ai-halloween-review-card-{{ ai_gen_id }}::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    border-radius: {{ block.settings.card_border_radius }}px;
    background: linear-gradient(135deg, rgba(255, 140, 0, 0.05) 0%, rgba(0, 123, 255, 0.05) 100%);
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }

  .ai-halloween-review-card-{{ ai_gen_id }}:hover {
    transform: translateY(-8px);
    box-shadow: 0 8px 40px rgba(255, 140, 0, 0.6), 0 0 50px rgba(0, 123, 255, 0.4);
    border-color: {{ block.settings.card_hover_border }};
  }

  .ai-halloween-review-card-{{ ai_gen_id }}:hover::before {
    opacity: 1;
  }

  .ai-halloween-review-header-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 15px;
    margin-bottom: 20px;
  }

  .ai-halloween-review-avatar-{{ ai_gen_id }} {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: {{ block.settings.avatar_background }};
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 28px;
    border: 2px solid {{ block.settings.card_border_color }};
    flex-shrink: 0;
    box-shadow: 0 0 15px rgba(255, 140, 0, 0.5);
  }

  .ai-halloween-review-info-{{ ai_gen_id }} {
    flex-grow: 1;
  }

  .ai-halloween-review-name-{{ ai_gen_id }} {
    font-size: 18px;
    font-weight: 600;
    color: {{ block.settings.text_color }};
    margin: 0 0 5px;
    text-shadow: 0 0 8px rgba(255, 140, 0, 0.3);
  }

  .ai-halloween-review-stars-{{ ai_gen_id }} {
    display: flex;
    gap: 3px;
    color: {{ block.settings.star_color }};
    font-size: 16px;
    filter: drop-shadow(0 0 5px rgba(255, 140, 0, 0.8));
  }

  .ai-halloween-review-text-{{ ai_gen_id }} {
    font-size: 15px;
    line-height: 1.6;
    color: {{ block.settings.text_color }};
    margin: 0 0 15px;
  }

  .ai-halloween-review-date-{{ ai_gen_id }} {
    font-size: 13px;
    color: {{ block.settings.date_color }};
    font-style: italic;
  }

  .ai-halloween-review-decoration-{{ ai_gen_id }} {
    position: absolute;
    top: 10px;
    right: 10px;
    font-size: 24px;
    opacity: 0.4;
    filter: drop-shadow(0 0 8px rgba(255, 140, 0, 0.6));
  }

  .ai-halloween-carousel-nav-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: {{ block.settings.button_background }};
    border: 2px solid {{ block.settings.card_border_color }};
    width: 45px;
    height: 45px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 10;
    transition: all 0.3s ease;
    color: #ffffff;
    font-size: 20px;
    font-weight: bold;
    box-shadow: 0 0 20px rgba(255, 140, 0, 0.5);
  }

  .ai-halloween-carousel-nav-{{ ai_gen_id }}:hover {
    background: {{ block.settings.button_hover_background }};
    border-color: {{ block.settings.card_hover_border }};
    box-shadow: 0 0 30px rgba(255, 140, 0, 0.8), 0 0 40px rgba(0, 123, 255, 0.5);
    transform: translateY(-50%) scale(1.1);
  }

  .ai-halloween-carousel-nav-{{ ai_gen_id }}:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .ai-halloween-carousel-prev-{{ ai_gen_id }} {
    left: 0;
  }

  .ai-halloween-carousel-next-{{ ai_gen_id }} {
    right: 0;
  }

  .ai-halloween-carousel-dots-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    gap: 10px;
    margin-top: 30px;
  }

  .ai-halloween-carousel-dot-{{ ai_gen_id }} {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: rgba(255, 140, 0, 0.2);
    border: 2px solid {{ block.settings.card_border_color }};
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .ai-halloween-carousel-dot-{{ ai_gen_id }}.active {
    background: {{ block.settings.card_border_color }};
    box-shadow: 0 0 15px {{ block.settings.card_border_color }}, 0 0 25px rgba(0, 123, 255, 0.4);
    transform: scale(1.2);
  }

  @media screen and (max-width: 989px) {
    .ai-halloween-reviews-carousel-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
    }

    .ai-halloween-carousel-wrapper-{{ ai_gen_id }} {
      padding: 0 50px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-halloween-reviews-{{ ai_gen_id }} {
      padding: 40px 15px;
    }

    .ai-halloween-reviews-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.7 }}px;
    }

    .ai-halloween-reviews-carousel-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .ai-halloween-carousel-wrapper-{{ ai_gen_id }} {
      padding: 0 40px;
    }

    .ai-halloween-review-card-{{ ai_gen_id }} {
      padding: 25px;
      min-height: auto;
    }

    .ai-halloween-carousel-nav-{{ ai_gen_id }} {
      width: 35px;
      height: 35px;
      font-size: 16px;
    }
  }
{% endstyle %}

