<script>
  (function() {
    class HalloweenReviewsCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentIndex = 0;
        this.cards = [];
        this.itemsPerPage = 4;
      }

      connectedCallback() {
        this.carousel = this.querySelector('.ai-halloween-reviews-carousel-{{ ai_gen_id }}');
        this.prevBtn = this.querySelector('.ai-halloween-carousel-prev-{{ ai_gen_id }}');
        this.nextBtn = this.querySelector('.ai-halloween-carousel-next-{{ ai_gen_id }}');
        this.dotsContainer = this.querySelector('.ai-halloween-carousel-dots-{{ ai_gen_id }}');
        this.cards = Array.from(this.querySelectorAll('.ai-halloween-review-card-{{ ai_gen_id }}'));
        
        this.updateItemsPerPage();
        this.createDots();
        this.setupEventListeners();
        this.updateCarousel();

        window.addEventListener('resize', () => {
          this.updateItemsPerPage();
          this.createDots();
          this.currentIndex = 0;
          this.updateCarousel();
        });
      }

      updateItemsPerPage() {
        const width = window.innerWidth;
        if (width <= 749) {
          this.itemsPerPage = 1;
        } else if (width <= 989) {
          this.itemsPerPage = 2;
        } else {
          this.itemsPerPage = 4;
        }
      }

      createDots() {
        this.dotsContainer.innerHTML = '';
        const totalPages = Math.ceil(this.cards.length / this.itemsPerPage);
        
        for (let i = 0; i < totalPages; i++) {
          const dot = document.createElement('button');
          dot.classList.add('ai-halloween-carousel-dot-{{ ai_gen_id }}');
          dot.setAttribute('aria-label', `Go to page ${i + 1}`);
          if (i === 0) dot.classList.add('active');
          dot.addEventListener('click', () => {
            this.currentIndex = i;
            this.updateCarousel();
          });
          this.dotsContainer.appendChild(dot);
        }
      }

      setupEventListeners() {
        this.prevBtn.addEventListener('click', () => this.prev());
        this.nextBtn.addEventListener('click', () => this.next());

        let startX = 0;
        let endX = 0;

        this.carousel.addEventListener('touchstart', (e) => {
          startX = e.touches[0].clientX;
        });

        this.carousel.addEventListener('touchend', (e) => {
          endX = e.changedTouches[0].clientX;
          if (startX - endX > 50) {
            this.next();
          } else if (endX - startX > 50) {
            this.prev();
          }
        });
      }

      prev() {
        if (this.currentIndex > 0) {
          this.currentIndex--;
          this.updateCarousel();
        }
      }

      next() {
        const totalPages = Math.ceil(this.cards.length / this.itemsPerPage);
        if (this.currentIndex < totalPages - 1) {
          this.currentIndex++;
          this.updateCarousel();
        }
      }

      updateCarousel() {
        const totalPages = Math.ceil(this.cards.length / this.itemsPerPage);
        
        this.cards.forEach((card, index) => {
          const pageIndex = Math.floor(index / this.itemsPerPage);
          if (pageIndex === this.currentIndex) {
            card.style.display = 'block';
          } else {
            card.style.display = 'none';
          }
        });

        this.prevBtn.disabled = this.currentIndex === 0;
        this.nextBtn.disabled = this.currentIndex === totalPages - 1;

        const dots = this.dotsContainer.querySelectorAll('.ai-halloween-carousel-dot-{{ ai_gen_id }}');
        dots.forEach((dot, index) => {
          if (index === this.currentIndex) {
            dot.classList.add('active');
          } else {
            dot.classList.remove('active');
          }
        });
      }
    }

    customElements.define('halloween-reviews-carousel-{{ ai_gen_id }}', HalloweenReviewsCarousel{{ ai_gen_id }});
  })();
</script>

