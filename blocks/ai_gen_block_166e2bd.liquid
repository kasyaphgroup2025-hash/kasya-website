{% doc %}
  @prompt
    Create a bold and elegant heading block for KasyaPH’s 11.11 Mega Sale featuring the Radiance Collection.
    Theme: Black and White minimalist, fashion editorial style with a premium, modern vibe.
    Headline should highlight both the 11.11 Mega Sale and the Radiance Collection launch — something that feels exclusive and sophisticated.
    Example tone: “The Radiance Collection Shines This 11.11” or “Step Into the Spotlight — 11.11 Radiance Arrives.”
    Include a short subheading that hints at limited-time offers or new arrivals.
    Design direction:
    
    Big bold serif font for the main headline
    
    Soft sans serif subtext below
    
    Clean layout with subtle motion (fade-in or slide)
    
    Background in white or black with soft glow accents to suggest “radiance”, can you make the shop now button make scroll section in radiance collection , Can you make the button scroll to radiance collection no need to input section ID 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-radiance-heading-{{ ai_gen_id }} {
    position: relative;
    padding: {{ block.settings.padding_top }}px {{ block.settings.padding_horizontal }}px {{ block.settings.padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
    overflow: hidden;
    min-height: {{ block.settings.min_height }}px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-radiance-heading-{{ ai_gen_id }}::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: {{ block.settings.glow_size }}px;
    height: {{ block.settings.glow_size }}px;
    background: radial-gradient(circle, {{ block.settings.glow_color }} 0%, transparent 70%);
    opacity: {{ block.settings.glow_opacity | divided_by: 100.0 }};
    pointer-events: none;
  }

  .ai-radiance-heading__container-{{ ai_gen_id }} {
    position: relative;
    z-index: 1;
    text-align: {{ block.settings.text_alignment }};
    max-width: {{ block.settings.content_width }}px;
    width: 100%;
  }

  .ai-radiance-heading__eyebrow-{{ ai_gen_id }} {
    font-family: {{ block.settings.subtext_font.family }}, {{ block.settings.subtext_font.fallback_families }};
    font-weight: {{ block.settings.subtext_font.weight }};
    font-size: {{ block.settings.eyebrow_size }}px;
    color: {{ block.settings.eyebrow_color }};
    letter-spacing: {{ block.settings.eyebrow_spacing }}px;
    text-transform: uppercase;
    margin-bottom: {{ block.settings.eyebrow_margin }}px;
    opacity: 0;
  }

  .ai-radiance-heading__title-{{ ai_gen_id }} {
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-weight: {{ block.settings.heading_font.weight }};
    font-size: {{ block.settings.heading_size }}px;
    line-height: {{ block.settings.heading_line_height }};
    color: {{ block.settings.heading_color }};
    margin: 0 0 {{ block.settings.heading_margin }}px;
    opacity: 0;
  }

  .ai-radiance-heading__subtext-{{ ai_gen_id }} {
    font-family: {{ block.settings.subtext_font.family }}, {{ block.settings.subtext_font.fallback_families }};
    font-weight: {{ block.settings.subtext_font.weight }};
    font-size: {{ block.settings.subtext_size }}px;
    line-height: 1.6;
    color: {{ block.settings.subtext_color }};
    margin: 0;
    opacity: 0;
  }

  .ai-radiance-heading__cta-{{ ai_gen_id }} {
    margin-top: {{ block.settings.button_margin }}px;
    opacity: 0;
  }

  .ai-radiance-heading__button-{{ ai_gen_id }} {
    display: inline-block;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    font-family: {{ block.settings.subtext_font.family }}, {{ block.settings.subtext_font.fallback_families }};
    font-weight: {{ block.settings.subtext_font.weight }};
    font-size: {{ block.settings.button_font_size }}px;
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    letter-spacing: 1px;
    text-transform: uppercase;
    transition: all 0.3s ease;
    border: {{ block.settings.button_border_width }}px solid {{ block.settings.button_border_color }};
    cursor: pointer;
  }

  .ai-radiance-heading__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
    color: {{ block.settings.button_hover_text_color }};
    border-color: {{ block.settings.button_hover_border_color }};
    transform: translateY(-2px);
  }

  .ai-radiance-heading--loaded-{{ ai_gen_id }} .ai-radiance-heading__eyebrow-{{ ai_gen_id }} {
    animation: ai-radiance-fade-in-{{ ai_gen_id }} 0.8s ease-out 0.2s forwards;
  }

  .ai-radiance-heading--loaded-{{ ai_gen_id }} .ai-radiance-heading__title-{{ ai_gen_id }} {
    animation: ai-radiance-slide-up-{{ ai_gen_id }} 1s ease-out 0.4s forwards;
  }

  .ai-radiance-heading--loaded-{{ ai_gen_id }} .ai-radiance-heading__subtext-{{ ai_gen_id }} {
    animation: ai-radiance-fade-in-{{ ai_gen_id }} 0.8s ease-out 0.8s forwards;
  }

  .ai-radiance-heading--loaded-{{ ai_gen_id }} .ai-radiance-heading__cta-{{ ai_gen_id }} {
    animation: ai-radiance-fade-in-{{ ai_gen_id }} 0.8s ease-out 1.2s forwards;
  }

  @keyframes ai-radiance-fade-in-{{ ai_gen_id }} {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes ai-radiance-slide-up-{{ ai_gen_id }} {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-radiance-heading-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_top | times: 0.6 }}px {{ block.settings.padding_horizontal | times: 0.5 }}px {{ block.settings.padding_bottom | times: 0.6 }}px;
      min-height: {{ block.settings.min_height | times: 0.7 }}px;
    }

    .ai-radiance-heading__eyebrow-{{ ai_gen_id }} {
      font-size: {{ block.settings.eyebrow_size | times: 0.8 }}px;
    }

    .ai-radiance-heading__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.5 }}px;
    }

    .ai-radiance-heading__subtext-{{ ai_gen_id }} {
      font-size: {{ block.settings.subtext_size | times: 0.9 }}px;
    }

    .ai-radiance-heading__button-{{ ai_gen_id }} {
      font-size: {{ block.settings.button_font_size | times: 0.9 }}px;
      padding: {{ block.settings.button_padding_vertical | times: 0.8 }}px {{ block.settings.button_padding_horizontal | times: 0.8 }}px;
    }
  }

  @media screen and (min-width: 750px) and (max-width: 989px) {
    .ai-radiance-heading__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.7 }}px;
    }
  }
{% endstyle %}

<radiance-heading-{{ ai_gen_id }}
  class="ai-radiance-heading-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-radiance-heading__container-{{ ai_gen_id }}">
    {% if block.settings.eyebrow_text != blank %}
      <div class="ai-radiance-heading__eyebrow-{{ ai_gen_id }}">
        {{ block.settings.eyebrow_text }}
      </div>
    {% endif %}

    {% if block.settings.heading_text != blank %}
      <h1 class="ai-radiance-heading__title-{{ ai_gen_id }}">
        {{ block.settings.heading_text }}
      </h1>
    {% endif %}

    {% if block.settings.subtext != blank %}
      <div class="ai-radiance-heading__subtext-{{ ai_gen_id }}">
        {{ block.settings.subtext }}
      </div>
    {% endif %}

    {% if block.settings.show_button and block.settings.button_text != blank %}
      <div class="ai-radiance-heading__cta-{{ ai_gen_id }}">
        <button
          class="ai-radiance-heading__button-{{ ai_gen_id }}"
        >
          {{ block.settings.button_text }}
        </button>
      </div>
    {% endif %}
  </div>
</radiance-heading-{{ ai_gen_id }}>

<script>
  (function() {
    class RadianceHeading{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        setTimeout(() => {
          this.classList.add('ai-radiance-heading--loaded-{{ ai_gen_id }}');
        }, 100);

        this.setupScrollButton();
      }

      setupScrollButton() {
        const button = this.querySelector('.ai-radiance-heading__button-{{ ai_gen_id }}');
        if (!button) return;

        button.addEventListener('click', (e) => {
          e.preventDefault();
          
          const targetElement = this.findRadianceSection();
          
          if (targetElement) {
            const headerOffset = 80;
            const elementPosition = targetElement.getBoundingClientRect().top;
            const offsetPosition = elementPosition + window.pageYOffset - headerOffset;

            window.scrollTo({
              top: offsetPosition,
              behavior: 'smooth'
            });
          }
        });
      }

      findRadianceSection() {
        const searchTerms = ['radiance', 'collection', 'radiance-collection'];
        
        for (const term of searchTerms) {
          const elementById = document.getElementById(term);
          if (elementById) {
            return elementById;
          }
          
          const elementByClass = document.querySelector('.' + term);
          if (elementByClass) {
            return elementByClass;
          }
          
          const elementByPartialId = document.querySelector('[id*="' + term + '"]');
          if (elementByPartialId && elementByPartialId !== this) {
            return elementByPartialId;
          }
          
          const elementByPartialClass = document.querySelector('[class*="' + term + '"]');
          if (elementByPartialClass && elementByPartialClass !== this) {
            return elementByPartialClass;
          }
        }
        
        const allSections = document.querySelectorAll('section, [class*="section"], .shopify-section');
        const currentIndex = Array.from(allSections).indexOf(this.closest('section, .shopify-section'));
        
        if (currentIndex !== -1 && currentIndex + 1 < allSections.length) {
          return allSections[currentIndex + 1];
        }
        
        return null;
      }
    }

    customElements.define('radiance-heading-{{ ai_gen_id }}', RadianceHeading{{ ai_gen_id }});
  })();
</script>

