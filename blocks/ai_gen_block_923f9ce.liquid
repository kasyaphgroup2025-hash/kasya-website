{% doc %}
  @prompt
    Create a clean and minimal highlight section for our new Wideleg Pants color.
    
    Design Style:
    - Soft neutral background (#F2EDE7 or off-white)
    - Premium, calm, boutique aesthetic
    - Large, centered hero image on mobile
    - Generous spacing, no borders, no heavy shadows
    
    Section Layout:
    
    1. Title (centered):
       “New Color Drop: Wideleg Pants”
    
    2. Subtitle (centered, softer tone):
       “Flowy, breathable, and flattering — now in a new classic shade.”
    
    3. Large hero image (full width on mobile, balanced on desktop).
    
    4. Below the image, add two primary action buttons, stacked on mobile and side-by-side on desktop:
    
       Button 1:
       Label: “Shop Wideleg Collection”
       Link: (collection URL placeholder)
       Style: Rounded corners, dark neutral #2E2E2E background, white text.
    
       Button 2:
       Label: “Build Your Bundle — Save 18%”
       Link: (bundle builder page URL placeholder)
       Style: Rounded corners, outline style or soft neutral fill, dark text.
    
    5. Add a short fit note under the buttons:
       “Available in inclusive sizing. Adjustable waistband for all-day comfort.”
    
    6. Keep the section simple, quiet, and mobile-first. The goal is to showcase the new color and provide two clear shopping paths — individual pieces or bundle savings.
    
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-color-drop-{{ ai_gen_id }} {
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.padding_top_mobile }}px 20px {{ block.settings.padding_bottom_mobile }}px;
  }

  .ai-color-drop-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
  }

  .ai-color-drop-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: {{ block.settings.header_spacing_mobile }}px;
  }

  .ai-color-drop-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size_mobile }}px;
    font-weight: {{ block.settings.title_weight }};
    color: {{ block.settings.title_color }};
    margin: 0 0 {{ block.settings.title_margin }}px;
    line-height: 1.2;
  }

  .ai-color-drop-subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_size_mobile }}px;
    color: {{ block.settings.subtitle_color }};
    margin: 0;
    line-height: 1.5;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  .ai-color-drop-image-wrapper-{{ ai_gen_id }} {
    margin-bottom: {{ block.settings.image_spacing_mobile }}px;
    border-radius: {{ block.settings.image_border_radius }}px;
    overflow: hidden;
  }

  .ai-color-drop-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
  }

  .ai-color-drop-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: {{ block.settings.image_aspect_ratio }};
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-color-drop-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-color-drop-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-color-drop-actions-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: {{ block.settings.actions_spacing_mobile }}px;
  }

  .ai-color-drop-button-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: {{ block.settings.button_font_weight }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    transition: all 0.3s ease;
    text-align: center;
    border: 2px solid transparent;
  }

  .ai-color-drop-button-primary-{{ ai_gen_id }} {
    background-color: {{ block.settings.button_primary_bg }};
    color: {{ block.settings.button_primary_color }};
    border-color: {{ block.settings.button_primary_bg }};
  }

  .ai-color-drop-button-primary-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_primary_hover_bg }};
    border-color: {{ block.settings.button_primary_hover_bg }};
    color: {{ block.settings.button_primary_color }};
  }

  .ai-color-drop-button-secondary-{{ ai_gen_id }} {
    background-color: {{ block.settings.button_secondary_bg }};
    color: {{ block.settings.button_secondary_color }};
    border-color: {{ block.settings.button_secondary_border }};
  }

  .ai-color-drop-button-secondary-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_secondary_hover_bg }};
    color: {{ block.settings.button_secondary_hover_color }};
    border-color: {{ block.settings.button_secondary_hover_border }};
  }

  .ai-color-drop-note-{{ ai_gen_id }} {
    text-align: center;
    font-size: {{ block.settings.note_size_mobile }}px;
    color: {{ block.settings.note_color }};
    line-height: 1.6;
    max-width: 500px;
    margin: 0 auto;
  }

  @media screen and (min-width: 750px) {
    .ai-color-drop-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_top_desktop }}px 40px {{ block.settings.padding_bottom_desktop }}px;
    }

    .ai-color-drop-header-{{ ai_gen_id }} {
      margin-bottom: {{ block.settings.header_spacing_desktop }}px;
    }

    .ai-color-drop-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size_desktop }}px;
    }

    .ai-color-drop-subtitle-{{ ai_gen_id }} {
      font-size: {{ block.settings.subtitle_size_desktop }}px;
    }

    .ai-color-drop-image-wrapper-{{ ai_gen_id }} {
      margin-bottom: {{ block.settings.image_spacing_desktop }}px;
    }

    .ai-color-drop-actions-{{ ai_gen_id }} {
      flex-direction: row;
      justify-content: center;
      gap: 16px;
      margin-bottom: {{ block.settings.actions_spacing_desktop }}px;
    }

    .ai-color-drop-button-{{ ai_gen_id }} {
      min-width: 200px;
    }

    .ai-color-drop-note-{{ ai_gen_id }} {
      font-size: {{ block.settings.note_size_desktop }}px;
    }
  }
{% endstyle %}

<div class="ai-color-drop-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-color-drop-container-{{ ai_gen_id }}">
    {% if block.settings.title != blank or block.settings.subtitle != blank %}
      <div class="ai-color-drop-header-{{ ai_gen_id }}">
        {% if block.settings.title != blank %}
          <h2 class="ai-color-drop-title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
        {% endif %}
        {% if block.settings.subtitle != blank %}
          <p class="ai-color-drop-subtitle-{{ ai_gen_id }}">{{ block.settings.subtitle }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class="ai-color-drop-image-wrapper-{{ ai_gen_id }}">
      {% if block.settings.hero_image %}
        <img
          src="{{ block.settings.hero_image | image_url: width: 1400 }}"
          alt="{{ block.settings.hero_image.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.hero_image.width }}"
          height="{{ block.settings.hero_image.height }}"
          class="ai-color-drop-image-{{ ai_gen_id }}"
        >
      {% else %}
        <div class="ai-color-drop-image-placeholder-{{ ai_gen_id }}">
          {{ 'hero-apparel-1' | placeholder_svg_tag }}
          <div class="ai-color-drop-empty-state-{{ ai_gen_id }}">
            Add your hero image to showcase the new color
          </div>
        </div>
      {% endif %}
    </div>

    {% if block.settings.show_buttons %}
      <div class="ai-color-drop-actions-{{ ai_gen_id }}">
        {% if block.settings.button_primary_label != blank %}
          <a
            href="{{ block.settings.button_primary_link }}"
            class="ai-color-drop-button-{{ ai_gen_id }} ai-color-drop-button-primary-{{ ai_gen_id }}"
          >
            {{ block.settings.button_primary_label }}
          </a>
        {% endif %}

        {% if block.settings.button_secondary_label != blank %}
          <a
            href="{{ block.settings.button_secondary_link }}"
            class="ai-color-drop-button-{{ ai_gen_id }} ai-color-drop-button-secondary-{{ ai_gen_id }}"
          >
            {{ block.settings.button_secondary_label }}
          </a>
        {% endif %}
      </div>
    {% endif %}

    {% if block.settings.fit_note != blank %}
      <div class="ai-color-drop-note-{{ ai_gen_id }}">
        {{ block.settings.fit_note }}
      </div>
    {% endif %}
  </div>
</div>

