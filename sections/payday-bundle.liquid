{%- comment -%}
  Payday Sale bundle builder (Kasya).
  Pricing shown here is a preview. The real discounts are three automatic
  discounts in Shopify admin; tier settings below must match them.
{%- endcomment -%}
{%- liquid
  assign p = section.settings.product
  assign free_ship_cents = settings.free_shipping_threshold | default: 0 | times: 100
  assign size_chart_img = section.settings.size_chart_image
  if p != blank
    for m in p.media
      if m.media_type == 'image' and m.alt == 'LP | Size Chart'
        assign size_chart_img = m.preview_image
        break
      endif
    endfor
  endif
-%}
{{ 'payday-bundle.css' | asset_url | stylesheet_tag }}

{%- if p == blank -%}
  <div class="payday-empty page-width">
    <p>Select the Wide-Leg Pants product in this section's settings.</p>
  </div>
{%- else -%}
  <payday-bundle
    class="payday"
    data-section-id="{{ section.id }}"
    style="--payday-accent: {{ section.settings.accent }}; --payday-ink: {{ section.settings.ink }};"
  >
    {%- liquid
      assign hero_desktop = section.settings.hero_image | default: p.featured_image
      assign hero_mobile = section.settings.hero_image_mobile | default: hero_desktop
      assign overlay = section.settings.overlay_opacity | divided_by: 100.0
      assign hero_pos = 'object-position: center'
      if hero_mobile.presentation.focal_point != blank
        assign hero_pos = hero_mobile.presentation.focal_point | prepend: 'object-position: '
      endif
      assign hero_alt = hero_mobile.alt | default: p.title
    -%}
    <section class="payday-hero">
      <div class="payday-hero__banner" style="--payday-overlay: {{ overlay }}; --payday-hero-m: {{ section.settings.hero_height_mobile | divided_by: 100.0 }}; --payday-hero-d: {{ section.settings.hero_height_desktop | divided_by: 100.0 }};">
        {%- if hero_desktop -%}
          <picture>
            <source media="(min-width: 750px)" srcset="{{ hero_desktop | image_url: width: 1200 }} 1200w, {{ hero_desktop | image_url: width: 1800 }} 1800w, {{ hero_desktop | image_url: width: 2400 }} 2400w" sizes="100vw">
            {{ hero_mobile | image_url: width: 1200 | image_tag:
              loading: 'eager',
              fetchpriority: 'high',
              sizes: '100vw',
              widths: '600, 900, 1200',
              class: 'payday-hero__img',
              style: hero_pos,
              alt: hero_alt
            }}
          </picture>
        {%- endif -%}
        <div class="payday-hero__overlay">
          <div class="payday-hero__text payday-wrap">
            {%- if section.settings.eyebrow != blank -%}
              <p class="payday-hero__eyebrow">{{ section.settings.eyebrow }}</p>
            {%- endif -%}
            <h1 class="payday-hero__title">{{ section.settings.heading }}</h1>
          </div>
        </div>
      </div>
      {%- if section.settings.subheading != blank -%}
        <div class="payday-wrap"><p class="payday-hero__sub">{{ section.settings.subheading }}</p></div>
      {%- endif -%}
    </section>

    <section class="payday-wrap payday-tiers-wrap" aria-labelledby="PaydayTiers-{{ section.id }}">
      <h2 class="payday-label-lg" id="PaydayTiers-{{ section.id }}">{{ section.settings.tiers_heading | default: 'Pick your bundle' }}</h2>
      <div class="payday-tiers" data-tiers></div>
      <p class="payday-tiers__note">Price shown is per piece. The discount applies to all pants in your order.</p>
    </section>

    <section class="payday-shop" aria-labelledby="PaydayProduct-{{ section.id }}">
      <div class="payday-shop__media">
        <div class="payday-gallery" data-gallery>
          <div class="payday-gallery__track" data-track tabindex="0" aria-label="Product photos, swipe to see more">
            {%- if p.featured_image -%}
              <figure class="payday-slide">
                <img src="{{ p.featured_image | image_url: width: 1000 }}" alt="{{ p.title | escape }}" width="1000" height="1250" loading="lazy">
              </figure>
            {%- endif -%}
          </div>
          <button type="button" class="payday-gallery__arrow payday-gallery__arrow--prev" data-prev aria-label="Previous photo" hidden>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m15 18-6-6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <button type="button" class="payday-gallery__arrow payday-gallery__arrow--next" data-next aria-label="Next photo" hidden>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m9 6 6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <div class="payday-gallery__dots" data-dots></div>
        </div>
      </div>

      <div class="payday-shop__panel payday-wrap">
        <div class="payday-title-row">
          <h2 class="payday-product-title" id="PaydayProduct-{{ section.id }}">{{ p.title }}</h2>
          <div class="payday-price" data-price aria-live="polite"><span class="payday-price__now">{{ p.price | money }}</span></div>
        </div>

        <div class="payday-field">
          <p class="payday-field__label" data-color-field>Color: <strong data-color-name></strong></p>
          <div class="payday-swatches" data-swatches role="group" aria-label="Color"></div>
        </div>

        <div class="payday-field">
          <div class="payday-field__head">
            <p class="payday-field__label">Size</p>
            <button type="button" class="payday-link" data-chart-toggle aria-expanded="false" aria-controls="PaydayChart-{{ section.id }}">Size chart</button>
          </div>
          <div class="payday-sizes" data-sizes role="group" aria-label="Size"></div>
          <p class="payday-stock" data-stock aria-live="polite">Select a size</p>
          <div class="payday-chart" id="PaydayChart-{{ section.id }}" data-chart hidden>
            {%- if section.settings.fit_note != blank -%}
              <div class="payday-chart__note">{{ section.settings.fit_note }}</div>
            {%- endif -%}
            {%- if size_chart_img -%}
              <img class="payday-chart__img" data-chart-src="{{ size_chart_img | image_url: width: 1200 }}" alt="Size chart for {{ p.title | escape }}" width="1200" height="{{ 1200 | divided_by: size_chart_img.aspect_ratio | round }}">
            {%- endif -%}
            {%- if section.settings.size_chart_note != blank -%}
              <p class="payday-chart__small">{{ section.settings.size_chart_note }}</p>
            {%- endif -%}
          </div>
        </div>

        <button type="button" class="payday-btn payday-btn--primary" data-add disabled>Choose a size to add</button>

        <div class="payday-tray">
          <h3 class="payday-label-lg">Your bundle</h3>
          <div data-tray-items></div>
          <div class="payday-slots" data-slots></div>
        </div>
      </div>
    </section>

    {%- if section.settings.trust_1 != blank or section.settings.trust_2 != blank or section.settings.trust_3 != blank -%}
      <section class="payday-wrap payday-trust" aria-label="Shopping with Kasya">
        {%- for i in (1..3) -%}
          {%- assign key = 'trust_' | append: i -%}
          {%- if section.settings[key] != blank -%}
            <p class="payday-trust__item">{{ section.settings[key] }}</p>
          {%- endif -%}
        {%- endfor -%}
      </section>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <section class="payday-wrap payday-faq" aria-labelledby="PaydayFaq-{{ section.id }}">
        <h2 class="payday-label-lg" id="PaydayFaq-{{ section.id }}">{{ section.settings.faq_heading | default: 'FAQ' }}</h2>
        {%- for block in section.blocks -%}
          <details class="payday-faq__item" {{ block.shopify_attributes }}>
            <summary>{{ block.settings.question }}</summary>
            <div class="payday-faq__answer">{{ block.settings.answer }}</div>
          </details>
        {%- endfor -%}
      </section>
    {%- endif -%}

    <aside class="payday-bar" data-bar aria-label="Your bundle summary">
      <div class="payday-bar__inner">
        <p class="payday-bar__msg" data-bar-msg aria-live="polite"></p>
        <div class="payday-steps" data-steps aria-hidden="true"></div>
        <div class="payday-bar__row">
          <div class="payday-bar__totals">
            <span class="payday-bar__count" data-bar-count></span>
            <span class="payday-bar__savings" data-bar-savings></span>
          </div>
          <button type="button" class="payday-btn payday-btn--checkout" data-checkout disabled>
            <span data-btn-label>Add to cart</span><span data-bar-total></span>
          </button>
        </div>
        <p class="payday-bar__ship" data-ship-line></p>
        <p class="payday-bar__error" data-error role="alert"></p>
      </div>
    </aside>

    <script type="application/json" data-payday-config>
      {
        "productId": {{ p.id }},
        "options": {{ p.options | json }},
        "freeShippingMin": {{ free_ship_cents | round }},
        "defaultTarget": {{ section.settings.tier_2_min }},
        "tiers": [
          { "min": {{ section.settings.tier_1_min }}, "pct": {{ section.settings.tier_1_pct }}, "badge": "" },
          { "min": {{ section.settings.tier_2_min }}, "pct": {{ section.settings.tier_2_pct }}, "badge": {{ section.settings.tier_2_badge | json }} },
          { "min": {{ section.settings.tier_3_min }}, "pct": {{ section.settings.tier_3_pct }}, "badge": {{ section.settings.tier_3_badge | json }} }
        ],
        "fallbackImage": {% if p.featured_image %}{{ p.featured_image | image_url: width: 1000 | json }}{% else %}null{% endif %},
        "media": [
          {%- assign media_count = 0 -%}
          {%- for m in p.media -%}
            {%- if m.media_type == 'image' and m.preview_image != blank -%}
              {%- if media_count > 0 -%},{%- endif -%}
              {%- assign media_count = media_count | plus: 1 -%}
              { "alt": {{ m.alt | json }}, "src": {{ m.preview_image | image_url: width: 1000 | json }} }
            {%- endif -%}
          {%- endfor -%}
        ],
        "variants": [
          {%- for v in p.variants -%}
            {
              "id": {{ v.id }},
              "options": {{ v.options | json }},
              "price": {{ v.price }},
              "available": {{ v.available }},
              "qty": {{ v.inventory_quantity | default: 0 }},
              "policy": {{ v.inventory_policy | json }},
              "managed": {{ v.inventory_management | json }},
              "image": {% if v.featured_image %}{{ v.featured_image | image_url: width: 1000 | json }}{% else %}null{% endif %}
            }{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        ]
      }
    </script>
  </payday-bundle>
  <script src="{{ 'payday-bundle.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{% schema %}
{
  "name": "Payday bundle builder",
  "tag": "div",
  "class": "section-payday-bundle",
  "settings": [
    { "type": "product", "id": "product", "label": "Eligible product (Wide-Leg Pants)" },
    { "type": "header", "content": "Hero" },
    { "type": "image_picker", "id": "hero_image", "label": "Banner image (desktop)", "info": "Wide lifestyle photo, at least 2400px wide. If empty, the product photo is used." },
    { "type": "image_picker", "id": "hero_image_mobile", "label": "Banner image (mobile)", "info": "Optional portrait photo, 4:5. Set a focal point so faces stay in frame." },
    { "type": "range", "id": "hero_height_mobile", "label": "Banner height on mobile", "info": "As a percentage of screen width. 100% is square.", "min": 60, "max": 125, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "hero_height_desktop", "label": "Banner height on desktop", "info": "As a percentage of screen width.", "min": 30, "max": 60, "step": 2, "unit": "%", "default": 44 },
    { "type": "range", "id": "overlay_opacity", "label": "Darken photo behind text", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 45 },
    { "type": "text", "id": "eyebrow", "label": "Campaign dates line", "default": "Payday Sale, limited time" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Up to 35% off Wide-Leg Pants" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Mix any colors and sizes. The more you add, the bigger your discount, applied automatically at checkout." },
    { "type": "header", "content": "Discount tiers" },
    { "type": "text", "id": "tiers_heading", "label": "Heading above the offers", "default": "Pick your bundle" },
    { "type": "paragraph", "content": "Preview only. These must match the three automatic Payday discounts in Shopify admin." },
    { "type": "number", "id": "tier_1_min", "label": "Tier 1 minimum pants", "default": 1 },
    { "type": "number", "id": "tier_1_pct", "label": "Tier 1 % off", "default": 15 },
    { "type": "number", "id": "tier_2_min", "label": "Tier 2 minimum pants", "default": 3 },
    { "type": "number", "id": "tier_2_pct", "label": "Tier 2 % off", "default": 25 },
    { "type": "text", "id": "tier_2_badge", "label": "Tier 2 badge", "default": "Most popular" },
    { "type": "number", "id": "tier_3_min", "label": "Tier 3 minimum pants", "default": 5 },
    { "type": "number", "id": "tier_3_pct", "label": "Tier 3 % off", "default": 35 },
    { "type": "text", "id": "tier_3_badge", "label": "Tier 3 badge", "default": "Best value" },
    { "type": "header", "content": "Fit and trust" },
    { "type": "richtext", "id": "fit_note", "label": "Size advice (shown above the size chart)", "default": "<p>Choose your usual size for a relaxed fit. Size up if you prefer extra room around the waist or tummy.</p>" },
    { "type": "image_picker", "id": "size_chart_image", "label": "Size chart image (fallback)", "info": "Used only if the product has no media with alt text LP | Size Chart." },
    { "type": "text", "id": "size_chart_note", "label": "Size chart note", "default": "Measurements may vary slightly due to fabric behavior and manual production." },
    { "type": "text", "id": "trust_1", "label": "Trust line 1" },
    { "type": "text", "id": "trust_2", "label": "Trust line 2" },
    { "type": "text", "id": "trust_3", "label": "Trust line 3" },
    { "type": "text", "id": "faq_heading", "label": "FAQ heading", "default": "FAQ" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "accent", "label": "Savings and progress color", "default": "#2F5D55" },
    { "type": "color", "id": "ink", "label": "Text and button color", "default": "#1F2421" }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ item",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Can I mix colors and sizes?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Yes. All pants in your bundle count toward your discount.</p>" }
      ]
    }
  ],
  "presets": [{ "name": "Payday bundle builder" }]
}
{% endschema %}
