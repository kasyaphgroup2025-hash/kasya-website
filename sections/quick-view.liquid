{%- if request.design_mode -%}
  {%- if request.page_type == 'product' -%}
    <link rel="stylesheet" href="{{ 'quick-view.css' | asset_url }}" media="print" onload="this.media='all'">
    <quick-view-modal-opener data-modal="#QuickView-Modal" class="visually-hidden">
      <button
        type="button"
        class="quick-view__submit button"
        aria-haspopup="dialog"
        data-product-url="{{ product.url }}"
        aria-label="{{ product.title | escape }}"
      >
        {%- render 'icon-eye' -%}
        <div class="loading-overlay__spinner hidden">
          <svg aria-hidden="true" focusable="false" role="presentation" class="spinner" viewBox="0 0 66 66" xmlns="http://www.w3.org/2000/svg">
            <circle class="path" fill="none" stroke-width="6" cx="33" cy="33" r="30"></circle>
          </svg>
        </div>
      </button>
    </quick-view-modal-opener>
  {%- endif -%}
<quick-view-modal id="QuickView-Modal" class="popup-modal quick-view-modal">
  <div role="dialog" aria-modal="true" aria-label="{{ 'products.product.quick_view' | t | escape }}" class="popup-modal__content quick-view-modal__content{% unless section.settings.inherit_color_scheme %} color-{{ section.settings.color_scheme }}{% endunless %}" tabindex="-1">
    <button id="ModalClose-QuickView" type="button" class="popup-modal__toggle quick-view-modal__toggle" aria-label="{{ 'accessibility.close' | t }}">{% render 'icon-close' %}</button>
    <div id="QuickViewInfo-QuickView" class="quick-view-modal__content-info popup-modal__content-info flex">
    {%- endif -%}
      <product-info
        id="ProductQuickView-{{ section.id }}"
        class="product-section section-{{ section.id }}-padding w100 h100 db{% if section.settings.use_background_input %} background-input{% endif %}{% if section.settings.use_background_input %} has-background-input{% endif %} db"
        data-section="{{ section.id }}"
        data-url="{{ product.url }}"
        data-update-url="false"
        {% if settings.recently_viewed_enable %}
          data-product-id="{{ product.id }}"
          data-product-url="{{ product.url }}"
          data-product-image="{{ product.featured_media | image_url: width: 100 }}"
        {% endif %}
        data-option-size="{{ product.options.size }}"
        >
        {%- liquid
          unless product.selected_variant
            if section.settings.default_image == 'product_featured_image'
              assign featured_media = product.featured_media  
            else
              if product.selected_or_first_available_variant.featured_media != null
                assign featured_media = product.selected_or_first_available_variant.featured_media
              else
                assign featured_media = product.featured_media  
              endif
            endif  
          else
            if product.selected_variant.featured_media != null
              assign featured_media = product.selected_variant.featured_media
            else
              assign featured_media = product.featured_media  
            endif
          endunless

          assign variant_images = product.images | where: 'attached_to_variant?', true | map: 'src'
          assign media_count = product.media.size
          if section.settings.hide_variants and media_count > 1 and variant_images.size > 0
            assign media_count = media_count | minus: variant_images.size | plus: 1
          endif

          assign media_width = 0.45

          assign is_vertical = false
          if section.settings.gallery_layout == 'thumbnail_slider_vertical' and media_count > 1
            assign is_vertical = true
          endif

          assign threshold_media_desktop = 4

          assign has_countdown = false

          assign only_use_variant_price = false
          assign price_block = section.blocks | where: "type", "price" | first
          if price_block
            assign only_use_variant_price = price_block.settings.variant_price
          endif
          assign cart_qty = cart | item_count_for_variant: product.selected_or_first_available_variant.id
        -%}

        <style>
          #MediaGallery-{{ section.id }}{
            --object-fit:{%- if section.settings.image_fit -%}cover{%- else -%}contain{%- endif -%};
          }  
        </style>

        {%- if product.quantity_price_breaks_configured? -%}
          <script src="{{ 'show-more.js' | asset_url }}" defer="defer"></script>
          <script src="{{ 'price-per-item.js' | asset_url }}" defer="defer"></script>
        {%- endif -%}
        {%- if request.design_mode -%}
          <script src="{{ 'countdown.js' | asset_url }}" defer="defer"></script>
        {%- endif -%}    

        {%- if customer.b2b? -%}
          {{ 'component-volume-pricing.css' | asset_url | stylesheet_tag }}
        {%- endif -%}

        {%- assign first_xr_model = product.media | where: "media_type", "model" | first -%}
        {%- if first_xr_model -%}
          {{ 'component-product-model.css' | asset_url | stylesheet_tag }}
          <link id="ModelViewerStyle-{{ section.id }}" rel="stylesheet" href="https://cdn.shopify.com/shopifycloud/model-viewer-ui/assets/v1.0/model-viewer-ui.css" media="print" onload="this.media='all'">
          <link id="ModelViewerOverride-{{ section.id }}" rel="stylesheet" href="{{ 'component-model-viewer-ui.css' | asset_url }}" media="print" onload="this.media='all'">
        {%- endif -%}
        
        <div class="product product--small product--media-{{ section.settings.media_position }} {% unless is_vertical %}product--{{ section.settings.gallery_layout }}{% else %}product--thumbnail_slider{% endunless %} grid grid--1-col grid--gapless {% if product.media.size > 0 %}grid--2-col-tablet{% else %}product--no-media{% endif %} w100">
          <div class="grid__item product__media-wrapper{% if section.settings.enable_sticky_info %} product__sticky{% endif %}">
            {%- render 'product-media-gallery', section: section, product: product, featured_media: featured_media, variant_images: variant_images, media_count: media_count, media_width: media_width, is_vertical: is_vertical, threshold_media_desktop: threshold_media_desktop -%}
          </div>
          <div class="product__info-wrapper product__info-wrapper-media-{{ section.settings.media_position }} grid__item por" style="--gap-desktop:{{ section.settings.gap_desktop }}px;--gap-mobile:{{ section.settings.gap_mobile }}px;">
            <div
              id="ProductInfo-{{ section.id }}"
              class="product__info-container accordion-wrapper--dividers"
            >
              {%- assign product_form_id = 'product-form-' | append: section.id -%}
              {%- for block in section.blocks -%}
                {%- case block.type -%}
                {%- when '@app' -%}
                  {%- render block -%}
                {%- when 'text' -%}
                  <p class="product__text
                    {% if block.settings.text_style == 'uppercase' %} caption-with-letter-spacing caption-with-letter-spacing--large uppercase{% elsif block.settings.text_style == 'subtitle' %} subtitle subtitle--medium{% endif %}
                    {% if block.settings.icon != 'none' %} product__text--with-icon flex align-center{% endif %}
                    {% if block.settings.color != 'color-foreground' %} color-foreground{% endif %}
                    break"
                    {% if block.settings.color != 'color-foreground' %}style="--color-foreground:{% if block.settings.color != 'custom' %}var(--color-button){% else %}{{ block.settings.custom_color.rgb | replace: ' ', ',' }}{% endif %};"{% endif %}
                    {{ block.shopify_attributes }}>
                    {%- render 'icon-picker', icon: block.settings.icon, icon_width: 16 -%}
                    <span>{{- block.settings.text -}}</span>
                  </p>
                {%- when 'title' -%}
                  <div class="product__title" {{ block.shopify_attributes }}>
                    {%- if block.settings.show_vendor_link and product.vendor -%}
                      <a href="{{ product.vendor | url_for_vendor }}" class="link color-foreground db w100 product__vendor-link font-body-semi-bold break">{{ 'products.product.by_vendor_html' | t: vendor: product.vendor }}</a>  
                    {%- endif -%}
                    <a href="{{ product.url }}" class="{{ block.settings.title_size }} font-heading-extra-bold margin0">{{ product.title | escape }}</a>
                  </div>
                {%- when 'price' -%}
                  <div {{ block.shopify_attributes }}>
                    <div id="price-top-{{ section.id }}" {{ block.shopify_attributes }}>
                      {%- unless product.price_varies and only_use_variant_price == false -%}
                        <div class="no-js-hidden" id="price-{{ section.id }}" role="status">
                          {%-liquid
                            unless product.quantity_price_breaks_configured?
                              render 'price', product: product, use_variant: true, show_badges: true, price_class: 'price--large flex align-center', show_in_card: false
                            else
                              render 'main-product-price-per-item', product: product, section: section, price_classes: 'price price--large'  
                            endunless
                          -%}
                        </div>
                      {%- else -%}
                        {%- render 'price-varies', target: product -%}  
                      {%- endunless -%}
                    </div>
                    {%- render 'main-product-volume-pricing-note', product: product, section_id: section.id, on_background_input: section.settings.use_background_input -%}
                    {%-liquid
                      assign show_taxes_text = false
                      if settings.show_taxes_notice and cart.taxes_included
                        assign show_taxes_text = true
                      endif
                      assign show_shipping_policy_notice = false
                      if settings.show_shipping_policy_notice and shop.shipping_policy.body != blank
                        assign show_shipping_policy_notice = true
                      endif
                    -%}
                    {%- if show_taxes_text or show_shipping_policy_notice -%}
                      <div class="product__tax caption rte margin-top-1rem">
                        {%- if show_taxes_text -%}
                          {{ 'products.product.include_taxes' | t }}
                        {%- endif -%}
                        {%- if show_shipping_policy_notice -%}
                          {{ 'products.product.shipping_policy_html' | t: link: shop.shipping_policy.url }}
                        {%- endif -%}
                      </div>
                    {%- endif -%}
                    {%- if product != blank -%}
                      <div class="margin-top-1rem">
                        {%- assign product_form_installment_id = 'product-form-installment-' | append: section.id -%}
                        {%- form 'product', product, id: product_form_installment_id, class: 'installment text-small' -%}
                          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                          {{ form | payment_terms }}
                        {%- endform -%}
                      </div>
                    {%- endif -%}
                  </div>
                {%- when 'description' -%}
                  {%- if product.description != blank -%}
                    <div class="product__description rte">
                      {{ product.description }}
                    </div>
                  {%- endif -%}
                {%- when 'custom_liquid' -%}
                  {{ block.settings.custom_liquid }}
                {%- when 'collapsible_tab' -%}
                  {%- if request.design_mode or block.settings.content != blank or block.settings.page.content != blank -%}
                    <details-accordion class="product__accordion accordion db" {{ block.shopify_attributes }}>
                      <details id="Details-{{ block.id }}-{{ section.id }}"
                        {% if block.settings.expand %}
                          open
                        {% endif %}
                      >
                        <summary class="summary-accordion summary-accordion--has-hover flex justify-space-between align-center por"
                          {% if block.settings.expand %}
                            aria-expaned="true"
                          {% endif %}
                        >
                          <div class="summary__title flex align-center flex-grow-1">
                            {% render 'icon-accordion', icon: block.settings.icon %}
                            <h2 class="h4 accordion__title">
                              {{ block.settings.heading | default: block.settings.page.title }}
                            </h2>
                          </div>
                          <div class="summary-accordion__plus-minus-wrapper flex justify-center align-center">
                            <span class="summary-accordion__plus-minus por flex justify-center align-center">
                              <span class="summary-accordion__icon-line"></span>
                              <span class="summary-accordion__icon-line"></span>
                            </span>
                          </div>
                        </summary>
                        <div class="accordion__content{% if block.settings.icon == 'none' %} accordion__content--no-icon{% endif %}{% if block.settings.content == blank and block.settings.page.content == blank %} accordion__content--empty{% endif %}" id="ProductAccordion-{{ block.id }}-{{ section.id }}">
                          <div class="rte">
                            {{ block.settings.content }}
                            {{ block.settings.page.content }}
                          </div>
                        </div>
                      </details>
                    </details-accordion>
                  {%- endif -%}
                {%- when 'share' -%}
                  {%- assign share_url = product.selected_variant.url | default: product.url | prepend: request.origin -%}
                  {%- render 'main-product-share', share_url: share_url, title: product.title, block: block, featured_media: featured_media -%}
                {%- when 'sale_box' -%}
                  <div class="product__sale-box product__info-box flex flex-column{% if block.settings.picker_type == 'button' %} overflow-hidden{% endif %}" {{ block.shopify_attributes }}>
                    {%- render 'main-product-variant-picker', product: product, block: block, product_form_id: product_form_id, picker_type: block.settings.picker_type, enable_color_swatches: block.settings.enable_color_swatches, color_swatches_style: block.settings.color_swatches_style -%}
                    {%- if product.price_varies and only_use_variant_price == false -%}
                      <div class="no-js-hidden" id="price-{{ section.id }}" role="status">
                        {%-liquid
                          unless product.quantity_price_breaks_configured?
                            render 'price', product: product, use_variant: true, show_badges: true, price_class: 'price--large flex align-center', show_in_card: false
                          else
                            render 'main-product-price-per-item', product: product, section: section, price_classes: 'price price--large'  
                          endunless  
                        -%}
                      </div>
                    {%- endif -%}
                    {%-liquid
                      if block.settings.show_free_shipping_bar and settings.free_shipping_enable
                        assign should_show_free_shipping_bar = true
                        if settings.free_shipping_exclude_products != blank and settings.free_shipping_exclude_products.count > 0
                          assign exclude_product_ids = settings.free_shipping_exclude_products | map: 'id'
                          if exclude_product_ids contains product.id
                            assign should_show_free_shipping_bar = false
                          endif
                        endif
                        if should_show_free_shipping_bar
                          render 'free-shipping-bar', wrapper_classes: 'product__free-shipping-bar'
                        endif
                      endif

                      assign check_against_inventory = true
                      assign quantity_rule_soldout = false
                      if product.selected_or_first_available_variant.inventory_management != 'shopify' or product.selected_or_first_available_variant.inventory_policy == 'continue'
                        assign check_against_inventory = false
                      endif
                      if product.selected_or_first_available_variant.quantity_rule.min > product.selected_or_first_available_variant.inventory_quantity and check_against_inventory
                        assign quantity_rule_soldout = true
                      endif

                      assign has_qty_rules = false
                      if product.selected_or_first_available_variant.quantity_rule.increment > 1 or product.selected_or_first_available_variant.quantity_rule.min > 1 or product.selected_or_first_available_variant.quantity_rule.max != null
                        assign has_qty_rules = true
                      endif
    
                      assign has_vol_pricing = false
                      if product.selected_or_first_available_variant.quantity_price_breaks.size > 0
                        assign has_vol_pricing = true
                      endif
                    -%}
                    <div class="product__sale-box__actions">
                      <product-form class="product-form">
                        <div class="product-form__error-message-wrapper alert alert--error alert--no-button" role="alert" hidden>
                          <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-error" viewBox="0 0 13 13">
                            <circle cx="6.5" cy="6.50049" r="5.5" stroke="white" stroke-width="2"/>
                            <circle cx="6.5" cy="6.5" r="5.5" fill="currentColor" stroke="currentColor" stroke-width="0.7"/>
                            <path d="M5.87413 3.52832L5.97439 7.57216H7.02713L7.12739 3.52832H5.87413ZM6.50076 9.66091C6.88091 9.66091 7.18169 9.37267 7.18169 9.00504C7.18169 8.63742 6.88091 8.34917 6.50076 8.34917C6.12061 8.34917 5.81982 8.63742 5.81982 9.00504C5.81982 9.37267 6.12061 9.66091 6.50076 9.66091Z" fill="white"/>
                            <path d="M5.87413 3.17832H5.51535L5.52424 3.537L5.6245 7.58083L5.63296 7.92216H5.97439H7.02713H7.36856L7.37702 7.58083L7.47728 3.537L7.48617 3.17832H7.12739H5.87413ZM6.50076 10.0109C7.06121 10.0109 7.5317 9.57872 7.5317 9.00504C7.5317 8.43137 7.06121 7.99918 6.50076 7.99918C5.94031 7.99918 5.46982 8.43137 5.46982 9.00504C5.46982 9.57872 5.94031 10.0109 6.50076 10.0109Z" fill="white" stroke="#EB001B" stroke-width="0.7">
                          </svg>
                          <span class="product-form__error-message"></span>
                        </div>
        
                        {%- form 'product', product, id: product_form_id, class: 'form', novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
                          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}"{% if product.selected_or_first_available_variant.available == false or quantity_rule_soldout %} disabled{% endif %} class="product-variant-id">
                          <div class="product-form__buttons product-form__buttons--input product-form__quantity-wrapper{% if has_qty_rules or has_vol_pricing %} product-form__wholesale{% endif %}{% unless block.settings.quantity_selector_enable %} product-form__buttons--no-quantity{% endunless %} {% if block.settings.show_dynamic_checkout and product.selling_plan_groups == empty %}product-form__buttons-group{% else %}product-form__buttons-single{% endif %}" id="Quantity-Form-{{ section.id }}">
                            {%- render 'main-product-quantity-selector', product: product, block: block, section: section, cart_qty: cart_qty -%}
                            <button
                              type="submit"
                              name="add"
                              class="product-form__submit button flex w100 cart-submit-button"
                              {% if product.selected_or_first_available_variant.available == false or quantity_rule_soldout %}disabled{% endif %}
                              {% if product.selected_or_first_available_variant.inventory_management == 'shopify' and product.selected_or_first_available_variant.inventory_quantity < product.selected_or_first_available_variant.quantity_rule.min and product.selected_or_first_available_variant.inventory_policy == 'continue' and settings.enable_pre_order_text %}data-pre-order="true"{% endif %}
                            >
                              <span>
                                {%- if product.selected_or_first_available_variant.available and quantity_rule_soldout == false -%}
                                  {%- unless product.selected_or_first_available_variant.inventory_management == 'shopify' and product.selected_or_first_available_variant.inventory_quantity < product.selected_or_first_available_variant.quantity_rule.min and product.selected_or_first_available_variant.inventory_policy == 'continue' and settings.enable_pre_order_text -%}
                                    {{ 'products.product.add_to_cart' | t }}
                                  {%- else -%}
                                    {{ 'products.product.pre_order' | t }}
                                  {%- endunless -%}  
                                {%- else -%}
                                  {{ 'products.product.sold_out' | t }}
                                {%- endif -%}
                              </span>
                              <div class="loading-overlay__spinner hidden">
                                {%- render 'icon-cart-loading' -%}
                              </div>
                            </button>
                            {%- if block.settings.show_dynamic_checkout -%}
                              {{ form | payment_button }}
                            {%- endif -%}
                            {%- render 'main-product-quantity-rules', product: product, section_id: section.id -%}
                            {%- render 'main-product-volume-pricing', product: product, section: section -%}
                          </div>
                        {%- endform -%}
                      </product-form>  
                    </div>
                    {%-liquid
                      if block.settings.enable_compare and settings.enable_product_compare
                        assign enable_compare = true
                      else
                        assign enable_compare = false
                      endif
                    -%}
                    {%- if enable_compare -%}
                      <div class="product__sale-box__footer por flex">
                        {%- render 'product-compare-button-main', product: product -%}
                      </div>
                    {%- endif -%}  
                  </div>
                {%- when 'rating' -%}
                  {%- render 'main-product-rating', product: product, block: block, allow_anchor: false -%}
                {%- when 'countdown' -%}
                  {%- if block.settings.fallback_datetime != blank or block.settings.metafields != blank -%}
                    {%- liquid
                      assign is_countdown_list = false
                      assign final_countdown_value = block.settings.fallback_datetime
                      if block.settings.metafields != blank
                        assign countdown_metafield_namespace_key = block.settings.metafields | split: '.'
                        assign countdown_individual_value = product.metafields[countdown_metafield_namespace_key[0]][countdown_metafield_namespace_key[1]]
                        if countdown_individual_value != blank and countdown_individual_value.type contains 'date'
                          if countdown_individual_value.type contains 'list.'
                            assign is_countdown_list = true
                            assign final_countdown_value = countdown_individual_value.value
                          else
                            assign final_countdown_value = countdown_individual_value.value | date: '%Y-%m-%d %H:%M:%S%z'
                          endif
                        endif  
                      endif  
                    -%}
                    {%- if final_countdown_value != blank -%}
                      {%-liquid
                        assign has_countdown = true
                        unless is_countdown_list
                          assign date_parts = final_countdown_value | split: ':' 
                        endunless
                      -%}
                      <count-down {% if is_countdown_list %}data-list="{% for value in final_countdown_value %}{{ value | date: '%Y-%m-%d %H:%M:%S%z' }}{% unless forloop.last %},{% endunless %}{% endfor %}"{% else %}data-endtime="{{ final_countdown_value }}"{% if date_parts.size == 2 %} data-reverse-time="{{ 'now' | date: '%Y-%m-%d' }} {{ final_countdown_value }}:00{{ 'now' | date: '%z' }}" data-now-time="{{ 'now' | date: '%Y-%m-%d %H:%M:%S%z' }}"{% endif %}{% endif %}
                        data-timezone="{{ 'now' | date: '%z' }}"
                        data-expired-msg="{{ block.settings.expiration_message | escape }}"
                        class="product__info-box flex product__countdown countdown-simple"
                        data-has-own-tpl="true"
                        {% if block.settings.hide_after_expiry %}data-hide-after-expiry="true"{% endif %}
                        {{ block.shopify_attributes }}
                      >
                        <div class="countdown-simple__inner flex align-center flex-wrap">
                          {%- if block.settings.title != blank -%}
                            <span class="h5 font-heading-extra-bold">{{ block.settings.title }}</span>
                          {%- endif -%}
                          {%- render 'countdown-tpl-simple' -%}
                        </div>
                      </count-down>
                    {%- endif -%} 
                  {%- elsif request.design_mode -%}
                    <div class="product__info-box flex product__countdown countdown-simple" {{ block.shopify_attributes }}>
                      <div class="countdown-simple__inner flex align-center flex-wrap">
                        {%- if block.settings.title != blank -%}
                          <span class="h5 font-heading-extra-bold">{{ block.settings.title }}</span>
                        {%- endif -%}
                        {%- render 'countdown-tpl-simple', use_design_mode: true -%}
                      </div>
                    </div>   
                  {%- endif -%}
                {%- when 'information_group' -%}
                  {%- render 'main-product-information-group', section: section, block: block, product: product -%}
                {%- when 'trusted_payment_badge' -%}
                  {%- render 'main-product-trusted-payment-badge', section: section, block: block, product: product -%}
                {%- when 'separated_line' -%}
                  <hr {{ block.shopify_attributes }}>
                {%- when 'text_in_multi_line' -%}
                  <div class="rte product__rte
                    {% if block.settings.show_in_a_box %} product__info-box product__sale-box{% endif %}
                    {% if block.settings.color != 'color-foreground' %} color-foreground rewrite-color-link{% endif %}
                  "
                    {{ block.shopify_attributes }}
                    {% if block.settings.color != 'color-foreground' %}style="--color-foreground:{% if block.settings.color != 'custom' %}var(--color-button){% else %}{{ block.settings.custom_color.rgb | replace: ' ', ',' }}{% endif %};"{% endif %}
                  >
                    {{ block.settings.text }}
                  </div>
                {%- when 'icons_with_text' -%}
                  {%- render 'main-product-text-icons', block: block -%}
                {%- when 'custom_image' -%}
                  {%- render 'main-product-image-block', block: block -%}
                {%- endcase -%}
              {%- endfor -%}
            </div>
          </div>
        </div>

        {%- if product.media.size > 0 -%}
          <script src="{{ 'product-modal.js' | asset_url }}" defer="defer"></script>
          <script src="{{ 'media-gallery.js' | asset_url }}" defer="defer"></script>
          {%- unless section.settings.disable_images_lightbox -%}
            <link rel="stylesheet" href="{{ 'photoswipe.css' | asset_url }}" media="print" onload="this.media='all'">
          {%- endunless -%}
        {%- endif -%}
        {%- if first_xr_model -%}
          <script type="application/json" id="ProductJSON-{{ product.id }}">
            {{ product.media | where: 'media_type', 'model' | json }}
          </script>
          <script src="{{ 'product-model.js' | asset_url }}" defer></script>
        {%- endif -%}
        {%- if has_countdown or request.design_mode -%}
            <script src="{{ 'countdown.js' | asset_url }}" defer="defer"></script>
            {{ 'component-countdown.css' | asset_url | stylesheet_tag }}
        {%- endif -%}  

        {%- assign collapsible_tabs = section.blocks | where: "type", "collapsible_tab" -%}
        {%- if collapsible_tabs.size > 0 -%}
          <script src="{{ 'details-accordion.js' | asset_url }}" defer="defer"></script>
        {%- endif -%}
      </product-info>
      <script src="{{ 'product-info.js' | asset_url }}" defer="defer"></script>
      {%- if request.design_mode -%}
    </div>
  </div>
</quick-view-modal>
{%- endif -%}

