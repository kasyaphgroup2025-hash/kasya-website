{% comment %}
  KasyaPH Product Landing Lifestyle
  Where-to-wear-it section for real-life use cases.
{% endcomment %}

<section class="kasya-lp-lifestyle">
  <div class="kasya-lp-lifestyle__inner">
    <div class="kasya-lp-lifestyle__header">
      {% if section.settings.heading != blank %}
        <h2 class="kasya-lp-lifestyle__heading">
          {{ section.settings.heading }}
        </h2>
      {% endif %}

      {% if section.settings.subheading != blank %}
        <p class="kasya-lp-lifestyle__subheading">
          {{ section.settings.subheading }}
        </p>
      {% endif %}
    </div>

    {% if section.blocks.size > 0 %}
      <div class="kasya-lp-lifestyle__grid">
        {% for block in section.blocks %}
          {% liquid
            assign lifestyle_image = block.settings.image
            assign image_alt = block.settings.title | default: section.settings.heading
          %}

          <article class="kasya-lp-lifestyle__card" {{ block.shopify_attributes }}>
            <div class="kasya-lp-lifestyle__image-wrap">
              {% if lifestyle_image != blank %}
                {{
                  lifestyle_image
                  | image_url: width: 900
                  | image_tag:
                    class: 'kasya-lp-lifestyle__image',
                    loading: 'lazy',
                    widths: '360, 540, 720, 900',
                    sizes: '(min-width: 680px) 360px, calc(100vw - 32px)',
                    alt: image_alt
                }}
              {% else %}
                <div class="kasya-lp-lifestyle__placeholder" aria-hidden="true">
                  <span>Upload lifestyle image</span>
                </div>
              {% endif %}
            </div>

            <div class="kasya-lp-lifestyle__copy">
              {% if block.settings.title != blank %}
                <h3 class="kasya-lp-lifestyle__title">
                  {{ block.settings.title }}
                </h3>
              {% endif %}

              {% if block.settings.description != blank %}
                <p class="kasya-lp-lifestyle__description">
                  {{ block.settings.description }}
                </p>
              {% endif %}
            </div>
          </article>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</section>

<style>
  .kasya-lp-lifestyle {
    background: #ffffff;
    color: #111111;
    font-family: inherit;
    max-width: 760px;
    margin: 0 auto;
  }

  .kasya-lp-lifestyle * {
    box-sizing: border-box;
  }

  .kasya-lp-lifestyle__inner {
    padding: 22px 16px 120px;
  }

  .kasya-lp-lifestyle__header {
    margin-bottom: 14px;
  }

  .kasya-lp-lifestyle__heading {
    margin: 0;
    font-size: 22px;
    font-weight: 850;
    letter-spacing: 0.06em;
    line-height: 1.08;
    text-transform: uppercase;
  }

  .kasya-lp-lifestyle__subheading {
    margin: 8px 0 0;
    color: #444444;
    font-size: 14px;
    line-height: 1.45;
  }

  .kasya-lp-lifestyle__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 14px;
  }

  .kasya-lp-lifestyle__card {
    min-width: 0;
    overflow: hidden;
    border: 1px solid #eeeeee;
    border-radius: 8px;
    background: #ffffff;
  }

  .kasya-lp-lifestyle__image-wrap {
    width: 100%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: #f3f3f3;
  }

  .kasya-lp-lifestyle__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .kasya-lp-lifestyle__placeholder {
    width: 100%;
    height: 100%;
    min-height: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 18px;
    background: #f4f4f4;
    color: #777777;
    text-align: center;
  }

  .kasya-lp-lifestyle__placeholder span {
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.1em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .kasya-lp-lifestyle__copy {
    padding: 11px 13px 13px;
  }

  .kasya-lp-lifestyle__title {
    margin: 0;
    font-size: 15px;
    font-weight: 850;
    line-height: 1.18;
  }

  .kasya-lp-lifestyle__description {
    margin: 5px 0 0;
    color: #555555;
    font-size: 12px;
    line-height: 1.36;
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  @media screen and (min-width: 680px) {
    .kasya-lp-lifestyle__inner {
      padding: 28px 26px 80px;
    }

    .kasya-lp-lifestyle__heading {
      font-size: 26px;
    }

    .kasya-lp-lifestyle__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 18px 14px;
    }

    .kasya-lp-lifestyle__image-wrap {
      aspect-ratio: 4 / 3;
    }

    .kasya-lp-lifestyle__copy {
      padding: 13px 14px 15px;
    }

    .kasya-lp-lifestyle__title {
      font-size: 16px;
    }

    .kasya-lp-lifestyle__description {
      font-size: 13px;
    }
  }
</style>

{% schema %}
{
  "name": "Kasya LP Lifestyle",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "WHERE TO WEAR IT"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Everyday moments made easier, softer, and more put-together."
    }
  ],
  "blocks": [
    {
      "type": "lifestyle_card",
      "name": "Lifestyle Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Office Day"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Short description",
          "default": "Polished enough for work, relaxed enough for long hours."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Kasya LP Lifestyle",
      "blocks": [
        {
          "type": "lifestyle_card",
          "settings": {
            "title": "Office Day",
            "description": "Polished enough for work, relaxed enough for long hours."
          }
        },
        {
          "type": "lifestyle_card",
          "settings": {
            "title": "Errands",
            "description": "Easy to move in while still looking put-together."
          }
        },
        {
          "type": "lifestyle_card",
          "settings": {
            "title": "Family Lunch",
            "description": "Comfortable, modest, and effortless to style."
          }
        },
        {
          "type": "lifestyle_card",
          "settings": {
            "title": "Travel",
            "description": "Relaxed fit that moves with you through a long day."
          }
        }
      ]
    }
  ]
}
{% endschema %}
