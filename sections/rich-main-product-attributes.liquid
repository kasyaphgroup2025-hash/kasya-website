<style>
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  {%- render 'section-heading-styles' -%}
</style>
{{ 'section-main-product-attributes.css' | asset_url | stylesheet_tag }}
<div class="{% unless section.settings.enable_section_box_layout %}color-{{ section.settings.color_scheme }} gradient isolate{% else %}section-{{ section.id }}-padding page-width{% endunless %}">
  <div class="{% unless section.settings.enable_section_box_layout %}section-{{ section.id }}-padding page-width{% else %}color-{{ section.settings.color_scheme }} gradient isolate section__box{% endunless %}">
    {%- render 'section-heading' -%}
    <div class="product-attributes break">
      {%- if section.settings.show_description and product.description != blank -%}
				<div class="product__description rte quick-add-hidden">
					{{ product.description }}
				</div>
			{%- endif -%}
      <product-attributes-table class="product-attributes__table grid grid--1-col grid--2-col-tablet grid--3-col-desktop{% if section.settings.show_description and product.description != blank %} element-margin-top{% endif %}{% if section.settings.table_color_scheme != section.settings.color_scheme %} color-{{ section.settings.table_color_scheme }} gradient product-attributes__table--padding{% endif %}" data-section="{{ section.id }}" data-url="{{ product.url }}">
        {% content_for 'blocks' %}
      </product-attributes-table>
    </div>
  </div>
</div>
<script src="{{ 'component-product-attributes-table.js' | asset_url }}" defer="defer"></script>
{% schema %}
{
  "name": "t:names.rich_product_attributes",
  "tag": "section",
  "class": "section product-attributes-section",
  "blocks": [
    {
      "type": "_product-attribute-standard"
    },
    {
      "type": "_product-attribute-specifications-group"
    }
  ],
  "settings": [
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "t:settings.show_description",
      "default": false
    },
    {
      "type": "text",
      "id": "title",
      "default": "Product information",
      "label": "t:settings.heading"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "t:settings.subheading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h0",
          "label": "t:sections.all.heading_size.options__3.label"
        }
      ],
      "default": "h1",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "checkbox",
      "id": "enable_section_box_layout",
      "label": "t:sections.all.enable_section_box_layout.label",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "inverse",
      "label": "t:sections.all.colors.label"
    },
    {
      "type": "color_scheme",
      "id": "table_color_scheme",
      "default": "background-1",
      "label": "t:settings.content_color_scheme"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "t:names.rich_product_attributes",
      "category": "t:categories.product",
      "blocks": {
        "standard_sku": {
          "type": "_product-attribute-standard",
          "settings": {
            "title": "SKU",
            "attribute": "sku"
          }
        },
        "standard_brand": {
          "type": "_product-attribute-standard",
          "settings": {
            "title": "Brand",
            "attribute": "product_brand"
          }
        },
        "standard_type": {
          "type": "_product-attribute-standard",
          "settings": {
            "title": "Product type",
            "attribute": "product_type"
          }
        },
        "standard_weight": {
          "type": "_product-attribute-standard",
          "settings": {
            "title": "Weight",
            "attribute": "weight"
          }
        },
        "specs_group_1": {
          "type": "_product-attribute-specifications-group",
          "blocks": {
            "spec_1": {
              "type": "_product-attribute-specification"
            }
          },
          "block_order": ["spec_1"]
        }
      },
      "block_order": ["standard_sku", "standard_brand", "standard_type", "standard_weight", "specs_group_1"]
    }
  ],
  "enabled_on": {
    "templates": ["product"]
  }
}
{% endschema %}