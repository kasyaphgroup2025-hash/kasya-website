{{ 'homepage-custom.css' | asset_url | stylesheet_tag }}

<section class="home-editorial home-hero-photo" aria-label="{{ section.settings.heading | escape }}">
  <div class="home-hero-photo__media">
    {%- if section.settings.mobile_image != blank or section.settings.desktop_image != blank -%}
      {%- assign mobile_image = section.settings.mobile_image | default: section.settings.desktop_image -%}
      {%- assign desktop_image = section.settings.desktop_image | default: section.settings.mobile_image -%}
      <picture class="home-media">
        {%- if desktop_image != blank -%}
          <source media="(min-width: 750px)" srcset="{{ desktop_image | image_url: width: 2400 }}">
        {%- endif -%}
        {{ mobile_image | image_url: width: 1200 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '375, 550, 750, 900, 1100, 1400', alt: section.settings.image_alt }}
      </picture>
    {%- else -%}
      <div class="home-media home-media--empty"></div>
    {%- endif -%}
  </div>

  <div class="home-hero-photo__content">
    <div class="home-hero-photo__text">
      {%- if section.settings.kicker != blank -%}
        <p class="home-editorial__kicker">{{ section.settings.kicker | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h1 class="home-editorial__heading home-editorial__heading--display">{{ section.settings.heading | escape }}</h1>
      {%- endif -%}
      {%- if section.settings.copy != blank -%}
        <div class="home-editorial__copy home-hero-photo__copy">{{ section.settings.copy }}</div>
      {%- endif -%}
      {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
        <a class="home-editorial__button" href="{{ section.settings.button_link }}">{{ section.settings.button_label | escape }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Home hero photo",
  "tag": "section",
  "class": "section-home-hero-photo",
  "settings": [
    { "type": "image_picker", "id": "mobile_image", "label": "Mobile image" },
    { "type": "image_picker", "id": "desktop_image", "label": "Desktop image" },
    { "type": "text", "id": "image_alt", "label": "Image alt text", "default": "Kasya editorial campaign" },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "New campaign" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Everyday Edit" },
    { "type": "richtext", "id": "copy", "label": "Copy", "default": "<p>Soft silhouettes, confident layers, and pieces made for your daily rhythm.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop now" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [
    { "name": "Home hero photo" }
  ]
}
{% endschema %}
