{{ 'homepage-custom.css' | asset_url | stylesheet_tag }}

<style>
  body.home-hero-header-enabled .section-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 60;
    transform: translateY(0);
    transition: transform 240ms ease, background-color 240ms ease;
  }

  body.home-hero-header-enabled .section-header .header-wrapper,
  body.home-hero-header-enabled .section-header .header {
    background: transparent !important;
    box-shadow: none;
    transition: background-color 240ms ease, box-shadow 240ms ease;
  }

  body.home-hero-header-enabled .section-header .header {
    position: relative !important;
    inset: auto !important;
    top: 0 !important;
    width: 100%;
  }

  body.home-hero-header-enabled.home-hero-header-solid .section-header .header-wrapper,
  body.home-hero-header-enabled.home-hero-header-solid .section-header .header {
    background: rgba(0, 0, 0, 0.94) !important;
  }

  body.home-hero-header-enabled.home-hero-header-solid .section-header {
    box-shadow: 0 0.8rem 2.4rem rgba(0, 0, 0, 0.28);
  }

  body.home-hero-header-enabled.home-hero-header-hidden .section-header {
    transform: translateY(-110%);
  }

  body.home-hero-header-enabled .section-header .header__inner {
    min-height: 7.2rem;
  }

  body.home-hero-header-enabled .section-header .header__icon,
  body.home-hero-header-enabled .section-header .header__heading-link,
  body.home-hero-header-enabled .section-header .header__menu-item,
  body.home-hero-header-enabled .section-header .cart-count-bubble {
    --color-foreground: 255, 255, 255;
    --color-link: 255, 255, 255;
    color: #ffffff !important;
  }

  body.home-hero-header-enabled .section-header svg,
  body.home-hero-header-enabled .section-header svg path,
  body.home-hero-header-enabled .section-header svg circle,
  body.home-hero-header-enabled .section-header svg line,
  body.home-hero-header-enabled .section-header svg polyline {
    color: #ffffff;
    stroke: currentColor;
  }

  body.home-hero-header-enabled .section-header .header__heading-logo {
    filter: brightness(0) invert(1);
  }

  @media screen and (max-width: 749px) {
    body.home-hero-header-enabled .section-header .header {
      display: grid !important;
      grid-template-columns: minmax(4.4rem, 1fr) auto minmax(4.4rem, 1fr) !important;
      align-items: center;
      column-gap: 0;
    }

    body.home-hero-header-enabled .section-header .header__heading,
    body.home-hero-header-enabled .section-header .header__heading-link {
      grid-column: 2;
      justify-self: center;
      margin: 0;
    }

    body.home-hero-header-enabled .section-header .header__heading {
      position: absolute;
      left: 50%;
      transform: translateX(-50%);
      z-index: 1;
    }

    body.home-hero-header-enabled .section-header .header__icons {
      grid-column: 3;
      justify-self: end;
      gap: 0.1rem;
      z-index: 2;
    }

    body.home-hero-header-enabled .section-header .header__icons .header__icon {
      width: 3.6rem;
      height: 3.6rem;
    }

    body.home-hero-header-enabled .section-header .header__icons .header__icon svg {
      width: 2rem;
      height: 2rem;
    }
  }

  .home-hero-photo {
    min-height: 100svh;
    isolation: isolate;
  }

  .home-hero-photo__media::after {
    background:
      linear-gradient(90deg, rgba(0, 0, 0, 0.72), rgba(0, 0, 0, 0.34) 42%, rgba(0, 0, 0, 0.02) 76%),
      linear-gradient(180deg, rgba(0, 0, 0, 0.08), rgba(0, 0, 0, 0.08) 58%, rgba(0, 0, 0, 0.32));
  }

  .home-hero-photo__content {
    min-height: 100svh;
    justify-content: center;
    padding: 10.2rem 4.2rem 4.4rem;
  }

  .home-hero-photo__text {
    width: min(100%, 29.6rem);
    max-width: none;
    margin-top: 3.2rem;
  }

  .home-hero-photo__eyebrow {
    margin: 0 0 1.8rem;
    color: #ffffff;
    font-size: 1.32rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    line-height: 1;
    text-shadow: 0 0.2rem 0.9rem rgba(0, 0, 0, 0.72);
    text-transform: uppercase;
  }

  .home-hero-photo__headline {
    margin: 0;
    color: #ffffff;
    font-family: var(--font-heading-family, inherit);
    font-size: clamp(4.6rem, 14.2vw, 7.2rem);
    font-weight: 900;
    letter-spacing: 0;
    line-height: 0.98;
    text-transform: uppercase;
    text-shadow: 0.36rem 0.45rem 0.9rem rgba(0, 0, 0, 0.46);
  }

  .home-hero-photo__headline span,
  .home-hero-photo__headline em {
    display: block;
  }

  .home-hero-photo__headline em {
    font-style: italic;
  }

  .home-hero-photo__tagline {
    margin: 2.4rem 0 0;
    color: #ffffff;
    font-size: 1.18rem;
    font-style: italic;
    font-weight: 500;
    letter-spacing: 0.06em;
    line-height: 1.25;
    text-shadow: 0 0.2rem 0.8rem rgba(0, 0, 0, 0.68);
    text-transform: uppercase;
  }

  .home-hero-photo__actions {
    display: grid;
    gap: 1.1rem;
    width: min(100%, 22.4rem);
    margin-top: 8.2rem;
  }

  .home-hero-photo__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 4.4rem;
    padding: 0 1.7rem;
    border: 0.14rem solid #ffffff;
    color: #ffffff;
    font-size: 1.55rem;
    font-weight: 400;
    line-height: 1;
    text-decoration: none;
  }

  .home-hero-photo__button--outline {
    background: rgba(0, 0, 0, 0.12);
  }

  .home-hero-photo__button--light {
    background: #ffffff;
    color: #000000 !important;
    opacity: 1;
  }

  @media screen and (min-width: 750px) {
    .home-hero-photo__content {
      justify-content: center;
      padding: 12rem 6.4rem 6.4rem;
    }

    .home-hero-photo__text {
      width: min(38vw, 43rem);
      margin-top: 2rem;
    }

    .home-hero-photo__headline {
      font-size: clamp(6.2rem, 6.8vw, 10.4rem);
    }

    .home-hero-photo__actions {
      width: min(100%, 25rem);
      margin-top: 5rem;
    }
  }
</style>

{%- liquid
  assign primary_button_link = section.settings.primary_button_link | default: '#home-quick-shop-grid'
  assign secondary_button_link = section.settings.secondary_button_link | default: section.settings.button_link | default: '/collections/back-to-rhythm'
-%}

<section class="home-editorial home-hero-photo" aria-label="{{ section.settings.headline_top | escape }} {{ section.settings.headline_italic | escape }}">
  <div class="home-hero-photo__media">
    {%- if section.settings.mobile_image != blank or section.settings.desktop_image != blank -%}
      {%- assign mobile_image = section.settings.mobile_image | default: section.settings.desktop_image -%}
      {%- assign desktop_image = section.settings.desktop_image | default: section.settings.mobile_image -%}
      <picture class="home-media">
        {%- if desktop_image != blank -%}
          <source media="(min-width: 750px)" srcset="{{ desktop_image | image_url: width: 2400 }}">
        {%- endif -%}
        {{ mobile_image | image_url: width: 1400 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '375, 550, 750, 900, 1100, 1400', alt: section.settings.image_alt }}
      </picture>
    {%- else -%}
      <div class="home-media home-media--empty"></div>
    {%- endif -%}
  </div>

  <div class="home-hero-photo__content">
    <div class="home-hero-photo__text">
      {%- if section.settings.collection_label != blank -%}
        <p class="home-hero-photo__eyebrow">{{ section.settings.collection_label | escape }}</p>
      {%- endif -%}

      <h1 class="home-hero-photo__headline">
        <span>{{ section.settings.headline_top | escape }}</span>
        <em>{{ section.settings.headline_italic | escape }}</em>
      </h1>

      {%- if section.settings.tagline != blank -%}
        <p class="home-hero-photo__tagline">{{ section.settings.tagline | escape }}</p>
      {%- endif -%}

      <div class="home-hero-photo__actions">
        {%- if section.settings.primary_button_label != blank -%}
          <a class="home-hero-photo__button home-hero-photo__button--outline" href="{{ primary_button_link }}">
            {{ section.settings.primary_button_label | escape }}
          </a>
        {%- endif -%}
        {%- if section.settings.secondary_button_label != blank -%}
          <a class="home-hero-photo__button home-hero-photo__button--light" href="{{ secondary_button_link }}">
            {{ section.settings.secondary_button_label | escape }}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

<script>
  (() => {
    if (!document.body || document.body.dataset.homeHeroHeaderReady === 'true') return;

    const header = document.querySelector('.section-header');
    if (!header) return;

    document.body.dataset.homeHeroHeaderReady = 'true';
    document.body.classList.add('home-hero-header-enabled', 'home-hero-header-at-top');

    let lastScrollY = window.scrollY;
    let ticking = false;

    const updateHeader = () => {
      const currentScrollY = Math.max(window.scrollY, 0);
      const scrollingDown = currentScrollY > lastScrollY + 8;
      const scrollingUp = currentScrollY < lastScrollY - 8;

      if (currentScrollY < 16) {
        document.body.classList.add('home-hero-header-at-top');
        document.body.classList.remove('home-hero-header-hidden', 'home-hero-header-solid');
      } else if (scrollingDown) {
        document.body.classList.remove('home-hero-header-at-top', 'home-hero-header-solid');
        document.body.classList.add('home-hero-header-hidden');
      } else if (scrollingUp) {
        document.body.classList.remove('home-hero-header-at-top', 'home-hero-header-hidden');
        document.body.classList.add('home-hero-header-solid');
      }

      lastScrollY = currentScrollY;
      ticking = false;
    };

    window.addEventListener('scroll', () => {
      if (!ticking) {
        window.requestAnimationFrame(updateHeader);
        ticking = true;
      }
    }, { passive: true });

    document.querySelectorAll('a[href="#home-quick-shop-grid"]').forEach((link) => {
      if (link.dataset.homeQuickShopScrollReady === 'true') return;
      link.dataset.homeQuickShopScrollReady = 'true';

      link.addEventListener('click', (event) => {
        const quickShop = document.querySelector('.section-home-quick-shop-grid, .home-quick-shop');
        if (!quickShop) return;

        event.preventDefault();
        quickShop.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    });

    updateHeader();
  })();
</script>

{% schema %}
{
  "name": "Home hero photo",
  "tag": "section",
  "class": "section-home-hero-photo",
  "settings": [
    { "type": "image_picker", "id": "mobile_image", "label": "Mobile image" },
    { "type": "image_picker", "id": "desktop_image", "label": "Desktop image" },
    { "type": "text", "id": "image_alt", "label": "Image alt text", "default": "Kasya Back to Rythm campaign" },
    { "type": "text", "id": "collection_label", "label": "Small collection text", "default": "6.6 COLLECTION" },
    { "type": "text", "id": "headline_top", "label": "Headline first line", "default": "BACK TO" },
    { "type": "text", "id": "headline_italic", "label": "Headline italic line", "default": "RYTHM" },
    { "type": "text", "id": "tagline", "label": "Tagline", "default": "OFFICE-READY, WEEKEND-EASY" },
    { "type": "text", "id": "primary_button_label", "label": "First button label", "default": "View Collection" },
    { "type": "url", "id": "primary_button_link", "label": "First button link" },
    { "type": "text", "id": "secondary_button_label", "label": "Second button label", "default": "Shop Now" },
    { "type": "url", "id": "secondary_button_link", "label": "Second button link" },
    { "type": "url", "id": "button_link", "label": "Legacy button link" }
  ],
  "presets": [
    { "name": "Home hero photo" }
  ]
}
{% endschema %}
