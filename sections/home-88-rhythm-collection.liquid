{{ 'home-88-rhythm-collection.css' | asset_url | stylesheet_tag }}

{%- assign rhythm_url = section.settings.rhythm_collection.url | default: section.settings.custom_url -%}
{%- assign desktop_banner_image = section.settings.desktop_banner_image | default: section.settings.mobile_banner_image -%}
{%- assign mobile_banner_image = section.settings.mobile_banner_image | default: desktop_banner_image -%}

<section
  id="home-88-rhythm-collection"
  class="home-88-rhythm"
  style="
    --rhythm-text: {{ section.settings.text_color }};
    --rhythm-button-bg: {{ section.settings.button_background }};
    --rhythm-button-text: {{ section.settings.button_text_color }};
    --rhythm-button-border: {{ section.settings.button_border_color }};
    --rhythm-divider: {{ section.settings.divider_color }};
    --rhythm-height-mobile: {{ section.settings.section_height_mobile }}px;
    --rhythm-height-desktop: {{ section.settings.section_height_desktop }}px;
    --rhythm-content-mobile: {{ section.settings.left_width_mobile }}%;
    --rhythm-content-desktop: {{ section.settings.left_width_desktop }}%;
    --rhythm-padding-mobile: {{ section.settings.content_padding_mobile }}px;
    --rhythm-padding-desktop: {{ section.settings.content_padding_desktop }}px;
    --rhythm-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --rhythm-position-mobile: {{ section.settings.mobile_image_position }};
    --rhythm-position-desktop: {{ section.settings.desktop_image_position }};
    --rhythm-heading-mobile: {{ section.settings.heading_size_mobile }}px;
    --rhythm-heading-desktop: {{ section.settings.heading_size_desktop }}px;
    --rhythm-description-mobile: {{ section.settings.description_size_mobile }}px;
    --rhythm-description-desktop: {{ section.settings.description_size_desktop }}px;
    --rhythm-button-mobile: {{ section.settings.button_size_mobile }}px;
    --rhythm-button-desktop: {{ section.settings.button_size_desktop }}px;
    --rhythm-line-mobile: {{ section.settings.description_line_height_mobile | divided_by: 100.0 }};
    --rhythm-line-desktop: {{ section.settings.description_line_height_desktop | divided_by: 100.0 }};
  "
>
  <div class="home-88-rhythm__media">
    {%- if desktop_banner_image != blank -%}
      <picture class="home-88-rhythm__picture">
        {%- if section.settings.mobile_banner_image != blank -%}
          <source
            media="(max-width: 749px)"
            srcset="
              {{ mobile_banner_image | image_url: width: 480 }} 480w,
              {{ mobile_banner_image | image_url: width: 720 }} 720w,
              {{ mobile_banner_image | image_url: width: 960 }} 960w
            "
            sizes="100vw"
          >
        {%- endif -%}
        {{ desktop_banner_image | image_url: width: 2400 | image_tag: loading: 'lazy', widths: '480, 720, 960, 1200, 1600, 2000, 2400', sizes: '100vw', alt: section.settings.left_image_alt }}
      </picture>
    {%- else -%}
      {{ 'lifestyle-2' | placeholder_svg_tag: 'home-88-rhythm__placeholder' }}
    {%- endif -%}
  </div>
  <div class="home-88-rhythm__overlay"></div>
  <div class="home-88-rhythm__content">
    <h2>{{ section.settings.heading | escape }}</h2>
    <p>{{ section.settings.description | escape }}</p>
    <a class="home-88-rhythm__button"{% if rhythm_url != blank %} href="{{ rhythm_url }}"{% else %} aria-disabled="true"{% endif %}>
      <span>{{ section.settings.button_label | escape }}</span>
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 12h13M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </a>
  </div>
</section>

{% schema %}
{
  "name": "Home 8.8 rhythm",
  "tag": "section",
  "class": "section-home-88-rhythm",
  "settings": [
    { "type": "header", "content": "Banner image" },
    { "type": "image_picker", "id": "desktop_banner_image", "label": "Desktop banner image" },
    { "type": "paragraph", "content": "Desktop recommended: 2400 × 1000 px (12:5), WebP." },
    { "type": "image_picker", "id": "mobile_banner_image", "label": "Mobile banner image", "info": "Falls back to the desktop banner image when blank." },
    { "type": "paragraph", "content": "Use a mobile-specific crop that keeps the subject and text area visible." },
    { "type": "text", "id": "left_image_alt", "label": "Banner image alt text" },
    { "type": "select", "id": "mobile_image_position", "label": "Mobile image position", "default": "center center", "options": [{ "value": "left center", "label": "Left" }, { "value": "center center", "label": "Center" }, { "value": "right center", "label": "Right" }, { "value": "center top", "label": "Top" }, { "value": "center bottom", "label": "Bottom" }] },
    { "type": "select", "id": "desktop_image_position", "label": "Desktop image position", "default": "center center", "options": [{ "value": "left center", "label": "Left" }, { "value": "center center", "label": "Center" }, { "value": "right center", "label": "Right" }, { "value": "center top", "label": "Top" }, { "value": "center bottom", "label": "Bottom" }] },
    { "type": "range", "id": "overlay_opacity", "label": "Overlay opacity", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 30 },
    { "type": "text", "id": "heading", "label": "Heading", "default": "CONTINUE THE RHYTHM" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "The Rhythm Collection is designed for everyday ease. More pieces in the same calm, polished spirit, made to mix, match, and move with you." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Explore the Rhythm Collection" },
    { "type": "collection", "id": "rhythm_collection", "label": "Rhythm collection" },
    { "type": "url", "id": "custom_url", "label": "Optional custom URL" },
    { "type": "header", "content": "Style and layout" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#ffffff" },
    { "type": "color", "id": "button_background", "label": "Button background color", "default": "#172437" },
    { "type": "color", "id": "button_text_color", "label": "Button text color", "default": "#ffffff" },
    { "type": "color", "id": "button_border_color", "label": "Button border color", "default": "#ffffff" },
    { "type": "color", "id": "divider_color", "label": "Section divider color", "default": "#ffffff" },
    { "type": "range", "id": "section_height_mobile", "label": "Mobile banner height", "min": 200, "max": 500, "step": 10, "unit": "px", "default": 260 },
    { "type": "range", "id": "section_height_desktop", "label": "Desktop banner height", "min": 260, "max": 600, "step": 10, "unit": "px", "default": 340 },
    { "type": "range", "id": "left_width_mobile", "label": "Mobile content width", "min": 50, "max": 100, "step": 1, "unit": "%", "default": 86 },
    { "type": "range", "id": "left_width_desktop", "label": "Desktop content width", "min": 30, "max": 70, "step": 1, "unit": "%", "default": 48 },
    { "type": "range", "id": "content_padding_mobile", "label": "Mobile content padding", "min": 8, "max": 40, "step": 2, "unit": "px", "default": 16 },
    { "type": "range", "id": "content_padding_desktop", "label": "Desktop content padding", "min": 24, "max": 100, "step": 4, "unit": "px", "default": 48 },
    { "type": "header", "content": "Typography" },
    { "type": "range", "id": "heading_size_mobile", "label": "Mobile heading size", "min": 14, "max": 32, "step": 1, "unit": "px", "default": 20 },
    { "type": "range", "id": "heading_size_desktop", "label": "Desktop heading size", "min": 24, "max": 54, "step": 1, "unit": "px", "default": 32 },
    { "type": "range", "id": "description_size_mobile", "label": "Mobile description size", "min": 8, "max": 18, "step": 1, "unit": "px", "default": 10 },
    { "type": "range", "id": "description_size_desktop", "label": "Desktop description size", "min": 12, "max": 24, "step": 1, "unit": "px", "default": 14 },
    { "type": "range", "id": "button_size_mobile", "label": "Mobile button text size", "min": 8, "max": 16, "step": 1, "unit": "px", "default": 9 },
    { "type": "range", "id": "button_size_desktop", "label": "Desktop button text size", "min": 10, "max": 20, "step": 1, "unit": "px", "default": 12 },
    { "type": "range", "id": "description_line_height_mobile", "label": "Mobile description line height", "min": 105, "max": 170, "step": 5, "unit": "%", "default": 135 },
    { "type": "range", "id": "description_line_height_desktop", "label": "Desktop description line height", "min": 105, "max": 170, "step": 5, "unit": "%", "default": 145 }
  ],
  "presets": [{ "name": "Home 8.8 rhythm" }]
}
{% endschema %}
