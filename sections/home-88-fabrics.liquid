{{ 'home-88-fabrics.css' | asset_url | stylesheet_tag }}

<section
  id="home-88-fabrics"
  class="home-88-fabrics"
  style="
    --fabrics-bg: {{ section.settings.background_color }};
    --fabrics-text: {{ section.settings.text_color }};
    --fabrics-top-mobile: {{ section.settings.padding_top_mobile }}px;
    --fabrics-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
    --fabrics-top-desktop: {{ section.settings.padding_top_desktop }}px;
    --fabrics-bottom-desktop: {{ section.settings.padding_bottom_desktop }}px;
    --fabrics-gap: {{ section.settings.card_gap }}px;
    --fabrics-card-padding: {{ section.settings.card_padding }}px;
    --fabrics-icon: {{ section.settings.icon_size }}px;
    --fabrics-heading-mobile: {{ section.settings.heading_size_mobile }}px;
    --fabrics-heading-desktop: {{ section.settings.heading_size_desktop }}px;
    --fabrics-title-mobile: {{ section.settings.title_size_mobile }}px;
    --fabrics-title-desktop: {{ section.settings.title_size_desktop }}px;
    --fabrics-description-mobile: {{ section.settings.description_size_mobile }}px;
    --fabrics-description-desktop: {{ section.settings.description_size_desktop }}px;
    --fabrics-line-mobile: {{ section.settings.description_line_height_mobile | divided_by: 100.0 }};
    --fabrics-line-desktop: {{ section.settings.description_line_height_desktop | divided_by: 100.0 }};
  "
>
  <div class="home-88-fabrics__inner">
    <h2>{{ section.settings.heading | escape }}</h2>
    <div class="home-88-fabrics__grid">
      {%- for block in section.blocks limit: 4 -%}
        <article class="home-88-fabrics__card" style="--fabric-card-bg: {{ block.settings.background_color }}; --fabric-card-text: {{ block.settings.text_color }};" {{ block.shopify_attributes }}>
          {%- if block.settings.icon != blank -%}
            {{ block.settings.icon | image_url: width: 240 | image_tag: class: 'home-88-fabrics__icon', loading: 'lazy', widths: '60, 90, 120, 180, 240', alt: block.settings.icon_alt }}
          {%- endif -%}
          <h3>{{ block.settings.title | escape }}</h3>
          <p>{{ block.settings.description | escape }}</p>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Home 8.8 fabrics",
  "tag": "section",
  "class": "section-home-88-fabrics",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "heading", "label": "Section heading", "default": "DIFFERENT FABRICS FOR DIFFERENT KINDS OF EASE" },
    { "type": "color", "id": "background_color", "label": "Section background color", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Section text color", "default": "#171714" },
    { "type": "range", "id": "padding_top_mobile", "label": "Mobile top padding", "min": 20, "max": 100, "step": 4, "unit": "px", "default": 44 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Mobile bottom padding", "min": 20, "max": 100, "step": 4, "unit": "px", "default": 44 },
    { "type": "range", "id": "padding_top_desktop", "label": "Desktop top padding", "min": 32, "max": 140, "step": 4, "unit": "px", "default": 68 },
    { "type": "range", "id": "padding_bottom_desktop", "label": "Desktop bottom padding", "min": 32, "max": 140, "step": 4, "unit": "px", "default": 68 },
    { "type": "range", "id": "card_gap", "label": "Card gap", "min": 2, "max": 24, "step": 2, "unit": "px", "default": 8 },
    { "type": "range", "id": "card_padding", "label": "Card internal padding", "min": 4, "max": 36, "step": 2, "unit": "px", "default": 14 },
    { "type": "range", "id": "icon_size", "label": "Icon size", "min": 16, "max": 72, "step": 2, "unit": "px", "default": 34 },
    { "type": "header", "content": "Typography" },
    { "type": "range", "id": "heading_size_mobile", "label": "Mobile heading size", "min": 14, "max": 34, "step": 1, "unit": "px", "default": 20 },
    { "type": "range", "id": "heading_size_desktop", "label": "Desktop heading size", "min": 22, "max": 52, "step": 1, "unit": "px", "default": 34 },
    { "type": "range", "id": "title_size_mobile", "label": "Mobile fabric-title size", "min": 8, "max": 18, "step": 1, "unit": "px", "default": 11 },
    { "type": "range", "id": "title_size_desktop", "label": "Desktop fabric-title size", "min": 12, "max": 26, "step": 1, "unit": "px", "default": 17 },
    { "type": "range", "id": "description_size_mobile", "label": "Mobile description size", "min": 7, "max": 16, "step": 1, "unit": "px", "default": 9 },
    { "type": "range", "id": "description_size_desktop", "label": "Desktop description size", "min": 10, "max": 22, "step": 1, "unit": "px", "default": 14 },
    { "type": "range", "id": "description_line_height_mobile", "label": "Mobile description line height", "min": 105, "max": 170, "step": 5, "unit": "%", "default": 130 },
    { "type": "range", "id": "description_line_height_desktop", "label": "Desktop description line height", "min": 105, "max": 170, "step": 5, "unit": "%", "default": 140 }
  ],
  "blocks": [
    {
      "type": "fabric",
      "name": "Fabric",
      "settings": [
        { "type": "text", "id": "title", "label": "Fabric title", "default": "Acid Linen" },
        { "type": "textarea", "id": "description", "label": "Fabric description", "default": "Light, breathable and crisp." },
        { "type": "image_picker", "id": "icon", "label": "Optional icon image" },
        { "type": "text", "id": "icon_alt", "label": "Icon alt text" },
        { "type": "color", "id": "background_color", "label": "Card background color", "default": "#d8bf9f" },
        { "type": "color", "id": "text_color", "label": "Card text color", "default": "#171714" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Home 8.8 fabrics",
      "blocks": [
        { "type": "fabric", "settings": { "title": "Acid Linen", "description": "Light, breathable and crisp.", "background_color": "#d8bf9f", "text_color": "#171714" } },
        { "type": "fabric", "settings": { "title": "Soft Linen", "description": "Soft to the touch with natural drape.", "background_color": "#a8ad8b", "text_color": "#171714" } },
        { "type": "fabric", "settings": { "title": "Knitted", "description": "Flexible comfort that moves with you.", "background_color": "#172437", "text_color": "#ffffff" } },
        { "type": "fabric", "settings": { "title": "Acid Linen", "description": "Structured, durable and made to last.", "background_color": "#d8d7d2", "text_color": "#171714" } }
      ]
    }
  ]
}
{% endschema %}
