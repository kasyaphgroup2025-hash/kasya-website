 function count(){return basket.reduce((acc,x)=>acc+x.quantity,0)}
 function rate(n){return n>=5?35:n>=3?25:n>=1?15:0}
 function savings(n){return Math.round(n*UNIT_PRICE*rate(n))/100}
 function goalClick(n){goal=n;document.querySelectorAll('.tier').forEach(x=>{const active=Number(x.dataset.goal)===n;x.classList.toggle('selected',active);x.setAttribute('aria-pressed',String(active));x.querySelector('.flag').textContent=active?(n===3?'POPULAR GOAL':'YOUR GOAL'):'YOUR GOAL'});render();document.getElementById('builder').scrollIntoView({behavior:'smooth',block:'start'})}
 document.querySelectorAll('.tier').forEach(b=>b.addEventListener('click',()=>goalClick(Number(b.dataset.goal))));
 function chooseColor(name){selectedColor=name;document.querySelectorAll('.productCard').forEach(b=>{const active=b.dataset.color===name;b.classList.toggle('chosen',active);b.setAttribute('aria-pressed',String(active))});document.getElementById('selectedColor').textContent=name}
 document.querySelectorAll('.productCard').forEach(b=>b.addEventListener('click',()=>chooseColor(b.dataset.color)));
 function chooseSize(name){selectedSize=name;document.querySelectorAll('.sizeBtn').forEach(b=>{const active=b.dataset.size===name;b.classList.toggle('active',active);b.setAttribute('aria-pressed',String(active))})}
 document.querySelectorAll('.sizeBtn').forEach(b=>b.addEventListener('click',()=>chooseSize(b.dataset.size)));
 function updateQty(){document.getElementById('quantity').textContent=String(newQty)}
 document.getElementById('incQty').addEventListener('click',()=>{newQty=Math.min(20,newQty+1);updateQty()});document.getElementById('decQty').addEventListener('click',()=>{newQty=Math.max(1,newQty-1);updateQty()});
 function toast(msg){const t=document.getElementById('toast');t.textContent=msg;t.classList.add('show');clearTimeout(toast.timer);toast.timer=setTimeout(()=>t.classList.remove('show'),1800)}
 document.getElementById('addButton').addEventListener('click',()=>{const existing=basket.find(x=>x.color===selectedColor&&x.size===selectedSize);if(existing)existing.quantity+=newQty;else basket.push({color:selectedColor,size:selectedSize,quantity:newQty});render();toast(`Added ${newQty} ${newQty===1?'pair':'pairs'} · ${selectedColor} / ${selectedSize}`);newQty=1;updateQty();});
 function edit(i,delta){if(!basket[i])return;basket[i].quantity+=delta;if(basket[i].quantity<=0)basket.splice(i,1);render()}
 function render(){
  const n=count(),pct=rate(n),subtotal=n*UNIT_PRICE,save=savings(n),total=subtotal-save;
  document.getElementById('progressFill').style.width=Math.min(100,n/5*100)+'%';
  [1,3,5].forEach(k=>document.getElementById('step'+k).classList.toggle('done',n>=k));
  document.getElementById('progressTitle').textContent=n===0?'Start building your bundle':`${n} ${n===1?'pair':'pairs'} in your bundle`;
  document.getElementById('tierNow').textContent=`${n} ${n===1?'pair':'pairs'} · ${pct}% unlocked`;
  let message='';
  if(n===0)message=`Your selected goal is ${goal} ${goal===1?'pair':'pairs'}. Choose your first color and size.`;
  else if(n<3)message=`<em>15% OFF unlocked!</em> Add ${3-n} more ${3-n===1?'pair':'pairs'} to unlock 25% OFF on all 3.`;
  else if(n<5)message=`<em>25% OFF unlocked!</em> Add ${5-n} more ${5-n===1?'pair':'pairs'} to unlock 35% OFF on all 5.`;
  else message='<em>You unlocked the best deal: 35% OFF!</em> All qualifying pairs receive the highest tier.';
  if(n>=1 && goal>n)message+=` <span style="font-weight:400;color:#666">(Your selected goal: ${goal} pairs)</span>`;
  document.getElementById('goalMessage').innerHTML=message;
  document.getElementById('bagCount').textContent=String(n);
  document.getElementById('pairLabel').textContent=`${n} ${n===1?'pair':'pairs'} added`;
  const list=document.getElementById('cartlist');list.innerHTML='';
  if(!basket.length){list.innerHTML='<div class="empty">Your bundle is empty.<br>Choose your favorite shades to get started.</div>'}
  else basket.forEach((x,i)=>{const el=document.createElement('div');el.className='item';const img=document.createElement('img');img.className='itemPhoto';img.src=refs[x.color].currentSrc||refs[x.color].src;img.alt=x.color+' pants';el.appendChild(img);const details=document.createElement('div');details.innerHTML=`<div class="itemName"></div><div class="itemSize"></div>`;details.querySelector('.itemName').textContent=x.color;details.querySelector('.itemSize').textContent=`Size ${x.size} · ${money(x.quantity*UNIT_PRICE)}`;el.appendChild(details);const mini=document.createElement('div');mini.className='miniQty';const minus=document.createElement('button');minus.type='button';minus.setAttribute('aria-label','Remove one '+x.color+' in size '+x.size);minus.textContent='−';minus.onclick=()=>edit(i,-1);const val=document.createElement('span');val.textContent=String(x.quantity);const plus=document.createElement('button');plus.type='button';plus.setAttribute('aria-label','Add one '+x.color+' in size '+x.size);plus.textContent='+';plus.onclick=()=>edit(i,1);mini.append(minus,val,plus);el.appendChild(mini);list.appendChild(el)});
  document.getElementById('subTotal').textContent=money(subtotal);
  document.getElementById('discountTitle').textContent=`Payday savings (${pct}%)`;
  document.getElementById('discountValue').textContent='−'+money(save);
  document.getElementById('finalTotal').textContent=money(total);
  document.getElementById('savingsValue').textContent=money(save);
  document.getElementById('shippingMessage').textContent=n===0?'Existing free-shipping benefits are handled separately from Payday progress.':total>=SHIPPING_THRESHOLD?'Estimated bundle exceeds ₱2,000 after discount. Actual free-shipping eligibility depends on Shopify checkout.':`Preview: ${money(SHIPPING_THRESHOLD-total)} away from ₱2,000 after discount. Shopify checkout makes the final decision.`;
  document.getElementById('stickyTotal').textContent=money(total);
  document.getElementById('stickySavings').textContent=n?`${n} ${n===1?'pair':'pairs'} · Save ${money(save)}`:'0 pairs · Build your bundle';
  document.getElementById('stickyButton').textContent=n?'VIEW MY BUNDLE →':'START BUILDING →';
 }
 function goTo(){document.getElementById(count()?'bundle':'builder').scrollIntoView({behavior:'smooth',block:'center'})}
 document.getElementById('stickyButton').addEventListener('click',goTo);document.getElementById('bagBtn').addEventListener('click',goTo);
 document.getElementById('sizeHelp').addEventListener('click',()=>{const el=document.getElementById('fitDetails');el.open=true;el.scrollIntoView({behavior:'smooth',block:'center'})});
 document.getElementById('menuBtn').addEventListener('click',()=>toast('Prototype only · navigation is not connected'));
 // Local design-preview fallback when remote image loading is unavailable.
 document.querySelectorAll('img[data-fallback]').forEach(img=>{img.addEventListener('error',()=>{if(img.dataset.fallback && img.src!==img.dataset.fallback){img.src=img.dataset.fallback}}, {once:true})});
 chooseColor(selectedColor);chooseSize(selectedSize);render();
})();
</script>
</div>
