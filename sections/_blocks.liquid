<style>
  .section-{{ section.id }}-padding {
    {% render 'layout-panel-style', local_settings: section.settings %}
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  {%- render 'section-heading-styles' -%}
</style>

<div class="{% unless section.settings.enable_section_box_layout %}color-{{ section.settings.color_scheme }} gradient isolate{% else %}{% unless section.settings.section_width == 'full_bleed' %}page-width{% if section.settings.section_width == 'stretched_grid' %}--full{% endif %}{% endunless %}{% if section.settings.section_width == 'narrow' %} page-width--narrow{% endif %}{% endunless %}">
  <div class="custom-section collapsible-row-layout section-{{ section.id }}-padding">
    {%- unless section.settings.enable_section_box_layout or section.settings.title == blank -%}
      <div class="page-width{% if section.settings.section_width == 'full_bleed' or section.settings.section_width == 'stretched_grid' %}--full{% endif %}{% if section.settings.section_width == 'narrow' %}--narrow{% endif %}">
        {%- render 'section-heading' -%}
      </div>
    {%- endunless -%}
    <div class="custom-section__inner {% if section.settings.enable_section_box_layout %}color-{{ section.settings.color_scheme }} gradient isolate section__box{% else %}{% unless section.settings.section_width == 'full_bleed' %}page-width{% if section.settings.section_width == 'stretched_grid' %}--full{% endif %}{% endunless %}{% if section.settings.section_width == 'narrow' %} page-width--narrow{% endif %}{% endif %}">
      {%- if section.settings.enable_section_box_layout -%}
        {%- render 'section-heading' -%}
      {%- endif -%}  
      {%- capture children -%}
        {%- content_for 'blocks' -%}
      {%- endcapture -%}
      {%- render 'section', section_object: section, children: children -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:names.section",
  "class": "section-wrapper",
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    },
    {
      "type": "_divider"
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "title",
      "default": "Product information",
      "label": "t:settings.heading"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "t:settings.subheading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h0",
          "label": "t:sections.all.heading_size.options__3.label"
        }
      ],
      "default": "h1",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "header",
      "content": "t:content.size"
    },
    {
      "type": "select",
      "id": "section_width",
      "options": [
        {
          "value": "full_bleed",
          "label": "t:sections.all.grid_layout.options_1.label"
        },
        {
          "value": "stretched_grid",
          "label": "t:sections.all.grid_layout.options_2.label"
        },
        {
          "value": "grid",
          "label": "t:sections.all.grid_layout.options_3.label"
        },
        {
          "value": "narrow",
          "label": "t:sections.all.grid_layout.options_4.label"
        }
      ],
      "default": "grid",
      "label": "t:settings.width"
    },
    {
      "type": "header",
      "content": "t:content.desktop_layout",
      "info": "t:info.also_apply_to_tablets"
    },
    {
      "type": "select",
      "id": "content_direction_desktop",
      "label": "t:settings.direction",
      "options": [
        {
          "value": "column",
          "label": "t:options.vertical"
        },
        {
          "value": "row",
          "label": "t:options.horizontal"
        }
      ],
      "default": "column"
    },
    {
      "type": "select",
      "id": "horizontal_alignment_desktop",
      "label": "t:settings.alignment",
      "options": [
        {
          "value": "flex-start",
          "label": "t:options.left"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "flex-end",
          "label": "t:options.right"
        },
        {
          "value": "space-between",
          "label": "t:options.space_between"
        }
      ],
      "default": "flex-start",
      "visible_if": "{{ section.settings.content_direction_desktop == 'row' }}"
    },
    {
      "type": "select",
      "id": "vertical_alignment_desktop",
      "label": "t:settings.position",
      "options": [
        {
          "value": "flex-start",
          "label": "t:options.top"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "flex-end",
          "label": "t:options.bottom"
        }
      ],
      "default": "center",
      "visible_if": "{{ section.settings.content_direction_desktop == 'row' }}"
    },
    {
      "type": "select",
      "id": "horizontal_alignment_flex_direction_column_desktop",
      "label": "t:settings.alignment",
      "options": [
        {
          "value": "flex-start",
          "label": "t:options.left"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "flex-end",
          "label": "t:options.right"
        }
      ],
      "default": "flex-start",
      "visible_if": "{{ section.settings.content_direction_desktop != 'row' }}"
    },
    {
      "type": "range",
      "id": "gap_desktop",
      "label": "t:settings.gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "header",
      "content": "t:content.mobile_layout"
    },
    {
      "type": "select",
      "id": "content_direction_mobile",
      "label": "t:settings.direction",
      "options": [
        {
          "value": "column",
          "label": "t:options.vertical"
        },
        {
          "value": "row",
          "label": "t:options.horizontal"
        }
      ],
      "default": "column"
    },
    {
      "type": "select",
      "id": "horizontal_alignment_mobile",
      "label": "t:settings.alignment",
      "options": [
        {
          "value": "left",
          "label": "t:options.left"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "right",
          "label": "t:options.right"
        },
        {
          "value": "space-between",
          "label": "t:options.space_between"
        }
      ],
      "default": "left",
      "visible_if": "{{ section.settings.content_direction_mobile == 'row' }}"
    },
    {
      "type": "select",
      "id": "vertical_alignment_mobile",
      "label": "t:settings.position",
      "options": [
        {
          "value": "start",
          "label": "t:options.top"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "end",
          "label": "t:options.bottom"
        }
      ],
      "default": "center",
      "visible_if": "{{ section.settings.content_direction_mobile == 'row' }}"
    },
    {
      "type": "select",
      "id": "horizontal_alignment_flex_direction_column_mobile",
      "label": "t:settings.alignment",
      "options": [
        {
          "value": "start",
          "label": "t:options.left"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "end",
          "label": "t:options.right"
        }
      ],
      "default": "start",
      "visible_if": "{{ section.settings.content_direction_mobile != 'row' }}"
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "label": "t:settings.gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "checkbox",
      "id": "enable_section_box_layout",
      "label": "t:sections.all.enable_section_box_layout.label",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "background-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "t:names.custom_section",
      "category": "t:categories.custom"
    }
  ]
}
{% endschema %}