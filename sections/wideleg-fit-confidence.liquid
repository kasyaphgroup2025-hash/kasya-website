{%- liquid
  assign section_bg = section.settings.section_bg
  assign card_bg = section.settings.card_bg
  assign text_color = section.settings.text_color
  assign muted_text = section.settings.muted_text
  assign accent_color = section.settings.accent_color
-%}

<section
  class="wideleg-fit-confidence wideleg-fit-confidence--{{ section.id }}"
  style="
    --wfc-section-bg: {{ section_bg }};
    --wfc-card-bg: {{ card_bg }};
    --wfc-text: {{ text_color }};
    --wfc-muted: {{ muted_text }};
    --wfc-accent: {{ accent_color }};
  "
>
  <div class="wideleg-fit-confidence__inner page-width">
    <div class="wideleg-fit-confidence__header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="wideleg-fit-confidence__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="wideleg-fit-confidence__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}

      {%- if section.settings.description != blank -%}
        <div class="wideleg-fit-confidence__description rte">
          {{ section.settings.description }}
        </div>
      {%- endif -%}
    </div>

    {%- assign image_blocks = section.blocks | where: 'type', 'proof_image' -%}
    {%- if image_blocks.size > 0 -%}
      <div class="wideleg-fit-confidence__proof-grid">
        {%- for block in image_blocks -%}
          <article class="wideleg-fit-confidence__proof-card" {{ block.shopify_attributes }}>
            <div class="wideleg-fit-confidence__proof-media">
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 1200
                  | image_tag:
                    loading: 'lazy',
                    widths: '360, 550, 720, 900, 1200',
                    sizes: '(min-width: 990px) 33vw, (min-width: 750px) 50vw, 100vw',
                    class: 'wideleg-fit-confidence__proof-image'
                }}
              {%- else -%}
                <div class="wideleg-fit-confidence__proof-placeholder">
                  {{ 'image' | placeholder_svg_tag: 'wideleg-fit-confidence__proof-placeholder-svg' }}
                </div>
              {%- endif -%}
            </div>

            <div class="wideleg-fit-confidence__proof-content">
              {%- if block.settings.label != blank -%}
                <h3 class="wideleg-fit-confidence__proof-label">{{ block.settings.label }}</h3>
              {%- endif -%}

              {%- if block.settings.caption != blank -%}
                <p class="wideleg-fit-confidence__proof-caption">{{ block.settings.caption }}</p>
              {%- endif -%}
            </div>
          </article>
        {%- endfor -%}
      </div>
    {%- endif -%}

    <div class="wideleg-fit-confidence__details">
      <div class="wideleg-fit-confidence__fit-notes">
        {%- if section.settings.fit_notes_heading != blank -%}
          <h3 class="wideleg-fit-confidence__subheading">{{ section.settings.fit_notes_heading }}</h3>
        {%- endif -%}

        {%- assign note_blocks = section.blocks | where: 'type', 'fit_note' -%}
        {%- if note_blocks.size > 0 -%}
          <ul class="wideleg-fit-confidence__notes-list" role="list">
            {%- for block in note_blocks -%}
              {%- if block.settings.note != blank -%}
                <li class="wideleg-fit-confidence__note" {{ block.shopify_attributes }}>
                  <span class="wideleg-fit-confidence__note-mark" aria-hidden="true"></span>
                  <span class="wideleg-fit-confidence__note-text">{{ block.settings.note }}</span>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>

      <aside class="wideleg-fit-confidence__model-card">
        {%- if section.settings.model_heading != blank -%}
          <h3 class="wideleg-fit-confidence__subheading">{{ section.settings.model_heading }}</h3>
        {%- endif -%}

        <div class="wideleg-fit-confidence__model-list">
          {%- if section.settings.model_height != blank -%}
            <div class="wideleg-fit-confidence__model-item">
              <span class="wideleg-fit-confidence__model-label">{{ section.settings.model_height_label }}</span>
              <span class="wideleg-fit-confidence__model-value">{{ section.settings.model_height }}</span>
            </div>
          {%- endif -%}

          {%- if section.settings.model_size_worn != blank -%}
            <div class="wideleg-fit-confidence__model-item">
              <span class="wideleg-fit-confidence__model-label">{{ section.settings.model_size_worn_label }}</span>
              <span class="wideleg-fit-confidence__model-value">{{ section.settings.model_size_worn }}</span>
            </div>
          {%- endif -%}

          {%- if section.settings.usual_size != blank -%}
            <div class="wideleg-fit-confidence__model-item">
              <span class="wideleg-fit-confidence__model-label">{{ section.settings.usual_size_label }}</span>
              <span class="wideleg-fit-confidence__model-value">{{ section.settings.usual_size }}</span>
            </div>
          {%- endif -%}
        </div>

        {%- if section.settings.fit_recommendation != blank -%}
          <div class="wideleg-fit-confidence__recommendation rte">
            {{ section.settings.fit_recommendation }}
          </div>
        {%- endif -%}

        {%- if section.settings.cta_label != blank and section.settings.cta_link != blank -%}
          <a class="wideleg-fit-confidence__cta" href="{{ section.settings.cta_link }}">
            {{ section.settings.cta_label }}
          </a>
        {%- endif -%}
      </aside>
    </div>
  </div>

  <style>
    .wideleg-fit-confidence--{{ section.id }} {
      background: var(--wfc-section-bg);
      color: var(--wfc-text);
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    }

    .wideleg-fit-confidence--{{ section.id }} .wideleg-fit-confidence__inner {
      max-width: 1200px;
    }

    .wideleg-fit-confidence--{{ section.id }} .wideleg-fit-confidence__header {
      max-width: 44rem;
      margin-bottom: 2rem;
    }

    .wideleg-fit-confidence--{{ section.id }} .wideleg-fit-confidence__eyebrow {
      margin: 0 0 0.75rem;
      font-size: 0.74rem;
      line-height: 1.2;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--wfc-accent);
      font-weight: 700;
    }

    .wideleg-fit-confidence--{{ section.id }} .wideleg-fit-confidence__heading {
      margin: 0;
      color: var(--wfc-text);
      font-size: clamp(2rem, 6vw, 3.25rem);
      line-height: 1.06;
    }

    .wideleg-fit-confidence--{{ section.id }} .wideleg-fit-confidence__description {
      margin-top: 1rem;
      color: var(--wfc-muted);
      font-size: 1rem;
      line-height: 1.65;
    }

    .wideleg-fit-confidence--{{ section.id }} .wideleg-fit-confidence__description p {
      margin: 0;
    }

    .wideleg-fit-confidence--{{ section.id }} .wideleg-fit-confidence__proof-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .wideleg-fit-confidence--{{ section.id }} .wideleg-fit-confidence__proof-card,
    .wideleg-fit-confidence--{{ section.id }} .wideleg-fit-confidence__model-card,
    .wideleg-fit-confidence--{{ section.id }} .wideleg-fit-confidence__fit-notes {
      background: var(--wfc-card-bg);
      border: 1px solid rgba(40, 33, 28, 0.08);
      border-radius: 1.5rem;
      overflow: hidden;
      box-shadow: 0 10px 30px rgba(52, 43, 37, 0.05);
    }

    .wideleg-fit-confidence--{{ section.id }} .wideleg-fit-confidence__proof-media {
      aspect-ratio: 4 / 5;
      background: rgba(122, 100, 84, 0.08);
      overflow: hidden;
    }

    .wideleg-fit-confidence--{{ section.id }} .wideleg-fit-confidence__proof-image,
    .wideleg-fit-confidence--{{ section.id }} .wideleg-fit-confidence__proof-placeholder-svg {
      width: 100%;
      height: 100%;
      display: block;
      object-fit: cover;
    }

    .wideleg-fit-confidence--{{ section.id }} .wideleg-fit-confidence__proof-placeholder {
      width: 100%;
      height: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      color: rgba(52, 43, 37, 0.18);
    }

    .wideleg-fit-confidence--{{ section.id }} .wideleg-fit-confidence__proof-content {
      padding: 1rem 1rem 1.15rem;
    }

    .wideleg-fit-confidence--{{ section.id }} .wideleg-fit-confidence__proof-label,
    .wideleg-fit-confidence--{{ section.id }} .wideleg-fit-confidence__subheading {
      margin: 0;
      color: var(--wfc-text);
      font-size: 1.08rem;
      line-height: 1.3;
    }

    .wideleg-fit-confidence--{{ section.id }} .wideleg-fit-confidence__proof-caption {
      margin: 0.5rem 0 0;
      color: var(--wfc-muted);
      font-size: 0.95rem;
      line-height: 1.6;
    }

    .wideleg-fit-confidence--{{ section.id }} .wideleg-fit-confidence__details {
      display: grid;
      grid-template-columns: 1fr;
      gap: 1rem;
      margin-top: 1.25rem;
    }

    .wideleg-fit-confidence--{{ section.id }} .wideleg-fit-confidence__fit-notes,
    .wideleg-fit-confidence--{{ section.id }} .wideleg-fit-confidence__model-card {
      padding: 1.25rem;
    }

    .wideleg-fit-confidence--{{ section.id }} .wideleg-fit-confidence__notes-list {
      list-style: none;
      margin: 1rem 0 0;
      padding: 0;
      display: grid;
      gap: 0.75rem;
    }

    .wideleg-fit-confidence--{{ section.id }} .wideleg-fit-confidence__note {
      display: flex;
      align-items: flex-start;
      gap: 0.75rem;
      color: var(--wfc-text);
      line-height: 1.55;
    }

    .wideleg-fit-confidence--{{ section.id }} .wideleg-fit-confidence__note-mark {
      width: 0.62rem;
      height: 0.62rem;
      border-radius: 999px;
      background: var(--wfc-accent);
      flex: 0 0 0.62rem;
      margin-top: 0.4rem;
    }

    .wideleg-fit-confidence--{{ section.id }} .wideleg-fit-confidence__model-list {
      display: grid;
      gap: 0.8rem;
      margin-top: 1rem;
    }

    .wideleg-fit-confidence--{{ section.id }} .wideleg-fit-confidence__model-item {
      display: flex;
      justify-content: space-between;
      gap: 1rem;
      padding-bottom: 0.8rem;
      border-bottom: 1px solid rgba(40, 33, 28, 0.08);
    }

    .wideleg-fit-confidence--{{ section.id }} .wideleg-fit-confidence__model-label {
      color: var(--wfc-muted);
      font-size: 0.92rem;
      line-height: 1.5;
    }

    .wideleg-fit-confidence--{{ section.id }} .wideleg-fit-confidence__model-value {
      color: var(--wfc-text);
      font-size: 0.96rem;
      line-height: 1.5;
      font-weight: 600;
      text-align: right;
    }

    .wideleg-fit-confidence--{{ section.id }} .wideleg-fit-confidence__recommendation {
      margin-top: 1rem;
      color: var(--wfc-muted);
      line-height: 1.65;
    }

    .wideleg-fit-confidence--{{ section.id }} .wideleg-fit-confidence__recommendation p {
      margin: 0;
    }

    .wideleg-fit-confidence--{{ section.id }} .wideleg-fit-confidence__cta {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 3rem;
      padding: 0.8rem 1.15rem;
      margin-top: 1.25rem;
      border-radius: 999px;
      background: var(--wfc-text);
      color: var(--wfc-section-bg);
      text-decoration: none;
      font-weight: 600;
      transition: transform 0.18s ease, opacity 0.18s ease;
    }

    .wideleg-fit-confidence--{{ section.id }} .wideleg-fit-confidence__cta:hover {
      transform: translateY(-1px);
      opacity: 0.92;
    }

    @media screen and (min-width: 750px) {
      .wideleg-fit-confidence--{{ section.id }} {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }

      .wideleg-fit-confidence--{{ section.id }} .wideleg-fit-confidence__proof-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .wideleg-fit-confidence--{{ section.id }} .wideleg-fit-confidence__details {
        grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
        align-items: start;
      }

      .wideleg-fit-confidence--{{ section.id }} .wideleg-fit-confidence__fit-notes,
      .wideleg-fit-confidence--{{ section.id }} .wideleg-fit-confidence__model-card {
        padding: 1.5rem;
      }
    }

    @media screen and (min-width: 990px) {
      .wideleg-fit-confidence--{{ section.id }} .wideleg-fit-confidence__header {
        margin-bottom: 2.5rem;
      }

      .wideleg-fit-confidence--{{ section.id }} .wideleg-fit-confidence__proof-grid {
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1.25rem;
      }

      .wideleg-fit-confidence--{{ section.id }} .wideleg-fit-confidence__proof-card:first-child {
        grid-column: span 2;
      }

      .wideleg-fit-confidence--{{ section.id }} .wideleg-fit-confidence__proof-card:first-child .wideleg-fit-confidence__proof-media {
        aspect-ratio: 16 / 10;
      }

      .wideleg-fit-confidence--{{ section.id }} .wideleg-fit-confidence__proof-card:last-child {
        grid-column: span 2;
      }

      .wideleg-fit-confidence--{{ section.id }} .wideleg-fit-confidence__details {
        gap: 1.25rem;
        margin-top: 1.5rem;
      }
    }
  </style>
</section>

{% schema %}
{
