</section>

<script>
  (() => {
    const section = document.querySelector('[data-shop-look-section="{{ section.id }}"]');
    if (!section || section.dataset.lookSyncReady === 'true') return;
    section.dataset.lookSyncReady = 'true';

    const mainCarousel = section.querySelector('[data-look-carousel]');
    const detailCarousel = section.querySelector('[data-look-details-carousel]');
    const mainSlides = Array.from(section.querySelectorAll('[data-look-slide]'));
    const detailSlides = Array.from(section.querySelectorAll('[data-look-details-slide]'));
    const dots = Array.from(section.querySelectorAll('[data-look-dots] .home-shop-the-look__dot'));
    let syncing = false;

    const getActiveIndex = (carousel, slides) => {
      if (!carousel || !slides.length) return 0;
      const center = carousel.scrollLeft + carousel.clientWidth / 2;
      return slides.reduce((closestIndex, slide, index) => {
        const closestSlide = slides[closestIndex];
        const currentDistance = Math.abs(slide.offsetLeft + slide.offsetWidth / 2 - center);
        const closestDistance = Math.abs(closestSlide.offsetLeft + closestSlide.offsetWidth / 2 - center);
        return currentDistance < closestDistance ? index : closestIndex;
      }, 0);
    };

    const setDots = (index) => {
      dots.forEach((dot, dotIndex) => dot.classList.toggle('is-active', dotIndex === index));
    };

    const scrollToIndex = (carousel, slides, index, behavior = 'smooth') => {
      const slide = slides[index];
      if (!carousel || !slide) return;
      const left = slide.offsetLeft - (carousel.clientWidth - slide.offsetWidth) / 2;
      carousel.scrollTo({ left, behavior });
    };

    const syncFrom = (source, index) => {
      if (syncing) return;
      syncing = true;
      setDots(index);
      if (source !== mainCarousel) scrollToIndex(mainCarousel, mainSlides, index);
      if (source !== detailCarousel) scrollToIndex(detailCarousel, detailSlides, index);
      window.setTimeout(() => { syncing = false; }, 240);
    };

    const bindScroll = (carousel, slides) => {
      let frame = null;
      carousel?.addEventListener('scroll', () => {
        if (syncing || frame) return;
        frame = window.requestAnimationFrame(() => {
          const index = getActiveIndex(carousel, slides);
          syncFrom(carousel, index);
          frame = null;
        });
      }, { passive: true });
    };

    section.querySelectorAll('[data-look-details-link]').forEach((link) => {
      link.addEventListener('click', (event) => {
        event.preventDefault();
        const index = Number(link.dataset.index || 0);
        syncFrom(mainCarousel, index);
        document.getElementById('look-details-{{ section.id }}')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    });

    bindScroll(mainCarousel, mainSlides);
    bindScroll(detailCarousel, detailSlides);
    setDots(0);
  })();
</script>

