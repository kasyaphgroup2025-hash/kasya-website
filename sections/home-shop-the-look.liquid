{{ 'homepage-custom.css' | asset_url | stylesheet_tag }}

<section class="home-editorial home-shop-the-look">
  <div class="home-editorial__inner">
    <div class="home-shop-the-look__layout">
      <div class="home-shop-the-look__image-wrap">
        {%- if section.settings.mobile_image != blank or section.settings.desktop_image != blank -%}
          {%- assign mobile_image = section.settings.mobile_image | default: section.settings.desktop_image -%}
          {%- assign desktop_image = section.settings.desktop_image | default: section.settings.mobile_image -%}
          <picture class="home-media">
            {%- if desktop_image != blank -%}
              <source media="(min-width: 750px)" srcset="{{ desktop_image | image_url: width: 1800 }}">
            {%- endif -%}
            {{ mobile_image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '375, 550, 750, 900, 1100, 1400', alt: section.settings.image_alt }}
          </picture>
        {%- else -%}
          <div class="home-media home-media--empty"></div>
        {%- endif -%}
        <div class="home-shop-the-look__overlay">
          {%- if section.settings.kicker != blank -%}
            <p class="home-editorial__kicker">{{ section.settings.kicker | escape }}</p>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h2 class="home-editorial__heading">{{ section.settings.heading | escape }}</h2>
          {%- endif -%}
          {%- if section.settings.copy != blank -%}
            <div class="home-editorial__copy">{{ section.settings.copy }}</div>
          {%- endif -%}
        </div>
      </div>

      <div class="home-shop-the-look__products">
        {%- for product in section.settings.product_list limit: section.settings.products_to_show -%}
          <a class="home-shop-the-look__product" href="{{ product.url }}">
            <span class="home-shop-the-look__product-image">
              {%- if product.featured_image != blank -%}
                {{ product.featured_image | image_url: width: 360 | image_tag: loading: 'lazy', widths: '120, 180, 240, 360', alt: product.featured_image.alt | default: product.title }}
              {%- else -%}
                <span class="home-media home-media--empty"></span>
              {%- endif -%}
            </span>
            <span>
              <span class="home-shop-the-look__product-title">{{ product.title | escape }}</span>
              <span class="home-shop-the-look__product-price">{{ product.price | money }}</span>
            </span>
          </a>
        {%- else -%}
          {%- for i in (1..3) -%}
            <div class="home-shop-the-look__product">
              <span class="home-shop-the-look__product-image"><span class="home-media home-media--empty"></span></span>
              <span>
                <span class="home-shop-the-look__product-title">Look item</span>
                <span class="home-shop-the-look__product-price">{{ 0 | money }}</span>
              </span>
            </div>
          {%- endfor -%}
        {%- endfor -%}

        {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
          <a class="home-editorial__button" href="{{ section.settings.button_link }}">{{ section.settings.button_label | escape }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Home shop the look",
  "tag": "section",
  "class": "section-home-shop-the-look",
  "settings": [
    { "type": "image_picker", "id": "mobile_image", "label": "Mobile look image" },
    { "type": "image_picker", "id": "desktop_image", "label": "Desktop look image" },
    { "type": "text", "id": "image_alt", "label": "Image alt text", "default": "Styled Kasya look" },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Shop the look" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "One look, all day" },
    { "type": "richtext", "id": "copy", "label": "Copy", "default": "<p>Pair soft structure with pieces selected for the full outfit.</p>" },
    { "type": "product_list", "id": "product_list", "label": "Products in this look", "limit": 6 },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 1, "max": 6, "step": 1, "default": 3 },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop collection" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [
    { "name": "Home shop the look" }
  ]
}
{% endschema %}
