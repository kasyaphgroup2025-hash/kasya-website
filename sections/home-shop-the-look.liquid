{{ 'homepage-custom.css' | asset_url | stylesheet_tag }}

<style>
  #shopify-section-{{ section.id }} .home-shop-the-look {
    background: linear-gradient(90deg, #151515, #323232 50%, #151515);
    color: #ffffff;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .home-shop-the-look .home-editorial__inner {
    width: 100%;
    max-width: none;
    padding: 3.4rem 0 4.2rem;
  }

  #shopify-section-{{ section.id }} .home-shop-the-look__heading-bar {
    display: grid;
    grid-template-columns: minmax(2rem, 1fr) auto minmax(2rem, 1fr);
    gap: 1.2rem;
    align-items: center;
    margin-bottom: 2.2rem;
  }

  #shopify-section-{{ section.id }} .home-shop-the-look__heading-bar::before,
  #shopify-section-{{ section.id }} .home-shop-the-look__heading-bar::after {
    content: "";
    height: 0.1rem;
    background: rgba(255, 255, 255, 0.72);
  }

  #shopify-section-{{ section.id }} .home-shop-the-look__title {
    margin: 0;
    color: #ffffff;
    font-family: "Helvetica Now Condensed", "Helvetica Neue Condensed", "Arial Narrow", sans-serif;
    font-size: clamp(2.8rem, 8.6vw, 4.4rem);
    font-weight: 500;
    letter-spacing: 0;
    line-height: 1;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .home-shop-the-look__carousel,
  #shopify-section-{{ section.id }} .home-shop-the-look__details-carousel {
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    padding: 0 2rem 0.2rem;
    scroll-padding-inline: 2rem;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  #shopify-section-{{ section.id }} .home-shop-the-look__carousel::-webkit-scrollbar,
  #shopify-section-{{ section.id }} .home-shop-the-look__details-carousel::-webkit-scrollbar {
    display: none;
  }

  #shopify-section-{{ section.id }} .home-shop-the-look__track,
  #shopify-section-{{ section.id }} .home-shop-the-look__details-track {
    display: flex;
    gap: 1.4rem;
    width: max-content;
  }

  #shopify-section-{{ section.id }} .home-shop-the-look__slide {
    position: relative;
    flex: 0 0 90vw;
    width: 90vw;
    max-width: 90vw;
    min-height: 29rem;
    overflow: hidden;
    border-radius: 2rem;
    background: #101010;
    scroll-snap-align: center;
  }

  #shopify-section-{{ section.id }} .home-shop-the-look__bg,
  #shopify-section-{{ section.id }} .home-shop-the-look__bg .home-media,
  #shopify-section-{{ section.id }} .home-shop-the-look__bg .home-media--empty {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    min-height: 0;
  }

  #shopify-section-{{ section.id }} .home-shop-the-look__bg img,
  #shopify-section-{{ section.id }} .home-shop-the-look__side-image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #shopify-section-{{ section.id }} .home-shop-the-look__slide::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(0,0,0,0.78), rgba(0,0,0,0.54) 43%, rgba(0,0,0,0.18));
  }

  #shopify-section-{{ section.id }} .home-shop-the-look__content {
    position: relative;
    z-index: 2;
    display: flex;
    min-height: 29rem;
    width: 56%;
    flex-direction: column;
    justify-content: center;
    gap: 0.9rem;
    padding: 2.2rem 1.2rem 2.2rem 2.1rem;
  }

  #shopify-section-{{ section.id }} .home-shop-the-look__look-title {
    margin: 0;
    color: #ffffff;
    font-family: "Helvetica Now Condensed", "Helvetica Neue Condensed", "Arial Narrow", sans-serif;
    font-size: clamp(2.6rem, 8.2vw, 4.1rem);
    font-style: italic;
    font-weight: 500;
    letter-spacing: 0;
    line-height: 0.98;
    overflow-wrap: normal;
    word-break: normal;
  }

  #shopify-section-{{ section.id }} .home-shop-the-look__sentence {
    margin: 0;
    max-width: 18rem;
    color: rgba(255, 255, 255, 0.9);
    font-size: clamp(1.08rem, 3vw, 1.35rem);
    font-style: italic;
    line-height: 1.18;
    overflow-wrap: normal;
    word-break: normal;
  }

  #shopify-section-{{ section.id }} .home-shop-the-look__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: min(100%, 13.2rem);
    min-height: 4rem;
    margin-top: 0.85rem;
    border: 0.12rem solid rgba(255, 255, 255, 0.92);
    background: rgba(0, 0, 0, 0.12);
    color: #ffffff;
    font-family: "Helvetica Now Condensed", "Helvetica Neue Condensed", "Arial Narrow", sans-serif;
    font-size: 1.7rem;
    font-weight: 500;
    line-height: 1;
    text-align: center;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .home-shop-the-look__side-image {
    position: absolute;
    z-index: 1;
    top: 2.2rem;
    right: 1.5rem;
    bottom: 2.2rem;
    width: 42%;
    overflow: hidden;
    border-radius: 1.6rem;
    background: #181818;
  }

  #shopify-section-{{ section.id }} .home-shop-the-look__side-image .home-media,
  #shopify-section-{{ section.id }} .home-shop-the-look__side-image .home-media--empty {
    width: 100%;
    height: 100%;
    min-height: 0;
  }

  #shopify-section-{{ section.id }} .home-shop-the-look__dots {
    display: flex;
    justify-content: center;
    gap: 0.42rem;
    margin-top: 1.4rem;
  }

  #shopify-section-{{ section.id }} .home-shop-the-look__dot {
    width: 0.82rem;
    height: 0.82rem;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.52);
  }

  #shopify-section-{{ section.id }} .home-shop-the-look__dot.is-active,
  #shopify-section-{{ section.id }} .home-shop-the-look__dot:first-child {
    background: #ffffff;
  }

  #shopify-section-{{ section.id }} .home-shop-the-look__details {
    margin-top: 2.4rem;
    color: #1a1a1a;
  }

  #shopify-section-{{ section.id }} .home-shop-the-look__details-slide {
    flex: 0 0 90vw;
    width: 90vw;
    max-width: 90vw;
    scroll-snap-align: center;
  }

  #shopify-section-{{ section.id }} .home-shop-the-look__details-label {
    margin: 0 0 0.3rem;
    color: rgba(255, 255, 255, 0.72);
    font-family: "Helvetica Now Condensed", "Helvetica Neue Condensed", "Arial Narrow", sans-serif;
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .home-shop-the-look__details-title {
    margin: 0;
    color: #ffffff;
    font-family: Optima, "Palatino Linotype", serif;
    font-size: 2rem;
    font-weight: 400;
    line-height: 1.05;
  }

  #shopify-section-{{ section.id }} .home-shop-the-look__details-sentence {
    margin: 0.2rem 0 0.8rem;
    color: rgba(255, 255, 255, 0.82);
    font-family: Optima, "Palatino Linotype", serif;
    font-size: 1.15rem;
    line-height: 1.2;
  }

  #shopify-section-{{ section.id }} .home-shop-the-look__details-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.8rem;
  }

  #shopify-section-{{ section.id }} .home-shop-the-look__details-main {
    overflow: hidden;
    border-radius: 0.35rem;
    background: #111111;
    aspect-ratio: 16 / 9;
  }

  #shopify-section-{{ section.id }} .home-shop-the-look__details-main img,
  #shopify-section-{{ section.id }} .home-shop-the-look__item-image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #shopify-section-{{ section.id }} .home-shop-the-look__items {
    display: grid;
    gap: 0.7rem;
  }

  #shopify-section-{{ section.id }} .home-shop-the-look__item {
    display: grid;
    grid-template-columns: 7.2rem minmax(0, 1fr);
    gap: 0.9rem;
    align-items: center;
    padding: 0.7rem;
    border: 0.1rem solid rgba(0, 0, 0, 0.09);
    border-radius: 0.7rem;
    background: rgba(255, 255, 255, 0.94);
    color: #151515;
  }

  #shopify-section-{{ section.id }} .home-shop-the-look__item-image {
    overflow: hidden;
    border-radius: 0.25rem;
    background: #e8e8e8;
    aspect-ratio: 1 / 1;
  }

  #shopify-section-{{ section.id }} .home-shop-the-look__item-placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #eeeeee, #d5d5d5);
  }

  #shopify-section-{{ section.id }} .home-shop-the-look__item-content {
    min-width: 0;
  }

  #shopify-section-{{ section.id }} .home-shop-the-look__item-title {
    margin: 0;
    color: #111111;
    font-family: "Helvetica Now Condensed", "Helvetica Neue Condensed", "Arial Narrow", sans-serif;
    font-size: 1.28rem;
    font-weight: 700;
    line-height: 1.05;
  }

  #shopify-section-{{ section.id }} .home-shop-the-look__item-description {
    margin: 0.25rem 0 0.6rem;
    color: rgba(0, 0, 0, 0.72);
    font-size: 1.03rem;
    line-height: 1.18;
  }

  #shopify-section-{{ section.id }} .home-shop-the-look__item-action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.6rem;
    padding: 0 1rem;
    border: 0.12rem solid #303030;
    color: #151515;
    font-family: "Helvetica Now Condensed", "Helvetica Neue Condensed", "Arial Narrow", sans-serif;
    font-size: 1.02rem;
    font-weight: 800;
    letter-spacing: 0.02em;
    line-height: 1;
    text-decoration: none;
    text-transform: uppercase;
  }

  @media screen and (min-width: 420px) {
    #shopify-section-{{ section.id }} .home-shop-the-look__details-grid {
      grid-template-columns: 1.05fr 0.95fr;
      align-items: stretch;
    }

    #shopify-section-{{ section.id }} .home-shop-the-look__details-main {
      aspect-ratio: auto;
      min-height: 18.6rem;
    }
  }

  @media screen and (max-width: 374px) {
    #shopify-section-{{ section.id }} .home-shop-the-look__carousel,
    #shopify-section-{{ section.id }} .home-shop-the-look__details-carousel {
      padding-inline: 1.4rem;
      scroll-padding-inline: 1.4rem;
    }

    #shopify-section-{{ section.id }} .home-shop-the-look__slide,
    #shopify-section-{{ section.id }} .home-shop-the-look__details-slide {
      flex-basis: 91vw;
      width: 91vw;
      max-width: 91vw;
    }

    #shopify-section-{{ section.id }} .home-shop-the-look__slide {
      min-height: 26.5rem;
    }

    #shopify-section-{{ section.id }} .home-shop-the-look__content {
      min-height: 26.5rem;
      width: 58%;
      padding-left: 1.55rem;
    }

    #shopify-section-{{ section.id }} .home-shop-the-look__side-image {
      right: 1rem;
      width: 41%;
    }

    #shopify-section-{{ section.id }} .home-shop-the-look__button {
      width: min(100%, 11.8rem);
      min-height: 3.7rem;
      font-size: 1.5rem;
    }
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .home-shop-the-look .home-editorial__inner {
      padding: 5.2rem 0 6rem;
    }

    #shopify-section-{{ section.id }} .home-shop-the-look__heading-bar {
      gap: 2.2rem;
      margin-bottom: 3rem;
    }

    #shopify-section-{{ section.id }} .home-shop-the-look__title {
      font-size: clamp(3.6rem, 4vw, 5.8rem);
    }

    #shopify-section-{{ section.id }} .home-shop-the-look__carousel,
    #shopify-section-{{ section.id }} .home-shop-the-look__details-carousel {
      padding-inline: 5.6rem;
      scroll-padding-inline: 5.6rem;
    }

    #shopify-section-{{ section.id }} .home-shop-the-look__track,
    #shopify-section-{{ section.id }} .home-shop-the-look__details-track {
      gap: 2rem;
    }

    #shopify-section-{{ section.id }} .home-shop-the-look__slide,
    #shopify-section-{{ section.id }} .home-shop-the-look__details-slide {
      flex-basis: min(72vw, 68rem);
      width: min(72vw, 68rem);
      max-width: 68rem;
    }

    #shopify-section-{{ section.id }} .home-shop-the-look__slide {
      min-height: 38rem;
    }

    #shopify-section-{{ section.id }} .home-shop-the-look__content {
      min-height: 38rem;
      padding-left: 3.2rem;
    }
  }
</style>

{%- liquid
  assign fallback_titles = 'Morning Loop|Afternoon Pause|After Hours|Weekend Ease' | split: '|'
  assign fallback_sentences = 'A polished everyday pairing made for first meetings, quick errands, and everything in motion.|Soft structure for the quiet in-between moments that still need to look composed.|Easy pieces that move from office hours to after-work plans without overthinking.|Relaxed polish for slow days, casual plans, and dressing with less effort.' | split: '|'
  assign fallback_detail_sentences = 'For early starts and everything ahead.|Soft structure for quiet in-between moments.|Easy pieces that move from office hours to after-work plans.|Relaxed polish for slow days and casual plans.' | split: '|'
  assign fallback_product_1_titles = 'Inah Blouse|Inah Blouse|Daliah Polo|Daliah Polo' | split: '|'
  assign fallback_product_1_descriptions = 'Breathable, belted, and beautifully structured.|Lightweight ease with a polished everyday finish.|A structured polo top with utility-inspired detail.|Casual structure that still feels refined.' | split: '|'
  assign fallback_product_2_titles = 'Demi Barrel Pants|Hazel Trouser|Demi Barrel Pants|Hazel Trouser' | split: '|'
  assign fallback_product_2_descriptions = 'Relaxed silhouette with a clean, modern drape.|A relaxed trouser shape made for movement and comfort.|Soft volume with a clean waist and easy drape.|Comfortable, versatile, and easy to style on repeat.' | split: '|'
-%}

<section class="home-editorial home-shop-the-look" data-shop-look-section="{{ section.id }}">
  <div class="home-editorial__inner">
    <div class="home-shop-the-look__heading-bar">
      <h2 class="home-shop-the-look__title">{{ section.settings.section_heading | default: 'Shop the Look' | escape }}</h2>
    </div>

    <div class="home-shop-the-look__carousel" aria-label="Shop the Look carousel" data-look-carousel>
      <div class="home-shop-the-look__track">
        {%- for block in section.blocks -%}
          <article class="home-shop-the-look__slide" data-look-slide data-index="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
            <div class="home-shop-the-look__bg" aria-hidden="true">
              {%- if block.settings.look_image != blank -%}
                <div class="home-media">
                  {{ block.settings.look_image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '375, 550, 750, 900, 1100, 1400', alt: block.settings.image_alt }}
                </div>
              {%- else -%}
                <div class="home-media home-media--empty"></div>
              {%- endif -%}
            </div>

            <div class="home-shop-the-look__content">
              <h3 class="home-shop-the-look__look-title">{{ block.settings.look_title | default: fallback_titles[forloop.index0] | escape }}</h3>
              {%- if block.settings.look_sentence != blank -%}
                <p class="home-shop-the-look__sentence">{{ block.settings.look_sentence | escape }}</p>
              {%- endif -%}
              <a class="home-shop-the-look__button" href="#look-details-{{ section.id }}" data-look-details-link data-index="{{ forloop.index0 }}">{{ block.settings.button_label | default: 'View Look' | escape }}</a>
            </div>

            <div class="home-shop-the-look__side-image" aria-hidden="true">
              {%- if block.settings.look_image != blank -%}
                <div class="home-media">
                  {{ block.settings.look_image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '260, 360, 540, 720, 800', alt: block.settings.image_alt }}
                </div>
              {%- else -%}
                <div class="home-media home-media--empty"></div>
              {%- endif -%}
            </div>
          </article>
        {%- else -%}
          {%- for fallback_title in fallback_titles -%}
            <article class="home-shop-the-look__slide" data-look-slide data-index="{{ forloop.index0 }}">
              <div class="home-shop-the-look__bg" aria-hidden="true"><div class="home-media home-media--empty"></div></div>
              <div class="home-shop-the-look__content">
                <h3 class="home-shop-the-look__look-title">{{ fallback_title }}</h3>
                <p class="home-shop-the-look__sentence">{{ fallback_sentences[forloop.index0] }}</p>
                <a class="home-shop-the-look__button" href="#look-details-{{ section.id }}" data-look-details-link data-index="{{ forloop.index0 }}">View Look</a>
              </div>
              <div class="home-shop-the-look__side-image" aria-hidden="true"><div class="home-media home-media--empty"></div></div>
            </article>
          {%- endfor -%}
        {%- endfor -%}
      </div>
    </div>

    <div class="home-shop-the-look__dots" aria-hidden="true" data-look-dots>
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}<span class="home-shop-the-look__dot{% if forloop.first %} is-active{% endif %}"></span>{%- endfor -%}
      {%- else -%}
        {%- for i in (1..4) -%}<span class="home-shop-the-look__dot{% if forloop.first %} is-active{% endif %}"></span>{%- endfor -%}
      {%- endif -%}
    </div>

    <div class="home-shop-the-look__details" id="look-details-{{ section.id }}">
      <div class="home-shop-the-look__details-carousel" aria-label="Look Details carousel" data-look-details-carousel>
        <div class="home-shop-the-look__details-track">
          {%- for block in section.blocks -%}
            {%- liquid
              assign detail_title = block.settings.detail_heading | default: block.settings.look_title | default: fallback_titles[forloop.index0]
              assign detail_sentence = block.settings.detail_sentence | default: fallback_detail_sentences[forloop.index0]
              assign product_1_link = '#'
              if block.settings.product_1_custom_url != blank
                assign product_1_link = block.settings.product_1_custom_url
              elsif block.settings.product_1 != blank
                assign product_1_link = block.settings.product_1.url
              endif
              assign product_2_link = '#'
              if block.settings.product_2_custom_url != blank
                assign product_2_link = block.settings.product_2_custom_url
              elsif block.settings.product_2 != blank
                assign product_2_link = block.settings.product_2.url
              endif
              assign product_1_title = block.settings.product_1_title | default: block.settings.product_1.title | default: fallback_product_1_titles[forloop.index0]
              assign product_2_title = block.settings.product_2_title | default: block.settings.product_2.title | default: fallback_product_2_titles[forloop.index0]
              assign product_1_description = block.settings.product_1_description | default: fallback_product_1_descriptions[forloop.index0]
              assign product_2_description = block.settings.product_2_description | default: fallback_product_2_descriptions[forloop.index0]
            -%}
            <article class="home-shop-the-look__details-slide" data-look-details-slide data-index="{{ forloop.index0 }}">
              <p class="home-shop-the-look__details-label">Look Details</p>
              <h3 class="home-shop-the-look__details-title">{{ detail_title | escape }}</h3>
              <p class="home-shop-the-look__details-sentence">{{ detail_sentence | escape }}</p>

              <div class="home-shop-the-look__details-grid">
                <div class="home-shop-the-look__details-main">
                  {%- if block.settings.detail_main_image != blank -%}
                    {{ block.settings.detail_main_image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '375, 550, 750, 900, 1000', alt: block.settings.image_alt }}
                  {%- elsif block.settings.look_image != blank -%}
                    {{ block.settings.look_image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '375, 550, 750, 900, 1000', alt: block.settings.image_alt }}
                  {%- else -%}
                    <div class="home-shop-the-look__item-placeholder"></div>
                  {%- endif -%}
                </div>

                <div class="home-shop-the-look__items">
                  <div class="home-shop-the-look__item">
                    <div class="home-shop-the-look__item-image">
                      {%- if block.settings.product_1_image != blank -%}
                        {{ block.settings.product_1_image | image_url: width: 420 | image_tag: loading: 'lazy', widths: '160, 240, 320, 420', alt: product_1_title }}
                      {%- elsif block.settings.product_1.featured_image != blank -%}
                        {{ block.settings.product_1.featured_image | image_url: width: 420 | image_tag: loading: 'lazy', widths: '160, 240, 320, 420', alt: product_1_title }}
                      {%- else -%}
                        <div class="home-shop-the-look__item-placeholder"></div>
                      {%- endif -%}
                    </div>
                    <div class="home-shop-the-look__item-content">
                      <h4 class="home-shop-the-look__item-title">{{ product_1_title | escape }}</h4>
                      <p class="home-shop-the-look__item-description">{{ product_1_description | escape }}</p>
                      <a class="home-shop-the-look__item-action" href="{{ product_1_link }}">{{ block.settings.product_1_button_label | default: 'SEE FIT & COLORS' | escape }}</a>
                    </div>
                  </div>

                  <div class="home-shop-the-look__item">
                    <div class="home-shop-the-look__item-image">
                      {%- if block.settings.product_2_image != blank -%}
                        {{ block.settings.product_2_image | image_url: width: 420 | image_tag: loading: 'lazy', widths: '160, 240, 320, 420', alt: product_2_title }}
                      {%- elsif block.settings.product_2.featured_image != blank -%}
                        {{ block.settings.product_2.featured_image | image_url: width: 420 | image_tag: loading: 'lazy', widths: '160, 240, 320, 420', alt: product_2_title }}
                      {%- else -%}
                        <div class="home-shop-the-look__item-placeholder"></div>
                      {%- endif -%}
                    </div>
                    <div class="home-shop-the-look__item-content">
                      <h4 class="home-shop-the-look__item-title">{{ product_2_title | escape }}</h4>
                      <p class="home-shop-the-look__item-description">{{ product_2_description | escape }}</p>
                      <a class="home-shop-the-look__item-action" href="{{ product_2_link }}">{{ block.settings.product_2_button_label | default: 'SEE FIT & COLORS' | escape }}</a>
                    </div>
                  </div>
                </div>
              </div>
            </article>
          {%- else -%}
            {%- for fallback_title in fallback_titles -%}
              <article class="home-shop-the-look__details-slide" data-look-details-slide data-index="{{ forloop.index0 }}">
                <p class="home-shop-the-look__details-label">Look Details</p>
                <h3 class="home-shop-the-look__details-title">{{ fallback_title }}</h3>
                <p class="home-shop-the-look__details-sentence">{{ fallback_detail_sentences[forloop.index0] }}</p>
                <div class="home-shop-the-look__details-grid">
                  <div class="home-shop-the-look__details-main"><div class="home-shop-the-look__item-placeholder"></div></div>
                  <div class="home-shop-the-look__items">
                    <div class="home-shop-the-look__item"><div class="home-shop-the-look__item-image"><div class="home-shop-the-look__item-placeholder"></div></div><div class="home-shop-the-look__item-content"><h4 class="home-shop-the-look__item-title">{{ fallback_product_1_titles[forloop.index0] }}</h4><p class="home-shop-the-look__item-description">{{ fallback_product_1_descriptions[forloop.index0] }}</p><a class="home-shop-the-look__item-action" href="#">SEE FIT & COLORS</a></div></div>
                    <div class="home-shop-the-look__item"><div class="home-shop-the-look__item-image"><div class="home-shop-the-look__item-placeholder"></div></div><div class="home-shop-the-look__item-content"><h4 class="home-shop-the-look__item-title">{{ fallback_product_2_titles[forloop.index0] }}</h4><p class="home-shop-the-look__item-description">{{ fallback_product_2_descriptions[forloop.index0] }}</p><a class="home-shop-the-look__item-action" href="#">SEE FIT & COLORS</a></div></div>
