<script>
  (() => {
    const section = document.querySelector('[data-section-id="{{ section.id }}"]');
    if (!section) return;

    const form = section.querySelector('[data-jane-set-form]');
    const componentProductsElement = section.querySelector('[data-component-products]');
    const colorOptions = section.querySelector('[data-color-options]');
    const selectedColorText = section.querySelector('[data-selected-color]');
    const topSizeOptions = section.querySelector('[data-top-size-options]');
    const pantsSizeOptions = section.querySelector('[data-pants-size-options]');
    const submitButton = section.querySelector('[data-submit]');
    const submitText = section.querySelector('[data-submit-text]');
    const errorMessage = section.querySelector('[data-set-error]');
    const stickyAtc = section.querySelector('[data-sticky-atc]');
    const stickyContext = section.querySelector('[data-sticky-context]');
    const stickySubmitButton = section.querySelector('[data-sticky-submit]');
    const stickySubmitText = section.querySelector('[data-sticky-submit-text]');
    const slider = section.querySelector('[data-slider]');
    const dots = section.querySelector('[data-dots]');
    const prevButton = section.querySelector('[data-gallery-prev]');
    const nextButton = section.querySelector('[data-gallery-next]');
    const productMediaElement = section.querySelector('[data-product-media]');
    const reviewsLink = section.querySelector('[data-reviews-link]');
    const sizeChartToggle = section.querySelector('[data-size-chart-toggle]');
    const sizeChartToggleText = section.querySelector('[data-size-chart-toggle-text]');
    const sizeChartPanel = section.querySelector('[data-size-chart-panel]');
    const sizeChartImage = section.querySelector('[data-size-chart-image]');

    if (
      !form ||
      !componentProductsElement ||
      !colorOptions ||
      !topSizeOptions ||
      !pantsSizeOptions ||
      !submitButton
    ) {
      return;
    }

    const componentProducts = JSON.parse(componentProductsElement.textContent || '{}');
    const productMedia = productMediaElement ? JSON.parse(productMediaElement.textContent || '[]') : [];
    const sizes = ['Medium', 'Large', 'XL', '2XL', '3XL'];
    const setPrice = {{ section.settings.set_price_text | json }};
    const ctaText = {{ section.settings.cta_text | json }};
    const sizeChartTriggerText = {{ section.settings.size_chart_trigger_text | json }};
    const productImageAlt = {{ lp_product.title | json }};
    let selectedColor = '';
    let selectedTopSize = '';
    let selectedPantsSize = '';
    let isAdding = false;

    const normalize = value => String(value || '').trim().toLowerCase();

    function getComponentVariants(role) {
      return componentProducts[selectedColor]?.[role] || [];
    }

    function findVariant(role, size) {
      return getComponentVariants(role).find(variant => normalize(variant.size) === normalize(size)) || null;
    }

    function renderSizeOptions(container, role, selectedSize) {
      container.innerHTML = sizes.map(size => {
        const variant = findVariant(role, size);
        const available = Boolean(variant?.available);
        const selected = normalize(size) === normalize(selectedSize);

        return `
          <button
            type="button"
            class="kasya-product-hero__size ${selected ? 'is-selected' : ''} ${available ? '' : 'is-disabled'}"
            data-set-size="${size}"
            data-set-role="${role}"
            aria-pressed="${selected}"
            aria-disabled="${!available}"
          >
            ${size}
          </button>
        `;
      }).join('');
    }

    function renderSelectors() {
      renderSizeOptions(topSizeOptions, 'top', selectedTopSize);
      renderSizeOptions(pantsSizeOptions, 'pants', selectedPantsSize);
    }

    function getSelectionState() {
      const topVariant = findVariant('top', selectedTopSize);
      const pantsVariant = findVariant('pants', selectedPantsSize);
      const complete = Boolean(selectedColor && selectedTopSize && selectedPantsSize);
      const available = Boolean(complete && topVariant?.available && pantsVariant?.available);

      return { topVariant, pantsVariant, complete, available };
    }

    function setButtonState() {
      const { complete, available } = getSelectionState();
      const label = complete && !available ? 'SOLD OUT' : ctaText;
      const disabled = isAdding || !available;

      submitButton.disabled = disabled;
      if (submitText && !isAdding) submitText.textContent = label;

      if (stickySubmitButton) {
        stickySubmitButton.disabled = disabled;
      }
      if (stickySubmitText && !isAdding) {
        stickySubmitText.textContent = label;
      }
      if (stickyContext) {
        const selection = [
          selectedColor,
          selectedTopSize ? `TOP ${selectedTopSize}` : '',
          selectedPantsSize ? `PANTS ${selectedPantsSize}` : ''
        ].filter(Boolean).join(' / ');
        stickyContext.textContent = `${selection || 'SELECT COLOR AND SIZES'} — ${setPrice}`;
      }
    }

    function clearError() {
      if (!errorMessage) return;
      errorMessage.hidden = true;
      errorMessage.textContent = '';
    }

    function showError(message) {
      if (!errorMessage) return;
      errorMessage.textContent = message;
      errorMessage.hidden = false;
    }

    function selectColor(color) {
      selectedColor = color;
      selectedTopSize = '';
      selectedPantsSize = '';
      clearError();

      colorOptions.querySelectorAll('[data-color-value]').forEach(button => {
        const selected = normalize(button.dataset.colorValue) === normalize(selectedColor);
        button.classList.toggle('is-selected', selected);
        button.setAttribute('aria-pressed', String(selected));
      });

      if (selectedColorText) selectedColorText.textContent = selectedColor.toUpperCase();
      renderSelectors();
      setButtonState();

      document.dispatchEvent(new CustomEvent('kasya:hero-color-change', {
        detail: {
          color: selectedColor,
          displayColor: selectedColor,
          images: {},
          fabricCloseup: '',
          featuredImage: productMedia[0]?.src || ''
        }
      }));
    }

    function selectSize(role, size) {
      if (role === 'top') {
        selectedTopSize = size;
      } else {
        selectedPantsSize = size;
      }

      clearError();
      renderSelectors();
      setButtonState();
    }

    function renderGallery() {
      if (!slider || !dots || !productMedia.length) return;

      slider.innerHTML = productMedia.map((media, index) => `
        <div class="kasya-product-hero__slide">
          <img
            src="${media.src}"
            alt="${productImageAlt} ${index + 1}"
            width="1400"
            height="1750"
            loading="${index === 0 ? 'eager' : 'lazy'}"
          >
        </div>
      `).join('');

      dots.innerHTML = productMedia.map((_, index) => `
        <button
          type="button"
          class="kasya-product-hero__dot ${index === 0 ? 'is-active' : ''}"
          aria-label="Go to image ${index + 1}"
          data-dot-index="${index}"
        ></button>
      `).join('');

      const hasMultipleImages = productMedia.length > 1;
      if (prevButton) prevButton.hidden = !hasMultipleImages;
      if (nextButton) nextButton.hidden = !hasMultipleImages;
    }

    function getCurrentSlideIndex() {
      if (!slider?.clientWidth) return 0;
      const slideCount = slider.querySelectorAll('.kasya-product-hero__slide').length;
      return Math.min(slideCount - 1, Math.max(0, Math.round(slider.scrollLeft / slider.clientWidth)));
    }

    function scrollToSlide(index) {
      const slides = slider?.querySelectorAll('.kasya-product-hero__slide');
      if (!slides?.length) return;
      const targetIndex = (index + slides.length) % slides.length;
      slider.scrollTo({ left: slider.clientWidth * targetIndex, behavior: 'smooth' });
    }

    function updateDots() {
      const activeIndex = getCurrentSlideIndex();
      dots?.querySelectorAll('[data-dot-index]').forEach((dot, index) => {
        dot.classList.toggle('is-active', index === activeIndex);
      });
    }

    function initializeStickyVisibility() {
      if (!stickyAtc || !submitButton) return;
      document.body.classList.add('kasya-sticky-atc-enabled');

      const setVisible = visible => stickyAtc.classList.toggle('is-visible', visible);
      if (!('IntersectionObserver' in window)) return;

      const observer = new IntersectionObserver(entries => {
        const entry = entries[0];
        setVisible(!entry.isIntersecting && entry.boundingClientRect.bottom <= 0);
      }, { threshold: 0 });

      observer.observe(submitButton);
    }

    async function addSetToCart() {
      if (isAdding) return;

      const { topVariant, pantsVariant, complete, available } = getSelectionState();

      if (!complete) {
        showError('Please select a color, top size, and pants size.');
        setButtonState();
        return;
      }

      if (!available) {
        showError('This size combination is currently unavailable.');
        setButtonState();
        return;
      }

      isAdding = true;
      clearError();
      submitButton.disabled = true;
      if (submitText) submitText.textContent = 'ADDING...';
      if (stickySubmitButton) stickySubmitButton.disabled = true;
      if (stickySubmitText) stickySubmitText.textContent = 'ADDING...';

      const properties = {
        _set_name: 'Jane Coordinates Set',
        _set_color: selectedColor,
        _top_size: selectedTopSize,
        _pants_size: selectedPantsSize
      };

      try {
        const response = await fetch('/cart/add.js', {
          method: 'POST',
          headers: {
            'Accept': 'application/json',
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            items: [
              {
                id: topVariant.id,
                quantity: 1,
                properties: { ...properties, _set_role: 'Top' }
              },
              {
                id: pantsVariant.id,
                quantity: 1,
                properties: { ...properties, _set_role: 'Pants' }
              }
            ]
          })
        });

        if (!response.ok) {
          const error = await response.json().catch(() => ({}));
          throw new Error(error.description || error.message || 'Unable to add this set to your cart.');
        }

        window.location.assign('/cart');
      } catch (error) {
        isAdding = false;
        showError(error.message || 'Unable to add this set to your cart. Please try again.');
        setButtonState();
      }
    }

    colorOptions.addEventListener('click', event => {
      const button = event.target.closest('[data-color-value]');
      if (button) selectColor(button.dataset.colorValue);
    });

    section.addEventListener('click', event => {
      const sizeButton = event.target.closest('[data-set-size]');
      if (sizeButton) {
        selectSize(sizeButton.dataset.setRole, sizeButton.dataset.setSize);
      }
    });

    form.addEventListener('submit', event => {
      event.preventDefault();
      addSetToCart();
    });

    stickySubmitButton?.addEventListener('click', addSetToCart);
    slider?.addEventListener('scroll', () => window.requestAnimationFrame(updateDots));
    prevButton?.addEventListener('click', () => scrollToSlide(getCurrentSlideIndex() - 1));
    nextButton?.addEventListener('click', () => scrollToSlide(getCurrentSlideIndex() + 1));
    dots?.addEventListener('click', event => {
      const dot = event.target.closest('[data-dot-index]');
      if (dot) scrollToSlide(Number(dot.dataset.dotIndex));
    });

    sizeChartToggle?.addEventListener('click', () => {
      const expanded = sizeChartToggle.getAttribute('aria-expanded') === 'true';
      sizeChartToggle.setAttribute('aria-expanded', String(!expanded));
      if (sizeChartPanel) sizeChartPanel.hidden = expanded;
      if (!expanded && sizeChartImage && !sizeChartImage.getAttribute('src')) {
        sizeChartImage.setAttribute('src', sizeChartImage.dataset.sizeChartSrc);
      }
      if (sizeChartToggleText) {
        sizeChartToggleText.textContent = expanded ? sizeChartTriggerText : 'Hide size chart';
      }
    });

    reviewsLink?.addEventListener('click', event => {
      const target = document.querySelector(reviewsLink.getAttribute('href'));
      if (!target) return;
      event.preventDefault();
      target.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });

    renderGallery();
    renderSelectors();
    setButtonState();
    initializeStickyVisibility();
  })();
</script>

