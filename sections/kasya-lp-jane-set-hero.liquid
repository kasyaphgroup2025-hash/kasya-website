{% comment %}
  KasyaPH Jane Set Landing Hero
  Uses one visible parent product and four hidden component products.
{% endcomment %}

{% liquid
  assign lp_product = section.settings.product
  assign black_top_product = section.settings.black_top_product
  assign black_pants_product = section.settings.black_pants_product
  assign taupe_top_product = section.settings.taupe_top_product
  assign taupe_pants_product = section.settings.taupe_pants_product

  if lp_product == blank and product
    assign lp_product = product
  endif

  if lp_product != blank
    assign size_chart_image = section.settings.size_chart_image
    assign size_chart_alt = section.settings.size_chart_trigger_text

    for media in lp_product.media
      if media.media_type == 'image' and media.preview_image != blank and media.alt == 'LP | Size Chart'
        assign size_chart_image = media.preview_image
        assign size_chart_alt = media.alt
        break
      endif
    endfor
  endif
%}

<section class="kasya-product-hero{% if section.settings.enable_sticky_atc %} kasya-product-hero--sticky-enabled{% endif %}" data-kasya-hero data-section-id="{{ section.id }}">
  {% if lp_product == blank %}
    <div class="kasya-product-hero__empty">
      <p>Select a product in this section's settings.</p>
    </div>
  {% else %}
    {% if section.settings.show_header %}
      <header class="kasya-product-hero__header">
        <button class="kasya-product-hero__menu" type="button" aria-label="Open menu">
          <span></span>
          <span></span>
          <span></span>
        </button>

        <a class="kasya-product-hero__logo" href="/">
          {{ section.settings.logo_text }}
        </a>

        <a class="kasya-product-hero__cart" href="/cart" aria-label="Cart">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M6.2 6.2h15l-1.7 8.4H7.7L6.2 6.2Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>
            <path d="M6.2 6.2 5.7 3.5H2.8" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
            <circle cx="9" cy="20" r="1.35" fill="currentColor"/>
            <circle cx="18" cy="20" r="1.35" fill="currentColor"/>
          </svg>
        </a>
      </header>
    {% endif %}

    <div class="kasya-product-hero__gallery" data-gallery>
      <div class="kasya-product-hero__slider" data-slider>
        {% if lp_product.featured_image != blank %}
          <div class="kasya-product-hero__slide">
            <img
              src="{{ lp_product.featured_image | image_url: width: 1400 }}"
              alt="{{ lp_product.title | escape }}"
              width="1400"
              height="1750"
              loading="eager"
            >
          </div>
        {% endif %}
      </div>

      <button
        type="button"
        class="kasya-product-hero__arrow kasya-product-hero__arrow--prev"
        aria-label="Previous image"
        data-gallery-prev
        hidden
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="m15 18-6-6 6-6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>

      <button
        type="button"
        class="kasya-product-hero__arrow kasya-product-hero__arrow--next"
        aria-label="Next image"
        data-gallery-next
        hidden
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="m9 6 6 6-6 6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>

      <div class="kasya-product-hero__dots" data-dots></div>
    </div>

    <div class="kasya-product-hero__info">
      <div class="kasya-product-hero__meta-row">
        {% if section.settings.product_label != blank %}
          <p class="kasya-product-hero__label">
            {{ section.settings.product_label }}
          </p>
        {% endif %}

        {% if section.settings.rating_text != blank %}
          <a class="kasya-product-hero__rating" href="#kasya-lp-reviews" aria-label="Read customer reviews" data-reviews-link>
            <span>★★★★★</span>
            <small>{{ section.settings.rating_text }}</small>
          </a>
        {% endif %}
      </div>

      <div class="kasya-product-hero__title-row">
        <div>
          <h1 class="kasya-product-hero__title">
            {{ section.settings.heading | default: lp_product.title }}
          </h1>

          {% if section.settings.subtitle != blank %}
            <p class="kasya-product-hero__subtitle">
              {{ section.settings.subtitle }}
            </p>
          {% endif %}
        </div>

        <div class="kasya-product-hero__set-pricing">
          <span class="kasya-product-hero__compare-price">{{ section.settings.compare_at_price_text }}</span>
          <span class="kasya-product-hero__price">{{ section.settings.set_price_text }}</span>
          <span class="kasya-product-hero__discount">{{ section.settings.discount_badge_text }}</span>
        </div>
      </div>

      {% if section.settings.description != blank %}
        <p class="kasya-product-hero__description">
          {{ section.settings.description }}
        </p>
      {% endif %}

      <form class="kasya-product-hero__form" data-jane-set-form novalidate>
        <script type="application/json" data-component-products>
          {
            "Black": {
              "top": [
                {% for variant in black_top_product.variants %}
                  {
                    "id": {{ variant.id | json }},
                    "size": {{ variant.option1 | json }},
                    "available": {{ variant.available | json }}
                  }{% unless forloop.last %},{% endunless %}
                {% endfor %}
              ],
              "pants": [
                {% for variant in black_pants_product.variants %}
                  {
                    "id": {{ variant.id | json }},
                    "size": {{ variant.option1 | json }},
                    "available": {{ variant.available | json }}
                  }{% unless forloop.last %},{% endunless %}
                {% endfor %}
              ]
            },
            "Taupe": {
              "top": [
                {% for variant in taupe_top_product.variants %}
                  {
                    "id": {{ variant.id | json }},
                    "size": {{ variant.option1 | json }},
                    "available": {{ variant.available | json }}
                  }{% unless forloop.last %},{% endunless %}
                {% endfor %}
              ],
              "pants": [
                {% for variant in taupe_pants_product.variants %}
                  {
                    "id": {{ variant.id | json }},
                    "size": {{ variant.option1 | json }},
                    "available": {{ variant.available | json }}
                  }{% unless forloop.last %},{% endunless %}
                {% endfor %}
              ]
            }
          }
        </script>

        <script type="application/json" data-product-media>
          [
            {% assign lp_media_count = 0 %}
            {% for media in lp_product.media %}
              {% if media.media_type == 'image' and media.preview_image != blank %}
                {% if lp_media_count > 0 %},{% endif %}
                {% assign lp_media_count = lp_media_count | plus: 1 %}
                {
                  "alt": {{ media.alt | json }},
                  "src": {{ media.preview_image | image_url: width: 1400 | json }}
                }
              {% endif %}
            {% endfor %}
          ]
        </script>

        <script type="application/json" data-color-blocks>
          [
            {% for block in section.blocks %}
              {
                "display_name": {{ block.settings.display_name | json }},
                "option_value": {{ block.settings.option_value | json }},
                "swatch": {% if block.settings.swatch_color != blank %}{{ block.settings.swatch_color | json }}{% else %}null{% endif %},
                "image_1": {% if block.settings.image_1 != blank %}{{ block.settings.image_1 | image_url: width: 1400 | json }}{% else %}null{% endif %},
                "image_2": {% if block.settings.image_2 != blank %}{{ block.settings.image_2 | image_url: width: 1400 | json }}{% else %}null{% endif %},
                "image_3": {% if block.settings.image_3 != blank %}{{ block.settings.image_3 | image_url: width: 1400 | json }}{% else %}null{% endif %},
                "image_4": {% if block.settings.image_4 != blank %}{{ block.settings.image_4 | image_url: width: 1400 | json }}{% else %}null{% endif %},
                "image_5": {% if block.settings.image_5 != blank %}{{ block.settings.image_5 | image_url: width: 1400 | json }}{% else %}null{% endif %},
                "images": [
                  {% assign image_count = 0 %}

                  {% if block.settings.image_1 != blank %}
                    {% assign image_count = image_count | plus: 1 %}
                    {{ block.settings.image_1 | image_url: width: 1400 | json }}
                  {% endif %}

                  {% if block.settings.image_2 != blank %}
                    {% if image_count > 0 %},{% endif %}
                    {% assign image_count = image_count | plus: 1 %}
                    {{ block.settings.image_2 | image_url: width: 1400 | json }}
                  {% endif %}

                  {% if block.settings.image_3 != blank %}
                    {% if image_count > 0 %},{% endif %}
                    {% assign image_count = image_count | plus: 1 %}
                    {{ block.settings.image_3 | image_url: width: 1400 | json }}
                  {% endif %}

                  {% if block.settings.image_4 != blank %}
                    {% if image_count > 0 %},{% endif %}
                    {% assign image_count = image_count | plus: 1 %}
                    {{ block.settings.image_4 | image_url: width: 1400 | json }}
                  {% endif %}

                  {% if block.settings.image_5 != blank %}
                    {% if image_count > 0 %},{% endif %}
                    {% assign image_count = image_count | plus: 1 %}
                    {{ block.settings.image_5 | image_url: width: 1400 | json }}
                  {% endif %}
                ]
              }{% unless forloop.last %},{% endunless %}
            {% endfor %}
          ]
        </script>

        <div class="kasya-product-hero__swatches-wrap">
          <p class="kasya-product-hero__option-label">COLOR</p>
          <div class="kasya-product-hero__swatches" data-color-options>
            <button
              type="button"
              class="kasya-product-hero__color-option"
              data-color-value="Black"
              aria-pressed="false"
            >
              <span class="kasya-product-hero__color-dot kasya-product-hero__color-dot--black"></span>
              Black
            </button>
            <button
              type="button"
              class="kasya-product-hero__color-option"
              data-color-value="Taupe"
              aria-pressed="false"
            >
              <span class="kasya-product-hero__color-dot kasya-product-hero__color-dot--taupe"></span>
              Taupe
            </button>
          </div>

          <p class="kasya-product-hero__selected-color">
            COLOR: <span data-selected-color>PLEASE SELECT</span>
          </p>
        </div>

        <div class="kasya-product-hero__sizes-wrap">
          <p class="kasya-product-hero__option-label">TOP SIZE</p>
          <div class="kasya-product-hero__sizes" data-top-size-options></div>
        </div>

        <div class="kasya-product-hero__sizes-wrap">
          <p class="kasya-product-hero__option-label">PANTS SIZE</p>
          <div class="kasya-product-hero__sizes" data-pants-size-options></div>
        </div>

        {% if section.settings.size_helper_text != blank %}
          <p class="kasya-product-hero__size-helper">
            {{ section.settings.size_helper_text }}
          </p>
        {% endif %}

        {% if section.settings.show_size_chart and size_chart_image != blank %}
          <div class="kasya-product-hero__size-chart" data-size-chart>
            <button
              type="button"
              class="kasya-product-hero__size-chart-toggle"
              aria-expanded="false"
              data-size-chart-toggle
            >
              <span data-size-chart-toggle-text>{{ section.settings.size_chart_trigger_text }}</span>
              <span class="kasya-product-hero__size-chart-icon" aria-hidden="true">⌄</span>
            </button>

            <div class="kasya-product-hero__size-chart-panel" data-size-chart-panel hidden>
              <img
                data-size-chart-image
                data-size-chart-src="{{ size_chart_image | image_url: width: 1200 }}"
                alt="{{ size_chart_alt | escape }}"
                width="1200"
                height="900"
                loading="lazy"
              >

              {% if section.settings.size_chart_note != blank %}
                <p class="kasya-product-hero__size-chart-note">
                  {{ section.settings.size_chart_note }}
                </p>
              {% endif %}
            </div>
          </div>
        {% endif %}

        <button
          type="submit"
          class="kasya-product-hero__add"
          data-submit
          disabled
        >
          <span class="kasya-product-hero__add-icon">
            <svg width="25" height="25" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M6.2 6.2h15l-1.7 8.4H7.7L6.2 6.2Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>
              <path d="M6.2 6.2 5.7 3.5H2.8" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
              <circle cx="9" cy="20" r="1.35" fill="currentColor"/>
              <circle cx="18" cy="20" r="1.35" fill="currentColor"/>
            </svg>
          </span>
          <span data-submit-text>{{ section.settings.cta_text }}</span>
        </button>
        <p class="kasya-product-hero__error" data-set-error role="alert" aria-live="polite" hidden></p>
      </form>
    </div>

    {% if section.settings.enable_sticky_atc %}
      <div class="kasya-product-hero__sticky-atc" data-sticky-atc>
        <div class="kasya-product-hero__sticky-context" data-sticky-context>
          SELECT COLOR AND SIZES — {{ section.settings.set_price_text }}
        </div>

        <button
          type="button"
          class="kasya-product-hero__sticky-button"
          data-sticky-submit
          disabled
        >
          <span data-sticky-submit-text>{{ section.settings.cta_text }}</span>
        </button>
      </div>
    {% endif %}
  {% endif %}
</section>

<style>
  .kasya-product-hero {
    --kasya-black: #000000;
    --kasya-text: #111111;
    --kasya-muted: #555555;
    --kasya-line: #eeeeee;
    --kasya-accent: #e83b3b;
    --kasya-bg: #ffffff;

    background: var(--kasya-bg);
    color: var(--kasya-text);
    font-family: inherit;
    max-width: 760px;
    margin: 0 auto;
  }

  .kasya-product-hero * {
    box-sizing: border-box;
  }

  .kasya-product-hero__empty {
    padding: 32px 18px;
    text-align: center;
  }

  .kasya-product-hero__header {
    height: 72px;
    padding: 0 22px;
    display: grid;
    grid-template-columns: 44px 1fr 44px;
    align-items: center;
    background: #fff;
  }

  .kasya-product-hero__menu {
    width: 36px;
    height: 36px;
    border: 0;
    background: transparent;
    padding: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 6px;
    cursor: pointer;
  }

  .kasya-product-hero__menu span {
    display: block;
    width: 31px;
    height: 3px;
    background: #000;
  }

  .kasya-product-hero__logo {
    justify-self: center;
    text-decoration: none;
    color: #111;
    font-family: serif;
    font-size: 28px;
    letter-spacing: 0.32em;
    line-height: 1;
  }

  .kasya-product-hero__cart {
    justify-self: end;
    color: #111;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .kasya-product-hero__gallery {
    width: 100%;
    background: #f2f2f2;
    position: relative;
  }

  .kasya-product-hero__slider {
    width: 100%;
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }

  .kasya-product-hero__slider::-webkit-scrollbar {
    display: none;
  }

  .kasya-product-hero__slide {
    flex: 0 0 100%;
    width: 100%;
    scroll-snap-align: start;
    background: #f2f2f2;
  }

  .kasya-product-hero__slide img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  .kasya-product-hero__arrow {
    position: absolute;
    top: 48%;
    z-index: 3;
    width: 34px;
    height: 34px;
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.72);
    color: #000000;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    cursor: pointer;
    transform: translateY(-50%);
    box-shadow: 0 8px 22px rgba(0, 0, 0, 0.08);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .kasya-product-hero__arrow[hidden] {
    display: none;
  }

  .kasya-product-hero__arrow--prev {
    left: 10px;
  }

  .kasya-product-hero__arrow--next {
    right: 10px;
  }

  .kasya-product-hero__arrow:focus-visible {
    outline: 2px solid #000000;
    outline-offset: 2px;
  }

  .kasya-product-hero__dots {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 5px;
    min-height: 18px;
    margin-top: -24px;
    position: relative;
    z-index: 2;
    pointer-events: none;
  }

  .kasya-product-hero__dot {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    border: 0;
    padding: 0;
    background: rgba(255, 255, 255, 0.55);
    pointer-events: auto;
  }

  .kasya-product-hero__dot.is-active {
    background: #ffffff;
    box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.12);
  }

  .kasya-product-hero__info {
    padding: 22px 26px 22px;
    background: #fff;
  }

  .kasya-product-hero__meta-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
  }

  .kasya-product-hero__label {
    margin: 0;
    font-size: 16px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #333;
  }

  .kasya-product-hero__rating {
    display: flex;
    align-items: center;
    gap: 5px;
    white-space: nowrap;
    color: #000;
    cursor: pointer;
    text-decoration: none;
  }

  .kasya-product-hero__rating span {
    font-size: 14px;
    letter-spacing: 0.12em;
  }

  .kasya-product-hero__rating small {
    font-size: 14px;
    color: #333;
  }

  .kasya-product-hero__title-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: start;
    gap: 14px;
    margin-top: 22px;
  }

  .kasya-product-hero__title {
    margin: 0;
    font-size: clamp(34px, 5vw, 44px);
    line-height: 1;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: 800;
    overflow-wrap: anywhere;
  }

  .kasya-product-hero__subtitle {
    margin: 8px 0 0;
    font-size: 18px;
    line-height: 1.25;
    color: #333;
  }

  .kasya-product-hero__price {
    font-size: clamp(28px, 4.8vw, 38px);
    line-height: 1;
    font-weight: 900;
    color: var(--kasya-accent);
    white-space: nowrap;
  }

  .kasya-product-hero__set-pricing {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 6px;
  }

  .kasya-product-hero__compare-price {
    color: var(--kasya-muted);
    font-size: 16px;
    line-height: 1;
    text-decoration: line-through;
  }

  .kasya-product-hero__discount {
    display: inline-flex;
    align-items: center;
    min-height: 26px;
    padding: 4px 9px;
    border-radius: 4px;
    background: var(--kasya-accent);
    color: #ffffff;
    font-size: 12px;
    font-weight: 800;
    line-height: 1;
  }

  .kasya-product-hero__description {
    margin: 20px 0 0;
    max-width: 620px;
    font-size: 18px;
    line-height: 1.45;
    letter-spacing: 0.03em;
    font-style: italic;
    color: #222;
  }

  .kasya-product-hero__form {
    margin-top: 26px;
  }

  .kasya-product-hero__swatches-wrap {
    border-top: 1px solid var(--kasya-line);
    padding-top: 18px;
  }

  .kasya-product-hero__swatches {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    max-width: 360px;
  }

  .kasya-product-hero__color-option {
    min-height: 44px;
    padding: 8px 14px;
    border: 1px solid #d6d6d6;
    border-radius: 4px;
    background: #ffffff;
    color: #111111;
    display: inline-flex;
    align-items: center;
    gap: 9px;
    cursor: pointer;
    font-size: 15px;
    font-weight: 700;
  }

  .kasya-product-hero__color-option.is-selected {
    border-color: #000000;
    box-shadow: inset 0 0 0 1px #000000;
  }

  .kasya-product-hero__color-dot {
    width: 22px;
    height: 22px;
    border: 1px solid rgba(0, 0, 0, 0.18);
    border-radius: 999px;
    background: #000000;
  }

  .kasya-product-hero__color-dot--taupe {
    background: #b8a38e;
  }

  .kasya-product-hero__swatch {
    width: 40px;
    height: 40px;
    border-radius: 999px;
    border: 1px solid transparent;
    background: var(--swatch);
    padding: 0;
    cursor: pointer;
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.12);
  }

  .kasya-product-hero__swatch.is-selected {
    border-color: #000;
    box-shadow: inset 0 0 0 1px #fff;
  }

  .kasya-product-hero__selected-color {
    margin: 10px 0 0;
    font-size: 17px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: 700;
  }

  .kasya-product-hero__selected-color span {
    font-weight: 400;
  }

  .kasya-product-hero__sizes-wrap {
    margin-top: 24px;
  }

  .kasya-product-hero__option-label {
    margin: 0 0 12px;
    font-size: 15px;
    letter-spacing: 0.12em;
    font-weight: 800;
    text-transform: uppercase;
  }

  .kasya-product-hero__sizes {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .kasya-product-hero__size {
    min-height: 46px;
    min-width: 58px;
    padding: 10px 14px;
    border: 1px solid #d6d6d6;
    border-radius: 999px;
    background: #fff;
    color: #111;
    font-size: 15px;
    font-weight: 700;
    cursor: pointer;
  }

  .kasya-product-hero__size.is-selected {
    background: #000;
    border-color: #000;
    color: #fff;
  }

  .kasya-product-hero__size.is-disabled {
    opacity: 0.35;
    text-decoration: line-through;
    cursor: not-allowed;
  }

  .kasya-product-hero__size-helper {
    margin: 12px 0 0;
    color: #555;
    font-size: 14px;
    line-height: 1.4;
  }

  .kasya-product-hero__size-chart {
    margin-top: 12px;
    border-top: 1px solid var(--kasya-line);
    border-bottom: 1px solid var(--kasya-line);
  }

  .kasya-product-hero__size-chart-toggle {
    width: 100%;
    min-height: 44px;
    border: 0;
    background: transparent;
    color: #111;
    display: flex;
    align-items: center;
    justify-content: space-between;
