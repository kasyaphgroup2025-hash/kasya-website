{{ 'homepage-custom.css' | asset_url | stylesheet_tag }}
{{ 'component-loading-overlay.css' | asset_url | stylesheet_tag }}
<script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>

<style>
  #shopify-section-{{ section.id }} .home-quick-shop {
    background: #030303;
    color: #ffffff;
  }

  #shopify-section-{{ section.id }} .home-quick-shop .home-editorial__inner {
    padding-top: 0;
    padding-bottom: 4.2rem;
  }

  #shopify-section-{{ section.id }} .home-quick-shop__banner {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 18rem;
    margin-bottom: 0;
    overflow: hidden;
    background: linear-gradient(90deg, #171717, #303030 50%, #171717);
  }

  #shopify-section-{{ section.id }} .home-quick-shop__banner .home-media,
  #shopify-section-{{ section.id }} .home-quick-shop__banner .home-media--empty {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    min-height: 0;
  }

  #shopify-section-{{ section.id }} .home-quick-shop__banner img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #shopify-section-{{ section.id }} .home-quick-shop__banner::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(0,0,0,0.42), rgba(0,0,0,0.18), rgba(0,0,0,0.42));
  }

  #shopify-section-{{ section.id }} .home-quick-shop__banner-title {
    position: relative;
    z-index: 1;
    margin: 0;
    color: #ffffff;
    font-family: "Helvetica Now Condensed", "Helvetica Neue Condensed", "Arial Narrow", sans-serif;
    font-size: clamp(2.9rem, 8.2vw, 4.7rem);
    font-weight: 600;
    letter-spacing: 0;
    line-height: 1;
    text-align: center;
    text-shadow: 0 0.18rem 0.7rem rgba(0, 0, 0, 0.48);
  }

  #shopify-section-{{ section.id }} .home-quick-shop__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0;
    background: #030303;
  }

  #shopify-section-{{ section.id }} .home-quick-shop__card {
    min-width: 0;
    background: linear-gradient(90deg, #151515, #242424);
  }

  #shopify-section-{{ section.id }} .home-quick-shop__image-link {
    position: relative;
    display: block;
    aspect-ratio: 0.82;
    overflow: hidden;
    background: #0f0f0f;
  }

  #shopify-section-{{ section.id }} .home-quick-shop__product-image,
  #shopify-section-{{ section.id }} .home-quick-shop__image-link .home-media,
  #shopify-section-{{ section.id }} .home-quick-shop__image-link .home-media--empty {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 0;
  }

  #shopify-section-{{ section.id }} .home-quick-shop__product-image:not(.is-active) {
    display: none;
  }

  #shopify-section-{{ section.id }} .home-quick-shop__product-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #shopify-section-{{ section.id }} .home-quick-shop__swatches {
    display: flex;
    justify-content: center;
    gap: 0.48rem;
    min-height: 1.7rem;
    margin: 0.7rem 0 0.5rem;
  }

  #shopify-section-{{ section.id }} .home-quick-shop__swatch {
    display: block;
    width: 1.22rem;
    height: 1.22rem;
    padding: 0;
    border: 0.1rem solid rgba(255, 255, 255, 0.55);
    border-radius: 50%;
    background: var(--swatch-color, #d8d8d8);
    cursor: pointer;
  }

  #shopify-section-{{ section.id }} .home-quick-shop__swatch.is-active {
    border-color: #ffffff;
    box-shadow: 0 0 0 0.14rem #030303, 0 0 0 0.24rem rgba(255, 255, 255, 0.9);
  }

  #shopify-section-{{ section.id }} .home-quick-shop__info {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.75rem 0.9rem;
    align-items: center;
    padding: 0 1.15rem 1.25rem;
    background: transparent;
    font-family: "Helvetica Now Condensed", "Helvetica Neue Condensed", "Arial Narrow", sans-serif;
  }

  #shopify-section-{{ section.id }} .home-quick-shop__title {
    margin: 0;
    color: #ffffff;
    font-family: inherit;
    font-size: clamp(1.35rem, 3.7vw, 1.7rem);
    font-weight: 700;
    letter-spacing: 0;
    line-height: 1.08;
  }

  #shopify-section-{{ section.id }} .home-quick-shop__price {
    color: #ffffff;
    font-family: inherit;
    font-size: clamp(1.32rem, 3.55vw, 1.68rem);
    font-weight: 700;
    line-height: 1.08;
    text-align: right;
    white-space: nowrap;
  }

  #shopify-section-{{ section.id }} .home-quick-shop__quick-add {
    display: block;
    grid-column: 1 / -1;
  }

  #shopify-section-{{ section.id }} .home-quick-shop__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 3rem;
    padding: 0.35rem 1rem;
    border: 0.1rem solid rgba(255, 255, 255, 0.9);
    border-radius: 0.5rem;
    background: transparent;
    color: #ffffff;
    font-family: inherit;
    font-size: 1.08rem;
    font-weight: 500;
    letter-spacing: 0;
    line-height: 1;
    text-align: center;
    text-transform: none;
    cursor: pointer;
  }

  #shopify-section-{{ section.id }} .home-quick-shop__button .loading-overlay__spinner {
    margin-left: 0.6rem;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .home-quick-shop .home-editorial__inner {
      padding-bottom: 5.6rem;
    }

    #shopify-section-{{ section.id }} .home-quick-shop__banner {
      min-height: 30rem;
    }

    #shopify-section-{{ section.id }} .home-quick-shop__banner-title {
      font-size: clamp(4rem, 4.4vw, 6.2rem);
    }

    #shopify-section-{{ section.id }} .home-quick-shop__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    #shopify-section-{{ section.id }} .home-quick-shop__info {
      padding: 0 1.4rem 1.5rem;
    }
  }
</style>

<section class="home-editorial home-quick-shop" data-home-quick-shop-section="{{ section.id }}">
  <div class="home-editorial__inner">
    <div class="home-quick-shop__banner">
      {%- if section.settings.banner_image != blank -%}
        <div class="home-media">
          {{ section.settings.banner_image | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '375, 550, 750, 900, 1200, 1600', alt: section.settings.banner_alt }}
        </div>
      {%- else -%}
        <div class="home-media home-media--empty"></div>
      {%- endif -%}
      {%- assign banner_heading = section.settings.banner_heading | default: section.settings.banner_title | default: 'Back to Rhythm' -%}
      <h2 class="home-quick-shop__banner-title">{{ banner_heading | escape }}</h2>
    </div>

    <div class="home-quick-shop__grid">
      {%- for block in section.blocks limit: 4 -%}
        {%- liquid
          assign product = block.settings.product
          assign product_url = block.settings.custom_url | default: block.settings.custom_product_url
          if product_url == blank and product != blank
            assign product_url = product.url
          endif
          if product_url == blank
            assign product_url = '#'
          endif

          assign product_title = block.settings.product_title | default: block.settings.product_name
          if product_title == blank and product != blank
            assign product_title = product.title
          endif
          if product_title == blank
            assign product_title = 'Product name'
          endif

          assign quick_add_url = ''
          if product != blank
            assign quick_add_url = product.url
          elsif product_url != '#'
            assign quick_add_url = product_url
          else
            assign product_title_downcase = product_title | downcase
            if product_title_downcase contains 'daliah'
              assign quick_add_url = '/products/daliah-polo-acid-linen'
            elsif product_title_downcase contains 'inah'
              assign quick_add_url = '/products/inah-blouse-viscose-linen'
            elsif product_title_downcase contains 'hazel'
              assign quick_add_url = '/products/hazel-trouser-viscose-linen'
            elsif product_title_downcase contains 'demi'
              assign quick_add_url = '/products/demi-barrel-pants-acid-linen'
            endif
          endif

          assign product_price = block.settings.product_price
          if product_price == blank and product != blank
            assign product_price = product.price | money
          endif
          if product_price == blank
            assign product_price = '₱999'
          endif

          assign image_1 = block.settings.image_1
          if image_1 == blank and product != blank
            assign image_1 = product.featured_image
          endif
          assign image_2 = block.settings.image_2 | default: image_1
          assign image_1_alt = block.settings.image_1_alt | default: product_title
          assign image_2_alt = block.settings.image_2_alt | default: product_title
          assign color_1_label = block.settings.color_1_label | default: 'Color 1'
          assign color_2_label = block.settings.color_2_label | default: 'Color 2'
          assign color_1_swatch = block.settings.color_1_swatch | default: block.settings.color_1 | default: '#111111'
          assign color_2_swatch = block.settings.color_2_swatch | default: block.settings.color_2 | default: '#d8c8ad'
        -%}
        <article class="home-quick-shop__card" {{ block.shopify_attributes }} data-home-quick-shop-card>
          <a class="home-quick-shop__image-link" href="{{ product_url }}" aria-label="{{ product_title | escape }}">
            {%- if image_1 != blank -%}
              <span class="home-quick-shop__product-image is-active" data-home-quick-shop-image="1">
                {{ image_1 | image_url: width: 900 | image_tag: loading: 'lazy', widths: '180, 260, 360, 540, 720, 900', alt: image_1_alt }}
              </span>
            {%- else -%}
              <span class="home-quick-shop__product-image is-active" data-home-quick-shop-image="1"><span class="home-media home-media--empty"></span></span>
            {%- endif -%}

            {%- if image_2 != blank -%}
              <span class="home-quick-shop__product-image" data-home-quick-shop-image="2">
                {{ image_2 | image_url: width: 900 | image_tag: loading: 'lazy', widths: '180, 260, 360, 540, 720, 900', alt: image_2_alt }}
              </span>
            {%- else -%}
              <span class="home-quick-shop__product-image" data-home-quick-shop-image="2"><span class="home-media home-media--empty"></span></span>
            {%- endif -%}
          </a>

          <div class="home-quick-shop__swatches" aria-label="Choose color for {{ product_title | escape }}">
            <button class="home-quick-shop__swatch is-active" type="button" style="--swatch-color: {{ color_1_swatch }};" data-home-quick-shop-swatch="1" aria-label="{{ color_1_label | escape }}"></button>
            <button class="home-quick-shop__swatch" type="button" style="--swatch-color: {{ color_2_swatch }};" data-home-quick-shop-swatch="2" aria-label="{{ color_2_label | escape }}"></button>
          </div>

          <div class="home-quick-shop__info">
            <h3 class="home-quick-shop__title"><a href="{{ product_url }}">{{ product_title | escape }}</a></h3>
            <div class="home-quick-shop__price">{{ product_price | escape }}</div>
            {%- if quick_add_url != blank -%}
              <quick-add-drawer-opener class="home-quick-shop__quick-add">
                <button class="home-quick-shop__button" type="button" aria-haspopup="dialog" aria-label="Quick shop {{ product_title | escape }}" data-product-url="{{ quick_add_url }}">
                  <span>Quick Shop</span>
                  <div class="loading-overlay__spinner hidden">
                    {%- render 'icon-cart-loading' -%}
                  </div>
                </button>
              </quick-add-drawer-opener>
            {%- else -%}
              <a class="home-quick-shop__button" href="#" role="button">Quick Shop</a>
            {%- endif -%}
          </div>
        </article>
      {%- else -%}
        {%- assign fallback_names = 'Daliah Polo|Inah Blouse|Hazel Trouser|Demi Barrel Pants' | split: '|' -%}
        {%- for fallback_name in fallback_names -%}
          <article class="home-quick-shop__card" data-home-quick-shop-card>
            <a class="home-quick-shop__image-link" href="#" aria-label="{{ fallback_name | escape }}">
              <span class="home-quick-shop__product-image is-active" data-home-quick-shop-image="1"><span class="home-media home-media--empty"></span></span>
              <span class="home-quick-shop__product-image" data-home-quick-shop-image="2"><span class="home-media home-media--empty"></span></span>
            </a>
            <div class="home-quick-shop__swatches" aria-hidden="true">
              <button class="home-quick-shop__swatch is-active" type="button" style="--swatch-color: #111111;" data-home-quick-shop-swatch="1"></button>
              <button class="home-quick-shop__swatch" type="button" style="--swatch-color: #d8c8ad;" data-home-quick-shop-swatch="2"></button>
            </div>
            <div class="home-quick-shop__info">
              <h3 class="home-quick-shop__title">{{ fallback_name }}</h3>
              <div class="home-quick-shop__price">₱999</div>
              <a class="home-quick-shop__button" href="#" role="button">Quick Shop</a>
            </div>
          </article>
        {%- endfor -%}
      {%- endfor -%}
    </div>
  </div>
</section>

<script>
  (() => {
    const initQuickShop = (root = document) => {
      const section = root.querySelector('[data-home-quick-shop-section="{{ section.id }}"]');
      if (!section) return;

      section.querySelectorAll('[data-home-quick-shop-card]').forEach((card) => {
        card.querySelectorAll('[data-home-quick-shop-swatch]').forEach((swatch) => {
          if (swatch.dataset.homeQuickShopReady === 'true') return;
          swatch.dataset.homeQuickShopReady = 'true';

          swatch.addEventListener('click', () => {
            const target = swatch.getAttribute('data-home-quick-shop-swatch');

            card.querySelectorAll('[data-home-quick-shop-swatch]').forEach((item) => {
              item.classList.toggle('is-active', item === swatch);
            });

            card.querySelectorAll('[data-home-quick-shop-image]').forEach((image) => {
              image.classList.toggle('is-active', image.getAttribute('data-home-quick-shop-image') === target);
            });
          });
        });
      });
    };

    initQuickShop();

    document.addEventListener('shopify:section:load', (event) => {
      initQuickShop(event.target);
    });
  })();
</script>

{% schema %}
{
  "name": "Home quick shop grid",
  "tag": "section",
  "class": "section-home-quick-shop-grid",
  "settings": [
    { "type": "image_picker", "id": "banner_image", "label": "Back to Rhythm banner image" },
    { "type": "text", "id": "banner_alt", "label": "Banner image alt text", "default": "Back to Rhythm collection" },
    { "type": "text", "id": "banner_heading", "label": "Banner heading", "default": "Back to Rhythm" }
  ],
  "blocks": [
    {
      "type": "product_card",
      "name": "Product card",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "url", "id": "custom_url", "label": "Custom URL" },
        { "type": "text", "id": "product_title", "label": "Product title", "default": "Daliah Polo" },
        { "type": "text", "id": "product_price", "label": "Product price", "default": "₱999" },
        { "type": "image_picker", "id": "image_1", "label": "Image 1" },
        { "type": "text", "id": "image_1_alt", "label": "Image 1 alt text" },
        { "type": "text", "id": "color_1_label", "label": "Color 1 label", "default": "Black" },
        { "type": "color", "id": "color_1_swatch", "label": "Color 1 swatch", "default": "#111111" },
        { "type": "image_picker", "id": "image_2", "label": "Image 2" },
        { "type": "text", "id": "image_2_alt", "label": "Image 2 alt text" },
        { "type": "text", "id": "color_2_label", "label": "Color 2 label", "default": "Ivory" },
        { "type": "color", "id": "color_2_swatch", "label": "Color 2 swatch", "default": "#d8c8ad" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Home quick shop grid",
      "blocks": [
        { "type": "product_card" },
        { "type": "product_card" },
        { "type": "product_card" },
        { "type": "product_card" }
      ]
    }
  ]
}
{% endschema %}
