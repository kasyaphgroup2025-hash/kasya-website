{{ 'homepage-custom.css' | asset_url | stylesheet_tag }}
{{ 'component-loading-overlay.css' | asset_url | stylesheet_tag }}

<style>
  #shopify-section-{{ section.id }} .home-quick-shop {
    background: #030303;
    color: #ffffff;
  }

  #shopify-section-{{ section.id }} .home-quick-shop .home-editorial__inner {
    padding-top: 0;
    padding-bottom: 4.2rem;
  }

  #shopify-section-{{ section.id }} .home-quick-shop__banner {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 18rem;
    margin-bottom: 0;
    overflow: hidden;
    background: linear-gradient(90deg, #171717, #303030 50%, #171717);
  }

  #shopify-section-{{ section.id }} .home-quick-shop__banner .home-media,
  #shopify-section-{{ section.id }} .home-quick-shop__banner .home-media--empty {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    min-height: 0;
  }

  #shopify-section-{{ section.id }} .home-quick-shop__banner img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #shopify-section-{{ section.id }} .home-quick-shop__banner::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(0,0,0,0.42), rgba(0,0,0,0.18), rgba(0,0,0,0.42));
  }

  #shopify-section-{{ section.id }} .home-quick-shop__banner-title {
    position: relative;
    z-index: 1;
    margin: 0;
    color: #ffffff;
    font-family: "Helvetica Now Condensed", "Helvetica Neue Condensed", "Arial Narrow", sans-serif;
    font-size: clamp(2.9rem, 8.2vw, 4.7rem);
    font-weight: 600;
    letter-spacing: 0;
    line-height: 1;
    text-align: center;
    text-shadow: 0 0.18rem 0.7rem rgba(0, 0, 0, 0.48);
  }

  #shopify-section-{{ section.id }} .home-quick-shop__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0;
    background: #030303;
  }

  #shopify-section-{{ section.id }} .home-quick-shop__card {
    min-width: 0;
    background: linear-gradient(90deg, #151515, #242424);
  }

  #shopify-section-{{ section.id }} .home-quick-shop__image-link {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 0.82;
    overflow: hidden;
    padding: 0;
    border: 0;
    background: #0f0f0f;
    color: inherit;
    cursor: pointer;
    text-align: inherit;
    appearance: none;
  }

  #shopify-section-{{ section.id }} .home-quick-shop__product-image,
  #shopify-section-{{ section.id }} .home-quick-shop__image-link .home-media,
  #shopify-section-{{ section.id }} .home-quick-shop__image-link .home-media--empty {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 0;
  }

  #shopify-section-{{ section.id }} .home-quick-shop__product-image:not(.is-active) {
    display: none;
  }

  #shopify-section-{{ section.id }} .home-quick-shop__product-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #shopify-section-{{ section.id }} .home-quick-shop__swatches {
    display: flex;
    justify-content: center;
    gap: 0.6rem;
    min-height: 2.2rem;
    margin: 0.78rem 0 0.58rem;
  }

  #shopify-section-{{ section.id }} .home-quick-shop__swatch {
    display: block;
    width: 1.7rem;
    height: 1.7rem;
    padding: 0;
    border: 0.1rem solid rgba(255, 255, 255, 0.55);
    border-radius: 50%;
    background: var(--swatch-color, #d8d8d8);
    cursor: pointer;
  }

  #shopify-section-{{ section.id }} .home-quick-shop__swatch.is-active {
    border-color: #ffffff;
    box-shadow: 0 0 0 0.16rem #030303, 0 0 0 0.28rem rgba(255, 255, 255, 0.9);
  }

  #shopify-section-{{ section.id }} .home-quick-shop__info {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.75rem 0.9rem;
    align-items: center;
    padding: 0 1.15rem 1.25rem;
    background: transparent;
    font-family: "Helvetica Now Condensed", "Helvetica Neue Condensed", "Arial Narrow", sans-serif;
  }

  #shopify-section-{{ section.id }} .home-quick-shop__title {
    margin: 0;
    color: #ffffff;
    font-family: inherit;
    font-size: clamp(1.35rem, 3.7vw, 1.7rem);
    font-weight: 700;
    letter-spacing: 0;
    line-height: 1.08;
  }

  #shopify-section-{{ section.id }} .home-quick-shop__title-button {
    display: inline;
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    font-weight: inherit;
    letter-spacing: inherit;
    line-height: inherit;
    text-align: left;
    text-decoration: none;
    cursor: pointer;
    appearance: none;
  }

  #shopify-section-{{ section.id }} .home-quick-shop__price {
    color: #ffffff;
    font-family: inherit;
    font-size: clamp(1.45rem, 3.9vw, 1.85rem);
    font-weight: 700;
    line-height: 1.08;
    text-align: right;
    white-space: nowrap;
  }

  #shopify-section-{{ section.id }} .home-quick-shop__quick-add {
    display: block;
    grid-column: 1 / -1;
  }

  #shopify-section-{{ section.id }} .home-quick-shop__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 3rem;
    padding: 0.35rem 1rem;
    border: 0.1rem solid rgba(255, 255, 255, 0.9);
    border-radius: 0.5rem;
    background: transparent;
    color: #ffffff;
    font-family: inherit;
    font-size: 1.08rem;
    font-weight: 500;
    letter-spacing: 0;
    line-height: 1;
    text-align: center;
    text-transform: none;
    cursor: pointer;
  }

  #shopify-section-{{ section.id }} .home-quick-shop__selector[hidden] {
    display: none;
  }

  #shopify-section-{{ section.id }} .home-quick-shop__selector {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: grid;
    place-items: center;
    padding: 1.8rem;
    background: rgba(0, 0, 0, 0.42);
  }

  #shopify-section-{{ section.id }} .home-quick-shop__selector-panel {
    width: min(100%, 34rem);
    border-radius: 0.8rem;
    background: #ffffff;
    color: #171717;
    box-shadow: 0 1.4rem 4rem rgba(0, 0, 0, 0.28);
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .home-quick-shop__selector-header {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    padding: 0.8rem 1rem 0;
  }

  #shopify-section-{{ section.id }} .home-quick-shop__selector-close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3.2rem;
    height: 3.2rem;
    padding: 0;
    border: 0;
    background: transparent;
    color: #171717;
    font-size: 2.6rem;
    line-height: 1;
    cursor: pointer;
  }

  #shopify-section-{{ section.id }} .home-quick-shop__selector-body {
    display: grid;
    gap: 1.2rem;
    padding: 0.4rem 1.5rem 1.6rem;
  }

  #shopify-section-{{ section.id }} .home-quick-shop__selector-summary {
    display: grid;
    grid-template-columns: 7.2rem minmax(0, 1fr);
    gap: 1.1rem;
    align-items: center;
  }

  #shopify-section-{{ section.id }} .home-quick-shop__selector-image {
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 0.6rem;
    background: #f2f2f2;
  }

  #shopify-section-{{ section.id }} .home-quick-shop__selector-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #shopify-section-{{ section.id }} .home-quick-shop__selector-product {
    margin: 0 0 0.35rem;
    font-size: 1.7rem;
    font-weight: 600;
    line-height: 1.16;
  }

  #shopify-section-{{ section.id }} .home-quick-shop__selector-price {
    font-size: 1.45rem;
    line-height: 1.1;
  }

  #shopify-section-{{ section.id }} .home-quick-shop__selector-warning {
    margin: 0;
    color: #d60000;
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.2;
  }

  #shopify-section-{{ section.id }} .home-quick-shop__selector-fields {
    display: grid;
    gap: 0.9rem;
  }

  #shopify-section-{{ section.id }} .home-quick-shop__selector-field {
    display: grid;
    gap: 0.4rem;
  }

  #shopify-section-{{ section.id }} .home-quick-shop__selector-field label {
    color: #171717;
    font-size: 1.15rem;
    font-weight: 700;
    line-height: 1.1;
  }

  #shopify-section-{{ section.id }} .home-quick-shop__selector-field select {
    width: 100%;
    min-height: 3.9rem;
    padding: 0 1rem;
    border: 0.1rem solid rgba(0, 0, 0, 0.2);
    border-radius: 0.4rem;
    background: #ffffff;
    color: #171717;
    font-size: 1.35rem;
  }

  #shopify-section-{{ section.id }} .home-quick-shop__selector-submit {
    width: 100%;
    min-height: 4.2rem;
    border: 0;
    border-radius: 0;
    background: #000000;
    color: #ffffff;
    font-size: 1.3rem;
    font-weight: 700;
    cursor: pointer;
  }

  #shopify-section-{{ section.id }} .home-quick-shop__selector-submit[disabled] {
    opacity: 0.45;
    cursor: not-allowed;
  }

  #shopify-section-{{ section.id }} .home-quick-shop__selector-error {
    margin: 0;
    color: #d60000;
    font-size: 1.2rem;
    line-height: 1.25;
  }

  #shopify-section-{{ section.id }} .home-quick-shop__floating-cart[hidden] {
    display: none;
  }

  #shopify-section-{{ section.id }} .home-quick-shop__floating-cart {
    position: fixed;
    right: 1.6rem;
    bottom: 8.8rem;
    z-index: 70;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 4.8rem;
    height: 4.8rem;
    padding: 0;
    border: 0.1rem solid rgba(255, 255, 255, 0.24);
    border-radius: 50%;
    background: #050505;
    color: #ffffff;
    box-shadow: 0 0.8rem 2.6rem rgba(0, 0, 0, 0.34);
    cursor: pointer;
  }

  #shopify-section-{{ section.id }} .home-quick-shop__floating-cart svg {
    width: 2.2rem;
    height: 2.2rem;
  }

  #shopify-section-{{ section.id }} .home-quick-shop__floating-count {
    position: absolute;
    top: -0.4rem;
    right: -0.3rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.8rem;
    height: 1.8rem;
    padding: 0 0.45rem;
    border-radius: 999rem;
    background: #ffffff;
    color: #050505;
    font-size: 1rem;
    font-weight: 700;
    line-height: 1;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .home-quick-shop .home-editorial__inner {
      padding-bottom: 5.6rem;
    }

    #shopify-section-{{ section.id }} .home-quick-shop__banner {
      min-height: 30rem;
    }

    #shopify-section-{{ section.id }} .home-quick-shop__banner-title {
      font-size: clamp(4rem, 4.4vw, 6.2rem);
    }

    #shopify-section-{{ section.id }} .home-quick-shop__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    #shopify-section-{{ section.id }} .home-quick-shop__info {
      padding: 0 1.4rem 1.5rem;
    }
  }
</style>

<section class="home-editorial home-quick-shop" data-home-quick-shop-section="{{ section.id }}">
  <div class="home-editorial__inner">
    <div class="home-quick-shop__banner">
      {%- if section.settings.banner_image != blank -%}
        <div class="home-media">
          {{ section.settings.banner_image | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '375, 550, 750, 900, 1200, 1600', alt: section.settings.banner_alt }}
        </div>
      {%- else -%}
        <div class="home-media home-media--empty"></div>
      {%- endif -%}
      {%- assign banner_heading = section.settings.banner_heading | default: section.settings.banner_title | default: 'Back to Rhythm' -%}
      <h2 class="home-quick-shop__banner-title">{{ banner_heading | escape }}</h2>
    </div>

    <div class="home-quick-shop__grid">
      {%- for block in section.blocks limit: 4 -%}
        {%- liquid
          assign product = block.settings.product
          assign product_url = block.settings.custom_url | default: block.settings.custom_product_url
          if product_url contains 'shopify://products/'
            assign product_handle = product_url | split: 'shopify://products/' | last
            assign product_url = '/products/' | append: product_handle
          endif
          if product_url == blank and product != blank
            assign product_url = product.url
          endif
          if product_url == blank
            assign product_url = '#'
          endif

          assign product_title = block.settings.product_title | default: block.settings.product_name
          if product_title == blank and product != blank
            assign product_title = product.title
          endif
          if product_title == blank
            assign product_title = 'Product name'
          endif

          assign product_json_url = ''
          if product != blank
            assign product_json_url = product.url
          else
            assign product_title_downcase = product_title | downcase
            if product_title_downcase contains 'daliah'
              assign product_json_url = '/products/daliah-polo-acid-linen'
            elsif product_title_downcase contains 'inah'
              assign product_json_url = '/products/inah-blouse-viscose-linen'
            elsif product_title_downcase contains 'hazel'
              assign product_json_url = '/products/hazel-trouser-viscose-linen'
            elsif product_title_downcase contains 'demi'
              assign product_json_url = '/products/demi-barrel-pants-acid-linen'
            endif
          endif

          assign product_price = block.settings.product_price
          if product_price == blank and product != blank
            assign product_price = product.price | money
          endif
          if product_price == blank
            assign product_price = '₱999'
          endif

          assign image_1 = block.settings.image_1
          if image_1 == blank and product != blank
            assign image_1 = product.featured_image
          endif
          assign image_2 = block.settings.image_2 | default: image_1
          assign image_1_alt = block.settings.image_1_alt | default: product_title
          assign image_2_alt = block.settings.image_2_alt | default: product_title
          assign color_1_label = block.settings.color_1_label | default: 'Color 1'
          assign color_2_label = block.settings.color_2_label | default: 'Color 2'
          assign color_1_swatch = block.settings.color_1_swatch | default: block.settings.color_1 | default: '#111111'
          assign color_2_swatch = block.settings.color_2_swatch | default: block.settings.color_2 | default: '#d8c8ad'
        -%}
        <article class="home-quick-shop__card" {{ block.shopify_attributes }} data-home-quick-shop-card>
          <a class="home-quick-shop__image-link" href="{{ product_url }}" aria-label="View {{ product_title | escape }} product page">
            {%- if image_1 != blank -%}
              <span class="home-quick-shop__product-image is-active" data-home-quick-shop-image="1">
                {{ image_1 | image_url: width: 900 | image_tag: loading: 'lazy', widths: '180, 260, 360, 540, 720, 900', alt: image_1_alt }}
              </span>
            {%- else -%}
              <span class="home-quick-shop__product-image is-active" data-home-quick-shop-image="1"><span class="home-media home-media--empty"></span></span>
            {%- endif -%}

            {%- if image_2 != blank -%}
              <span class="home-quick-shop__product-image" data-home-quick-shop-image="2">
                {{ image_2 | image_url: width: 900 | image_tag: loading: 'lazy', widths: '180, 260, 360, 540, 720, 900', alt: image_2_alt }}
              </span>
            {%- else -%}
              <span class="home-quick-shop__product-image" data-home-quick-shop-image="2"><span class="home-media home-media--empty"></span></span>
            {%- endif -%}
          </a>

          <div class="home-quick-shop__swatches" aria-label="Choose color for {{ product_title | escape }}">
            <button class="home-quick-shop__swatch is-active" type="button" style="--swatch-color: {{ color_1_swatch }};" data-home-quick-shop-swatch="1" aria-label="{{ color_1_label | escape }}"></button>
            <button class="home-quick-shop__swatch" type="button" style="--swatch-color: {{ color_2_swatch }};" data-home-quick-shop-swatch="2" aria-label="{{ color_2_label | escape }}"></button>
          </div>

          <div class="home-quick-shop__info">
            <h3 class="home-quick-shop__title">
              <a class="home-quick-shop__title-button" href="{{ product_url }}" aria-label="View {{ product_title | escape }} product page">{{ product_title | escape }}</a>
            </h3>
            <div class="home-quick-shop__price">{{ product_price | escape }}</div>
            <div class="home-quick-shop__quick-add">
              <button class="home-quick-shop__button" type="button" aria-haspopup="dialog" aria-label="Quick shop {{ product_title | escape }}" data-home-quick-shop-open data-home-quick-shop-product-url="{{ product_json_url }}">
                <span>Quick Shop</span>
              </button>
            </div>
          </div>

          <script type="application/json" data-home-quick-shop-color-images>
            [
              {
                "label": {{ color_1_label | json }},
                "src": {%- if image_1 != blank -%}{{ image_1 | image_url: width: 900 | json }}{%- else -%}null{%- endif -%},
                "alt": {{ image_1_alt | json }}
              },
              {
                "label": {{ color_2_label | json }},
                "src": {%- if image_2 != blank -%}{{ image_2 | image_url: width: 900 | json }}{%- else -%}null{%- endif -%},
                "alt": {{ image_2_alt | json }}
              }
            ]
          </script>

          {%- if product != blank -%}
            <script type="application/json" data-home-quick-shop-product-json>
              {
                "title": {{ product.title | json }},
                "price": {{ product.price | json }},
                "options": {{ product.options_with_values | json }},
                "variants": {{ product.variants | json }}
              }
            </script>
          {%- endif -%}
        </article>
      {%- else -%}
        {%- assign fallback_names = 'Daliah Polo|Inah Blouse|Hazel Trouser|Demi Barrel Pants' | split: '|' -%}
        {%- for fallback_name in fallback_names -%}
          <article class="home-quick-shop__card" data-home-quick-shop-card>
            <a class="home-quick-shop__image-link" href="#" aria-label="View {{ fallback_name | escape }} product page">
              <span class="home-quick-shop__product-image is-active" data-home-quick-shop-image="1"><span class="home-media home-media--empty"></span></span>
              <span class="home-quick-shop__product-image" data-home-quick-shop-image="2"><span class="home-media home-media--empty"></span></span>
            </a>
            <div class="home-quick-shop__swatches" aria-hidden="true">
              <button class="home-quick-shop__swatch is-active" type="button" style="--swatch-color: #111111;" data-home-quick-shop-swatch="1"></button>
              <button class="home-quick-shop__swatch" type="button" style="--swatch-color: #d8c8ad;" data-home-quick-shop-swatch="2"></button>
            </div>
            <div class="home-quick-shop__info">
              <h3 class="home-quick-shop__title"><a class="home-quick-shop__title-button" href="#" aria-label="View {{ fallback_name | escape }} product page">{{ fallback_name }}</a></h3>
              <div class="home-quick-shop__price">₱999</div>
              <button class="home-quick-shop__button" type="button" data-home-quick-shop-open>Quick Shop</button>
            </div>
          </article>
        {%- endfor -%}
      {%- endfor -%}
    </div>
  </div>

  <button class="home-quick-shop__floating-cart" type="button" aria-label="Open cart" data-home-quick-shop-floating-cart hidden>
    <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M3.6 5.2H5.5L7.2 15.3H18.1L20.1 8H7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
      <circle cx="9.4" cy="19" r="1.25" fill="currentColor"/>
      <circle cx="17" cy="19" r="1.25" fill="currentColor"/>
    </svg>
    <span class="home-quick-shop__floating-count" data-home-quick-shop-floating-count>0</span>
  </button>

  <div class="home-quick-shop__selector" data-home-quick-shop-selector hidden>
    <div class="home-quick-shop__selector-panel" role="dialog" aria-modal="true" aria-label="Choose product options">
      <div class="home-quick-shop__selector-header">
        <button class="home-quick-shop__selector-close" type="button" aria-label="Close" data-home-quick-shop-close>&times;</button>
      </div>
      <form class="home-quick-shop__selector-body" data-home-quick-shop-form>
        <div class="home-quick-shop__selector-summary">
          <div class="home-quick-shop__selector-image" data-home-quick-shop-selector-image></div>
          <div>
            <p class="home-quick-shop__selector-product" data-home-quick-shop-selector-title></p>
            <div class="home-quick-shop__selector-price" data-home-quick-shop-selector-price></div>
          </div>
        </div>
        <p class="home-quick-shop__selector-warning">Choose your size</p>
        <div class="home-quick-shop__selector-fields" data-home-quick-shop-selector-fields></div>
        <p class="home-quick-shop__selector-error" data-home-quick-shop-selector-error hidden></p>
        <button class="home-quick-shop__selector-submit" type="submit" disabled data-home-quick-shop-submit>Add to Cart</button>
      </form>
    </div>
  </div>
</section>

<script>
  (() => {
    const sectionId = '{{ section.id }}';

    const initQuickShop = (root = document) => {
      const section = root.querySelector(`[data-home-quick-shop-section="${sectionId}"]`);
      if (!section || section.dataset.homeQuickShopInitialized === 'true') return;
      section.dataset.homeQuickShopInitialized = 'true';

      const selector = section.querySelector('[data-home-quick-shop-selector]');
      const form = section.querySelector('[data-home-quick-shop-form]');
      const fields = section.querySelector('[data-home-quick-shop-selector-fields]');
      const titleNode = section.querySelector('[data-home-quick-shop-selector-title]');
      const priceNode = section.querySelector('[data-home-quick-shop-selector-price]');
      const imageNode = section.querySelector('[data-home-quick-shop-selector-image]');
      const errorNode = section.querySelector('[data-home-quick-shop-selector-error]');
      const submitButton = section.querySelector('[data-home-quick-shop-submit]');
      const floatingCartButton = section.querySelector('[data-home-quick-shop-floating-cart]');
      const floatingCartCount = section.querySelector('[data-home-quick-shop-floating-count]');
      let currentProduct = null;
      let selectedVariant = null;
      let hasHomepageCartAdd = false;
      let currentColorImages = [];
      let fallbackSelectorImage = '';

      const moneyFromCents = (cents) => {
        if (window.Shopify && typeof window.Shopify.formatMoney === 'function') {
          return window.Shopify.formatMoney(cents, window.money_format || '{{ shop.money_format | replace: "'", "\\'" }}');
        }
        return `₱${(Number(cents || 0) / 100).toLocaleString('en-PH', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
      };

      const normalizeKey = (value) => {
        return String(value || '')
          .trim()
          .toLowerCase()
          .replace(/[\s_-]+/g, ' ')
          .replace(/[^a-z0-9 ]/g, '')
          .trim();
      };

      const normalizeProduct = (product) => {
        if (!product) return null;
        const variants = product.variants || [];
        const rawOptions = product.options || [];
        const options = rawOptions.map((option, index) => {
          if (typeof option === 'string') {
            const values = [...new Set(variants.map((variant) => variant[`option${index + 1}`]).filter(Boolean))];
            return { name: option, values };
          }
          return {
            name: option.name,
            values: option.values || [...new Set(variants.map((variant) => variant[`option${index + 1}`]).filter(Boolean))]
          };
        });
        return { ...product, options, variants };
      };

      const parseProduct = async (card) => {
        const script = card.querySelector('[data-home-quick-shop-product-json]');
        if (script) {
          try {
            return normalizeProduct(JSON.parse(script.textContent));
          } catch (error) {
            return null;
          }
        }

        const productUrl = card.querySelector('[data-home-quick-shop-open]')?.dataset.homeQuickShopProductUrl;
        if (!productUrl) return null;

        try {
          const response = await fetch(`${productUrl}.js`);
          if (!response.ok) return null;
          return normalizeProduct(await response.json());
        } catch (error) {
          return null;
        }
      };

      const parseColorImages = (card) => {
        const script = card.querySelector('[data-home-quick-shop-color-images]');
        if (!script) return [];
        try {
          return JSON.parse(script.textContent)
            .map((image, index) => ({ ...image, index }))
            .filter((image) => image && image.src);
        } catch (error) {
          return [];
        }
      };

      const renderSelectorImage = (image, fallbackTitle) => {
        if (image && image.src) {
          const existingImage = imageNode.querySelector('img');
          if (existingImage) {
            existingImage.src = image.src;
            existingImage.removeAttribute('srcset');
            existingImage.removeAttribute('sizes');
            existingImage.alt = image.alt || fallbackTitle;
          } else {
            imageNode.innerHTML = `<img src="${image.src}" alt="${image.alt || fallbackTitle}">`;
          }
          return;
        }
        imageNode.innerHTML = fallbackSelectorImage;
      };

      const updateSelectorImageForSelectedColor = (fallbackTitle) => {
        const selects = Array.from(fields.querySelectorAll('select'));
        const colorSelect = selects.find((select) => normalizeKey(select.dataset.optionName).includes('color')) || selects.find((select) => {
          return currentColorImages.some((item) => normalizeKey(item.label) === normalizeKey(select.value));
        });

        if (!colorSelect || !colorSelect.value) {
          renderSelectorImage(null, fallbackTitle);
          return;
        }

        const selectedColor = normalizeKey(colorSelect.value);
        const directMatch = currentColorImages.find((item) => normalizeKey(item.label) === selectedColor);
        const looseMatch = currentColorImages.find((item) => {
          const label = normalizeKey(item.label);
          return label && (label.includes(selectedColor) || selectedColor.includes(label));
        });
        const selectedIndex = Array.from(colorSelect.options).filter((option) => option.value).findIndex((option) => option.value === colorSelect.value);
        const indexMatch = selectedIndex >= 0 ? currentColorImages[selectedIndex] : null;

        renderSelectorImage(directMatch || looseMatch || indexMatch || null, fallbackTitle);
      };

      const getSelectedOptions = () => {
        return Array.from(fields.querySelectorAll('select')).map((select) => select.value);
      };

      const findVariant = () => {
        if (!currentProduct) return null;
        const selectedOptions = getSelectedOptions();
        if (selectedOptions.some((option) => !option)) return null;
        return currentProduct.variants.find((variant) => {
          return selectedOptions.every((option, index) => variant[`option${index + 1}`] === option);
        }) || null;
      };

      const updateVariantState = () => {
        selectedVariant = findVariant();
        const isAvailable = Boolean(selectedVariant && selectedVariant.available);
        submitButton.disabled = !isAvailable;
        submitButton.textContent = selectedVariant && !selectedVariant.available ? 'Sold Out' : 'Add to Cart';
        errorNode.hidden = true;
        errorNode.textContent = '';
      };

      const closeSelector = () => {
        selector.hidden = true;
        document.documentElement.classList.remove('overflow-hidden');
      };

      const getCartDrawer = () => document.querySelector('cart-drawer') || document.querySelector('cart-notification') || document.querySelector('cart-items');

      const getCartItemCount = () => {
        const bubble = document.querySelector('#cart-icon-bubble .cart-count-bubble span[aria-hidden="true"]') || document.querySelector('#cart-icon-bubble .cart-count-bubble span');
        const count = bubble ? parseInt(bubble.textContent.replace(/\D/g, ''), 10) : 0;
        return Number.isFinite(count) ? count : 0;
      };

      const isCartDrawerOpen = () => {
        const drawer = document.querySelector('cart-drawer');
        return Boolean(drawer && (drawer.classList.contains('animate') || drawer.classList.contains('active') || drawer.hasAttribute('open')));
      };

      const updateFloatingCart = () => {
        if (!floatingCartButton) return;
        const count = getCartItemCount();
        if (floatingCartCount) floatingCartCount.textContent = String(count);
        floatingCartButton.hidden = !hasHomepageCartAdd || count <= 0 || isCartDrawerOpen();
      };

      const openExistingCartDrawer = () => {
        const cart = getCartDrawer();
        if (cart && typeof cart.open === 'function') {
          cart.open(floatingCartButton);
          setTimeout(updateFloatingCart, 50);
        }
      };

      const openSelector = async (card) => {
        const product = await parseProduct(card);
        if (!product) {
          currentProduct = null;
          selectedVariant = null;
          currentColorImages = [];
          fallbackSelectorImage = '';
          titleNode.textContent = card.querySelector('.home-quick-shop__title')?.textContent?.trim() || 'Product options unavailable';
          priceNode.textContent = '';
          imageNode.innerHTML = '';
          fields.innerHTML = '';
          submitButton.disabled = true;
          errorNode.textContent = 'Please select a real Shopify product for this Quick Shop card.';
          errorNode.hidden = false;
          selector.hidden = false;
          return;
        }

        currentProduct = product;
        currentColorImages = parseColorImages(card);
        const title = card.querySelector('.home-quick-shop__title')?.textContent?.trim() || product.title;
        const manualPrice = card.querySelector('.home-quick-shop__price')?.textContent?.trim();
        const activeImage = card.querySelector('.home-quick-shop__product-image.is-active img');

        titleNode.textContent = title;
        priceNode.textContent = manualPrice || moneyFromCents(product.price);
        fallbackSelectorImage = activeImage ? `<img src="${activeImage.currentSrc || activeImage.src}" alt="${activeImage.alt || title}">` : '';
        imageNode.innerHTML = fallbackSelectorImage;
        fields.innerHTML = '';

        product.options.forEach((option, index) => {
          const field = document.createElement('div');
          field.className = 'home-quick-shop__selector-field';

          const label = document.createElement('label');
          const selectId = `HomeQuickShop-${sectionId}-${index}`;
          label.setAttribute('for', selectId);
          label.textContent = option.name;

          const select = document.createElement('select');
          select.id = selectId;
          select.dataset.optionPosition = String(index + 1);
          select.dataset.optionName = option.name || '';
          select.innerHTML = `<option value="">Select ${option.name}</option>`;

          option.values.forEach((value) => {
            const optionNode = document.createElement('option');
            optionNode.value = value;
            optionNode.textContent = value;
            select.appendChild(optionNode);
          });

          select.addEventListener('change', () => {
            updateVariantState();
            updateSelectorImageForSelectedColor(title);
          });
          field.append(label, select);
          fields.appendChild(field);
        });

        updateSelectorImageForSelectedColor(title);
        submitButton.disabled = true;
        submitButton.textContent = 'Add to Cart';
        errorNode.hidden = true;
        errorNode.textContent = '';
        selector.hidden = false;
        document.documentElement.classList.add('overflow-hidden');
      };

      const updateCartIconBubbleFromResponse = (response) => {
        const cartIconHtml = response?.sections?.['cart-icon-bubble'];
        const currentCartIcon = document.getElementById('cart-icon-bubble');
        if (!cartIconHtml || !currentCartIcon) return;

        const parsedHtml = new DOMParser().parseFromString(cartIconHtml, 'text/html');
        const updatedCartIcon = parsedHtml.getElementById('cart-icon-bubble') || parsedHtml.querySelector('#cart-icon-bubble');
        const updatedCartIconContent = updatedCartIcon || parsedHtml.querySelector('.shopify-section') || parsedHtml.body;
        if (updatedCartIconContent) currentCartIcon.innerHTML = updatedCartIconContent.innerHTML;
      };

      const openKasyaAovCartAfterAdd = (response) => {
        if (!window.KasyaAovCart || typeof window.KasyaAovCart.open !== 'function') return false;

        try {
          updateCartIconBubbleFromResponse(response);
          window.KasyaAovCart.open();
          return true;
        } catch (error) {
          console.warn('[Kasya AOV Cart] Home quick-shop hook failed; falling back to original cart drawer.', error);
          return false;
        }
      };

      const addToCart = (variantId) => {
        const cart = getCartDrawer();
        if (!cart || typeof cart.renderContents !== 'function' || typeof cart.getSectionsToRender !== 'function') {
          throw new Error('Existing cart drawer is unavailable.');
        }

        const formData = new FormData();
        formData.append('id', variantId);
        formData.append('quantity', '1');
        formData.append('sections', cart.getSectionsToRender().map((section) => section.id));
        formData.append('sections_url', window.location.pathname);
        if (typeof cart.setActiveElement === 'function') cart.setActiveElement(document.activeElement);

        const config = typeof fetchConfig === 'function' ? fetchConfig('javascript') : { method: 'POST', headers: { Accept: 'application/json' } };
        config.headers = config.headers || {};
        config.headers['X-Requested-With'] = 'XMLHttpRequest';
        delete config.headers['Content-Type'];
        config.body = formData;

        return fetch(window.routes.cart_add_url, config)
          .then((response) => response.json())
          .then((response) => {
            if (response.status) throw new Error(response.description || response.message || 'Unable to add to cart.');
            closeSelector();
            hasHomepageCartAdd = true;
            cart.classList.remove('is-empty');
            if (!openKasyaAovCartAfterAdd(response)) cart.renderContents(response);
            setTimeout(updateFloatingCart, 350);
            document.dispatchEvent(new CustomEvent('afterCartChanged', { detail: { productVariantId: variantId, source: 'home-quick-shop', cartData: response } }));
          });
      };

      section.querySelectorAll('[data-home-quick-shop-card]').forEach((card) => {
        card.querySelectorAll('[data-home-quick-shop-swatch]').forEach((swatch) => {
          swatch.addEventListener('click', () => {
            const target = swatch.getAttribute('data-home-quick-shop-swatch');

            card.querySelectorAll('[data-home-quick-shop-swatch]').forEach((item) => {
              item.classList.toggle('is-active', item === swatch);
            });

            card.querySelectorAll('[data-home-quick-shop-image]').forEach((image) => {
              image.classList.toggle('is-active', image.getAttribute('data-home-quick-shop-image') === target);
            });
          });
        });

        card.querySelectorAll('[data-home-quick-shop-open]').forEach((button) => {
          button.addEventListener('click', () => openSelector(card));
        });
      });

      section.querySelector('[data-home-quick-shop-close]')?.addEventListener('click', closeSelector);
      selector.addEventListener('click', (event) => {
        if (event.target === selector) closeSelector();
      });
      floatingCartButton?.addEventListener('click', openExistingCartDrawer);
      document.querySelector('cart-drawer')?.addEventListener('transitionend', updateFloatingCart);
      document.querySelector('cart-drawer')?.querySelector('#CartDrawer-Overlay')?.addEventListener('click', () => setTimeout(updateFloatingCart, 350));
      document.addEventListener('keyup', (event) => {
        if (event.code && event.code.toUpperCase() === 'ESCAPE') setTimeout(updateFloatingCart, 350);
      });
      document.addEventListener('afterCartChanged', () => setTimeout(updateFloatingCart, 350));

      form.addEventListener('submit', (event) => {
        event.preventDefault();
        if (!selectedVariant || !selectedVariant.available) return;

        submitButton.disabled = true;
        submitButton.textContent = 'Adding...';
        addToCart(selectedVariant.id).catch((error) => {
          errorNode.textContent = error.message || 'Unable to add to cart.';
          errorNode.hidden = false;
          updateVariantState();
        });
      });
    };

    initQuickShop();

    document.addEventListener('shopify:section:load', (event) => {
      const section = event.target.querySelector(`[data-home-quick-shop-section="${sectionId}"]`);
      if (section) section.dataset.homeQuickShopInitialized = 'false';
      initQuickShop(event.target);
    });
  })();
</script>

