{% comment %}
  KasyaPH Product Landing Reassurance
  Shipping and return confidence strip.
{% endcomment %}

<section class="kasya-lp-reassurance">
  <div class="kasya-lp-reassurance__inner">
    <div class="kasya-lp-reassurance__header">
      {% if section.settings.heading != blank %}
        <h2 class="kasya-lp-reassurance__heading">
          {{ section.settings.heading }}
        </h2>
      {% endif %}

      {% if section.settings.subheading != blank %}
        <p class="kasya-lp-reassurance__subheading">
          {{ section.settings.subheading }}
        </p>
      {% endif %}
    </div>

    {% if section.blocks.size > 0 %}
      <div class="kasya-lp-reassurance__grid">
        {% for block in section.blocks %}
          {% liquid
            assign icon_title = block.settings.title | downcase
            assign icon_key = block.settings.icon | append: ' ' | append: block.settings.title | append: ' ' | append: block.settings.description | downcase

            assign icon_type = 'shipping'

            if icon_title contains 'shipping' or icon_title contains 'ships'
              assign icon_type = 'shipping'
            elsif icon_title contains 'payment' or icon_title contains 'cod' or icon_title contains 'gcash' or icon_title contains 'card'
              assign icon_type = 'payment'
            elsif icon_title contains 'return' or icon_title contains 'exchange' or icon_title contains 'accepted'
              assign icon_type = 'return'
            elsif icon_title contains 'help' or icon_title contains 'support' or icon_title contains 'message'
              assign icon_type = 'support'
            elsif icon_key contains 'payment' or icon_key contains 'card' or icon_key contains 'cash' or icon_key contains 'wallet' or icon_key contains 'gcash' or icon_key contains 'cod'
              assign icon_type = 'payment'
            elsif icon_key contains 'return' or icon_key contains 'exchange' or icon_key contains 'accepted' or icon_key contains 'tag'
              assign icon_type = 'return'
            elsif icon_key contains 'message' or icon_key contains 'chat' or icon_key contains 'support' or icon_key contains 'help'
              assign icon_type = 'support'
            elsif icon_key contains 'policy' or icon_key contains 'document' or icon_key contains 'shield'
              assign icon_type = 'policy'
            endif
          %}

          <article class="kasya-lp-reassurance__item" {{ block.shopify_attributes }}>
            <div class="kasya-lp-reassurance__icon" aria-hidden="true">
              {% if icon_type == 'payment' %}
                <svg viewBox="0 0 24 24" fill="none">
                  <path d="M3.8 6.7h16.4v10.6H3.8V6.7Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
                  <path d="M3.8 10h16.4M7 14.6h4.4M14.2 14.6h2.8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                </svg>
              {% elsif icon_type == 'return' %}
                <svg viewBox="0 0 24 24" fill="none">
                  <path d="M6.4 8.4 12 5.2l5.6 3.2v6.4L12 18l-5.6-3.2V8.4Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
                  <path d="m6.7 8.6 5.3 3 5.3-3M12 11.6v6" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
                  <path d="M4.2 18.2h5.2l-1.7-1.7M19.8 5.8h-5.2l1.7 1.7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              {% elsif icon_type == 'support' %}
                <svg viewBox="0 0 24 24" fill="none">
                  <path d="M5.2 18.4c-1.3-1.3-2-3-2-4.9C3.2 8.6 7.1 5 12 5s8.8 3.6 8.8 8.4-3.9 8.4-8.8 8.4c-1.3 0-2.6-.3-3.7-.8l-4.1 1 1-3.6Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
                  <path d="M8.5 12.6h7M8.5 15.4h4.8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                </svg>
              {% elsif icon_type == 'policy' %}
                <svg viewBox="0 0 24 24" fill="none">
                  <path d="M7 3.8h7.4L18 7.5v12.7H7V3.8Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
                  <path d="M14.2 3.9v3.8h3.7M9.8 11.2h5.4M9.8 14.2h5.4M9.8 17.2h3.4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                </svg>
              {% else %}
                <svg viewBox="0 0 24 24" fill="none">
                  <path d="M4.2 8.2h10.2v8H4.2v-8Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
                  <path d="M14.4 10.6h3.1l2.3 2.8v2.8h-5.4v-5.6Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
                  <path d="M7.1 19a1.55 1.55 0 1 0 0-3.1 1.55 1.55 0 0 0 0 3.1ZM17.4 19a1.55 1.55 0 1 0 0-3.1 1.55 1.55 0 0 0 0 3.1ZM6.1 5.6h6.4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                </svg>
              {% endif %}
            </div>

            <div class="kasya-lp-reassurance__copy">
              {% if block.settings.title != blank %}
                <h3 class="kasya-lp-reassurance__title">
                  {{ block.settings.title }}
                </h3>
              {% endif %}

              {% if block.settings.description != blank %}
                <p class="kasya-lp-reassurance__description">
                  {{ block.settings.description }}
                </p>
              {% endif %}
            </div>
          </article>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</section>

<style>
  .kasya-lp-reassurance {
    background: #ffffff;
    color: #111111;
    font-family: inherit;
    max-width: 760px;
    margin: 0 auto;
  }

  .kasya-lp-reassurance * {
    box-sizing: border-box;
  }

  .kasya-lp-reassurance__inner {
    padding: 20px 16px 32px;
  }

  .kasya-lp-reassurance__header {
    margin-bottom: 12px;
    text-align: center;
  }

  .kasya-lp-reassurance__heading {
    margin: 0;
    font-size: 19px;
    font-weight: 850;
    letter-spacing: 0;
    line-height: 1.1;
  }

  .kasya-lp-reassurance__subheading {
    margin: 8px 0 0;
    color: #666666;
    font-size: 13px;
    line-height: 1.45;
  }

  .kasya-lp-reassurance__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
  }

  .kasya-lp-reassurance__item {
    min-width: 0;
    min-height: 116px;
    padding: 13px 9px 12px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    text-align: center;
    border: 1px solid #e6e6e6;
    background: #ffffff;
  }

  .kasya-lp-reassurance__icon {
    width: 30px;
    height: 30px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #111111;
  }

  .kasya-lp-reassurance__icon svg {
    width: 27px;
    height: 27px;
  }

  .kasya-lp-reassurance__copy {
    margin-top: 9px;
    min-width: 0;
  }

  .kasya-lp-reassurance__title {
    margin: 0;
    font-size: 12px;
    font-weight: 850;
    letter-spacing: 0.02em;
    line-height: 1.18;
  }

  .kasya-lp-reassurance__description {
    margin: 5px 0 0;
    color: #666666;
    font-size: 11px;
    line-height: 1.3;
  }

  @media screen and (min-width: 680px) {
    .kasya-lp-reassurance__inner {
      padding: 26px 26px 42px;
    }

    .kasya-lp-reassurance__heading {
      font-size: 22px;
    }

    .kasya-lp-reassurance__grid {
      gap: 10px;
    }

    .kasya-lp-reassurance__item {
      min-height: 122px;
      padding: 16px 14px 14px;
    }
  }
</style>

{% schema %}
{
  "name": "Kasya LP Reassurance",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shipping & Return"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "A quick guide before checkout."
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff",
      "info": "This section is designed for a black and white trust strip."
    },
    {
      "type": "color",
      "id": "card_color",
      "label": "Item background color",
      "default": "#ffffff"
    }
  ],
  "blocks": [
    {
      "type": "reassurance_item",
      "name": "Reassurance Item",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icon keyword",
          "default": "shipping",
          "info": "Use shipping, payment, card, wallet, return, exchange, policy, document, shield, message, chat, support, or help. Icons render as black line icons."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Ships within"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "7 business days"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Kasya LP Reassurance",
      "blocks": [
        {
          "type": "reassurance_item",
          "settings": {
            "icon": "shipping",
            "title": "Ships within",
            "description": "7 business days"
          }
        },
        {
          "type": "reassurance_item",
          "settings": {
            "icon": "payment",
            "title": "Easy Payment",
            "description": "COD, GCash, and card payments available."
          }
        },
        {
          "type": "reassurance_item",
          "settings": {
            "icon": "return",
            "title": "Returns accepted",
            "description": "for unworn items with tags attached"
          }
        },
        {
          "type": "reassurance_item",
          "settings": {
            "icon": "message",
            "title": "Need help?",
            "description": "Message us for sizing assistance"
          }
        }
      ]
    }
  ]
}
{% endschema %}
