{{ 'home-88-outfit-considered.css' | asset_url | stylesheet_tag }}

{%- assign first_look = section.blocks.first -%}

<section
  id="home-88-shop-the-look"
  class="home-88-outfit"
  data-home-88-outfit
  data-section-id="{{ section.id }}"
  style="
    --outfit-bg: {{ section.settings.background_color }};
    --outfit-text: {{ section.settings.text_color }};
    --outfit-pad-top-mobile: {{ section.settings.padding_top_mobile }}px;
    --outfit-pad-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
    --outfit-pad-top-desktop: {{ section.settings.padding_top_desktop }}px;
    --outfit-pad-bottom-desktop: {{ section.settings.padding_bottom_desktop }}px;
    --outfit-heading-mobile: {{ section.settings.heading_size_mobile }}px;
    --outfit-heading-desktop: {{ section.settings.heading_size_desktop }}px;
    --outfit-product-mobile: {{ section.settings.product_title_size_mobile }}px;
    --outfit-product-desktop: {{ section.settings.product_title_size_desktop }}px;
    --outfit-button-mobile: {{ section.settings.product_button_size_mobile }}px;
    --outfit-button-desktop: {{ section.settings.product_button_size_desktop }}px;
  "
>
  <div class="home-88-outfit__inner">
    <h2 class="home-88-outfit__heading">{{ section.settings.heading | escape }}</h2>

    {%- if first_look != blank -%}
      {%- liquid
        assign initial_product_count = 0
        for product_index in (1..2)
          assign product_key = 'product_' | append: product_index
          if first_look.settings[product_key] != blank
            assign initial_product_count = initial_product_count | plus: 1
          endif
        endfor
      -%}

      <div class="home-88-outfit__stage" data-carousel>
        <div class="home-88-outfit__track" data-carousel-track tabindex="0" aria-label="Shop the Look gallery">
          {%- assign slide_index = 0 -%}
          {%- for block in section.blocks limit: 4 -%}
            {%- assign look_index = forloop.index0 -%}
            {%- for image_index in (1..3) -%}
              {%- liquid
                case image_index
                  when 1
                    assign image_key = 'front_image'
                    assign alt_key = 'front_image_alt'
                  when 2
                    assign image_key = 'side_image'
                    assign alt_key = 'side_image_alt'
                  else
                    assign image_key = 'back_image'
                    assign alt_key = 'back_image_alt'
                endcase
                assign outfit_image = block.settings[image_key]
                assign outfit_alt = block.settings[alt_key] | default: block.settings.look_title | default: section.settings.heading
              -%}
              {%- if outfit_image != blank -%}
                <div
                  class="home-88-outfit__slide"
                  data-carousel-slide="{{ slide_index }}"
                  data-look-index="{{ look_index }}"
                  data-block-id="{{ block.id }}"
                  aria-hidden="{% if slide_index == 0 %}false{% else %}true{% endif %}"
                  style="--slide-position-mobile: {{ block.settings.mobile_image_position }}; --slide-position-desktop: {{ block.settings.desktop_image_position }};"
                >
                  {{- outfit_image
                    | image_url: width: 1800
                    | image_tag:
                      class: 'home-88-outfit__image',
                      widths: '480, 720, 960, 1200, 1500, 1800',
                      sizes: '(min-width: 750px) min(1120px, calc(100vw - 96px)), calc(100vw - 24px)',
                      loading: 'lazy',
                      alt: outfit_alt
                  -}}
                </div>
                {%- assign slide_index = slide_index | plus: 1 -%}
              {%- endif -%}
            {%- endfor -%}
          {%- endfor -%}
        </div>

        {%- if slide_index > 1 -%}
          <button class="home-88-outfit__arrow home-88-outfit__arrow--previous" type="button" data-carousel-previous aria-label="Previous Shop the Look image">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m15 5-7 7 7 7" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"/></svg>
          </button>
          <button class="home-88-outfit__arrow home-88-outfit__arrow--next" type="button" data-carousel-next aria-label="Next Shop the Look image">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m9 5 7 7-7 7" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"/></svg>
          </button>

          <div class="home-88-outfit__dots" aria-label="Choose Shop the Look image">
            {%- assign dot_index = 0 -%}
            {%- for block in section.blocks limit: 4 -%}
              {%- for image_index in (1..3) -%}
                {%- liquid
                  case image_index
                    when 1
                      assign image_key = 'front_image'
                    when 2
                      assign image_key = 'side_image'
                    else
                      assign image_key = 'back_image'
                  endcase
                -%}
                {%- if block.settings[image_key] != blank -%}
                  <button
                    class="home-88-outfit__dot{% if dot_index == 0 %} is-active{% endif %}"
                    type="button"
                    data-carousel-dot="{{ dot_index }}"
                    aria-label="Show Shop the Look image {{ dot_index | plus: 1 }}"
                    aria-current="{% if dot_index == 0 %}true{% else %}false{% endif %}"
                  ></button>
                  {%- assign dot_index = dot_index | plus: 1 -%}
                {%- endif -%}
              {%- endfor -%}
            {%- endfor -%}
          </div>
        {%- endif -%}

        <div class="home-88-outfit__tray" data-product-tray data-product-count="{{ initial_product_count }}" aria-live="polite">
          {%- for product_index in (1..2) -%}
            {%- liquid
              assign product_key = 'product_' | append: product_index
              assign title_key = product_key | append: '_title'
              assign image_key = product_key | append: '_image'
              assign alt_key = product_key | append: '_image_alt'
              assign look_product = first_look.settings[product_key]
              assign product_title = look_product.title | default: first_look.settings[title_key]
              assign product_image = look_product.featured_image | default: first_look.settings[image_key]
              assign product_alt = product_image.alt | default: first_look.settings[alt_key] | default: product_title
            -%}
            <article class="home-88-outfit__product" data-product-slot="{{ product_index }}"{% if look_product == blank %} hidden{% endif %}>
              <a class="home-88-outfit__product-image-link" data-product-link{% if look_product != blank %} href="{{ look_product.url }}"{% endif %}>
                <img
                  class="home-88-outfit__product-image"
                  data-product-image
                  {% if product_image != blank %}src="{{ product_image | image_url: width: 240 }}"{% else %}hidden{% endif %}
                  alt="{{ product_alt | escape }}"
                  loading="lazy"
                  width="120"
                  height="150"
                >
              </a>
              <a class="home-88-outfit__product-title" data-product-title data-product-link{% if look_product != blank %} href="{{ look_product.url }}"{% endif %}>{{ product_title | escape }}</a>
              <quick-add-drawer-opener class="home-88-outfit__quick-add" data-product-opener>
                <button
                  class="home-88-outfit__product-button"
                  type="button"
                  data-product-button
                  data-product-url="{% if look_product != blank %}{{ look_product.url }}{% endif %}"
                  aria-haspopup="dialog"
                  aria-label="See fit and colors for {{ product_title | escape }}"
                  {% if look_product == blank %}disabled aria-disabled="true"{% endif %}
                >
                  <span>See Fit &amp; Colors</span>
                  <span class="loading-overlay__spinner hidden">{% render 'icon-cart-loading' %}</span>
                </button>
              </quick-add-drawer-opener>
            </article>
          {%- endfor -%}
        </div>
      </div>

      {%- for block in section.blocks limit: 4 -%}
        {%- liquid
          assign product_1 = block.settings.product_1
          assign product_2 = block.settings.product_2
          assign product_1_title = product_1.title | default: block.settings.product_1_title
          assign product_2_title = product_2.title | default: block.settings.product_2_title
          assign product_1_image = product_1.featured_image | default: block.settings.product_1_image
          assign product_2_image = product_2.featured_image | default: block.settings.product_2_image
        -%}
        <script type="application/json" data-look-json="{{ forloop.index0 }}">
          {
            "blockId": {{ block.id | json }},
            "products": [
              {
                "title": {{ product_1_title | json }},
                "url": {%- if product_1 != blank -%}{{ product_1.url | json }}{%- else -%}null{%- endif -%},
                "image": {
                  "src": {%- if product_1_image != blank -%}{{ product_1_image | image_url: width: 240 | json }}{%- else -%}null{%- endif -%},
                  "alt": {{ product_1_image.alt | default: block.settings.product_1_image_alt | default: product_1_title | json }}
                }
              },
              {
                "title": {{ product_2_title | json }},
                "url": {%- if product_2 != blank -%}{{ product_2.url | json }}{%- else -%}null{%- endif -%},
                "image": {
                  "src": {%- if product_2_image != blank -%}{{ product_2_image | image_url: width: 240 | json }}{%- else -%}null{%- endif -%},
                  "alt": {{ product_2_image.alt | default: block.settings.product_2_image_alt | default: product_2_title | json }}
                }
              }
            ]
          }
        </script>
      {%- endfor -%}
    {%- else -%}
      <div class="home-88-outfit__empty">
        {{ 'lifestyle-1' | placeholder_svg_tag: 'home-88-outfit__placeholder' }}
      </div>
    {%- endif -%}
  </div>
</section>

<script src="{{ 'home-88-outfit-considered.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Home 10.10 Shop the Look",
  "tag": "section",
  "class": "section-home-88-outfit-considered",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "SHOP THE LOOK" },
    { "type": "text", "id": "subtitle", "label": "Legacy subtitle (not displayed)", "default": "Three ways to wear the collection" },
    { "type": "text", "id": "thumbnail_helper_text", "label": "Legacy selector text (not displayed)", "default": "Choose your favorite look" },
    { "type": "color", "id": "background_color", "label": "Background color", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#171714" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top_mobile", "label": "Mobile top padding", "min": 20, "max": 100, "step": 4, "unit": "px", "default": 32 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Mobile bottom padding", "min": 20, "max": 100, "step": 4, "unit": "px", "default": 32 },
    { "type": "range", "id": "padding_top_desktop", "label": "Desktop top padding", "min": 32, "max": 160, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom_desktop", "label": "Desktop bottom padding", "min": 32, "max": 160, "step": 4, "unit": "px", "default": 48 },
    { "type": "header", "content": "Typography" },
    { "type": "range", "id": "heading_size_mobile", "label": "Mobile heading size", "min": 18, "max": 40, "step": 1, "unit": "px", "default": 22 },
    { "type": "range", "id": "heading_size_desktop", "label": "Desktop heading size", "min": 24, "max": 64, "step": 1, "unit": "px", "default": 28 },
    { "type": "range", "id": "subtitle_size_mobile", "label": "Legacy mobile subtitle size", "min": 10, "max": 22, "step": 1, "unit": "px", "default": 13 },
    { "type": "range", "id": "subtitle_size_desktop", "label": "Legacy desktop subtitle size", "min": 12, "max": 30, "step": 1, "unit": "px", "default": 18 },
    { "type": "range", "id": "label_size_mobile", "label": "Legacy mobile label size", "min": 9, "max": 18, "step": 1, "unit": "px", "default": 11 },
    { "type": "range", "id": "label_size_desktop", "label": "Legacy desktop label size", "min": 10, "max": 24, "step": 1, "unit": "px", "default": 13 },
    { "type": "range", "id": "look_title_size_mobile", "label": "Legacy mobile look-title size", "min": 12, "max": 28, "step": 1, "unit": "px", "default": 17 },
    { "type": "range", "id": "look_title_size_desktop", "label": "Legacy desktop look-title size", "min": 18, "max": 44, "step": 1, "unit": "px", "default": 30 },
    { "type": "range", "id": "description_size_mobile", "label": "Legacy mobile description size", "min": 10, "max": 20, "step": 1, "unit": "px", "default": 12 },
    { "type": "range", "id": "description_size_desktop", "label": "Legacy desktop description size", "min": 12, "max": 28, "step": 1, "unit": "px", "default": 17 },
    { "type": "range", "id": "thumbnail_helper_size_mobile", "label": "Legacy mobile helper size", "min": 9, "max": 18, "step": 1, "unit": "px", "default": 11 },
    { "type": "range", "id": "thumbnail_helper_size_desktop", "label": "Legacy desktop helper size", "min": 10, "max": 24, "step": 1, "unit": "px", "default": 14 },
    { "type": "range", "id": "thumbnail_title_size_mobile", "label": "Legacy mobile selector-title size", "min": 8, "max": 18, "step": 1, "unit": "px", "default": 11 },
    { "type": "range", "id": "thumbnail_title_size_desktop", "label": "Legacy desktop selector-title size", "min": 10, "max": 24, "step": 1, "unit": "px", "default": 14 },
    { "type": "range", "id": "product_title_size_mobile", "label": "Mobile tray product-title size", "min": 9, "max": 18, "step": 1, "unit": "px", "default": 13 },
    { "type": "range", "id": "product_title_size_desktop", "label": "Desktop tray product-title size", "min": 12, "max": 24, "step": 1, "unit": "px", "default": 15 },
    { "type": "range", "id": "product_button_size_mobile", "label": "Mobile tray button size", "min": 8, "max": 16, "step": 1, "unit": "px", "default": 10 },
    { "type": "range", "id": "product_button_size_desktop", "label": "Desktop tray button size", "min": 9, "max": 20, "step": 1, "unit": "px", "default": 12 },
    { "type": "header", "content": "Legacy layout settings" },
    { "type": "range", "id": "flatlay_gap", "label": "Legacy flatlay gap", "min": 2, "max": 28, "step": 2, "unit": "px", "default": 8 },
    { "type": "range", "id": "active_thumbnail_scale", "label": "Legacy active selector scale", "min": 100, "max": 112, "step": 1, "unit": "%", "default": 110 },
    { "type": "range", "id": "thumbnail_gap", "label": "Legacy selector gap", "min": 4, "max": 32, "step": 2, "unit": "px", "default": 12 }
  ],
  "blocks": [
    {
      "type": "look",
      "name": "Shop the Look slide",
      "settings": [
        { "type": "text", "id": "look_title", "label": "Look name (editor reference)", "default": "LOOK" },
        { "type": "textarea", "id": "look_description", "label": "Legacy description (not displayed)" },
        { "type": "image_picker", "id": "thumbnail_image", "label": "Legacy selector image (not displayed)" },
        { "type": "text", "id": "thumbnail_alt", "label": "Legacy selector alt text" },
        { "type": "paragraph", "content": "Recommended lifestyle images: 1200 × 1500 px or larger, WebP." },
        { "type": "image_picker", "id": "front_image", "label": "Lifestyle image 1" },
        { "type": "text", "id": "front_image_alt", "label": "Image 1 alt text" },
        { "type": "image_picker", "id": "side_image", "label": "Lifestyle image 2" },
        { "type": "text", "id": "side_image_alt", "label": "Image 2 alt text" },
        { "type": "image_picker", "id": "back_image", "label": "Lifestyle image 3" },
        { "type": "text", "id": "back_image_alt", "label": "Image 3 alt text" },
        { "type": "select", "id": "mobile_image_position", "label": "Mobile image position", "default": "center center", "options": [{ "value": "left center", "label": "Left" }, { "value": "center center", "label": "Center" }, { "value": "right center", "label": "Right" }, { "value": "center top", "label": "Top" }, { "value": "center bottom", "label": "Bottom" }] },
        { "type": "select", "id": "desktop_image_position", "label": "Desktop image position", "default": "center center", "options": [{ "value": "left center", "label": "Left" }, { "value": "center center", "label": "Center" }, { "value": "right center", "label": "Right" }, { "value": "center top", "label": "Top" }, { "value": "center bottom", "label": "Bottom" }] },
        { "type": "header", "content": "Product 1" },
        { "type": "product", "id": "product_1", "label": "Shopify product" },
        { "type": "text", "id": "product_1_title", "label": "Fallback title" },
        { "type": "image_picker", "id": "product_1_image", "label": "Fallback thumbnail" },
        { "type": "text", "id": "product_1_image_alt", "label": "Fallback thumbnail alt text" },
        { "type": "text", "id": "product_1_button_label", "label": "Legacy button label", "default": "See Fit & Colors" },
        { "type": "header", "content": "Product 2" },
        { "type": "product", "id": "product_2", "label": "Shopify product" },
        { "type": "text", "id": "product_2_title", "label": "Fallback title" },
        { "type": "image_picker", "id": "product_2_image", "label": "Fallback thumbnail" },
        { "type": "text", "id": "product_2_image_alt", "label": "Fallback thumbnail alt text" },
        { "type": "text", "id": "product_2_button_label", "label": "Legacy button label", "default": "See Fit & Colors" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Home 10.10 Shop the Look",
      "blocks": [
        { "type": "look", "settings": { "look_title": "LOOK 1" } },
        { "type": "look", "settings": { "look_title": "LOOK 2" } },
        { "type": "look", "settings": { "look_title": "LOOK 3" } }
      ]
    }
  ]
}
{% endschema %}
