{{ 'home-88-outfit-considered.css' | asset_url | stylesheet_tag }}

{%- assign first_look = section.blocks.first -%}

<div
  id="home-88-shop-the-look"
  class="home-88-outfit"
  data-home-88-outfit
  data-section-id="{{ section.id }}"
  style="
    --outfit-bg: {{ section.settings.background_color }};
    --outfit-text: {{ section.settings.text_color }};
    --outfit-pad-top-mobile: {{ section.settings.padding_top_mobile }}px;
    --outfit-pad-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
    --outfit-pad-top-desktop: {{ section.settings.padding_top_desktop }}px;
    --outfit-pad-bottom-desktop: {{ section.settings.padding_bottom_desktop }}px;
    --outfit-heading-mobile: {{ section.settings.heading_size_mobile }}px;
    --outfit-heading-desktop: {{ section.settings.heading_size_desktop }}px;
    --outfit-subtitle-mobile: {{ section.settings.subtitle_size_mobile }}px;
    --outfit-subtitle-desktop: {{ section.settings.subtitle_size_desktop }}px;
    --outfit-label-mobile: {{ section.settings.label_size_mobile }}px;
    --outfit-label-desktop: {{ section.settings.label_size_desktop }}px;
    --outfit-title-mobile: {{ section.settings.look_title_size_mobile }}px;
    --outfit-title-desktop: {{ section.settings.look_title_size_desktop }}px;
    --outfit-description-mobile: {{ section.settings.description_size_mobile }}px;
    --outfit-description-desktop: {{ section.settings.description_size_desktop }}px;
    --outfit-helper-mobile: {{ section.settings.thumbnail_helper_size_mobile }}px;
    --outfit-helper-desktop: {{ section.settings.thumbnail_helper_size_desktop }}px;
    --outfit-thumbnail-title-mobile: {{ section.settings.thumbnail_title_size_mobile }}px;
    --outfit-thumbnail-title-desktop: {{ section.settings.thumbnail_title_size_desktop }}px;
    --outfit-product-mobile: {{ section.settings.product_title_size_mobile }}px;
    --outfit-product-desktop: {{ section.settings.product_title_size_desktop }}px;
    --outfit-button-mobile: {{ section.settings.product_button_size_mobile }}px;
    --outfit-button-desktop: {{ section.settings.product_button_size_desktop }}px;
    --outfit-flatlay-gap: {{ section.settings.flatlay_gap }}px;
    --outfit-active-scale: {{ section.settings.active_thumbnail_scale | divided_by: 100.0 }};
    --outfit-thumbnail-gap: {{ section.settings.thumbnail_gap }}px;
  "
>
  <div class="home-88-outfit__inner">
    <h2 class="home-88-outfit__heading">{{ section.settings.heading | escape }}</h2>
    <p class="home-88-outfit__subtitle">{{ section.settings.subtitle | escape }}</p>

    <div class="home-88-outfit__composition" id="Home88OutfitPanel-{{ section.id }}" role="tabpanel">
      <div class="home-88-outfit__details">
        <p class="home-88-outfit__label">Shop The Look</p>
        <h3 class="home-88-outfit__look-title" data-look-title>{{ first_look.settings.look_title | escape }}</h3>
        <p class="home-88-outfit__description" data-look-description>{{ first_look.settings.look_description | escape }}</p>

        <div class="home-88-outfit__products">
          {%- for product_index in (1..2) -%}
            {%- liquid
              assign product_key = 'product_' | append: product_index
              assign title_key = product_key | append: '_title'
              assign image_key = product_key | append: '_image'
              assign alt_key = product_key | append: '_image_alt'
              assign button_key = product_key | append: '_button_label'
              assign look_product = first_look.settings[product_key]
              assign product_title = first_look.settings[title_key] | default: look_product.title
              assign product_image = first_look.settings[image_key]
              assign product_alt = first_look.settings[alt_key] | default: product_title
            -%}
            <article class="home-88-outfit__product" data-product-slot="{{ product_index }}">
              <a class="home-88-outfit__flatlay-link" data-product-link{% if look_product != blank %} href="{{ look_product.url }}"{% else %} aria-disabled="true"{% endif %}>
                <span class="home-88-outfit__flatlay">
                  <img
                    data-product-image
                    {% if product_image != blank %}src="{{ product_image | image_url: width: 800 }}"{% else %}hidden{% endif %}
                    alt="{{ product_alt | escape }}"
                    loading="lazy"
                    width="800"
                    height="1000"
                  >
                </span>
              </a>
              <a class="home-88-outfit__product-title" data-product-title data-product-link{% if look_product != blank %} href="{{ look_product.url }}"{% else %} aria-disabled="true"{% endif %}>{{ product_title | escape }}</a>
              <a class="home-88-outfit__product-button" data-product-button data-product-link{% if look_product != blank %} href="{{ look_product.url }}"{% else %} aria-disabled="true"{% endif %}>{{ first_look.settings[button_key] | default: 'See Color & Fit' | escape }}</a>
            </article>
          {%- endfor -%}
        </div>
      </div>

      <div class="home-88-outfit__carousel" data-carousel>
        <div class="home-88-outfit__track" data-carousel-track tabindex="0" aria-label="Outfit views">
          {%- for image_name in (1..3) -%}
            {%- liquid
              case image_name
                when 1
                  assign image_key = 'front_image'
                  assign alt_key = 'front_image_alt'
                when 2
                  assign image_key = 'side_image'
                  assign alt_key = 'side_image_alt'
                else
                  assign image_key = 'back_image'
                  assign alt_key = 'back_image_alt'
              endcase
              assign outfit_image = first_look.settings[image_key]
              assign outfit_alt = first_look.settings[alt_key] | default: first_look.settings.look_title
            -%}
            <div class="home-88-outfit__slide" data-carousel-slide>
              <img
                data-carousel-image="{{ forloop.index0 }}"
                {% if outfit_image != blank %}src="{{ outfit_image | image_url: width: 1400 }}"{% else %}hidden{% endif %}
                alt="{{ outfit_alt | escape }}"
                loading="lazy"
                width="1200"
                height="1500"
              >
            </div>
          {%- endfor -%}
        </div>
        <div class="home-88-outfit__dots" aria-label="Choose outfit view">
          {%- for dot in (1..3) -%}
            <button class="home-88-outfit__dot{% if forloop.first %} is-active{% endif %}" type="button" data-carousel-dot="{{ forloop.index0 }}" aria-label="Show outfit view {{ dot }}" aria-current="{% if forloop.first %}true{% else %}false{% endif %}"></button>
          {%- endfor -%}
        </div>
      </div>
    </div>

    <p class="home-88-outfit__helper">{{ section.settings.thumbnail_helper_text | escape }}</p>
    <div class="home-88-outfit__selectors" role="tablist" aria-label="Outfit recommendations">
      {%- for block in section.blocks limit: 3 -%}
        <button
          class="home-88-outfit__selector{% if forloop.first %} is-active{% endif %}"
          type="button"
          role="tab"
          aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
          aria-controls="Home88OutfitPanel-{{ section.id }}"
          data-look-trigger="{{ forloop.index0 }}"
          data-block-id="{{ block.id }}"
          {{ block.shopify_attributes }}
        >
          <span class="home-88-outfit__thumbnail">
            {%- if block.settings.thumbnail_image != blank -%}
              {{ block.settings.thumbnail_image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '180, 280, 400, 600, 800', sizes: '33vw', alt: block.settings.thumbnail_alt }}
            {%- else -%}
              {{ 'image' | placeholder_svg_tag: 'home-88-outfit__placeholder' }}
            {%- endif -%}
          </span>
          <span class="home-88-outfit__selector-title">{{ block.settings.look_title | escape }}</span>
        </button>

        {%- liquid
          assign product_1 = block.settings.product_1
          assign product_2 = block.settings.product_2
          assign product_1_title = block.settings.product_1_title | default: product_1.title
          assign product_2_title = block.settings.product_2_title | default: product_2.title
        -%}
        <script type="application/json" data-look-json="{{ forloop.index0 }}">
          {
            "blockId": {{ block.id | json }},
            "title": {{ block.settings.look_title | json }},
            "description": {{ block.settings.look_description | json }},
            "positionMobile": {{ block.settings.mobile_image_position | json }},
            "positionDesktop": {{ block.settings.desktop_image_position | json }},
            "images": [
              { "src": {%- if block.settings.front_image != blank -%}{{ block.settings.front_image | image_url: width: 1400 | json }}{%- else -%}null{%- endif -%}, "alt": {{ block.settings.front_image_alt | default: block.settings.look_title | json }} },
              { "src": {%- if block.settings.side_image != blank -%}{{ block.settings.side_image | image_url: width: 1400 | json }}{%- else -%}null{%- endif -%}, "alt": {{ block.settings.side_image_alt | default: block.settings.look_title | json }} },
              { "src": {%- if block.settings.back_image != blank -%}{{ block.settings.back_image | image_url: width: 1400 | json }}{%- else -%}null{%- endif -%}, "alt": {{ block.settings.back_image_alt | default: block.settings.look_title | json }} }
            ],
            "products": [
              {
                "title": {{ product_1_title | json }},
                "url": {%- if product_1 != blank -%}{{ product_1.url | json }}{%- else -%}null{%- endif -%},
                "image": { "src": {%- if block.settings.product_1_image != blank -%}{{ block.settings.product_1_image | image_url: width: 800 | json }}{%- else -%}null{%- endif -%}, "alt": {{ block.settings.product_1_image_alt | default: product_1_title | json }} },
                "buttonLabel": {{ block.settings.product_1_button_label | default: 'See Color & Fit' | json }}
              },
              {
                "title": {{ product_2_title | json }},
                "url": {%- if product_2 != blank -%}{{ product_2.url | json }}{%- else -%}null{%- endif -%},
                "image": { "src": {%- if block.settings.product_2_image != blank -%}{{ block.settings.product_2_image | image_url: width: 800 | json }}{%- else -%}null{%- endif -%}, "alt": {{ block.settings.product_2_image_alt | default: product_2_title | json }} },
                "buttonLabel": {{ block.settings.product_2_button_label | default: 'See Color & Fit' | json }}
              }
            ]
          }
        </script>
      {%- endfor -%}
    </div>
  </div>
</div>

<script src="{{ 'home-88-outfit-considered.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Home 8.8 outfit",
  "tag": "section",
  "class": "section-home-88-outfit-considered",
  "max_blocks": 3,
  "settings": [
    { "type": "text", "id": "heading", "label": "Main heading", "default": "YOUR OUTFIT IS ALREADY CONSIDERED" },
    { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "Three ways to wear the 8.8 collection" },
    { "type": "text", "id": "thumbnail_helper_text", "label": "Thumbnail helper text", "default": "Choose your favorite look" },
    { "type": "color", "id": "background_color", "label": "Background color", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#171714" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top_mobile", "label": "Mobile top padding", "min": 20, "max": 100, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Mobile bottom padding", "min": 20, "max": 100, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_top_desktop", "label": "Desktop top padding", "min": 32, "max": 160, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom_desktop", "label": "Desktop bottom padding", "min": 32, "max": 160, "step": 4, "unit": "px", "default": 80 },
    { "type": "header", "content": "Typography" },
    { "type": "range", "id": "heading_size_mobile", "label": "Mobile heading size", "min": 18, "max": 40, "step": 1, "unit": "px", "default": 25 },
    { "type": "range", "id": "heading_size_desktop", "label": "Desktop heading size", "min": 24, "max": 64, "step": 1, "unit": "px", "default": 42 },
    { "type": "range", "id": "subtitle_size_mobile", "label": "Mobile subtitle size", "min": 10, "max": 22, "step": 1, "unit": "px", "default": 13 },
    { "type": "range", "id": "subtitle_size_desktop", "label": "Desktop subtitle size", "min": 12, "max": 30, "step": 1, "unit": "px", "default": 18 },
    { "type": "range", "id": "label_size_mobile", "label": "Mobile Shop The Look size", "min": 9, "max": 18, "step": 1, "unit": "px", "default": 11 },
    { "type": "range", "id": "label_size_desktop", "label": "Desktop Shop The Look size", "min": 10, "max": 24, "step": 1, "unit": "px", "default": 13 },
    { "type": "range", "id": "look_title_size_mobile", "label": "Mobile look-title size", "min": 12, "max": 28, "step": 1, "unit": "px", "default": 17 },
    { "type": "range", "id": "look_title_size_desktop", "label": "Desktop look-title size", "min": 18, "max": 44, "step": 1, "unit": "px", "default": 30 },
    { "type": "range", "id": "description_size_mobile", "label": "Mobile description size", "min": 10, "max": 20, "step": 1, "unit": "px", "default": 12 },
    { "type": "range", "id": "description_size_desktop", "label": "Desktop description size", "min": 12, "max": 28, "step": 1, "unit": "px", "default": 17 },
    { "type": "range", "id": "thumbnail_helper_size_mobile", "label": "Mobile thumbnail helper size", "min": 9, "max": 18, "step": 1, "unit": "px", "default": 11 },
    { "type": "range", "id": "thumbnail_helper_size_desktop", "label": "Desktop thumbnail helper size", "min": 10, "max": 24, "step": 1, "unit": "px", "default": 14 },
    { "type": "range", "id": "thumbnail_title_size_mobile", "label": "Mobile thumbnail title size", "min": 8, "max": 18, "step": 1, "unit": "px", "default": 11 },
    { "type": "range", "id": "thumbnail_title_size_desktop", "label": "Desktop thumbnail title size", "min": 10, "max": 24, "step": 1, "unit": "px", "default": 14 },
    { "type": "range", "id": "product_title_size_mobile", "label": "Mobile product-title size", "min": 9, "max": 18, "step": 1, "unit": "px", "default": 11 },
    { "type": "range", "id": "product_title_size_desktop", "label": "Desktop product-title size", "min": 12, "max": 24, "step": 1, "unit": "px", "default": 15 },
    { "type": "range", "id": "product_button_size_mobile", "label": "Mobile product button size", "min": 8, "max": 16, "step": 1, "unit": "px", "default": 9 },
    { "type": "range", "id": "product_button_size_desktop", "label": "Desktop product button size", "min": 9, "max": 20, "step": 1, "unit": "px", "default": 12 },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "flatlay_gap", "label": "Flatlay gap", "min": 2, "max": 28, "step": 2, "unit": "px", "default": 8 },
    { "type": "range", "id": "active_thumbnail_scale", "label": "Active thumbnail scale", "min": 100, "max": 112, "step": 1, "unit": "%", "default": 110 },
    { "type": "range", "id": "thumbnail_gap", "label": "Thumbnail gap", "min": 4, "max": 32, "step": 2, "unit": "px", "default": 12 }
  ],
  "blocks": [
    {
      "type": "look",
      "name": "Outfit recommendation",
      "settings": [
        { "type": "text", "id": "look_title", "label": "Look title", "default": "THE WORK-DAY EDIT" },
        { "type": "textarea", "id": "look_description", "label": "Short description", "default": "Clean, composed, and ready for whatever the day holds." },
        { "type": "image_picker", "id": "thumbnail_image", "label": "Landscape selector thumbnail" },
        { "type": "text", "id": "thumbnail_alt", "label": "Thumbnail alt text" },
        { "type": "paragraph", "content": "Recommended outfit images: 1200 × 1500 px, 4:5 ratio, WebP." },
        { "type": "image_picker", "id": "front_image", "label": "Front outfit image" },
        { "type": "text", "id": "front_image_alt", "label": "Front image alt text" },
        { "type": "image_picker", "id": "side_image", "label": "Side outfit image" },
        { "type": "text", "id": "side_image_alt", "label": "Side image alt text" },
        { "type": "image_picker", "id": "back_image", "label": "Back outfit image" },
        { "type": "text", "id": "back_image_alt", "label": "Back image alt text" },
        { "type": "select", "id": "mobile_image_position", "label": "Mobile image position", "default": "center center", "options": [{ "value": "left center", "label": "Left" }, { "value": "center center", "label": "Center" }, { "value": "right center", "label": "Right" }, { "value": "center top", "label": "Top" }, { "value": "center bottom", "label": "Bottom" }] },
        { "type": "select", "id": "desktop_image_position", "label": "Desktop image position", "default": "center center", "options": [{ "value": "left center", "label": "Left" }, { "value": "center center", "label": "Center" }, { "value": "right center", "label": "Right" }, { "value": "center top", "label": "Top" }, { "value": "center bottom", "label": "Bottom" }] },
        { "type": "header", "content": "Product 1" },
        { "type": "product", "id": "product_1", "label": "Product" },
        { "type": "text", "id": "product_1_title", "label": "Custom display title" },
        { "type": "image_picker", "id": "product_1_image", "label": "Transparent flatlay image" },
        { "type": "text", "id": "product_1_image_alt", "label": "Flatlay image alt text" },
        { "type": "text", "id": "product_1_button_label", "label": "Button label", "default": "See Color & Fit" },
        { "type": "header", "content": "Product 2" },
        { "type": "product", "id": "product_2", "label": "Product" },
        { "type": "text", "id": "product_2_title", "label": "Custom display title" },
        { "type": "image_picker", "id": "product_2_image", "label": "Transparent flatlay image" },
        { "type": "text", "id": "product_2_image_alt", "label": "Flatlay image alt text" },
        { "type": "text", "id": "product_2_button_label", "label": "Button label", "default": "See Color & Fit" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Home 8.8 outfit",
      "blocks": [
        { "type": "look", "settings": { "look_title": "THE WORK-DAY EDIT", "look_description": "Clean, composed, and ready for whatever the day holds." } },
        { "type": "look", "settings": { "look_title": "THE WEEKEND EDIT", "look_description": "Relaxed polish for plans that unfold at their own pace." } },
        { "type": "look", "settings": { "look_title": "THE SOFT EDIT", "look_description": "Gentle structure and easy comfort for quieter moments." } }
      ]
    }
  ]
}
{% endschema %}
