{{ 'home-88-outfit-considered.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign shop_look = section.blocks.first
  assign lifestyle_image = shop_look.settings.front_image
  assign lifestyle_alt = shop_look.settings.front_image_alt | default: section.settings.heading
  assign product_count = 0

  for product_index in (1..2)
    assign product_key = 'product_' | append: product_index
    if shop_look.settings[product_key] != blank
      assign product_count = product_count | plus: 1
    endif
  endfor
-%}

<section
  id="home-88-shop-the-look"
  class="home-88-outfit"
  style="
    --outfit-bg: {{ section.settings.background_color }};
    --outfit-text: {{ section.settings.text_color }};
    --outfit-pad-top-mobile: {{ section.settings.padding_top_mobile }}px;
    --outfit-pad-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
    --outfit-pad-top-desktop: {{ section.settings.padding_top_desktop }}px;
    --outfit-pad-bottom-desktop: {{ section.settings.padding_bottom_desktop }}px;
    --outfit-heading-mobile: {{ section.settings.heading_size_mobile }}px;
    --outfit-heading-desktop: {{ section.settings.heading_size_desktop }}px;
    --outfit-product-mobile: {{ section.settings.product_title_size_mobile }}px;
    --outfit-product-desktop: {{ section.settings.product_title_size_desktop }}px;
    --outfit-button-mobile: {{ section.settings.product_button_size_mobile }}px;
    --outfit-button-desktop: {{ section.settings.product_button_size_desktop }}px;
  "
>
  <div class="home-88-outfit__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="home-88-outfit__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    {%- if shop_look != blank and lifestyle_image != blank -%}
      <div
        class="home-88-outfit__stage"
        style="--image-position-mobile: {{ shop_look.settings.mobile_image_position }}; --image-position-desktop: {{ shop_look.settings.desktop_image_position }};"
        {{ shop_look.shopify_attributes }}
      >
        {{- lifestyle_image
          | image_url: width: 1800
          | image_tag:
            class: 'home-88-outfit__image',
            widths: '480, 720, 960, 1200, 1500, 1800',
            sizes: '(min-width: 750px) min(1120px, calc(100vw - 96px)), calc(100vw - 24px)',
            loading: 'lazy',
            alt: lifestyle_alt
        -}}

        <div class="home-88-outfit__tray" data-product-count="{{ product_count }}">
          {%- for product_index in (1..2) -%}
            {%- liquid
              assign product_key = 'product_' | append: product_index
              assign title_key = product_key | append: '_title'
              assign image_key = product_key | append: '_image'
              assign alt_key = product_key | append: '_image_alt'
              assign button_key = product_key | append: '_button_label'
              assign look_product = shop_look.settings[product_key]
              assign product_title = shop_look.settings[title_key] | default: look_product.title
              assign product_image = shop_look.settings[image_key] | default: look_product.featured_image
              assign product_alt = shop_look.settings[alt_key] | default: product_image.alt | default: product_title
              assign button_label = shop_look.settings[button_key] | default: 'See Fit & Colors'
            -%}

            {%- if look_product != blank -%}
              <article class="home-88-outfit__product">
                <a class="home-88-outfit__product-image-link" href="{{ look_product.url }}" aria-label="View {{ product_title | escape }}">
                  {%- if product_image != blank -%}
                    {{- product_image
                      | image_url: width: 240
                      | image_tag:
                        class: 'home-88-outfit__product-image',
                        widths: '96, 144, 192, 240',
                        sizes: '(min-width: 750px) 64px, 48px',
                        loading: 'lazy',
                        alt: product_alt
                    -}}
                  {%- endif -%}
                </a>

                <a class="home-88-outfit__product-title" href="{{ look_product.url }}">{{ product_title | escape }}</a>

                <quick-add-drawer-opener class="home-88-outfit__quick-add">
                  <button
                    class="home-88-outfit__product-button"
                    type="button"
                    data-product-url="{{ look_product.url }}"
                    aria-haspopup="dialog"
                    aria-label="{{ button_label | escape }} for {{ product_title | escape }}"
                  >
                    <span>{{ button_label | escape }}</span>
                    <span class="loading-overlay__spinner hidden">{% render 'icon-cart-loading' %}</span>
                  </button>
                </quick-add-drawer-opener>
              </article>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    {%- else -%}
      <div class="home-88-outfit__empty">
        {{ 'lifestyle-1' | placeholder_svg_tag: 'home-88-outfit__placeholder' }}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Home 10.10 Shop the Look",
  "tag": "section",
  "class": "section-home-88-outfit-considered",
  "max_blocks": 1,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "SHOP THE LOOK" },
    { "type": "color", "id": "background_color", "label": "Background color", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#171714" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top_mobile", "label": "Mobile top padding", "min": 20, "max": 100, "step": 4, "unit": "px", "default": 32 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Mobile bottom padding", "min": 20, "max": 100, "step": 4, "unit": "px", "default": 32 },
    { "type": "range", "id": "padding_top_desktop", "label": "Desktop top padding", "min": 32, "max": 160, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom_desktop", "label": "Desktop bottom padding", "min": 32, "max": 160, "step": 4, "unit": "px", "default": 48 },
    { "type": "header", "content": "Typography" },
    { "type": "range", "id": "heading_size_mobile", "label": "Mobile heading size", "min": 18, "max": 40, "step": 1, "unit": "px", "default": 22 },
    { "type": "range", "id": "heading_size_desktop", "label": "Desktop heading size", "min": 24, "max": 64, "step": 1, "unit": "px", "default": 28 },
    { "type": "range", "id": "product_title_size_mobile", "label": "Mobile product-title size", "min": 9, "max": 18, "step": 1, "unit": "px", "default": 13 },
    { "type": "range", "id": "product_title_size_desktop", "label": "Desktop product-title size", "min": 12, "max": 24, "step": 1, "unit": "px", "default": 15 },
    { "type": "range", "id": "product_button_size_mobile", "label": "Mobile button size", "min": 8, "max": 16, "step": 1, "unit": "px", "default": 10 },
    { "type": "range", "id": "product_button_size_desktop", "label": "Desktop button size", "min": 9, "max": 20, "step": 1, "unit": "px", "default": 12 }
  ],
  "blocks": [
    {
      "type": "look",
      "name": "Shop the Look",
      "settings": [
        { "type": "paragraph", "content": "Recommended lifestyle image: 1200 × 1500 px or larger, WebP." },
        { "type": "image_picker", "id": "front_image", "label": "Lifestyle image" },
        { "type": "text", "id": "front_image_alt", "label": "Lifestyle image alt text" },
        { "type": "select", "id": "mobile_image_position", "label": "Mobile image position", "default": "center center", "options": [{ "value": "left center", "label": "Left" }, { "value": "center center", "label": "Center" }, { "value": "right center", "label": "Right" }, { "value": "center top", "label": "Top" }, { "value": "center bottom", "label": "Bottom" }] },
        { "type": "select", "id": "desktop_image_position", "label": "Desktop image position", "default": "center center", "options": [{ "value": "left center", "label": "Left" }, { "value": "center center", "label": "Center" }, { "value": "right center", "label": "Right" }, { "value": "center top", "label": "Top" }, { "value": "center bottom", "label": "Bottom" }] },
        { "type": "header", "content": "Product 1" },
        { "type": "product", "id": "product_1", "label": "Shopify product" },
        { "type": "text", "id": "product_1_title", "label": "Display title", "info": "Leave blank to use the Shopify product title." },
        { "type": "image_picker", "id": "product_1_image", "label": "Flat-lay thumbnail" },
        { "type": "text", "id": "product_1_image_alt", "label": "Thumbnail alt text" },
        { "type": "text", "id": "product_1_button_label", "label": "Button label", "default": "See Fit & Colors" },
        { "type": "header", "content": "Product 2" },
        { "type": "product", "id": "product_2", "label": "Shopify product" },
        { "type": "text", "id": "product_2_title", "label": "Display title", "info": "Leave blank to use the Shopify product title." },
        { "type": "image_picker", "id": "product_2_image", "label": "Flat-lay thumbnail" },
        { "type": "text", "id": "product_2_image_alt", "label": "Thumbnail alt text" },
        { "type": "text", "id": "product_2_button_label", "label": "Button label", "default": "See Fit & Colors" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Home 10.10 Shop the Look",
      "blocks": [{ "type": "look" }]
    }
  ]
}
{% endschema %}
