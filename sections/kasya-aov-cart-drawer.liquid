{{ 'kasya-aov-cart.css' | asset_url | stylesheet_tag }}

<kasya-aov-cart
  class="kasya-aov-cart"
  data-kasya-aov-cart
  aria-hidden="true"
>
  <div class="kasya-aov-cart__overlay" data-kasya-aov-cart-close></div>

  <aside
    class="kasya-aov-cart__drawer"
    role="dialog"
    aria-modal="true"
    aria-label="Almost Yours"
    tabindex="-1"
  >
    <header class="kasya-aov-cart__header">
      <h2 class="kasya-aov-cart__title">Almost Yours <span data-kasya-aov-cart-count>({{ cart.item_count }})</span></h2>
      <button type="button" class="kasya-aov-cart__close" data-kasya-aov-cart-close aria-label="Close cart">
        <span aria-hidden="true">×</span>
      </button>
    </header>

    <div class="kasya-aov-cart__timer" role="status">
      <span class="kasya-aov-cart__timer-icon" aria-hidden="true">◷</span>
      <span data-kasya-aov-cart-timer-text>
        {%- if cart.item_count > 0 -%}
          Your products are reserved for 03:00 minutes!
        {%- else -%}
          Add an item to start your reservation timer.
        {%- endif -%}
      </span>
    </div>

    <section class="kasya-aov-cart__shipping" aria-label="Free shipping progress">
      <p class="kasya-aov-cart__shipping-copy" data-kasya-aov-cart-progress-copy>
        You are ₱2,000 away from getting FREE SHIPPING
      </p>
      <div class="kasya-aov-cart__shipping-track-wrap">
        <div class="kasya-aov-cart__shipping-track" aria-hidden="true">
          <span class="kasya-aov-cart__shipping-progress" data-kasya-aov-cart-progress style="width: 0%;"></span>
          <span class="kasya-aov-cart__shipping-milestone kasya-aov-cart__shipping-milestone--free">🚚</span>
          <span class="kasya-aov-cart__shipping-milestone kasya-aov-cart__shipping-milestone--discount">🎁</span>
        </div>
      </div>
      <div class="kasya-aov-cart__shipping-labels">
        <span class="kasya-aov-cart__shipping-label kasya-aov-cart__shipping-label--free">FREE SHIPPING</span>
        <span class="kasya-aov-cart__shipping-label kasya-aov-cart__shipping-label--discount">₱450 OFF</span>
      </div>
      {%- comment -%}
        Phase 1.1 preview/testing: thresholds update from /cart.js subtotal.
        Phase 2 can reuse these hooks for richer cart-aware offers.
      {%- endcomment -%}
    </section>

    <div class="kasya-aov-cart__body">
      <section class="kasya-aov-cart__items" data-kasya-aov-cart-items aria-label="Cart items">
        {%- if cart.item_count > 0 -%}
          {%- for item in cart.items -%}
            {%- render 'kasya-aov-cart-item', item: item -%}
          {%- endfor -%}
        {%- else -%}
          <div class="kasya-aov-cart__empty" data-kasya-aov-cart-empty>
            <p>Your cart is waiting for something beautiful.</p>
          </div>
        {%- endif -%}
      </section>

      <section class="kasya-aov-cart__recommendations" aria-label="AOV product recommendations">
        <div class="kasya-aov-cart__recommendations-header">
          <div>
            <h3>You’ll Love These Too</h3>
            <p>Same collection, same fabric, same category.</p>
          </div>
          <a href="{{ routes.all_products_collection_url }}" class="kasya-aov-cart__recommendations-link">See All</a>
        </div>

        <div class="kasya-aov-cart__recommendations-list" data-kasya-aov-cart-recommendations>
          {%- comment -%}
            Phase 2: replace these placeholders with products returned by getKasyaAovRecommendations(cart).
            Future rules:
            - Pants in cart recommend tops.
            - Tops in cart recommend bottoms.
            - Jane Set in cart recommends non-Jane products only.
            - Exclude individual Jane Blouse and Jane Pants from recommendation output.
          {%- endcomment -%}
          {%- for index in (1..4) -%}
            <article class="kasya-aov-cart__recommendation-card">
              <div class="kasya-aov-cart__recommendation-image" aria-hidden="true"></div>
              <div class="kasya-aov-cart__recommendation-info">
                <h4>Recommended product</h4>
                <p class="kasya-aov-cart__recommendation-price" hidden></p>
              </div>
            </article>
          {%- endfor -%}
        </div>
      </section>
    </div>

    <footer class="kasya-aov-cart__footer">
      <section class="kasya-aov-cart__payment" aria-label="Secure checkout options">
        <div class="kasya-aov-cart__payment-topline">
          <span class="kasya-aov-cart__payment-accept">We accept</span>
          <span class="kasya-aov-cart__payment-label">
            <span aria-hidden="true">🔒</span>
            SECURE CHECKOUT WITH
          </span>
        </div>
        {%- comment -%}
          Payment image filenames prepared for upload:
          payment-gcash.png, payment-rcbc.png, payment-chinabank.png,
          payment-bpi.png, payment-unionbank.png.
          No matching logo assets are present yet, so placeholders are rendered.
        {%- endcomment -%}
        <div class="kasya-aov-cart__payment-badges" aria-label="Payment options">
          <span class="kasya-aov-cart__payment-badge" data-payment-logo-file="payment-gcash.png">
            <img src="{{ 'payment-gcash.png' | asset_url }}" alt="GCash" hidden onload="this.hidden=false; this.nextElementSibling.hidden=true" onerror="this.hidden=true; this.nextElementSibling.hidden=false">
            <span>GCash</span>
          </span>
          <span class="kasya-aov-cart__payment-badge" data-payment-logo-file="payment-rcbc.png">
            <img src="{{ 'payment-rcbc.png' | asset_url }}" alt="RCBC" hidden onload="this.hidden=false; this.nextElementSibling.hidden=true" onerror="this.hidden=true; this.nextElementSibling.hidden=false">
            <span>RCBC</span>
          </span>
          <span class="kasya-aov-cart__payment-badge" data-payment-logo-file="payment-chinabank.png">
            <img src="{{ 'payment-chinabank.png' | asset_url }}" alt="Chinabank" hidden onload="this.hidden=false; this.nextElementSibling.hidden=true" onerror="this.hidden=true; this.nextElementSibling.hidden=false">
            <span>Chinabank</span>
          </span>
          <span class="kasya-aov-cart__payment-badge" data-payment-logo-file="payment-bpi.png">
            <img src="{{ 'payment-bpi.png' | asset_url }}" alt="BPI" hidden onload="this.hidden=false; this.nextElementSibling.hidden=true" onerror="this.hidden=true; this.nextElementSibling.hidden=false">
            <span>BPI</span>
          </span>
          <span class="kasya-aov-cart__payment-badge" data-payment-logo-file="payment-unionbank.png">
            <img src="{{ 'payment-unionbank.png' | asset_url }}" alt="UnionBank" hidden onload="this.hidden=false; this.nextElementSibling.hidden=true" onerror="this.hidden=true; this.nextElementSibling.hidden=false">
            <span>UnionBank</span>
          </span>
        </div>
      </section>

      <form action="{{ routes.cart_url }}" method="post" class="kasya-aov-cart__checkout-form">
        <div class="kasya-aov-cart__subtotal" data-kasya-aov-cart-subtotal-wrap>
          <div class="kasya-aov-cart__subtotal-row">
            <span>Subtotal (<span data-kasya-aov-cart-footer-count>{{ cart.item_count }} item{% unless cart.item_count == 1 %}s{% endunless %}</span>)</span>
            <strong data-kasya-aov-cart-subtotal>{{ cart.total_price | money }}</strong>
          </div>
        </div>
        <p class="kasya-aov-cart__checkout-note">Shipping calculated at checkout.</p>
        <button type="submit" name="checkout" class="kasya-aov-cart__checkout">
          <span>PROCEED TO CHECKOUT</span>
          <span aria-hidden="true">→</span>
        </button>
      </form>
    </footer>
  </aside>
</kasya-aov-cart>

<script src="{{ 'kasya-aov-cart.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Kasya AOV Cart Drawer",
  "class": "kasya-aov-cart-section",
  "settings": [],
  "presets": [
    {
      "name": "Kasya AOV Cart Drawer"
    }
  ]
}
{% endschema %}
