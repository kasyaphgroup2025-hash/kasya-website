{{ 'kasya-aov-cart.css' | asset_url | stylesheet_tag }}

<kasya-aov-cart
  class="kasya-aov-cart{% if cart.item_count == 0 %} kasya-aov-cart--empty{% endif %}"
  data-kasya-aov-cart
  data-kasya-aov-cart-root
  aria-hidden="true"
>
  <div class="kasya-aov-cart__overlay" data-kasya-aov-cart-close></div>

  <aside
    class="kasya-aov-cart__drawer"
    role="dialog"
    aria-modal="true"
    aria-label="Almost Yours"
    tabindex="-1"
  >
    <header class="kasya-aov-cart__header">
      <h2 class="kasya-aov-cart__title">Almost Yours <span data-kasya-aov-cart-count>({{ cart.item_count }})</span></h2>
      <button type="button" class="kasya-aov-cart__close" data-kasya-aov-cart-close aria-label="Close cart">
        <span aria-hidden="true">×</span>
      </button>
    </header>

    <section class="kasya-aov-cart__empty-state" data-kasya-aov-cart-empty-state aria-label="Empty cart">
      <div class="kasya-aov-cart__empty-icon" aria-hidden="true">
        <svg viewBox="0 0 48 48" role="presentation" focusable="false">
          <path d="M14 18h20l-1.5 19h-17L14 18Z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
          <path d="M18 18c0-4 2.5-7 6-7s6 3 6 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
      </div>
      <p class="kasya-aov-cart__empty-title">Your bag is empty</p>
      <a href="/" class="kasya-aov-cart__empty-button">Continue shopping</a>
    </section>

    <div class="kasya-aov-cart__timer" role="status">
      <span class="kasya-aov-cart__timer-icon" aria-hidden="true">◷</span>
      <span data-kasya-aov-cart-timer-text>
        {%- if cart.item_count > 0 -%}
          <span>Your products are reserved for </span><strong class="kasya-aov-cart__timer-time" data-kasya-aov-cart-timer-time>03:00</strong><span> minutes!</span>
        {%- else -%}
          Add an item to start your reservation timer.
        {%- endif -%}
      </span>
    </div>

    <section class="kasya-aov-cart__shipping" aria-label="Free shipping progress">
      <p class="kasya-aov-cart__shipping-copy" data-kasya-aov-cart-progress-copy>
        You are ₱2,000 away from getting FREE SHIPPING
      </p>
      <div class="kasya-aov-cart__shipping-track-wrap">
        <div class="kasya-aov-cart__shipping-track" aria-hidden="true">
          <span class="kasya-aov-cart__shipping-progress" data-kasya-aov-cart-progress style="width: 0%;"></span>
          <span class="kasya-aov-cart__shipping-milestone kasya-aov-cart__shipping-milestone--free" data-kasya-aov-cart-milestone="free" aria-label="Free shipping milestone">
            <svg class="kasya-aov-cart__shipping-truck" viewBox="0 0 32 32" role="presentation" focusable="false">
              <path d="M5 10h14v10H5V10Z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
              <path d="M19 14h4l4 4v2h-8v-6Z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
              <path d="M9 23a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z" fill="none" stroke="currentColor" stroke-width="2"/>
              <path d="M23 23a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z" fill="none" stroke="currentColor" stroke-width="2"/>
            </svg>
          </span>
          <span class="kasya-aov-cart__shipping-milestone kasya-aov-cart__shipping-milestone--discount" data-kasya-aov-cart-milestone="discount" aria-label="₱450 OFF milestone">
            <span class="kasya-aov-cart__shipping-discount-value">₱450</span>
          </span>
        </div>
      </div>
      <div class="kasya-aov-cart__shipping-labels">
        <span class="kasya-aov-cart__shipping-label kasya-aov-cart__shipping-label--free">FREE SHIPPING</span>
        <span class="kasya-aov-cart__shipping-label kasya-aov-cart__shipping-label--discount">₱450 OFF</span>
      </div>
      {%- comment -%}
        Phase 1.1 preview/testing: thresholds update from /cart.js subtotal.
        Phase 2 can reuse these hooks for richer cart-aware offers.
      {%- endcomment -%}
    </section>

    <div class="kasya-aov-cart__body">
      <section class="kasya-aov-cart__items" data-kasya-aov-cart-items aria-label="Cart items">
        {%- if cart.item_count > 0 -%}
          {%- for item in cart.items -%}
            {%- render 'kasya-aov-cart-item', item: item -%}
          {%- endfor -%}
        {%- endif -%}
      </section>

      <section class="kasya-aov-cart__recommendations" data-kasya-aov-cart-recommendations aria-label="AOV product recommendations" hidden>
        <div class="kasya-aov-cart__recommendations-header">
          <h3 data-kasya-aov-cart-recommendation-title>You’ll Love These Too</h3>
          <p data-kasya-aov-cart-recommendation-subtitle>Smart picks based on what’s in your cart.</p>
        </div>
        <div class="kasya-aov-cart__recommendation-scroller" data-kasya-aov-cart-recommendation-carousel aria-label="Recommended products"></div>
      </section>
    </div>

    <footer class="kasya-aov-cart__footer">
      <section class="kasya-aov-cart__payment" aria-label="Secure checkout options">
        <div class="kasya-aov-cart__payment-topline">
          <span class="kasya-aov-cart__payment-accept">We accept</span>
          <span class="kasya-aov-cart__payment-label">
            <span aria-hidden="true">🔒</span>
            SECURE CHECKOUT WITH
          </span>
        </div>
        <div class="kasya-aov-cart__payment-badges" aria-label="Payment options">
          <span class="kasya-aov-cart__payment-badge">
            <img src="{{ 'payment-gcash.svg' | asset_url }}" alt="GCash" width="96" height="32" loading="lazy">
          </span>
          <span class="kasya-aov-cart__payment-badge">
            <img src="{{ 'payment-rcbc.svg' | asset_url }}" alt="RCBC" width="96" height="32" loading="lazy">
          </span>
          <span class="kasya-aov-cart__payment-badge kasya-aov-cart__payment-badge--wide">
            <img src="{{ 'payment-chinabank.svg' | asset_url }}" alt="Chinabank" width="116" height="32" loading="lazy">
          </span>
          <span class="kasya-aov-cart__payment-badge">
            <img src="{{ 'payment-bpi.svg' | asset_url }}" alt="BPI" width="96" height="32" loading="lazy">
          </span>
          <span class="kasya-aov-cart__payment-badge kasya-aov-cart__payment-badge--wide">
            <img src="{{ 'payment-unionbank.svg' | asset_url }}" alt="UnionBank" width="116" height="32" loading="lazy">
          </span>
        </div>
      </section>

      <form action="{{ routes.cart_url }}" method="post" class="kasya-aov-cart__checkout-form">
        <div class="kasya-aov-cart__subtotal" data-kasya-aov-cart-subtotal-wrap>
          <div class="kasya-aov-cart__subtotal-row">
            <span>Subtotal (<span data-kasya-aov-cart-footer-count>{{ cart.item_count }} item{% unless cart.item_count == 1 %}s{% endunless %}</span>)</span>
            <strong class="kasya-aov-cart__subtotal-amount" data-kasya-aov-cart-subtotal>{{ cart.total_price | money }}</strong>
          </div>
        </div>
        <p class="kasya-aov-cart__checkout-note">Shipping calculated at checkout.</p>
        <button type="submit" name="checkout" class="kasya-aov-cart__checkout">
          <span>PROCEED TO CHECKOUT</span>
          <span aria-hidden="true">→</span>
        </button>
      </form>
    </footer>
  </aside>
</kasya-aov-cart>

{%- liquid
  assign recommendation_groups = 'love:aov_love_collection|completePants:aov_tops_collection|completeTops:aov_bottoms_collection|completeJane:aov_jane_safe_collection|fallback:aov_fallback_collection' | split: '|'
-%}
<script type="application/json" data-kasya-aov-cart-recommendation-data>
{
  {%- for group in recommendation_groups -%}
    {%- liquid
      assign group_parts = group | split: ':'
      assign group_key = group_parts[0]
      assign setting_key = group_parts[1]
      assign source_collection = section.settings[setting_key]
    -%}
    "{{ group_key }}": [
      {%- if source_collection != blank -%}
      {%- for product in source_collection.products limit: 24 -%}
        {
          "handle": {{ product.handle | json }},
          "title": {{ product.title | json }},
          "url": {{ product.url | json }},
          "image": {%- if product.featured_image -%}{{ product.featured_image | image_url: width: 360 | json }}{%- else -%}null{%- endif -%},
          "images": [
            {%- for image in product.images -%}
              {
                "src": {{ image | image_url: width: 360 | json }},
                "alt": {{ image.alt | default: product.title | json }}
              }{%- unless forloop.last -%},{%- endunless -%}
            {%- endfor -%}
          ],
          "price": {{ product.price | json }},
          "available": {{ product.available | json }},
          "template": {{ product.template_suffix | json }},
          "type": {{ product.type | json }},
          "vendor": {{ product.vendor | json }},
          "tags": {{ product.tags | json }},
          "collections": [
            {%- for collection in product.collections -%}
              {
                "handle": {{ collection.handle | json }},
                "title": {{ collection.title | json }}
              }{%- unless forloop.last -%},{%- endunless -%}
            {%- endfor -%}
          ],
          "options": {{ product.options_with_values | json }},
          "variants": {{ product.variants | json }}
        }{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
      {%- endif -%}
    ]{%- unless forloop.last -%},{%- endunless -%}
  {%- endfor -%}
  ,
  "newToKasya": [
    {%- for product in section.settings.aov_new_to_kasya_products limit: 4 -%}
      {
        "handle": {{ product.handle | json }},
        "title": {{ product.title | json }},
        "url": {{ product.url | json }},
        "image": {%- if product.featured_image -%}{{ product.featured_image | image_url: width: 360 | json }}{%- else -%}null{%- endif -%},
        "images": [
          {%- for image in product.images -%}
            {
              "src": {{ image | image_url: width: 360 | json }},
              "alt": {{ image.alt | default: product.title | json }}
            }{%- unless forloop.last -%},{%- endunless -%}
          {%- endfor -%}
        ],
        "price": {{ product.price | json }},
        "available": {{ product.available | json }},
        "template": {{ product.template_suffix | json }},
        "type": {{ product.type | json }},
        "vendor": {{ product.vendor | json }},
        "tags": {{ product.tags | json }},
        "collections": [
          {%- for collection in product.collections -%}
            {
              "handle": {{ collection.handle | json }},
              "title": {{ collection.title | json }}
            }{%- unless forloop.last -%},{%- endunless -%}
          {%- endfor -%}
        ],
        "options": {{ product.options_with_values | json }},
        "variants": {{ product.variants | json }}
      }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ],
  "manualExclusions": [
    {%- for product in section.settings.aov_excluded_recommendation_products limit: 50 -%}
      {
        "handle": {{ product.handle | json }},
        "title": {{ product.title | json }},
        "url": {{ product.url | json }}
      }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ],
  "_customer": {
    "loggedIn": {%- if customer -%}true{%- else -%}false{%- endif -%},
    "ordersCount": {%- if customer -%}{{ customer.orders_count | default: 0 | json }}{%- else -%}null{%- endif -%}
  },
  "_allowedStorefrontCollections": [
    {%- for collection in section.settings.aov_allowed_storefront_collections -%}
      {
        "handle": {{ collection.handle | json }},
        "title": {{ collection.title | json }}
      }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ],
  "_defaultAllowedStorefrontCollections": [
    "pants",
    "skirts",
    "tops",
    "dresses",
    "kasya-set",
    "new-in",
    "core-essentials",
    "back-to-rhythm",
    "summer-collection",
    "everyday-edit",
    "premiere",
    "northern-blossom"
  ],
  "_sources": {
    {%- for group in recommendation_groups -%}
      {%- liquid
        assign group_parts = group | split: ':'
        assign group_key = group_parts[0]
        assign setting_key = group_parts[1]
        assign source_collection = section.settings[setting_key]
      -%}
      "{{ group_key }}": {
        "handle": {%- if source_collection != blank -%}{{ source_collection.handle | json }}{%- else -%}null{%- endif -%},
        "title": {%- if source_collection != blank -%}{{ source_collection.title | json }}{%- else -%}null{%- endif -%},
        "productCount": {%- if source_collection != blank -%}{{ source_collection.products_count | default: source_collection.all_products_count | default: 0 | json }}{%- else -%}0{%- endif -%}
      }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  }
}
</script>

<script src="{{ 'kasya-aov-cart.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Kasya AOV Cart Drawer",
  "class": "kasya-aov-cart-section",
  "settings": [
    {
      "type": "product_list",
      "id": "aov_new_to_kasya_products",
      "label": "New to Kasya starter products",
      "limit": 4
    },
    {
      "type": "collection_list",
      "id": "aov_allowed_storefront_collections",
      "label": "Allowed storefront recommendation collections",
      "limit": 20
    },
    {
      "type": "product_list",
      "id": "aov_excluded_recommendation_products",
      "label": "Exclude from AOV recommendations",
      "limit": 50
    },
    {
      "type": "collection",
      "id": "aov_love_collection",
      "label": "Optional fallback: similar products source"
    },
    {
      "type": "collection",
      "id": "aov_tops_collection",
      "label": "Optional fallback: tops source"
    },
    {
      "type": "collection",
      "id": "aov_bottoms_collection",
      "label": "Optional fallback: bottoms source"
    },
    {
      "type": "collection",
      "id": "aov_jane_safe_collection",
      "label": "Optional fallback: Jane-safe source"
    },
    {
      "type": "collection",
      "id": "aov_fallback_collection",
      "label": "Optional fallback: general source"
    }
  ],
  "presets": [
    {
      "name": "Kasya AOV Cart Drawer"
    }
  ]
}
{% endschema %}
