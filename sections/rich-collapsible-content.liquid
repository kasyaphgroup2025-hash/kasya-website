{{ 'collapsible-content.css' | asset_url | stylesheet_tag }}
<script src="{{ 'details-accordion.js' | asset_url }}" defer="defer"></script>
<style>
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
  {%- render 'section-heading-styles' -%}
</style>
{%- capture sizes -%}min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 | divided_by: 2 }}px, (min-width: 750px) calc((100vw - 130px) / 2), calc((100vw - 50px) / 2){%- endcapture -%}
<div class="{% unless section.settings.enable_section_box_layout %}color-{{ section.settings.color_scheme }} gradient isolate{% else %}page-width{% if section.settings.section_width == 'stretched_grid' %}--full{% endif %}{% if section.settings.section_width == 'narrow' %} page-width--narrow{% endif %}{% endunless %}">
  <div class="collapsible-content collapsible-row-layout section-{{ section.id }}-padding">
    <div class="collapsible-content__wrapper {% if section.settings.enable_section_box_layout %}color-{{ section.settings.color_scheme }} gradient isolate section__box{% else %}page-width{% if section.settings.section_width == 'stretched_grid' %}--full{% endif %}{% if section.settings.section_width == 'narrow' %} page-width--narrow{% endif %}{% endif %}">
      <div class="collapsible-content__header left">
        {%- if section.settings.title != blank -%}
          {%- render 'section-heading' -%}
        {%- else -%}
          <h2 class="visually-hidden">{{ 'accessibility.collapsible_content_title' | t }}</h2>
        {% endif %}
      </div>
      <div class="grid grid--1-col{% if section.settings.image != blank %} grid--2-col-tablet{% endif %} collapsible-content__grid{% if section.settings.desktop_layout == 'image_second' %} collapsible-content__grid--reverse{% endif %}">
        {%- if section.settings.image != blank -%}
          <div class="grid__item collapsible-content__grid-item collapsible-content__image{% if section.settings.hide_image_on_mobile %} small-hide{% endif %}">
            <use-animate class="collapsible-content__media collapsible-content__media--{{ section.settings.image_ratio }} media gradient"
              {% if section.settings.image_ratio == 'adapt' %} style="padding-bottom: {{ 1 | divided_by: section.settings.image.aspect_ratio | times: 100 }}%;"{% endif %}
            >
              {{ section.settings.image | image_url: width: 1500 | image_tag:
                loading: 'lazy',
                width: section.settings.image.width,
                height: section.settings.image.height,
                sizes: sizes,
                widths: '165, 360, 535, 750, 1070, 1250, 1500, 1900, 2500'
              }}
            </use-animate>
          </div>
        {% endif %}
        <div class="grid__item">
          {% content_for 'block', type: 'accordion', id: 'collapsible-content-root-block' %}
          {% content_for 'blocks' %}
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:names.rich_collapsible",
  "tag": "section",
  "class": "section collapsible-content-section",
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "options": [
        {
          "value": "stretched_grid",
          "label": "t:sections.all.grid_layout.options_2.label"
        },
        {
          "value": "grid",
          "label": "t:sections.all.grid_layout.options_3.label"
        },
        {
          "value": "narrow",
          "label": "t:sections.all.grid_layout.options_4.label"
        }
      ],
      "default": "grid",
      "label": "t:sections.all.grid_layout.label"
    },
    {
      "type": "text",
      "id": "title",
      "label": "t:sections.collapsible_content.settings.heading.label",
      "default": "Collapsible content"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "t:sections.collapsible_content.settings.subtitle.label"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h0",
          "label": "t:sections.all.heading_size.options__3.label"
        }
      ],
      "default": "h1",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "checkbox",
      "id": "enable_section_box_layout",
      "label": "t:sections.all.enable_section_box_layout.label",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "background-1",
      "label": "t:sections.all.colors.label"
    },
    {
      "type": "header",
      "content": "t:sections.collapsible_content.settings.header.content"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.collapsible_content.settings.image.label"
    },
    {
      "type": "checkbox",
      "id": "hide_image_on_mobile",
      "label": "t:sections.collapsible_content.settings.hide_image_on_mobile.label",
      "default": false
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        {
          "value": "adapt",
          "label": "t:sections.collapsible_content.settings.image_ratio.options__1.label"
        },
        {
          "value": "small",
          "label": "t:sections.collapsible_content.settings.image_ratio.options__2.label"
        },
        {
          "value": "large",
          "label": "t:sections.collapsible_content.settings.image_ratio.options__3.label"
        }
      ],
      "default": "adapt",
      "label": "t:sections.collapsible_content.settings.image_ratio.label"
    },
    {
      "type": "select",
      "id": "desktop_layout",
      "options": [
        {
          "value": "image_first",
          "label": "t:sections.collapsible_content.settings.desktop_layout.options__1.label"
        },
        {
          "value": "image_second",
          "label": "t:sections.collapsible_content.settings.desktop_layout.options__2.label"
        }
      ],
      "default": "image_second",
      "label": "t:settings.desktop_layout",
      "info": "t:sections.collapsible_content.settings.desktop_layout.info"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    },
    {
      "type": "_divider"
    }
  ],
  "presets": [
    {
      "name": "t:names.rich_collapsible",
      "category": "t:categories.storytelling",
      "blocks": {
        "collapsible-content-root-block": {
          "type": "accordion",
          "static": true,
          "blocks": {
            "row-1": {
              "type": "_accordion-row",
              "settings": {
                "open_by_default": true,
                "heading": "What is the return policy?"
              },
              "blocks": {
                "text-1": {
                  "type": "rich-text",
                  "settings": {
                    "text": "<p>Our goal is for every customer to be totally satisfied with their purchase. If this isn't the case, let us know and we'll do our best to work with you to make it right.</p>"
                  }
                }
              },
              "block_order": ["text-1"]
            },
            "row-2": {
              "type": "_accordion-row",
              "settings": {
                "heading": "Are any purchases final sale?"
              },
              "blocks": {
                "text-1": {
                  "type": "rich-text",
                  "settings": {
                    "text": "<p>We are unable to accept returns on certain items. These will be carefully marked before purchase.</p>"
                  }
                }
              },
              "block_order": ["text-1"]
            },
            "row-3": {
              "type": "_accordion-row",
              "settings": {
                "heading": "When will I get my order?"
              },
              "blocks": {
                "text-1": {
                  "type": "rich-text",
                  "settings": {
                    "text": "<p>We will work quickly to ship your order as soon as possible. Once your order has shipped, you will receive an email with further information. Delivery times vary depending on your location.</p>"
                  }
                }
              },
              "block_order": ["text-1"]
            },
            "row-4": {
              "type": "_accordion-row",
              "settings": {
                "heading": "Where are your products manufactured?"
              },
              "blocks": {
                "text-1": {
                  "type": "rich-text",
                  "settings": {
                    "text": "<p>Our products are manufactured both locally and globally. We carefully select our manufacturing partners to ensure our products are high quality and a fair value.</p>"
                  }
                }
              },
              "block_order": ["text-1"]
            },
            "row-5": {
              "type": "_accordion-row",
              "settings": {
                "heading": "How much does shipping cost?"
              },
              "blocks": {
                "text-1": {
                  "type": "rich-text",
                  "settings": {
                    "text": "<p>Shipping is calculated based on your location and the items in your order. You will always know the shipping price before you purchase.</p>"
                  }
                }
              },
              "block_order": ["text-1"]
            }
          },
          "block_order": ["row-1", "row-2", "row-3", "row-4", "row-5"]
        } 
      }
    }
  ]
}
{% endschema %}
