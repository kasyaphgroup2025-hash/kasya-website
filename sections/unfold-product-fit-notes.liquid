{% comment %}
  Draft-theme UNFOLD product fit notes.
  This section is intentionally handle-gated so the default product template can
  include it without changing Shopify product-template assignments.
{% endcomment %}

{%- liquid
  assign unfold_product_key = blank
  assign quinn_product_handle = section.settings.quinn_product_handle | strip

  case product.handle
    when 'olivia-skirt'
      assign unfold_product_key = 'olivia'
    when 'paisley-pants'
      assign unfold_product_key = 'paisley'
    when 'reese-polo'
      assign unfold_product_key = 'reese'
    when 'sofia-dress'
      assign unfold_product_key = 'sofia'
  endcase

  if unfold_product_key == blank and quinn_product_handle != blank and product.handle == quinn_product_handle
    assign unfold_product_key = 'quinn'
  endif

  if unfold_product_key != blank
    assign model_height_key = unfold_product_key | append: '_model_height'
    assign model_waist_key = unfold_product_key | append: '_model_waist'
    assign model_size_key = unfold_product_key | append: '_model_size'
    assign fit_note_1_key = unfold_product_key | append: '_fit_note_1'
    assign fit_note_2_key = unfold_product_key | append: '_fit_note_2'
    assign fit_note_3_key = unfold_product_key | append: '_fit_note_3'
    assign fit_note_4_key = unfold_product_key | append: '_fit_note_4'
    assign fit_note_5_key = unfold_product_key | append: '_fit_note_5'

    assign model_height = section.settings[model_height_key]
    assign model_waist = section.settings[model_waist_key]
    assign model_size = section.settings[model_size_key]
    assign fit_note_1 = section.settings[fit_note_1_key]
    assign fit_note_2 = section.settings[fit_note_2_key]
    assign fit_note_3 = section.settings[fit_note_3_key]
    assign fit_note_4 = section.settings[fit_note_4_key]
    assign fit_note_5 = section.settings[fit_note_5_key]
  endif
-%}

{%- if unfold_product_key != blank -%}
  {%- render 'unfold-fit-notes',
    model_height: model_height,
    model_waist: model_waist,
    model_size: model_size,
    fit_note_1: fit_note_1,
    fit_note_2: fit_note_2,
    fit_note_3: fit_note_3,
    fit_note_4: fit_note_4,
    fit_note_5: fit_note_5
  -%}
{%- endif -%}

