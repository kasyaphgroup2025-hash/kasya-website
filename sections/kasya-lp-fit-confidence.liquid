{% comment %}
  KasyaPH Product Landing Fit Confidence
  Standalone section for model views and fit notes.
{% endcomment %}

{% liquid
  assign uses_unfold_image_logic = false
  assign unfold_lp01_image = blank
  assign unfold_lp02_image = blank

  case product.handle
    when 'quinn-shawl', 'reese-polo', 'olivia-skirt', 'paisley-pants', 'sofia-dress'
      assign uses_unfold_image_logic = true
  endcase

  assign second_fit_key = 'side'
  assign second_fit_label = section.settings.side_label
  assign second_fit_description = section.settings.side_description
  assign third_fit_key = 'back'
  assign third_fit_label = section.settings.back_label
  assign third_fit_description = section.settings.back_description

  if uses_unfold_image_logic
    assign third_fit_key = 'fabric'
    assign third_fit_label = 'FABRIC CLOSEUP'
    assign third_fit_description = 'A closer look at the fabric, texture, and finish.'

    for media in product.media
      if media.media_type == 'image' and media.preview_image != blank
        assign media_alt_normalized = media.alt | strip | downcase | replace: '|', '' | replace: ' ', ''

        case media_alt_normalized
          when 'lp01'
            if unfold_lp01_image == blank
              assign unfold_lp01_image = media.preview_image
            endif
          when 'lp02'
            if unfold_lp02_image == blank
              assign unfold_lp02_image = media.preview_image
            endif
        endcase
      endif
    endfor
  endif
%}

<section class="kasya-fit-confidence" data-kasya-fit-confidence data-section-id="{{ section.id }}"{% if uses_unfold_image_logic %} data-unfold-image-logic="true"{% endif %}>
  <div class="kasya-fit-confidence__inner">
    <div class="kasya-fit-confidence__header">
      {% if section.settings.heading != blank %}
        <h2 class="kasya-fit-confidence__heading">
          {{ section.settings.heading }}
        </h2>
      {% endif %}

      {% if section.settings.subheading != blank %}
        <p class="kasya-fit-confidence__subheading">
          {{ section.settings.subheading }}
        </p>
      {% endif %}

      <p class="kasya-fit-confidence__color" data-fit-color-shown hidden>
        Color shown: <span data-fit-color-name></span>
      </p>
    </div>

    <div class="kasya-fit-confidence__cards">
      <article class="kasya-fit-confidence__card">
        <div class="kasya-fit-confidence__media">
          {% if section.settings.front_image != blank %}
            <img
              src="{{ section.settings.front_image | image_url: width: 900 }}"
              data-fit-image="front"
              data-default-src="{{ section.settings.front_image | image_url: width: 900 }}"
              alt="{{ section.settings.front_label | escape }}"
              width="900"
              height="1200"
              loading="lazy"
            >
            <div class="kasya-fit-confidence__placeholder" data-fit-placeholder="front" hidden>
              {{ section.settings.front_label }}
            </div>
          {% else %}
            <img
              data-fit-image="front"
              data-default-src=""
              alt="{{ section.settings.front_label | escape }}"
              width="900"
              height="1200"
              loading="lazy"
              hidden
            >
            <div class="kasya-fit-confidence__placeholder" data-fit-placeholder="front">
              {{ section.settings.front_label }}
            </div>
          {% endif %}
        </div>

        <div class="kasya-fit-confidence__card-copy">
          <h3 class="kasya-fit-confidence__card-label">
            {{ section.settings.front_label }}
          </h3>
          <p class="kasya-fit-confidence__card-description">
            {{ section.settings.front_description }}
          </p>
        </div>
      </article>

      {% if unfold_lp01_image != blank %}
        <article class="kasya-fit-confidence__card">
          <div class="kasya-fit-confidence__media">
            <img
              src="{{ unfold_lp01_image | image_url: width: 900 }}"
              data-fit-image="additional-view-lp01"
              data-default-src="{{ unfold_lp01_image | image_url: width: 900 }}"
              alt="MORE VIEW"
              width="900"
              height="1200"
              loading="lazy"
            >
            <div class="kasya-fit-confidence__placeholder" data-fit-placeholder="additional-view-lp01" hidden>
              MORE VIEW
            </div>
          </div>

          <div class="kasya-fit-confidence__card-copy">
            <h3 class="kasya-fit-confidence__card-label">MORE VIEW</h3>
            <p class="kasya-fit-confidence__card-description">
              Another look at the piece to show its shape, drape, and details.
            </p>
          </div>
        </article>
      {% endif %}

      {% if unfold_lp02_image != blank %}
        <article class="kasya-fit-confidence__card">
          <div class="kasya-fit-confidence__media">
            <img
              src="{{ unfold_lp02_image | image_url: width: 900 }}"
              data-fit-image="additional-view-lp02"
              data-default-src="{{ unfold_lp02_image | image_url: width: 900 }}"
              alt="MORE VIEW"
              width="900"
              height="1200"
              loading="lazy"
            >
            <div class="kasya-fit-confidence__placeholder" data-fit-placeholder="additional-view-lp02" hidden>
              MORE VIEW
            </div>
          </div>

          <div class="kasya-fit-confidence__card-copy">
            <h3 class="kasya-fit-confidence__card-label">MORE VIEW</h3>
            <p class="kasya-fit-confidence__card-description">
              An additional view to see more of the overall fit and finish.
            </p>
          </div>
        </article>
      {% endif %}

      {% unless uses_unfold_image_logic %}
        <article class="kasya-fit-confidence__card">
          <div class="kasya-fit-confidence__media">
            {% if section.settings.side_image != blank %}
              <img
                src="{{ section.settings.side_image | image_url: width: 900 }}"
                data-fit-image="{{ second_fit_key }}"
                data-default-src="{{ section.settings.side_image | image_url: width: 900 }}"
                alt="{{ second_fit_label | escape }}"
                width="900"
                height="1200"
                loading="lazy"
              >
              <div class="kasya-fit-confidence__placeholder" data-fit-placeholder="{{ second_fit_key }}" hidden>
                {{ second_fit_label }}
              </div>
            {% else %}
              <img
                data-fit-image="{{ second_fit_key }}"
                data-default-src=""
                alt="{{ second_fit_label | escape }}"
                width="900"
                height="1200"
                loading="lazy"
                hidden
              >
              <div class="kasya-fit-confidence__placeholder" data-fit-placeholder="{{ second_fit_key }}">
                {{ second_fit_label }}
              </div>
            {% endif %}
          </div>

          <div class="kasya-fit-confidence__card-copy">
            <h3 class="kasya-fit-confidence__card-label">
              {{ second_fit_label }}
            </h3>
            <p class="kasya-fit-confidence__card-description">
              {{ second_fit_description }}
            </p>
          </div>
        </article>
      {% endunless %}

      <article class="kasya-fit-confidence__card">
        <div class="kasya-fit-confidence__media">
          {% if section.settings.back_image != blank %}
            <img
              src="{{ section.settings.back_image | image_url: width: 900 }}"
              data-fit-image="{{ third_fit_key }}"
              data-default-src="{{ section.settings.back_image | image_url: width: 900 }}"
              alt="{{ third_fit_label | escape }}"
              width="900"
              height="1200"
              loading="lazy"
            >
            <div class="kasya-fit-confidence__placeholder" data-fit-placeholder="{{ third_fit_key }}" hidden>
              {{ third_fit_label }}
            </div>
          {% else %}
            <img
              data-fit-image="{{ third_fit_key }}"
              data-default-src=""
              alt="{{ third_fit_label | escape }}"
              width="900"
              height="1200"
              loading="lazy"
              hidden
            >
            <div class="kasya-fit-confidence__placeholder" data-fit-placeholder="{{ third_fit_key }}">
              {{ third_fit_label }}
            </div>
          {% endif %}
        </div>

        <div class="kasya-fit-confidence__card-copy">
          <h3 class="kasya-fit-confidence__card-label">
            {{ third_fit_label }}
          </h3>
          <p class="kasya-fit-confidence__card-description">
            {{ third_fit_description }}
          </p>
        </div>
      </article>
    </div>

    {%- assign fit_note_blocks = section.blocks | where: 'type', 'fit_note' -%}
    {%- render 'unfold-fit-notes',
      model_height: section.settings.model_height,
      model_waist: section.settings.model_waist,
      model_size: section.settings.model_size,
      legacy_model_info: section.settings.model_info,
      note_blocks: fit_note_blocks,
      embedded: true
    -%}
  </div>
</section>

<style>
  .kasya-fit-confidence {
    --kasya-fit-text: #111111;
    --kasya-fit-muted: #5d5d5d;
    --kasya-fit-line: #e9e4dd;
    --kasya-fit-soft: #f7f4ef;

    background: #ffffff;
    color: var(--kasya-fit-text);
    font-family: inherit;
    max-width: 760px;
    margin: 0 auto;
  }

  .kasya-fit-confidence * {
    box-sizing: border-box;
  }

  .kasya-fit-confidence__inner {
    padding: 30px 18px 34px;
  }

  .kasya-fit-confidence__header {
    max-width: 520px;
  }

  .kasya-fit-confidence__heading {
    margin: 0;
    font-size: 28px;
    font-weight: 850;
    letter-spacing: 0.08em;
    line-height: 1.05;
    text-transform: uppercase;
  }

  .kasya-fit-confidence__subheading {
    margin: 10px 0 0;
    color: var(--kasya-fit-muted);
    font-size: 15px;
    line-height: 1.45;
  }

  .kasya-fit-confidence__color {
    margin: 10px 0 0;
    color: #303030;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.08em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .kasya-fit-confidence__color span {
    font-weight: 500;
  }

  .kasya-fit-confidence__cards {
    display: grid;
    grid-template-columns: 1fr;
    gap: 14px;
    margin-top: 22px;
  }

  .kasya-fit-confidence__card {
    display: grid;
    grid-template-columns: 42% minmax(0, 1fr);
    gap: 14px;
    align-items: center;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--kasya-fit-line);
  }

  .kasya-fit-confidence__card:last-child {
    padding-bottom: 0;
    border-bottom: 0;
  }

  .kasya-fit-confidence__media {
    overflow: hidden;
    border-radius: 6px;
    background: var(--kasya-fit-soft);
    aspect-ratio: 3 / 4;
  }

  .kasya-fit-confidence__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .kasya-fit-confidence__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
    color: #7a746b;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-align: center;
    text-transform: uppercase;
  }

  .kasya-fit-confidence__card-copy {
    min-width: 0;
  }

  .kasya-fit-confidence__card-label {
    margin: 0;
    font-size: 13px;
    font-weight: 850;
    letter-spacing: 0.1em;
    line-height: 1.15;
    text-transform: uppercase;
  }

  .kasya-fit-confidence__card-description {
    margin: 8px 0 0;
    color: var(--kasya-fit-muted);
    font-size: 14px;
    line-height: 1.45;
  }

  @media screen and (min-width: 680px) {
    .kasya-fit-confidence__inner {
      padding: 42px 26px 46px;
    }

    .kasya-fit-confidence__heading {
      font-size: 34px;
    }

    .kasya-fit-confidence__cards {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 16px;
    }

    .kasya-fit-confidence__card {
      display: block;
      padding-bottom: 0;
      border-bottom: 0;
    }

    .kasya-fit-confidence__card-copy {
      margin-top: 12px;
    }
  }
</style>

<script>
  (() => {
    const section = document.querySelector('[data-kasya-fit-confidence][data-section-id="{{ section.id }}"]');
    if (!section) return;

    const colorLabel = section.querySelector('[data-fit-color-shown]');
    const colorName = section.querySelector('[data-fit-color-name]');
    const usesUnfoldImageLogic = section.dataset.unfoldImageLogic === 'true';
    const shots = usesUnfoldImageLogic
      ? ['front', 'additional-view-lp01', 'additional-view-lp02', 'fabric']
      : ['front', 'side', 'back'];

    function updateShot(shot, src, displayColor, strictColorMedia, imageLabel) {
      const image = section.querySelector(`[data-fit-image="${shot}"]`);
      const placeholder = section.querySelector(`[data-fit-placeholder="${shot}"]`);
      if (!image) return;

      const nextSrc = src || (strictColorMedia ? '' : image.dataset.defaultSrc) || '';

      if (nextSrc) {
        if (image.getAttribute('src') !== nextSrc) {
          image.setAttribute('src', nextSrc);
        }

        image.alt = `${displayColor} ${imageLabel || `${shot} view`}`.trim();
        image.hidden = false;

        if (placeholder) {
          placeholder.hidden = true;
        }

        return;
      }

      image.removeAttribute('src');
      image.hidden = true;

      if (placeholder) {
        placeholder.hidden = false;
      }
    }

    function updateFitImages(state) {
      if (!state || (!state.color && !state.previewColor)) return;

      const displayColor = String(state.displayColor || state.color || state.previewColor || '').trim();
      const images = state.images || {};
      const imageLabels = state.imageLabels || {};

      if (colorLabel && colorName && displayColor) {
        colorName.textContent = displayColor.toUpperCase();
        colorLabel.hidden = false;
      }

      shots.forEach(shot => {
        updateShot(shot, images[shot], displayColor, state.strictColorMedia, imageLabels[shot]);
      });
    }

    document.addEventListener('kasya:hero-color-change', event => {
      updateFitImages(event.detail);
    });

    if (window.KasyaLPSelectedColor) {
      updateFitImages(window.KasyaLPSelectedColor);
    }
  })();
</script>

{% schema %}
{
  "name": "Kasya LP Fit Confidence",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "HOW IT FITS"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "See how the garment falls from every angle before choosing your size."
    },
    {
      "type": "image_picker",
      "id": "front_image",
      "label": "Front image"
    },
    {
      "type": "text",
      "id": "front_label",
      "label": "Front label",
      "default": "FRONT VIEW"
    },
    {
      "type": "textarea",
      "id": "front_description",
      "label": "Front description",
      "default": "Shows the full silhouette and length."
    },
    {
      "type": "image_picker",
      "id": "side_image",
      "label": "Side image"
    },
    {
      "type": "text",
      "id": "side_label",
      "label": "Side label",
      "default": "SIDE VIEW"
    },
    {
      "type": "textarea",
      "id": "side_description",
      "label": "Side description",
      "default": "Shows the drape around the waist, hips, and tummy."
    },
    {
      "type": "image_picker",
      "id": "back_image",
      "label": "Back image"
    },
    {
      "type": "text",
      "id": "back_label",
      "label": "Back label",
      "default": "BACK VIEW"
    },
    {
      "type": "textarea",
      "id": "back_description",
      "label": "Back description",
      "default": "Shows how it falls from behind."
    },
    {
      "type": "header",
      "content": "Model reference"
    },
    {
      "type": "text",
      "id": "model_height",
      "label": "Model height",
      "info": "Example: 5'2"
    },
    {
      "type": "text",
      "id": "model_waist",
      "label": "Model waist",
      "info": "Example: 29\""
    },
    {
      "type": "text",
      "id": "model_size",
      "label": "Model size",
      "info": "Example: XL"
    },
    {
      "type": "textarea",
      "id": "model_info",
      "label": "Legacy model info",
      "info": "Fallback used only when the structured model fields above are blank.",
      "default": "Model is 5'2 and wears size L."
    }
  ],
  "blocks": [
    {
      "type": "fit_note",
      "name": "Fit note",
      "settings": [
        {
          "type": "text",
          "id": "note",
          "label": "Note",
          "default": "Relaxed through the waist and hips"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Kasya LP Fit Confidence",
      "blocks": [
        {
          "type": "fit_note",
          "settings": {
            "note": "Relaxed through the waist and hips"
          }
        },
        {
          "type": "fit_note",
          "settings": {
            "note": "Soft drape, not clingy"
          }
        },
        {
          "type": "fit_note",
          "settings": {
            "note": "True to size for a relaxed fit"
          }
        },
        {
          "type": "fit_note",
          "settings": {
            "note": "Size up if you prefer extra room"
          }
        }
      ]
    }
  ]
}
{% endschema %}
