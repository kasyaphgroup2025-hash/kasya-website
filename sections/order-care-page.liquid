{{ 'order-care-page.css' | asset_url | stylesheet_tag }}

<div class="order-care" data-order-care-page>
  <div class="order-care__inner">
    <aside class="order-care__assistance" aria-labelledby="OrderCareAssistance-{{ section.id }}">
      <div class="order-care__assistance-copy">
        <h2 id="OrderCareAssistance-{{ section.id }}">Need direct assistance?</h2>
        <p>For direct help with your concern, you may message us on Messenger.</p>
      </div>
      <a
        class="order-care__messenger"
        href="https://m.me/kasyaphhh"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Message Kasya on Messenger (opens in a new tab)"
      >
        <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="none">
          <path d="M12 2.25c-5.52 0-9.75 4.04-9.75 9.3 0 2.75 1.16 5.15 3.06 6.82v3.38l3.14-1.72c1.08.3 2.28.47 3.55.47 5.52 0 9.75-4.04 9.75-9.3S17.52 2.25 12 2.25Z" fill="currentColor"/>
          <path d="m6.8 14.3 3.25-3.45 2.55 1.9 3.55-3.8-3.25 3.45-2.55-1.9-3.55 3.8Z" fill="#fff"/>
        </svg>
        <span>Message Us</span>
      </a>
    </aside>

    <header class="order-care__intro">
      <div class="order-care__brand" aria-label="Kasya Order Care">
        <span>KASYA</span>
        <span>Order Care</span>
      </div>
      <h1>Need help with your order?</h1>
      <p>If the size doesn’t fit or something is wrong with your order, fill out this short form. We’ll review your concern and email you with the next steps.</p>
    </header>

    <section class="order-care__terms" aria-labelledby="OrderCareTerms-{{ section.id }}">
      <p class="order-care__eyebrow">Before you begin</p>
      <h2 id="OrderCareTerms-{{ section.id }}">Terms &amp; Agreement</h2>
      <div class="order-care__terms-box" role="region" aria-label="Kasya Order Care terms and agreement" tabindex="0">
        <p>Kasya Order Care is intended to help customers report concerns related to sizing, fit, incorrect items, damaged items, missing items, and other order-related concerns. Submitting this form does not automatically guarantee approval of a return, exchange, refund, or voucher.</p>
        <p>By using this form, you understand that Kasya may collect the email address and information you provide, including your order details, concern, and any supporting photos. This information will be used to review, process, document, and communicate with you about your Order Care request.</p>
        <p>You agree to provide accurate information and genuine supporting proof when needed. Kasya may contact you through the email address provided if additional information is required to complete the review.</p>
      </div>
      <aside class="order-care__shipping-notice" aria-labelledby="OrderCareShipping-{{ section.id }}">
        <h3 id="OrderCareShipping-{{ section.id }}">About return shipping</h3>
        <p>Please wait for our approval and instructions before sending your item back. If your return is eligible and successfully verified, we’ll send a <strong>₱150 OFF voucher</strong> to the email address you provided.</p>
      </aside>
    </section>
  </div>
</div>

{% schema %}
{
  "name": "Order Care introduction",
  "tag": "section",
  "class": "order-care-page-section",
  "settings": [],
  "presets": [
    {
      "name": "Order Care introduction"
    }
  ]
}
{% endschema %}
