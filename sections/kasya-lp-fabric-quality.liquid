{% comment %}
  KasyaPH Product Landing Fabric & Quality
  Compact quality proof section for fabric feel and care notes.
{% endcomment %}

<section class="kasya-lp-fabric-quality" data-kasya-fabric-quality data-section-id="{{ section.id }}">
  <div class="kasya-lp-fabric-quality__inner">
    <div class="kasya-lp-fabric-quality__header">
      {% if section.settings.heading != blank %}
        <h2 class="kasya-lp-fabric-quality__heading">
          {{ section.settings.heading }}
        </h2>
      {% endif %}

      {% if section.settings.subheading != blank %}
        <p class="kasya-lp-fabric-quality__subheading">
          {{ section.settings.subheading }}
        </p>
      {% endif %}

      <p class="kasya-lp-fabric-quality__color" data-fabric-color-shown hidden>
        Close-up shown: <span data-fabric-color-name></span>
      </p>
    </div>

    <div class="kasya-lp-fabric-quality__image-wrap">
      {% if section.settings.fabric_image != blank %}
        <img
          src="{{ section.settings.fabric_image | image_url: width: 1200 }}"
          data-fabric-image
          data-default-src="{{ section.settings.fabric_image | image_url: width: 1200 }}"
          alt="{{ section.settings.heading | default: 'Fabric close-up' | escape }}"
          width="1200"
          height="900"
          loading="lazy"
          class="kasya-lp-fabric-quality__image"
        >
        <div class="kasya-lp-fabric-quality__placeholder" data-fabric-placeholder hidden>
          Fabric close-up
        </div>
      {% else %}
        <img
          data-fabric-image
          data-default-src=""
          alt="{{ section.settings.heading | default: 'Fabric close-up' | escape }}"
          width="1200"
          height="900"
          loading="lazy"
          class="kasya-lp-fabric-quality__image"
          hidden
        >
        <div class="kasya-lp-fabric-quality__placeholder" data-fabric-placeholder>
          Fabric close-up
        </div>
      {% endif %}
    </div>

    {% if section.settings.main_note != blank %}
      <p class="kasya-lp-fabric-quality__main-note">
        {{ section.settings.main_note }}
      </p>
    {% endif %}

    <div class="kasya-product-hero__size-chart kasya-lp-fabric-quality__care" data-fabric-care>
      <button
        type="button"
        class="kasya-product-hero__size-chart-toggle"
        aria-expanded="false"
        aria-controls="FabricCarePanel-{{ section.id }}"
        data-fabric-care-toggle
      >
        {% if section.settings.fabric_care_dropdown_title != blank %}
          <span>{{ section.settings.fabric_care_dropdown_title | escape }}</span>
        {% endif %}
        <span class="kasya-product-hero__size-chart-icon" aria-hidden="true">⌄</span>
      </button>

      <div
        id="FabricCarePanel-{{ section.id }}"
        class="kasya-product-hero__size-chart-panel kasya-lp-fabric-quality__care-panel"
        data-fabric-care-panel
        hidden
      >
        {% if section.settings.fabric_care_heading != blank %}
          <h3>{{ section.settings.fabric_care_heading | escape }}</h3>
        {% endif %}

        {% if section.settings.fabric_care_description != blank %}
          <p>{{ section.settings.fabric_care_description | escape | newline_to_br }}</p>
        {% endif %}

        {% if section.settings.care_instructions_heading != blank %}
          <h3>{{ section.settings.care_instructions_heading | escape }}</h3>
        {% endif %}

        {% if section.settings.care_instruction_1 != blank
          or section.settings.care_instruction_2 != blank
          or section.settings.care_instruction_3 != blank
          or section.settings.care_instruction_4 != blank
          or section.settings.care_instruction_5 != blank
          or section.settings.care_instruction_6 != blank
          or section.settings.care_instruction_7 != blank
          or section.settings.care_instruction_8 != blank
        %}
          <ul>
            {% for instruction_number in (1..8) %}
              {% assign instruction_id = 'care_instruction_' | append: instruction_number %}
              {% assign instruction = section.settings[instruction_id] %}
              {% if instruction != blank %}
                <li>{{ instruction | escape }}</li>
              {% endif %}
            {% endfor %}
          </ul>
        {% endif %}
      </div>
    </div>

    {% if section.settings.show_feature_notes and section.blocks.size > 0 %}
      <div class="kasya-lp-fabric-quality__notes">
        {% for block in section.blocks %}
          <article class="kasya-lp-fabric-quality__note" {{ block.shopify_attributes }}>
            {% if block.settings.icon != blank %}
              <span class="kasya-lp-fabric-quality__note-icon" aria-hidden="true">
                {{ block.settings.icon }}
              </span>
            {% endif %}

            <div class="kasya-lp-fabric-quality__note-copy">
              {% if block.settings.title != blank %}
                <h3 class="kasya-lp-fabric-quality__note-title">
                  {{ block.settings.title }}
                </h3>
              {% endif %}

              {% if block.settings.description != blank %}
                <p class="kasya-lp-fabric-quality__note-description">
                  {{ block.settings.description }}
                </p>
              {% endif %}
            </div>
          </article>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</section>

<style>
  .kasya-lp-fabric-quality {
    --kasya-line: #eeeeee;
    background: #ffffff;
    color: #111111;
    font-family: inherit;
    max-width: 760px;
    margin: 0 auto;
  }

  .kasya-lp-fabric-quality * {
    box-sizing: border-box;
  }

  .kasya-lp-fabric-quality__inner {
    padding: 22px 16px 34px;
  }

  .kasya-lp-fabric-quality__header {
    margin-bottom: 14px;
  }

  .kasya-lp-fabric-quality__heading {
    margin: 0;
    font-size: 22px;
    font-weight: 850;
    letter-spacing: 0.06em;
    line-height: 1.08;
    text-transform: uppercase;
  }

  .kasya-lp-fabric-quality__subheading {
    margin: 8px 0 0;
    color: #444444;
    font-size: 14px;
    line-height: 1.45;
  }

  .kasya-lp-fabric-quality__color {
    margin: 10px 0 0;
    color: #303030;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.08em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .kasya-lp-fabric-quality__color span {
    font-weight: 500;
  }

  .kasya-lp-fabric-quality__image-wrap {
    margin-top: 16px;
    overflow: hidden;
    border-radius: 8px;
    background: #f3f3f3;
  }

  .kasya-lp-fabric-quality__image {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .kasya-lp-fabric-quality__image[hidden] {
    display: none;
  }

  .kasya-lp-fabric-quality__placeholder {
    width: 100%;
    aspect-ratio: 4 / 3;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 18px;
    color: #777777;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-align: center;
    text-transform: uppercase;
  }

  .kasya-lp-fabric-quality__placeholder[hidden] {
    display: none;
  }

  .kasya-lp-fabric-quality__main-note {
    margin: 15px 0 0;
    color: #222222;
    font-size: 14px;
    line-height: 1.5;
  }

  .kasya-lp-fabric-quality__care {
    margin-top: 16px;
  }

  .kasya-lp-fabric-quality__care-panel {
    color: #555555;
    font-size: 13px;
    line-height: 1.5;
    overflow-wrap: anywhere;
  }

  .kasya-lp-fabric-quality__care-panel h3 {
    margin: 2px 0 0;
    color: #222222;
    font-size: 13px;
    font-weight: 800;
    line-height: 1.35;
  }

  .kasya-lp-fabric-quality__care-panel p {
    margin: 6px 0 0;
  }

  .kasya-lp-fabric-quality__care-panel h3 + p + h3 {
    margin-top: 16px;
  }

  .kasya-lp-fabric-quality__care-panel ul {
    margin: 7px 0 0;
    padding-left: 19px;
  }

  .kasya-lp-fabric-quality__care-panel li {
    padding-left: 2px;
  }

  .kasya-lp-fabric-quality__care-panel li + li {
    margin-top: 4px;
  }

  .kasya-lp-fabric-quality__notes {
    margin-top: 16px;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
  }

  .kasya-lp-fabric-quality__note {
    min-width: 0;
    min-height: 112px;
    padding: 12px 10px;
    border: 1px solid #e6e6e6;
    background: #ffffff;
  }

  .kasya-lp-fabric-quality__note-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 24px;
    height: 24px;
    margin-bottom: 8px;
    color: #111111;
    font-size: 17px;
    line-height: 1;
  }

  .kasya-lp-fabric-quality__note-title {
    margin: 0;
    font-size: 12px;
    font-weight: 850;
    letter-spacing: 0.02em;
    line-height: 1.2;
  }

  .kasya-lp-fabric-quality__note-description {
    margin: 5px 0 0;
    color: #666666;
    font-size: 11px;
    line-height: 1.32;
  }

  @media screen and (min-width: 680px) {
    .kasya-lp-fabric-quality__inner {
      padding: 28px 26px 44px;
    }

    .kasya-lp-fabric-quality__heading {
      font-size: 26px;
    }

    .kasya-lp-fabric-quality__subheading,
    .kasya-lp-fabric-quality__main-note {
      font-size: 15px;
    }

    .kasya-lp-fabric-quality__notes {
      gap: 10px;
    }

    .kasya-lp-fabric-quality__note {
      min-height: 118px;
      padding: 14px;
    }
  }
</style>

<script>
  (() => {
    const section = document.querySelector('[data-kasya-fabric-quality][data-section-id="{{ section.id }}"]');
    if (!section) return;

    const image = section.querySelector('[data-fabric-image]');
    const placeholder = section.querySelector('[data-fabric-placeholder]');
    const colorLabel = section.querySelector('[data-fabric-color-shown]');
    const colorName = section.querySelector('[data-fabric-color-name]');
    const careToggle = section.querySelector('[data-fabric-care-toggle]');
    const carePanel = section.querySelector('[data-fabric-care-panel]');

    if (careToggle && carePanel && careToggle.dataset.fabricCareBound !== 'true') {
      careToggle.dataset.fabricCareBound = 'true';
      careToggle.addEventListener('click', () => {
        const isExpanded = careToggle.getAttribute('aria-expanded') === 'true';

        careToggle.setAttribute('aria-expanded', String(!isExpanded));
        carePanel.hidden = isExpanded;
      });
    }

    if (!image) return;

    function updateFabricImage(state) {
      if (!state || (!state.color && !state.previewColor)) return;

      const displayColor = String(state.displayColor || state.color || state.previewColor || '').trim();
      const nextSrc = state.fabricCloseup ||
        (state.strictColorMedia ? '' : image.dataset.defaultSrc || state.featuredImage) ||
        '';

      if (colorLabel && colorName && displayColor) {
        colorName.textContent = displayColor.toUpperCase();
        colorLabel.hidden = false;
      }

      if (nextSrc) {
        if (image.getAttribute('src') !== nextSrc) {
          image.setAttribute('src', nextSrc);
        }

        image.alt = `${displayColor} fabric close-up`.trim();
        image.hidden = false;

        if (placeholder) {
          placeholder.hidden = true;
        }

        return;
      }

      image.removeAttribute('src');
      image.hidden = true;

      if (placeholder) {
        placeholder.hidden = false;
      }
    }

    document.addEventListener('kasya:hero-color-change', event => {
      updateFabricImage(event.detail);
    });

    if (window.KasyaLPSelectedColor) {
      updateFabricImage(window.KasyaLPSelectedColor);
    }
  })();
</script>

{% schema %}
{
  "name": "Kasya LP Fabric Quality",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "FABRIC & QUALITY"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading / short description",
      "default": "Soft linen-feel fabric with a relaxed drape, made for everyday comfort."
    },
    {
      "type": "image_picker",
      "id": "fabric_image",
      "label": "Fabric close-up image",
      "info": "Fallback image. To make this image change per selected color, upload product media with alt text format: LP | Color | Fabric Close-up. Example: LP | Black | Fabric Close-up."
    },
    {
      "type": "textarea",
      "id": "main_note",
      "label": "Main fabric note",
      "default": "Designed to feel light, breathable, and comfortable for daily wear while still giving enough structure to look polished."
    },
    {
      "type": "checkbox",
      "id": "show_feature_notes",
      "label": "Show feature notes",
      "default": true
    },
    {
      "type": "header",
      "content": "Fabric and Care Dropdown"
    },
    {
      "type": "text",
      "id": "fabric_care_dropdown_title",
      "label": "Fabric and care dropdown title",
      "default": "FABRIC AND CARE"
    },
    {
      "type": "text",
      "id": "fabric_care_heading",
      "label": "Fabric heading",
      "default": "Fabric and Care"
    },
    {
      "type": "textarea",
      "id": "fabric_care_description",
      "label": "Fabric description",
      "default": "Made with Soft Linen fabric with a relaxed drape and comfortable feel. Due to the natural behavior of the fabric, slight shrinkage may happen after washing, especially when washed with hot water or dried using high heat."
    },
    {
      "type": "text",
      "id": "care_instructions_heading",
      "label": "Care instructions heading",
      "default": "Care Instructions"
    },
    {
      "type": "text",
      "id": "care_instruction_1",
      "label": "Care instruction 1",
      "default": "Wash with cold water."
    },
    {
      "type": "text",
      "id": "care_instruction_2",
      "label": "Care instruction 2",
      "default": "Use mild detergent."
    },
    {
      "type": "text",
      "id": "care_instruction_3",
      "label": "Care instruction 3",
      "default": "Avoid bleach."
    },
    {
      "type": "text",
      "id": "care_instruction_4",
      "label": "Care instruction 4",
      "default": "Do not use high-heat drying."
    },
    {
      "type": "text",
      "id": "care_instruction_5",
      "label": "Care instruction 5",
      "default": "Hang to dry."
    },
    {
      "type": "text",
      "id": "care_instruction_6",
      "label": "Care instruction 6",
      "default": "Use low heat when ironing if needed."
    },
    {
      "type": "text",
      "id": "care_instruction_7",
      "label": "Care instruction 7",
      "default": "Wash separately on first use. Slight color bleeding may occur."
    },
    {
      "type": "text",
      "id": "care_instruction_8",
      "label": "Care instruction 8"
    }
  ],
  "blocks": [
    {
      "type": "fabric_note",
      "name": "Fabric Note",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icon text or symbol",
          "default": "≈"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Soft drape"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Falls naturally without feeling stiff or bulky."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Kasya LP Fabric Quality",
      "blocks": [
        {
          "type": "fabric_note",
          "settings": {
            "icon": "≈",
            "title": "Soft drape",
            "description": "Falls naturally without feeling stiff or bulky."
          }
        },
        {
          "type": "fabric_note",
          "settings": {
            "icon": "◯",
            "title": "Breathable feel",
            "description": "Comfortable enough for warm days and long wear."
          }
        },
        {
          "type": "fabric_note",
          "settings": {
            "icon": "✱",
            "title": "Everyday structure",
            "description": "Polished enough for errands, work, and casual plans."
          }
        },
        {
          "type": "fabric_note",
          "settings": {
            "icon": "✓",
            "title": "Easy care",
            "description": "Wash gently and hang to dry to help maintain shape and fabric quality."
          }
        }
      ]
    }
  ]
}
{% endschema %}
