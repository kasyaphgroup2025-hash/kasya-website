{%-liquid
  assign has_gift_wrapping = false
  if settings.gift_wrapping_enable and settings.gift_wrapping_show_at != 'cart_page' and settings.gift_wrapping_product != blank
    assign has_gift_wrapping = true
  endif
-%}
<cart-drawer class="flex drawer drawer--cart{% if cart == empty %} is-empty{% endif %} h100">
  <div id="CartDrawer" class="cart-drawer">
    <div id="CartDrawer-Overlay"class="cart-drawer__overlay drawer__overlay"></div>
    <div class="drawer__inner drawer__inner--{{ section.settings.drawer_size }} drawer__inner--cart" role="dialog" aria-modal="true" aria-label="{{ 'sections.cart.title' | t }}" tabindex="-1">       
      <div class="drawer__header flex justify-space-between align-center">
        <h2 class="drawer__heading margin0 h4 font-heading-bold">{{ 'sections.cart.title' | t }}</h2>
        <button class="drawer__close" type="button" onclick="this.closest('cart-drawer').close()" aria-label="{{ 'accessibility.close' | t }}">{% render 'icon-close' %}</button>
      </div>
      {%- if section.settings.show_free_shipping_bar and settings.free_shipping_enable -%}
        <div>
          {%- render 'free-shipping-bar', wrapper_classes: 'cart-drawer__box', no_progress_margin: true, show_exclude_message: true -%}
        </div>
      {%- endif -%}  
      <div class="drawer__inner-empty flex-grow-1 flex flex-column">
        <div class="cart-drawer__warnings flex flex-column justify-left center flex-grow-1">
          <div class="cart-drawer__empty-content">
            <div class="cart-drawer__empty-content__top">
              <h2 class="cart-drawer__heading h2 font-heading-bold">{{ 'sections.cart.empty' | t }}</h2>

              {%- if section.settings.recommended_collection_list != blank -%}
                {%- if section.settings.recommended_collections_heading != blank -%}
                  <h3 class="{{ section.settings.recommended_collections_heading_size }} font-heading-bold margin0 small-margin-bottom">{{ section.settings.recommended_collections_heading }}</h3>
                {%- endif -%}
                {%- render 'recommended-collections', section_object: section, collections_layout: section.settings.recommended_collections_layout -%}
              {%- else -%}
                <a href="{{ settings.continue_button_link }}" class="button element-small-margin-top">
                  <span>{{ 'general.continue_shopping' | t }}</span>
                </a>  
              {%- endif -%}
            </div>

            {%- assign cart_discount_code_block = section.blocks | where: 'type', 'cart-discount-code' | first -%}
            {%- if cart_discount_code_block -%}
              <div class="cart__discount-code background-input flex flex-column cart-drawer__box">
                {%- if cart_discount_code_block.settings.short_description != blank -%}
                  <p class="caption margin0">{{ cart_discount_code_block.settings.short_description }}</p>
                  {%- render 'discount-code', local_settings: cart_discount_code_block.settings, shopify_attributes: cart_discount_code_block.shopify_attributes, blur_code: true -%}
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>
        </div>
        {%- if shop.customer_accounts_enabled and customer == nil -%}
          <div class="cart-drawer__login background-input center">
            <p class="cart__login-title h3 margin0 font-heading-extra-bold">{{ 'sections.cart.login.title' | t }}</p>
            <p class="cart__login-paragraph margin0 margin-top-1rem">
              {{ 'sections.cart.login.paragraph_html' | t: link: routes.account_login_url }}
            </p>
          </div>
        {%- endif -%}
      </div>
      <div class="cart-drawer__scroll-area">
        <cart-drawer-items class="cart-drawer__items h100">
          <form action="{{ routes.cart_url }}" id="CartDrawer-Form" class="cart__contents cart-drawer__form flex flex-wrap flex-grow-1" method="post">
            <div id="CartDrawer-CartItems" class="drawer__contents js-contents">
              {%- if cart != empty -%}
                <div class="drawer__cart-items-wrapper">
                  <table class="cart-items cart-items--drawer" role="table">
                    <tbody role="rowgroup">
                      {%- for item in cart.items -%}
                        <tr id="CartDrawer-Item-{{ item.index | plus: 1 }}" class="cart-item{% unless forloop.first %} cart-item--border{% endunless %}" role="row">
                          <td class="cart-item__media" role="cell" headers="CartDrawer-ColumnProductImage">
                            {% if item.image %}
                              {%- if settings.enable_appear_effect -%}
                                <use-animate class="skeleton-box">
                              {%- endif -%}  
                              {% comment %} Leave empty space due to a:empty CSS display: none rule {% endcomment %}
                              <a href="{{ item.url }}" class="cart-item__link flex media media--{{ section.settings.image_ratio }}" tabindex="-1" aria-hidden="true">
                                <img class="cart-item__image"
                                  src="{{ item.image | image_url: width: 300 }}"
                                  alt="{{ item.image.alt | escape }}"
                                  loading="lazy"
                                  width="{{ item.image.width }}"
                                  height="{{ item.image.height }}"
                                  {% if settings.enable_appear_effect %}
                                    onload="this.closest('.skeleton-box').classList.remove('skeleton-box')"
                                  {% endif %}
                                >
                              </a>
                              {%- if settings.enable_appear_effect -%}
                                </use-animate>
                              {%- endif -%}
                            {% endif %}
                          </td>

                          <td class="cart-item__details cart-item__details--drawer" role="cell" headers="CartDrawer-ColumnProduct">
                            {%- if section.settings.show_vendor -%}
                              <p class="caption light cart-item__vendor">{{ item.product.vendor }}</p>
                            {%- endif -%}

                            <a href="{{ item.url }}" class="cart-item__name h6 link link--text font-heading-bold">{{ item.product.title | escape }}</a>

                            {%- if item.product.has_only_default_variant == false or item.properties.size != 0 or item.selling_plan_allocation != nil -%}
                              <dl>
                                {%- if item.product.has_only_default_variant == false -%}
                                  {%- for option in item.options_with_values -%}
                                    <div class="product-option light">
                                      <dt>{{ option.name }}: </dt>
                                      <dd>{{ option.value }}</dd>
                                    </div>
                                  {%- endfor -%}
                                {%- endif -%}

                                {%- for property in item.properties -%}
                                  {%- assign property_first_char = property.first | slice: 0 -%}
                                  {%- if property.last != blank and property_first_char != '_' -%}
                                    <div class="product-option light">
                                      <dt>{{ property.first }}: </dt>
                                      <dd>
                                        {%- if property.last contains '/uploads/' -%}
                                          <a href="{{ property.last }}" class="link" target="_blank" aria-describedby="a11y-new-window-message">
                                            {{ property.last | split: '/' | last }}
                                          </a>
                                        {%- else -%}
                                          {{ property.last }}
                                        {%- endif -%}
                                      </dd>
                                    </div>
                                  {%- endif -%}
                                {%- endfor -%}
                              </dl>

                              <p class="product-option">{{ item.selling_plan_allocation.selling_plan.name }}</p>
                            {%- endif -%}

                            {%- liquid
                              assign check_against_inventory = true
                              assign quantity_rule_soldout = false

                              if item.variant.inventory_management != 'shopify' or item.variant.inventory_policy == 'continue'
                                assign check_against_inventory = false
                              endif
                              if item.variant.quantity_rule.min > item.variant.inventory_quantity and check_against_inventory
                                assign quantity_rule_soldout = true
                              endif
                            -%}
                            {%- if item.variant.available
                              and quantity_rule_soldout == false
                              and item.variant.inventory_management == 'shopify'
                              and item.variant.inventory_quantity < item.variant.quantity_rule.min
                              and item.variant.inventory_policy == 'continue'
                              and settings.enable_pre_order_text
                              and settings.pre_order_note != blank
                            -%}
                              <p class="caption margin0 rte">{{ settings.pre_order_note }}</p>
                            {%- endif -%}

                            <ul class="discounts list-unstyled" role="list" aria-label="{{ 'customer.order.discount' | t }}">
                              {%- for discount in item.discounts -%}
                                <li class="discounts__discount">
                                  {%- render 'icon-discount' -%}
                                  {{ discount.title }}
                                </li>
                              {%- endfor -%}
                            </ul>
                          </td>

                          <td class="cart-item__quantity" role="cell" headers="CartDrawer-ColumnQuantity">
                            <div class="cart-item__quantity-wrapper w100 flex justify-space-between align-center por">
                              <quantity-input class="quantity flex align-center color-foreground por">
                                <input class="quantity__input flex-grow-1 center background-input"
                                  type="number"
                                  data-quantity-variant-id="{{ item.variant.id }}"
                                  name="updates[]"
                                  value="{{ item.quantity }}"
                                  id="Drawer-quantity-{{ item.index | plus: 1 }}"
                                  min="0"
                                  data-min="{{ item.variant.quantity_rule.min }}"
                                  {% if item.variant.quantity_rule.max != null %}
                                    max="{{ item.variant.quantity_rule.max }}"
                                  {% endif %}
                                  step="{{ item.variant.quantity_rule.increment }}"
                                  aria-label="{{ 'products.product.quantity.input_label' | t: product: item.product.title | escape }}"
                                  data-index="{{ item.index | plus: 1 }}"
                                >
                                <div class="quantity__buttons flex flex-column flex-grow-1 small-hide">    
                                  <button class="quantity__button flex justify-center align-center no-js-hidden w100 color-foreground" name="plus" type="button">
                                    <span class="visually-hidden">{{ 'products.product.quantity.increase' | t: product: product.title | escape }}</span>
                                    <svg width="12" height="6" viewBox="0 0 12 6" fill="none" xmlns="http://www.w3.org/2000/svg">
                                      <path d="M10.6666 5.33331L5.99992 0.666646L1.33325 5.33331" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/>
                                    </svg>
                                  </button>
                                  <button class="quantity__button flex justify-center align-center no-js-hidden w100 color-foreground" name="minus" type="button">
                                    <span class="visually-hidden">{{ 'products.product.quantity.decrease' | t: product: product.title | escape }}</span>
                                    {%- unless item.quantity == item.variant.quantity_rule.increment -%}
                                      <svg width="12" height="7" viewBox="0 0 12 7" fill="none" xmlns="http://www.w3.org/2000/svg">
                                        <path d="M10.6666 1.16663L5.99992 5.83329L1.33325 1.16663" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/>
                                      </svg>
                                    {%- else -%}
                                      {%- render 'icon-remove', icon_width: 16 -%}
                                    {%- endunless -%}
                                  </button>
                                </div>
                              </quantity-input>
                              <div class="por">
                                <div class="loading-overlay hidden flex justify-right align-start">
                                  <div class="loading-overlay__spinner">
                                    {%- render 'icon-cart-loading' -%}
                                  </div>
                                </div>
                                <cart-remove-button id="CartDrawer-Remove-{{ item.index | plus: 1 }}" data-index="{{ item.index | plus: 1 }}">
                                  <button type="button" class="link justify-right align-center tap-area-icon por" aria-label="{{ 'sections.cart.remove_title' | t: title: item.title }}">
                                    {% render 'icon-remove' %}
                                  </button>
                                </cart-remove-button>
                              </div>
                            </div>
                          </td>

                          <td class="cart-drawer__item-total cart-item__totals flex justify-space-between align-center flex-wrap" role="cell" headers="CartDrawer-ColumnTotal">
                            <div class="cart-item__price-wrapper">
                              {%- if item.original_line_price != item.final_line_price -%}
                                <div class="cart-item__discounted-prices">
                                  <span class="visually-hidden">
                                    {{ 'products.product.price.regular_price' | t }}
                                  </span>
                                  <s class="cart-item__old-price product-option">
                                    {%- render 'price-format', price: item.original_line_price -%}
                                  </s>
                                  <span class="visually-hidden">
                                    {{ 'products.product.price.sale_price' | t }}
                                  </span>
                                  <strong class="cart-item__final-price product-option">
                                    {%- render 'price-format', price: item.final_line_price -%}
                                  </strong>
                                </div>
                              {%- else -%}
                                <span class="price price--start">
                                  {%- render 'price-format', price: item.original_line_price -%}
                                </span>
                              {%- endif -%}

                              {%- if item.variant.available and item.unit_price_measurement -%}
                                <div class="unit-price caption">
                                  <span class="visually-hidden">{{ 'products.product.price.unit_price' | t }}</span>
                                  {{ item.variant.unit_price | money }}
                                  <span aria-hidden="true">/</span>
                                  <span class="visually-hidden">&nbsp;{{ 'accessibility.unit_price_separator' | t }}&nbsp;</span>
                                  {%- if item.variant.unit_price_measurement.reference_value != 1 -%}
                                    {{- item.variant.unit_price_measurement.reference_value -}}
                                  {%- endif -%}
                                  {{ item.variant.unit_price_measurement.reference_unit }}
                                </div>
                              {%- endif -%}
                            </div>
                            {%- render 'cart-item-volume-pricing', item: item, show_note: true, in_drawer: true -%}
                          </td>
                          <td id="CartDrawer-LineItemError-{{ item.index | plus: 1 }}" class="cart-item__error alert alert--error hidden margin-top-1rem alert--small flex align-start" role="alert">
                            <small class="cart-item__error-text"></small>
                            <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-error" viewBox="0 0 13 13">
                              <circle cx="6.5" cy="6.50049" r="5.5" stroke="white" stroke-width="2"/>
                              <circle cx="6.5" cy="6.5" r="5.5" fill="#EB001B" stroke="#EB001B" stroke-width="0.7"/>
                              <path d="M5.87413 3.52832L5.97439 7.57216H7.02713L7.12739 3.52832H5.87413ZM6.50076 9.66091C6.88091 9.66091 7.18169 9.37267 7.18169 9.00504C7.18169 8.63742 6.88091 8.34917 6.50076 8.34917C6.12061 8.34917 5.81982 8.63742 5.81982 9.00504C5.81982 9.37267 6.12061 9.66091 6.50076 9.66091Z" fill="white"/>
                              <path d="M5.87413 3.17832H5.51535L5.52424 3.537L5.6245 7.58083L5.63296 7.92216H5.97439H7.02713H7.36856L7.37702 7.58083L7.47728 3.537L7.48617 3.17832H7.12739H5.87413ZM6.50076 10.0109C7.06121 10.0109 7.5317 9.57872 7.5317 9.00504C7.5317 8.43137 7.06121 7.99918 6.50076 7.99918C5.94031 7.99918 5.46982 8.43137 5.46982 9.00504C5.46982 9.57872 5.94031 10.0109 6.50076 10.0109Z" fill="white" stroke="#EB001B" stroke-width="0.7">
                            </svg>
                          </td>
                        </tr>
                      {%- endfor -%}
                    </tbody>
                  </table>
                </div>
              {%- endif -%}
              <p id="CartDrawer-LiveRegionText" class="visually-hidden" role="status"></p>
              <p id="CartDrawer-LineItemStatus" class="visually-hidden" aria-hidden="true" role="status">{{ 'accessibility.loading' | t }}</p>
            </div>
            <div id="CartDrawer-CartErrors" role="alert" class="cart-errors alert alert--error alert--small flex hidden">
              <span class="cart-item__error-text"></span>
              <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-error" viewBox="0 0 13 13">
                <circle cx="6.5" cy="6.50049" r="5.5" stroke="white" stroke-width="2"/>
                <circle cx="6.5" cy="6.5" r="5.5" fill="#EB001B" stroke="#EB001B" stroke-width="0.7"/>
                <path d="M5.87413 3.52832L5.97439 7.57216H7.02713L7.12739 3.52832H5.87413ZM6.50076 9.66091C6.88091 9.66091 7.18169 9.37267 7.18169 9.00504C7.18169 8.63742 6.88091 8.34917 6.50076 8.34917C6.12061 8.34917 5.81982 8.63742 5.81982 9.00504C5.81982 9.37267 6.12061 9.66091 6.50076 9.66091Z" fill="white"/>
                <path d="M5.87413 3.17832H5.51535L5.52424 3.537L5.6245 7.58083L5.63296 7.92216H5.97439H7.02713H7.36856L7.37702 7.58083L7.47728 3.537L7.48617 3.17832H7.12739H5.87413ZM6.50076 10.0109C7.06121 10.0109 7.5317 9.57872 7.5317 9.00504C7.5317 8.43137 7.06121 7.99918 6.50076 7.99918C5.94031 7.99918 5.46982 8.43137 5.46982 9.00504C5.46982 9.57872 5.94031 10.0109 6.50076 10.0109Z" fill="white" stroke="#EB001B" stroke-width="0.7">
              </svg>
            </div>
          </form>
        </cart-drawer-items>
        {%- if section.settings.product_recommendations_enable -%}
          <hr class="cart-drawer__scroll-area__line">
          {%- assign recommendation_section_id = 'cart-drawer-product-recommendations' -%}
          <cart-product-recommendations 
            data-url="{{ routes.product_recommendations_url }}" 
            data-product-ids="{{ cart.items | map: 'product_id' | join: ',' }}" 
            data-limit="{{ section.settings.product_recommendations_limit }}" 
            class="no-js-hidden cart-drawer__recommendation cart-drawer__recommendation--media-{{ section.settings.product_recommendations_image_ratio }}" 
            data-section-id="{{ recommendation_section_id }}" 
            data-component-classes="slider-component-desktop slider-component-tablet slider-component-mobile"
            data-grid-classes="slider slider--mobile slider--tablet slider--desktop grid--1-col" 
            data-remove-loading="true"
            data-item-selector=".item"
          >
            <div class="cart-drawer__recommendation-title-wrapper flex justify-space-between w100 align-center">
              <h2 class="h5 margin0">{{ section.settings.product_recommendations_heading }}</h2>
              <div class="cart-drawer__recommendation__slider-buttons slider-buttons slider-buttons--box flex align-center">
                <button type="button" id="Slider-{{ recommendation_section_id }}-prev-button" class="cart-drawer__recommendation__slider-button slider-button flex flex-column justify-center align-center slider-button--prev no-js-hidden tap-area-icon" name="previous" aria-label="{{ 'general.slider.previous_slide' | t }}" aria-controls="Slider-{{ recommendation_section_id }}" disabled="disabled">{% render 'icon-caret-slider-prev' %}</button>
                <button type="button" id="Slider-{{ recommendation_section_id }}-next-button" class="cart-drawer__recommendation__slider-button slider-button flex flex-column justify-center align-center slider-button--next no-js-hidden tap-area-icon" name="next" aria-label="{{ 'general.slider.next_slide' | t }}" aria-controls="Slider-{{ recommendation_section_id }}">{% render 'icon-caret-slider-next' %}</button>
              </div>
            </div>
            <div class="cart__recommendation-list"></div>
            <div class="cart__recommendation-loading small-margin-bottom">
              <div class="cart-drawer__recommendation-item">
                <span class="cart-drawer__recommendation-item__info media skeleton-box"></span>
                <div>
                  <div class="skeleton-box">
                    <span class="db margin-top-1rem"></span>
                  </div>
                  <div class="skeleton-box margin-top-1rem">
                    <span class="db margin-top-1rem"></span>
                  </div>
                </div>
              </div>
            </div>
          </cart-product-recommendations>
        {%- endif -%}
      </div>
      <div class="drawer__footer por flex flex-column justify-right flex-grow-1">
        <div class="drawer__footer__inner flex flex-column background-input">
          {%- if section.settings.show_cart_note or section.settings.show_shipping_calculator or has_gift_wrapping -%}
            <div class="drawer__footer__actions w100 flex overflow-hidden margin-bottom-1rem">
              {%- if has_gift_wrapping -%}
                {%- assign gift_wrapping_product = all_products[settings.gift_wrapping_product] -%}
                {%- assign gift_wrapping_cart_items = cart | line_items_for: gift_wrapping_product -%}
                <cart-drawer-footer-action class="cart-drawer__footer__action flex-grow-1">
                  <button type="button" class="flex justify-center align-center cart-drawer__footer__action-label button-label w100 unstyled-button color-foreground">
                    {%- render 'icon-picker', icon: 'gift', icon_width: 16 -%}
                    <span class="por">
                      {{ 'general.gift_wrapping.button_label' | t }}
                      {%- render 'gift-wrapping-bubble-number', gift_wrapping_cart_items: gift_wrapping_cart_items -%}
                    </span>
                  </button>
                  <div class="cart-drawer__footer__action-content w100 por overflow-hidden">
                    <div class="cart-drawer__footer__content-heading-wrapper w100 flex justify-space-between align-center">
                      <div class="cart-drawer__footer__content-heading flex align-center">
                        {%- render 'icon-picker', icon: 'gift', icon_width: 24 -%}
                        <span class="h4 font-heading-bold">
                          {{ 'general.gift_wrapping.button_label' | t }}
                          {%- render 'gift-wrapping-bubble', gift_wrapping_cart_items: gift_wrapping_cart_items -%}
                        </span>
                      </div>
                      <button type="button" class="cart-drawer__footer__action-close flex justify-center align-center tap-area-icon unstyled-button color-foreground">{%- render 'icon-close' -%}</button>
                    </div>  
                    <div class="cart-drawer__footer__content-inner por">
                      <gift-wrapping-updater class="db" data-is-drawer="true">
                        {%- render 'gift-wrapping-content', gift_wrapping_product: gift_wrapping_product, gift_wrapping_cart_items: gift_wrapping_cart_items -%}
                      </gift-wrapping-updater>
                    </div>
                  </div>
                </cart-drawer-footer-action>
              {%- endif -%}  
              {%- if section.settings.show_cart_note -%}
                <cart-drawer-footer-action class="cart-drawer__footer__action flex-grow-1">
                  <button type="button" class="flex justify-center align-center cart-drawer__footer__action-label button-label w100 unstyled-button color-foreground">
                    {%- render 'icon-pen' -%}
                    <span>{{ 'sections.cart.note_drawer' | t }}</span>
                  </button>
                  <cart-drawer-note class="cart-drawer__footer__action-content w100 por overflow-hidden">
                    <div class="cart-drawer__footer__content-heading-wrapper w100 flex justify-space-between align-center">
                      <div class="cart-drawer__footer__content-heading flex align-center">
                        {%- render 'icon-pen', icon_width: 24 -%}
                        <span class="h4 font-heading-bold">{{ 'sections.cart.note_drawer' | t }}</span>
                      </div>
                      <button type="button" class="cart-drawer__footer__action-close flex justify-center align-center tap-area-icon unstyled-button color-foreground">{%- render 'icon-close' -%}</button>
                    </div>  
                    <div class="cart-drawer__footer__content-inner">
                      <div class="cart__note">
                        <label for="Cart-note" class="cart-drawer__footer__action-content-label w100 field__label text-small font-body-bold uppercase">{{ 'sections.cart.note_label' | t }}</label>
                        <textarea class="text-area field__input cart__input-area" name="note" form="CartDrawer-Form" id="Cart-note" placeholder="{{ 'sections.cart.note' | t }}">{{ cart.note }}</textarea>
                      </div>
                      <div class="center cart__note__button-wrap element-small-margin-top">
                        <button class="button button--primary" type="button">
                          <span>{{ 'sections.cart.apply' | t }}</span>
                        </button>
                      </div>
                    </div>
                  </cart-drawer-note>
                </cart-drawer-footer-action>
              {%- endif -%}
              {%- if section.settings.show_shipping_calculator -%}
                <cart-drawer-footer-action class="cart-drawer__footer__action flex-grow-1">
                  <button type="button" class="flex justify-center align-center cart-drawer__footer__action-label button-label w100 unstyled-button color-foreground">
                    {%- render 'icon-shipping' -%}
                    <span>{{ 'sections.cart.shipping' | t }}</span>
                  </button>
                  <div class="cart-drawer__footer__action-content w100 cart-drawer__footer__action-content--shipping-calculator por">
                    <div class="cart-drawer__footer__content-heading-wrapper w100 flex justify-space-between align-center">
                      <div class="cart-drawer__footer__content-heading flex align-center">
                        {%- render 'icon-shipping', icon_width: 24 -%}
                        <span class="h4 font-heading-bold">{{ 'general.shipping_calculator.heading' | t }}</span>
                      </div>
                      <button type="button" class="cart-drawer__footer__action-close flex justify-center align-center tap-area-icon unstyled-button color-foreground">{%- render 'icon-close' -%}</button>
                    </div>
                    <div class="cart-drawer__footer__content-inner">
                      {%- render 'shipping-calculator' -%}  
                    </div>  
                  </div>
                </cart-drawer-footer-action>  
              {%- endif -%}
            </div>
          {%- endif -%}
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'subtotal' -%}
                {%- if settings.show_add_discount_code -%}
                  {% render 'cart-discount', section_id: section.id %}
                {%- endif -%}
                <div class="cart-drawer__footer cart-drawer__footer--subtotal" {{ block.shopify_attributes }}>
                  {%- if cart.total_discount > 0 -%}
                    <div class="totals flex justify-space-between align-end flex-wrap margin-bottom-1rem">
                      <p class="h6 margin0">{{ 'general.discount.total_discount' | t }}</p>
                      <p class="price price--total-discount font-body-semi-bold">
                        <s>{%- render 'price-format', price: cart.total_discount -%}</s>
                      </p>
                    </div>  
                  {%- endif -%}  

                  <div class="totals flex justify-space-between align-end flex-wrap" role="status">
                    <h2 class="totals__subtotal font-heading-bold uppercase h4">{{ 'sections.cart.subtotal' | t }}</h2>
                    <p class="totals__subtotal-value price font-body-semi-bold">
                      {%- render 'price-format', price: cart.total_price -%}
                    </p>
                  </div>
        
                  <div>
                    {%- if cart.cart_level_discount_applications.size > 0 -%}
                      <ul class="discounts list-unstyled" role="list" aria-label="{{ 'customer.order.discount' | t }}">
                        {%- for discount in cart.cart_level_discount_applications -%}
                          <li class="discounts__discount discounts__discount--end">
                            {%- render 'icon-discount' -%}
                            {{ discount.title }}
                            (-{{ discount.total_allocated_amount | money }})
                          </li>
                        {%- endfor -%}
                      </ul>
                    {%- endif -%}
                  </div>
        
                  <small class="tax-note text-small rte db">
                    {%-liquid
                      assign show_taxes_text = false
                      if settings.show_taxes_notice and cart.taxes_included
                        assign show_taxes_text = true
                      endif
                      assign show_shipping_policy_notice = false
                      if settings.show_shipping_policy_notice and shop.shipping_policy.body != blank
                        assign show_shipping_policy_notice = true
                      endif
                    -%}
                    {%- if show_taxes_text and show_shipping_policy_notice -%}
                      {%- if cart.taxes_included and shop.shipping_policy.body != blank -%}
                        {{ 'sections.cart.taxes_included_and_shipping_policy_html' | t: link: shop.shipping_policy.url }}
                      {%- elsif cart.taxes_included -%}
                        {{ 'sections.cart.taxes_included_but_shipping_at_checkout' | t }}
                      {%- elsif shop.shipping_policy.body != blank -%}
                        {{ 'sections.cart.taxes_and_shipping_policy_at_checkout_html' | t: link: shop.shipping_policy.url }}
                      {%- else -%}
                        {{ 'sections.cart.taxes_and_shipping_at_checkout' | t }}
                      {%- endif -%}
                    {%- elsif show_taxes_text -%}
                      {{ 'products.product.include_taxes' | t }}
                    {%- elsif show_shipping_policy_notice -%}
                      {{ 'products.product.shipping_policy_html' | t: link: shop.shipping_policy.url }}
                    {%- endif -%}
                  </small>
                </div>
              {%- when 'buttons' -%}
                <div class="center cart__ctas cart__ctas--grid" {{ block.shopify_attributes }}>
                  {%- if block.settings.show_view_cart_button -%}
                    <a href="{{ routes.cart_url }}" id="CartDrawer-ViewCart" class="button button--secondary button--shadow" data-no-instant>
                      <span>{{ 'sections.cart.view_cart' | t }}</span>
                    </a>
                  {%- endif -%}
        
                  <button type="submit" id="CartDrawer-Checkout" class="cart__checkout-button button button--shadow" name="checkout" form="CartDrawer-Form">
                    {%- render 'icon-lock' -%}
                    <span>{{ 'sections.cart.checkout' | t }}</span>
                  </button>
                </div>
              {%- else -%}
                {% render block %}  
            {%- endcase -%}  
          {%- endfor -%}  
        </div> 
      </div>
    </div>
  </div>
</cart-drawer>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    function isIE() {
      const ua = window.navigator.userAgent;
      const msie = ua.indexOf('MSIE ');
      const trident = ua.indexOf('Trident/');

      return (msie > 0 || trident > 0);
    }

    if (!isIE()) return;
    const cartSubmitInput = document.createElement('input');
    cartSubmitInput.setAttribute('name', 'checkout');
    cartSubmitInput.setAttribute('type', 'hidden');
    document.querySelector('#cart').appendChild(cartSubmitInput);
    document.querySelector('#checkout').addEventListener('click', function(event) {
      document.querySelector('#cart').submit();
    });
  });
</script>

{%- if section.settings.show_shipping_calculator or request.design_mode -%}
  <script src="{{ 'shipping-calculator.js' | asset_url }}" defer="defer"></script>
{%- endif -%}
{%- if section.settings.product_recommendations_enable -%}
  <link rel="stylesheet" href="{{ 'component-cart-drawer-product-recommendation.css' | asset_url }}" media="print" onload="this.media='all'">
  <script src="{{ 'product-price.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'cart-product-recommendation.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'cart-drawer-product-recommendation-item.js' | asset_url }}" defer="defer"></script>
{%- endif -%}
{%- if customer.b2b? -%}
  <link rel="stylesheet" href="{{ 'component-volume-pricing.css' | asset_url }}" media="print" onload="this.media='all'">
{%- endif -%}
{%- if settings.gift_wrapping_enable and settings.gift_wrapping_show_at != 'cart_page' and settings.gift_wrapping_product != blank -%}
  {{ 'component-gift-wrapping.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'gift-wrapping.js' | asset_url }}" defer="defer"></script>
{%- endif -%}
{%- if settings.show_add_discount_code or request.design_mode -%}
  {{ 'component-cart-discount.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'cart-discount.js' | asset_url }}" defer="defer"></script>
{%- endif -%}  
{%- if section.settings.recommended_collection_list != blank and section.settings.recommended_collections_layout == 'list' -%}
  <link rel="stylesheet" href="{{ 'component-recommended-collection-list.css' | asset_url }}" media="print" onload="this.media='all'">
{%- endif -%}

{% schema %}
{
