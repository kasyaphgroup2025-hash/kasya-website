        {
          "value": "small",
          "label": "t:sections.cart-drawer.settings.drawer_size.option_1.label"
        },
        {
          "value": "medium",
          "label": "t:sections.cart-drawer.settings.drawer_size.option_2.label"
        },
        {
          "value": "large",
          "label": "t:sections.cart-drawer.settings.drawer_size.option_3.label"
        }
      ],
      "default": "small"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:sections.cart-drawer.settings.image_ratio.label",
