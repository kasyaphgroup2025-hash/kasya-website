      "label": "t:settings_schema.cart.settings.show_shipping_calculator.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_free_shipping_bar",
      "label": "t:sections.cart-drawer.settings.show_free_shipping_bar.label",
