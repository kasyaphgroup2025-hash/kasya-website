{{ 'home-88-collection-story.css' | asset_url | stylesheet_tag }}

{%- assign story_editorial_font = section.settings.editorial_font -%}

{%- style -%}
  {%- if story_editorial_font != blank -%}
    {{ story_editorial_font | font_face: font_display: 'swap' }}

    #shopify-section-{{ section.id }} .home-88-story__heading,
    #shopify-section-{{ section.id }} .home-88-story__opening {
      font-family: {{ story_editorial_font.family }}, {{ story_editorial_font.fallback_families }};
      font-style: {{ story_editorial_font.style }};
      font-weight: {{ story_editorial_font.weight }};
    }
  {%- else -%}
    #shopify-section-{{ section.id }} .home-88-story__heading,
    #shopify-section-{{ section.id }} .home-88-story__opening {
      font-family: Georgia, "Times New Roman", serif;
      font-style: normal;
      font-weight: 400;
    }
  {%- endif -%}

  #shopify-section-{{ section.id }} + .section-home-next-collection .home-next-collection {
    padding-top: {{ section.settings.section_gap_mobile }}px;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} + .section-home-next-collection .home-next-collection {
      padding-top: {{ section.settings.section_gap_desktop }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign story_image = section.settings.editorial_image | default: section.settings.mobile_image
  assign story_image_alt = section.settings.editorial_image_alt | default: section.settings.heading
  assign story_paragraphs = section.settings.main_body | newline_to_br | split: '<br />'
-%}

<section
  id="home-88-collection-story"
  class="home-88-story"
  style="
    --story-bg: {{ section.settings.story_background }};
    --story-text: {{ section.settings.story_text_color }};
    --home-88-story-height-mobile: {{ section.settings.section_height_mobile }}px;
    --home-88-story-height-desktop: {{ section.settings.section_height_desktop }}px;
    --story-side-padding-mobile: {{ section.settings.panel_padding_mobile }}px;
    --story-side-padding-desktop: {{ section.settings.panel_padding_desktop }}px;
    --story-bottom-mobile: {{ section.settings.bottom_spacing_mobile }}px;
    --story-bottom-desktop: {{ section.settings.bottom_spacing_desktop }}px;
    --story-heading-mobile: {{ section.settings.heading_size_mobile }}px;
    --story-heading-desktop: {{ section.settings.heading_size_desktop }}px;
    --story-opening-mobile: {{ section.settings.opening_size_mobile }}px;
    --story-opening-desktop: {{ section.settings.opening_size_desktop }}px;
    --story-body-mobile: {{ section.settings.body_size_mobile }}px;
    --story-body-desktop: {{ section.settings.body_size_desktop }}px;
    --story-closing-mobile: {{ section.settings.closing_size_mobile }}px;
    --story-closing-desktop: {{ section.settings.closing_size_desktop }}px;
    --story-line-mobile: {{ section.settings.line_height_mobile | divided_by: 100.0 }};
    --story-line-desktop: {{ section.settings.line_height_desktop | divided_by: 100.0 }};
    --story-position-mobile: {{ section.settings.image_position_mobile }};
    --story-position-desktop: {{ section.settings.image_position_desktop }};
  "
>
  <div class="home-88-story__media">
    {%- if story_image != blank -%}
      <picture class="home-88-story__picture">
        {%- if section.settings.mobile_image != blank -%}
          <source
            media="(max-width: 749px)"
            srcset="
              {{ section.settings.mobile_image | image_url: width: 375 }} 375w,
              {{ section.settings.mobile_image | image_url: width: 550 }} 550w,
              {{ section.settings.mobile_image | image_url: width: 750 }} 750w,
              {{ section.settings.mobile_image | image_url: width: 1000 }} 1000w
            "
            sizes="100vw"
          >
        {%- endif -%}
        {{ story_image
          | image_url: width: 2400
          | image_tag:
            loading: 'lazy',
            widths: '480, 750, 1000, 1200, 1500, 1800, 2100, 2400',
            sizes: '100vw',
            alt: story_image_alt
        }}
      </picture>
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'home-88-story__placeholder' }}
    {%- endif -%}
  </div>

  <div class="home-88-story__copy">
    {%- if section.settings.heading != blank -%}
      <h2 class="home-88-story__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    {%- if section.settings.opening_line != blank -%}
      <p class="home-88-story__opening">{{ section.settings.opening_line | escape }}</p>
    {%- endif -%}

    {%- if section.settings.main_body != blank -%}
      <div class="home-88-story__body">
        {%- for paragraph in story_paragraphs -%}
          {%- assign paragraph_text = paragraph | strip -%}
          {%- if paragraph_text != blank -%}
            <p>{{ paragraph_text | escape }}</p>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.closing_line != blank -%}
      <p class="home-88-story__closing">{{ section.settings.closing_line | escape }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Home UNFOLD story",
  "tag": "section",
  "class": "section-home-88-story",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "UNFOLD" },
    { "type": "text", "id": "opening_line", "label": "Campaign line", "default": "Different chapters. Same becoming." },
    { "type": "textarea", "id": "main_body", "label": "Story copy", "default": "Life unfolds differently for every woman. Some chapters are about finding your footing; others bring greater confidence and clarity.\n\nUNFOLD brings polished, comfortable pieces made to move with you through every chapter." },
    { "type": "textarea", "id": "closing_line", "label": "Closing line", "default": "Elegance that feels natural at every stage." },
    { "type": "font_picker", "id": "editorial_font", "label": "Editorial serif font", "default": "playfair_display_n4" },
    { "type": "color", "id": "story_background", "label": "Story background color", "default": "#1d2107" },
    { "type": "color", "id": "story_text_color", "label": "Story text color", "default": "#ffffff" },
    { "type": "header", "content": "Images" },
    { "type": "image_picker", "id": "editorial_image", "label": "Desktop image" },
    { "type": "image_picker", "id": "mobile_image", "label": "Mobile image (optional)" },
    { "type": "paragraph", "content": "The desktop image is used on all screen sizes when no mobile image is selected." },
    { "type": "text", "id": "editorial_image_alt", "label": "Image alt text" },
    { "type": "select", "id": "image_position_mobile", "label": "Mobile image position", "default": "center center", "options": [{ "value": "left center", "label": "Left" }, { "value": "center center", "label": "Center" }, { "value": "right center", "label": "Right" }, { "value": "center top", "label": "Top" }, { "value": "center bottom", "label": "Bottom" }] },
    { "type": "select", "id": "image_position_desktop", "label": "Desktop image position", "default": "center center", "options": [{ "value": "left center", "label": "Left" }, { "value": "center center", "label": "Center" }, { "value": "right center", "label": "Right" }, { "value": "center top", "label": "Top" }, { "value": "center bottom", "label": "Bottom" }] },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "section_height_mobile", "label": "Story height — Mobile", "min": 420, "max": 700, "step": 10, "unit": "px", "default": 500 },
    { "type": "range", "id": "section_height_desktop", "label": "Story height — Desktop", "min": 450, "max": 900, "step": 10, "unit": "px", "default": 600 },
    { "type": "range", "id": "panel_padding_mobile", "label": "Mobile side spacing", "min": 16, "max": 48, "step": 2, "unit": "px", "default": 20 },
    { "type": "range", "id": "panel_padding_desktop", "label": "Desktop side spacing", "min": 24, "max": 96, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "bottom_spacing_mobile", "label": "Mobile text spacing from bottom", "min": 24, "max": 100, "step": 4, "unit": "px", "default": 32 },
    { "type": "range", "id": "bottom_spacing_desktop", "label": "Desktop text spacing from bottom", "min": 32, "max": 120, "step": 4, "unit": "px", "default": 64 },
    { "type": "header", "content": "Spacing after story" },
    { "type": "range", "id": "section_gap_mobile", "label": "Bottom spacing — Mobile", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "section_gap_desktop", "label": "Bottom spacing — Desktop", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 72 },
    { "type": "header", "content": "Typography" },
    { "type": "range", "id": "heading_size_mobile", "label": "Mobile heading size", "min": 30, "max": 44, "step": 1, "unit": "px", "default": 34 },
    { "type": "range", "id": "heading_size_desktop", "label": "Desktop heading size", "min": 40, "max": 60, "step": 1, "unit": "px", "default": 48 },
    { "type": "range", "id": "opening_size_mobile", "label": "Mobile campaign-line size", "min": 14, "max": 20, "step": 1, "unit": "px", "default": 16 },
    { "type": "range", "id": "opening_size_desktop", "label": "Desktop campaign-line size", "min": 18, "max": 24, "step": 1, "unit": "px", "default": 20 },
    { "type": "range", "id": "body_size_mobile", "label": "Mobile body size", "min": 13, "max": 17, "step": 1, "unit": "px", "default": 14 },
    { "type": "range", "id": "body_size_desktop", "label": "Desktop body size", "min": 15, "max": 20, "step": 1, "unit": "px", "default": 16 },
    { "type": "range", "id": "closing_size_mobile", "label": "Mobile closing-line size", "min": 14, "max": 18, "step": 1, "unit": "px", "default": 15 },
    { "type": "range", "id": "closing_size_desktop", "label": "Desktop closing-line size", "min": 16, "max": 22, "step": 1, "unit": "px", "default": 18 },
    { "type": "range", "id": "line_height_mobile", "label": "Mobile line height", "min": 130, "max": 170, "step": 5, "unit": "%", "default": 150 },
    { "type": "range", "id": "line_height_desktop", "label": "Desktop line height", "min": 130, "max": 170, "step": 5, "unit": "%", "default": 150 }
  ],
  "presets": [{ "name": "Home UNFOLD story" }]
}
{% endschema %}
