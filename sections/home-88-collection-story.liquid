{{ 'home-88-collection-story.css' | asset_url | stylesheet_tag }}

<section
  id="home-88-collection-story"
  class="home-88-story"
  style="
    --story-bg: {{ section.settings.story_background }};
    --story-text: {{ section.settings.story_text_color }};
    --story-height-mobile: {{ section.settings.section_height_mobile }}px;
    --story-height-desktop: {{ section.settings.section_height_desktop }}px;
    --story-padding-mobile: {{ section.settings.panel_padding_mobile }}px;
    --story-padding-desktop: {{ section.settings.panel_padding_desktop }}px;
    --story-heading-mobile: {{ section.settings.heading_size_mobile }}px;
    --story-heading-desktop: {{ section.settings.heading_size_desktop }}px;
    --story-opening-mobile: {{ section.settings.opening_size_mobile }}px;
    --story-opening-desktop: {{ section.settings.opening_size_desktop }}px;
    --story-body-mobile: {{ section.settings.body_size_mobile }}px;
    --story-body-desktop: {{ section.settings.body_size_desktop }}px;
    --story-closing-mobile: {{ section.settings.closing_size_mobile }}px;
    --story-closing-desktop: {{ section.settings.closing_size_desktop }}px;
    --story-line-mobile: {{ section.settings.line_height_mobile | divided_by: 100.0 }};
    --story-line-desktop: {{ section.settings.line_height_desktop | divided_by: 100.0 }};
    --story-position-mobile: {{ section.settings.image_position_mobile }};
    --story-position-desktop: {{ section.settings.image_position_desktop }};
  "
>
  <div class="home-88-story__copy">
    <h2>{{ section.settings.heading | escape }}</h2>
    <p class="home-88-story__opening">{{ section.settings.opening_line | escape }}</p>
    <div class="home-88-story__body">{{ section.settings.main_body | escape | newline_to_br }}</div>
    <p class="home-88-story__closing">{{ section.settings.closing_line | escape }}</p>
  </div>
  <div class="home-88-story__media">
    {%- if section.settings.editorial_image != blank -%}
      {{ section.settings.editorial_image
        | image_url: width: 1800
        | image_tag:
          loading: 'lazy',
          widths: '320, 480, 640, 800, 1000, 1200, 1500, 1800',
          sizes: '50vw',
          alt: section.settings.editorial_image_alt
      }}
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'home-88-story__placeholder' }}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Home 8.8 story",
  "tag": "section",
  "class": "section-home-88-story",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "THE INTERLUDE EDIT" },
    { "type": "text", "id": "opening_line", "label": "Opening line", "default": "Some days do not stay one way." },
    { "type": "textarea", "id": "main_body", "label": "Main body", "default": "The weather changes. The pace moves. Plans unfold differently than expected.\n\nThe Interlude Edit brings together polished silhouettes, breathable comfort, and versatile shapes designed to help you move through each shift with quiet composure." },
    { "type": "textarea", "id": "closing_line", "label": "Closing line", "default": "Not dressed for only one moment, but ready for everything in between." },
    { "type": "color", "id": "story_background", "label": "Story background color", "default": "#1d2107" },
    { "type": "color", "id": "story_text_color", "label": "Story text color", "default": "#ffffff" },
    { "type": "image_picker", "id": "editorial_image", "label": "Editorial image" },
    { "type": "paragraph", "content": "Recommended: 1600 × 1200 px (4:3), WebP." },
    { "type": "text", "id": "editorial_image_alt", "label": "Editorial image alt text" },
    { "type": "select", "id": "image_position_mobile", "label": "Mobile image position", "default": "center center", "options": [{ "value": "left center", "label": "Left" }, { "value": "center center", "label": "Center" }, { "value": "right center", "label": "Right" }, { "value": "center top", "label": "Top" }, { "value": "center bottom", "label": "Bottom" }] },
    { "type": "select", "id": "image_position_desktop", "label": "Desktop image position", "default": "center center", "options": [{ "value": "left center", "label": "Left" }, { "value": "center center", "label": "Center" }, { "value": "right center", "label": "Right" }, { "value": "center top", "label": "Top" }, { "value": "center bottom", "label": "Bottom" }] },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "section_height_mobile", "label": "Mobile section height", "min": 260, "max": 500, "step": 10, "unit": "px", "default": 320 },
    { "type": "range", "id": "section_height_desktop", "label": "Desktop section height", "min": 320, "max": 600, "step": 10, "unit": "px", "default": 400 },
    { "type": "range", "id": "panel_padding_mobile", "label": "Mobile left-panel padding", "min": 8, "max": 40, "step": 2, "unit": "px", "default": 12 },
    { "type": "range", "id": "panel_padding_desktop", "label": "Desktop left-panel padding", "min": 24, "max": 100, "step": 4, "unit": "px", "default": 48 },
    { "type": "header", "content": "Typography" },
    { "type": "range", "id": "heading_size_mobile", "label": "Mobile heading size", "min": 12, "max": 30, "step": 1, "unit": "px", "default": 18 },
    { "type": "range", "id": "heading_size_desktop", "label": "Desktop heading size", "min": 20, "max": 52, "step": 1, "unit": "px", "default": 30 },
    { "type": "range", "id": "opening_size_mobile", "label": "Mobile opening-line size", "min": 9, "max": 20, "step": 1, "unit": "px", "default": 12 },
    { "type": "range", "id": "opening_size_desktop", "label": "Desktop opening-line size", "min": 12, "max": 28, "step": 1, "unit": "px", "default": 16 },
    { "type": "range", "id": "body_size_mobile", "label": "Mobile body size", "min": 8, "max": 18, "step": 1, "unit": "px", "default": 10 },
    { "type": "range", "id": "body_size_desktop", "label": "Desktop body size", "min": 12, "max": 24, "step": 1, "unit": "px", "default": 14 },
    { "type": "range", "id": "closing_size_mobile", "label": "Mobile closing-line size", "min": 8, "max": 18, "step": 1, "unit": "px", "default": 10 },
    { "type": "range", "id": "closing_size_desktop", "label": "Desktop closing-line size", "min": 12, "max": 24, "step": 1, "unit": "px", "default": 14 },
    { "type": "range", "id": "line_height_mobile", "label": "Mobile line height", "min": 105, "max": 170, "step": 5, "unit": "%", "default": 135 },
    { "type": "range", "id": "line_height_desktop", "label": "Desktop line height", "min": 105, "max": 170, "step": 5, "unit": "%", "default": 135 }
  ],
  "presets": [{ "name": "Home 8.8 story" }]
}
{% endschema %}
