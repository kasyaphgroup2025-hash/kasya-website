</style>

<script>
  (() => {
    const section = document.querySelector('[data-section-id="{{ section.id }}"]');
    if (!section) return;

    const slider = section.querySelector('[data-slider]');
    const dots = section.querySelector('[data-dots]');
    const prevButton = section.querySelector('[data-gallery-prev]');
    const nextButton = section.querySelector('[data-gallery-next]');
    const reviewsLink = section.querySelector('[data-reviews-link]');
    const variantInput = section.querySelector('[data-variant-id]');
    const priceEl = section.querySelector('[data-price]');
    const submitButton = section.querySelector('[data-submit]');
    const submitText = section.querySelector('[data-submit-text]');
    const stickyAtc = section.querySelector('[data-sticky-atc]');
    const stickyContext = section.querySelector('[data-sticky-context]');
    const stickySubmitButton = section.querySelector('[data-sticky-submit]');
    const stickySubmitText = section.querySelector('[data-sticky-submit-text]');
    const colorSwatchesContainer = section.querySelector('[data-color-swatches]');
    const selectedColorText = section.querySelector('[data-selected-color]');
    const sizeOptionsContainer = section.querySelector('[data-size-options]');
    const selectedSizeText = section.querySelector('[data-selected-size]');
    const sizeChartToggle = section.querySelector('[data-size-chart-toggle]');
    const sizeChartToggleText = section.querySelector('[data-size-chart-toggle-text]');
    const sizeChartPanel = section.querySelector('[data-size-chart-panel]');
    const sizeChartImage = section.querySelector('[data-size-chart-image]');
    const optionNamesEl = section.querySelector('[data-product-options]');
    const variantsEl = section.querySelector('[data-variants]');
    const productMediaEl = section.querySelector('[data-product-media]');
    const colorBlocksEl = section.querySelector('[data-color-blocks]');

    if (!slider || !dots || !variantInput || !optionNamesEl || !variantsEl || !colorBlocksEl) return;

    if (stickyAtc) {
      document.body.classList.add('kasya-sticky-atc-enabled');
    }

    const optionNames = JSON.parse(optionNamesEl.textContent || '[]');
    const variants = JSON.parse(variantsEl.textContent || '[]');
    const productMedia = productMediaEl ? JSON.parse(productMediaEl.textContent || '[]') : [];
    const colorBlocksRaw = JSON.parse(colorBlocksEl.textContent || '[]');
    const colorBlocks = colorBlocksRaw.filter(block => block && block.option_value);
    const requireExplicitVariantSelection = section.dataset.requireExplicitVariantSelection === 'true';
    const showInitialMediaPreview = section.dataset.initialMediaPreview === 'true';

    const defaultColor = {{ section.settings.default_color | json }};
    const colorOptionName = {{ section.settings.color_option_name | json }};
    const sizeOptionName = {{ section.settings.size_option_name | json }};
    const ctaText = {{ section.settings.cta_text | json }};
    const sizeChartTriggerText = {{ section.settings.size_chart_trigger_text | json }};
    const sizeChartHideText = 'Hide size chart';
    const fallbackImage = {% if lp_product.featured_image != blank %}{{ lp_product.featured_image | image_url: width: 1400 | json }}{% else %}null{% endif %};
    const lpShotOrder = ['front', 'side', 'back', 'sitting', 'fabric close up'];

    const lower = value => String(value || '').trim().toLowerCase();

    function normalizeColorName(value) {
      return String(value || '')
        .trim()
        .replace(/([a-z])([A-Z])/g, '$1 $2')
        .replace(/[-_]+/g, ' ')
        .replace(/\s+/g, ' ')
        .toLowerCase()
        .trim();
    }

    function getAutomaticSwatchColor(colorValue) {
      const value = normalizeColorName(colorValue);
      const compactValue = value.replace(/\s+/g, '');

      if (value.includes('black')) return '#000000';

      const swatchMap = [
        { names: ['dusty lilac', 'soft lilac', 'light lilac', 'lilac', 'lavender'], color: '#C8B4D9' },
        { names: ['dusty purple', 'muted purple'], color: '#A58AAF' },
        { names: ['nude beige', 'skin tone', 'skintone', 'flesh', 'skin'], color: '#D8B79B' },
        { names: ['light nude', 'warm nude', 'nude'], color: '#D8BEA2' },
        { names: ['light beige', 'beige'], color: '#DCC5A1' },
        { names: ['mocha beige'], color: '#B89C84' },
        { names: ['greige'], color: '#B7AEA3' },
        { names: ['stone'], color: '#B9AEA0' },
        { names: ['sand'], color: '#D6C2A3' },
        { names: ['taupe'], color: '#B8A38E' },
        { names: ['dark teal', 'deep teal', 'blue green', 'petrol', 'teal'], color: '#0F5C5C' },
        { names: ['emerald'], color: '#0F6B4F' },
        { names: ['forest green', 'forest'], color: '#0F5132' },
        { names: ['dark green'], color: '#123F2E' },
        { names: ['moss green'], color: '#637A45' },
        { names: ['olive green', 'olive'], color: '#5F6F3A' },
        { names: ['deep navy', 'navy blue', 'navy'], color: '#101E4A' },
        { names: ['royal blue'], color: '#172A78' },
        { names: ['blue'], color: '#2F5D9C' },
        { names: ['light gray', 'light grey'], color: '#B8B8B8' },
        { names: ['gray', 'grey', 'charcoal'], color: '#7A7A7A' },
        { names: ['off white', 'white', 'cream'], color: '#F4EFE8' },
        { names: ['khaki'], color: '#B5A06A' },
        { names: ['choco brown', 'chocolate brown', 'brown'], color: '#7A4A2A' },
        { names: ['mocha'], color: '#8B6F5A' },
        { names: ['camel'], color: '#B57A45' },
        { names: ['coffee'], color: '#5A3825' },
        { names: ['burgundy'], color: '#6F1D1B' },
        { names: ['wine red', 'maroon', 'red'], color: '#8B0000' },
        { names: ['old rose', 'dusty pink', 'rose'], color: '#C98C8C' },
        { names: ['pink'], color: '#E8A7B7' },
        { names: ['blush'], color: '#F0C7B7' },
        { names: ['green'], color: '#0F5132' },
        { names: ['sage'], color: '#9CAF88' },
        { names: ['peach'], color: '#F4BE98' },
        { names: ['mustard'], color: '#C99700' }
      ];

      const match = swatchMap.find(item => {
        return item.names.some(name => {
          const normalizedName = normalizeColorName(name);
          const compactName = normalizedName.replace(/\s+/g, '');
          return value.includes(normalizedName) || compactValue.includes(compactName);
        });
      });

      return match ? match.color : '#000000';
    }

    function getSwatchColor(block, displayName, colorValue) {
      const manualSwatch = block && block.swatch ? String(block.swatch).trim() : '';
      const colorName = displayName || colorValue;
      const manualIsBlack = ['#000', '#000000'].includes(lower(manualSwatch));
      const nameIsBlack = normalizeColorName(colorName).includes('black');

      if (manualSwatch && (!manualIsBlack || nameIsBlack)) return manualSwatch;

      return getAutomaticSwatchColor(colorName);
    }

    function findOptionIndex(targetName, fallbackKeyword) {
      let index = optionNames.findIndex(name => lower(name) === lower(targetName));
      if (index !== -1) return index;

      index = optionNames.findIndex(name => lower(name).includes(lower(fallbackKeyword)));
      if (index !== -1) return index;

      return -1;
    }

    const colorIndex = findOptionIndex(colorOptionName, 'color');
    let sizeIndex = findOptionIndex(sizeOptionName, 'size');

    if (sizeIndex === -1) {
      sizeIndex = optionNames.findIndex((name, index) => index !== colorIndex);
    }

    let selectedColor = requireExplicitVariantSelection ? '' : (defaultColor || '');
    let selectedSize = '';

    function getColorBlock(colorValue) {
      return colorBlocks.find(block => {
        return lower(block.option_value) === lower(colorValue) || lower(block.display_name) === lower(colorValue);
      });
    }

    function parseProductMediaAlt(altText) {
      const parts = String(altText || '').split('|').map(part => part.trim());
      if (parts.length !== 3 || lower(parts[0]) !== 'lp') return null;

      return {
        color: parts[1],
        shot: normalizeMediaShotName(parts[2])
      };
    }

    function normalizeMediaShotName(value) {
      const shot = normalizeColorName(value);
      const compactShot = shot.replace(/[^a-z0-9]/g, '');

      if (showInitialMediaPreview && compactShot.includes('front')) return 'front';
      if (showInitialMediaPreview && compactShot.includes('side')) return 'side';
      if (showInitialMediaPreview && compactShot.includes('back')) return 'back';

      if (showInitialMediaPreview && ['close up', 'closeup', 'close', 'fabric', 'fabric detail', 'fabric details', 'fabric shot', 'detail', 'details'].includes(shot)) {
        return 'fabric close up';
      }

      return shot;
    }

    function getProductMediaShotMapForColor(colorValue, block, shotOrder = lpShotOrder) {
      const colorNames = [colorValue, block && block.option_value, block && block.display_name]
        .filter(Boolean)
        .map(value => lower(value));
      const uniqueColorNames = [...new Set(colorNames)];
      const allowedShots = new Set(shotOrder);
      const images = {};

      productMedia.forEach(item => {
        const parsed = parseProductMediaAlt(item.alt);
        if (!parsed || !item.src) return;
        if (!uniqueColorNames.includes(lower(parsed.color))) return;
        if (!allowedShots.has(parsed.shot) || images[parsed.shot]) return;

        images[parsed.shot] = item.src;
      });

      return images;
    }

    function getProductMediaImagesForColor(colorValue, block, shotOrder = lpShotOrder) {
      const imageMap = getProductMediaShotMapForColor(colorValue, block, shotOrder);

      return shotOrder.map(shot => imageMap[shot]).filter(Boolean);
    }

    function getManualFitImageMapForBlock(block) {
      if (!block) return {};

      return {
        front: block.image_1,
        side: block.image_2,
        back: block.image_3
      };
    }

    function mediaTextHasShotCue(value, shot) {
      const compact = compactMediaName(value);

      if (shot === 'front') return compact.includes('front');
      if (shot === 'side') return compact.includes('side');
      if (shot === 'back') return compact.includes('back');

      return false;
    }

    function getFlexibleFitImageMapForColor(colorValue, block) {
      if (!showInitialMediaPreview || !colorValue) return {};

      const fitShotOrder = ['front', 'side', 'back'];
      const images = {};

      fitShotOrder.forEach(shot => {
        const matchedMedia = productMedia.find(item => {
          const mediaText = `${item.alt || ''} ${item.src || ''}`;
          return item.src && mediaTextMatchesColor(mediaText, colorValue, block) && mediaTextHasShotCue(mediaText, shot);
        });

        if (matchedMedia) images[shot] = matchedMedia.src;
      });

      const colorGalleryImages = getImagesForColor(colorValue);
      fitShotOrder.forEach((shot, index) => {
        if (!images[shot] && colorGalleryImages[index]) {
          images[shot] = colorGalleryImages[index];
        }
      });

      return images;
    }

    function getFitImageMapForColor(colorValue) {
      const fitShotOrder = ['front', 'side', 'back'];
      const block = getColorBlock(colorValue);
      const defaultBlock = getColorBlock(defaultColor);
      const selectedMediaImages = getProductMediaShotMapForColor(colorValue, block, fitShotOrder);
      const selectedManualImages = getManualFitImageMapForBlock(block);
      const selectedFlexibleImages = getFlexibleFitImageMapForColor(colorValue, block);
      const defaultMediaImages = lower(colorValue) === lower(defaultColor)
        ? {}
        : getProductMediaShotMapForColor(defaultColor, defaultBlock, fitShotOrder);
      const defaultManualImages = lower(colorValue) === lower(defaultColor)
        ? {}
        : getManualFitImageMapForBlock(defaultBlock);

      return fitShotOrder.reduce((images, shot) => {
        images[shot] = selectedMediaImages[shot] ||
          selectedManualImages[shot] ||
          selectedFlexibleImages[shot] ||
          defaultMediaImages[shot] ||
          defaultManualImages[shot] ||
          '';
        return images;
      }, {});
    }

    function compactMediaName(value) {
      return normalizeColorName(value).replace(/[^a-z0-9]/g, '');
    }

    function mediaTextHasFabricCue(value) {
      const compact = compactMediaName(value);
      return compact.includes('fabric') ||
        compact.includes('closeup') ||
        compact.includes('detail') ||
        compact.includes('texture');
    }

    function mediaTextMatchesColor(value, colorValue, block) {
      const text = compactMediaName(value);
      const colorNames = [colorValue, block && block.option_value, block && block.display_name]
        .filter(Boolean)
        .map(compactMediaName);

      return colorNames.some(colorName => colorName && text.includes(colorName));
    }

    function getFlexibleFabricCloseupForColor(colorValue, block) {
      if (!showInitialMediaPreview || !colorValue) return '';

      const matchedMedia = productMedia.find(item => {
        const mediaText = `${item.alt || ''} ${item.src || ''}`;
        return item.src && mediaTextMatchesColor(mediaText, colorValue, block) && mediaTextHasFabricCue(mediaText);
      });

      if (matchedMedia) return matchedMedia.src;

      const colorGalleryImages = getImagesForColor(colorValue);
      return colorGalleryImages[4] || '';
    }

    function getFabricCloseupForColor(colorValue) {
      const block = getColorBlock(colorValue);
      const fabricImages = getProductMediaImagesForColor(colorValue, block, ['fabric close up']);

      return fabricImages[0] ||
        getFlexibleFabricCloseupForColor(colorValue, block) ||
        (showInitialMediaPreview && block ? block.image_5 : '') ||
        getFirstAvailableFabricCloseup();
    }

    function getFirstAvailableFabricCloseup() {
      const variantColors = getAvailableColorsFromVariants();
      const sourceColors = colorBlocks.length ? colorBlocks.map(block => block.option_value) : variantColors;
      const uniqueColors = [...new Set(sourceColors.filter(Boolean))];

      for (const colorValue of uniqueColors) {
        const block = getColorBlock(colorValue);
        const fabricImages = getProductMediaImagesForColor(colorValue, block, ['fabric close up']);

        if (fabricImages[0]) return fabricImages[0];
        if (showInitialMediaPreview && block && block.image_5) return block.image_5;
      }

      return fallbackImage || '';
    }

    function getAvailableColorsFromVariants() {
      if (colorIndex === -1) return [];
      return [...new Set(variants.map(variant => variant.options[colorIndex]).filter(Boolean))];
    }

    function getAvailableSizesForColor(colorValue) {
      if (sizeIndex === -1) return [];

      const sizes = [];

      variants.forEach(variant => {
        const variantColor = colorIndex === -1 ? null : variant.options[colorIndex];
        const variantSize = variant.options[sizeIndex];

        if (!variantSize) return;

        if (colorIndex === -1 || !colorValue || lower(variantColor) === lower(colorValue)) {
          if (!sizes.includes(variantSize)) sizes.push(variantSize);
        }
      });

      return sizes;
    }

    function findVariant() {
      if (requireExplicitVariantSelection && (!selectedColor || !selectedSize)) {
        return null;
      }

      let match = variants.find(variant => {
        const colorMatches = colorIndex === -1 || lower(variant.options[colorIndex]) === lower(selectedColor);
        const sizeMatches = sizeIndex === -1 || lower(variant.options[sizeIndex]) === lower(selectedSize);
        return colorMatches && sizeMatches && variant.available;
      });

      if (match) return match;

      match = variants.find(variant => {
        const colorMatches = colorIndex === -1 || lower(variant.options[colorIndex]) === lower(selectedColor);
        const sizeMatches = sizeIndex === -1 || lower(variant.options[sizeIndex]) === lower(selectedSize);
        return colorMatches && sizeMatches;
      });

      return requireExplicitVariantSelection ? (match || null) : (match || variants[0]);
    }

    function getImagesForColor(colorValue) {
      const block = getColorBlock(colorValue);
      const productMediaImages = getProductMediaImagesForColor(colorValue, block);

      if (productMediaImages.length > 0) return productMediaImages;

      const orderedImageKeys = ['image_1', 'image_2', 'image_3', 'image_4', 'image_5'];
      const orderedImages = block
        ? orderedImageKeys.map(key => block[key]).filter(Boolean)
        : [];
      const legacyImages = block && Array.isArray(block.images) ? block.images.filter(Boolean) : [];
      const images = orderedImages.length ? orderedImages : legacyImages;

      if (images.length > 0) return images;

      const selectedVariantImage = findVariant();

      if (
        selectedVariantImage &&
        selectedVariantImage.featured_image &&
        (colorIndex === -1 || lower(selectedVariantImage.options[colorIndex]) === lower(colorValue))
      ) {
        return [selectedVariantImage.featured_image];
      }

      const variant = variants.find(item => {
        return colorIndex !== -1 && lower(item.options[colorIndex]) === lower(colorValue) && item.featured_image;
      });

      if (variant && variant.featured_image) return [variant.featured_image];

      return fallbackImage ? [fallbackImage] : [];
    }

    function uniqueImages(images) {
      return [...new Set(images.filter(Boolean))];
    }

    function getInitialGalleryImages() {
      const previewColor = getInitialPreviewColor();

      if (previewColor) {
        const previewImages = getImagesForColor(previewColor);

        if (previewImages.length > 0) return previewImages;
      }

      const blockImages = uniqueImages(
        colorBlocks.flatMap(block => {
          const orderedImageKeys = ['image_1', 'image_2', 'image_3', 'image_4', 'image_5'];
          const orderedImages = orderedImageKeys.map(key => block[key]);
          const legacyImages = Array.isArray(block.images) ? block.images : [];

          return orderedImages.concat(legacyImages);
        })
      );

      if (blockImages.length > 0) return blockImages;

      const variantImages = uniqueImages(variants.map(variant => variant.featured_image));

      if (variantImages.length > 0) return variantImages;

      return fallbackImage ? [fallbackImage] : [];
    }

    function getInitialPreviewColor() {
      return getAvailableColorsFromVariants()[0] || colorBlocks[0]?.option_value || defaultColor || '';
    }

    function renderInitialSlider() {
      const images = getInitialGalleryImages();

      slider.innerHTML = images.map((src, index) => `
        <div class="kasya-product-hero__slide">
          <img
            src="${src}"
            alt="{{ lp_product.title | escape }} ${index + 1}"
            width="1400"
            height="1750"
            loading="${index === 0 ? 'eager' : 'lazy'}"
          >
        </div>
      `).join('');

      dots.innerHTML = images.map((_, index) => `
        <button
          type="button"
          class="kasya-product-hero__dot ${index === 0 ? 'is-active' : ''}"
          aria-label="Go to image ${index + 1}"
          data-dot-index="${index}"
        ></button>
      `).join('');

      slider.scrollTo({ left: 0, behavior: 'auto' });
      updateCarouselControls();
    }

    function renderSlider(colorValue) {
      const images = getImagesForColor(colorValue);

      slider.innerHTML = images.map((src, index) => `
        <div class="kasya-product-hero__slide">
          <img
            src="${src}"
            alt="{{ lp_product.title | escape }} ${index + 1}"
            width="1400"
            height="1750"
            loading="${index === 0 ? 'eager' : 'lazy'}"
          >
        </div>
      `).join('');

      dots.innerHTML = images.map((_, index) => `
        <button
          type="button"
          class="kasya-product-hero__dot ${index === 0 ? 'is-active' : ''}"
          aria-label="Go to image ${index + 1}"
          data-dot-index="${index}"
        ></button>
      `).join('');

      slider.scrollTo({ left: 0, behavior: 'auto' });
      updateCarouselControls();
    }

    function getCurrentSlideIndex() {
      const slides = slider.querySelectorAll('.kasya-product-hero__slide');
      if (!slides.length || !slider.clientWidth) return 0;

      return Math.min(slides.length - 1, Math.max(0, Math.round(slider.scrollLeft / slider.clientWidth)));
    }

    function updateCarouselControls() {
      const slides = slider.querySelectorAll('.kasya-product-hero__slide');
      const hasMultipleImages = slides.length > 1;

      if (prevButton) {
        prevButton.hidden = !hasMultipleImages;
      }

      if (nextButton) {
        nextButton.hidden = !hasMultipleImages;
      }
    }

    function scrollToSlide(index) {
      const slides = slider.querySelectorAll('.kasya-product-hero__slide');
      if (!slides.length) return;

      const targetIndex = (index + slides.length) % slides.length;

      slider.scrollTo({
        left: slider.clientWidth * targetIndex,
        behavior: 'smooth'
      });
    }

    function updateDots() {
      const slides = slider.querySelectorAll('.kasya-product-hero__slide');
      if (!slides.length) return;

      const index = getCurrentSlideIndex();

      dots.querySelectorAll('.kasya-product-hero__dot').forEach((dot, dotIndex) => {
        dot.classList.toggle('is-active', dotIndex === index);
      });

      updateCarouselControls();
    }

    function renderColors() {
      const variantColors = getAvailableColorsFromVariants();
      const sourceColors = colorBlocks.length ? colorBlocks.map(block => block.option_value) : variantColors;
      const uniqueColors = [...new Set(sourceColors.filter(Boolean))];

      colorSwatchesContainer.innerHTML = uniqueColors.map(colorValue => {
        const block = getColorBlock(colorValue);
        const displayName = block ? block.display_name : colorValue;
        const swatch = getSwatchColor(block, displayName, colorValue);

        return `
          <button
            type="button"
            class="kasya-product-hero__swatch"
            style="--swatch: ${swatch};"
            aria-label="${displayName}"
            title="${displayName}"
            data-color-value="${colorValue}"
            data-color-display="${displayName}"
          ></button>
        `;
      }).join('');
    }

    function isSizeAvailable(sizeValue) {
      return variants.some(variant => {
        const colorMatches = colorIndex === -1 || !selectedColor || lower(variant.options[colorIndex]) === lower(selectedColor);
        const sizeMatches = sizeIndex === -1 || lower(variant.options[sizeIndex]) === lower(sizeValue);
        return colorMatches && sizeMatches && variant.available;
      });
    }

    function renderSizes() {
      const sizes = getAvailableSizesForColor(selectedColor);

      if (!sizes.length) {
        sizeOptionsContainer.innerHTML = '';
        return;
      }

      if (!requireExplicitVariantSelection && (!selectedSize || !sizes.includes(selectedSize))) {
        const firstAvailableSize = sizes.find(size => isSizeAvailable(size));
        selectedSize = firstAvailableSize || sizes[0];
      } else if (requireExplicitVariantSelection && selectedSize && !sizes.includes(selectedSize)) {
        selectedSize = '';
      }

      sizeOptionsContainer.innerHTML = sizes.map(size => {
        const available = isSizeAvailable(size);

        return `
          <button
            type="button"
            class="kasya-product-hero__size ${selectedSize && lower(size) === lower(selectedSize) ? 'is-selected' : ''} ${available ? '' : 'is-disabled'}"
            data-size-value="${size}"
            ${available ? '' : 'aria-disabled="true"'}
          >
            ${size}
          </button>
        `;
      }).join('');
    }

    function updateSelectedClasses() {
      section.querySelectorAll('[data-color-value]').forEach(button => {
        button.classList.toggle('is-selected', Boolean(selectedColor) && lower(button.dataset.colorValue) === lower(selectedColor));
      });

      section.querySelectorAll('[data-size-value]').forEach(button => {
        button.classList.toggle('is-selected', Boolean(selectedSize) && lower(button.dataset.sizeValue) === lower(selectedSize));
      });
    }

    function updateSelectionLabels() {
      const block = getColorBlock(selectedColor);
      const displayColor = String((block && block.display_name) || selectedColor || '');

      if (selectedColorText) {
        selectedColorText.textContent = displayColor ? displayColor.toUpperCase() : 'Please select';
        selectedColorText.classList.toggle('is-required', !displayColor);
      }

      if (selectedSizeText) {
        selectedSizeText.textContent = selectedSize || 'Please select';
        selectedSizeText.classList.toggle('is-required', !selectedSize);
      }
    }

    function updateVariantState() {
      const variant = findVariant();

      if (!variant) {
        variantInput.value = '';
        variantInput.disabled = true;
        updateSelectionLabels();

        if (submitButton && submitText) {
          submitButton.disabled = true;
          submitButton.setAttribute('aria-disabled', 'true');
          submitText.textContent = ctaText;
        }

        if (stickyAtc && stickyContext) {
          const colorLabel = selectedColor ? String(selectedColor).toUpperCase() : 'Please select';
          const sizeLabel = selectedSize ? String(selectedSize).toUpperCase() : 'Please select';
          stickyContext.textContent = `COLOR: ${colorLabel} / SIZE: ${sizeLabel}`;
        }

        if (stickySubmitButton && stickySubmitText) {
          stickySubmitButton.disabled = true;
          stickySubmitButton.setAttribute('aria-disabled', 'true');
          stickySubmitText.textContent = ctaText;
        }

        return;
      }

      variantInput.value = variant.id;
      variantInput.disabled = false;
      priceEl.textContent = variant.price;
      updateSelectionLabels();

      if (stickyAtc && stickyContext) {
        const block = getColorBlock(selectedColor);
        const displayColor = String((block && block.display_name) || selectedColor || '').toUpperCase();
        const displaySize = selectedSize ? ` / ${String(selectedSize).toUpperCase()}` : '';
        stickyContext.textContent = `${displayColor}${displaySize} — ${variant.price}`;
      }

      if (variant.available) {
        submitButton.disabled = false;
        submitButton.removeAttribute('aria-disabled');
        submitText.textContent = ctaText;

        if (stickySubmitButton && stickySubmitText) {
          stickySubmitButton.disabled = false;
          stickySubmitButton.removeAttribute('aria-disabled');
          stickySubmitText.textContent = ctaText;
        }
      } else {
        submitButton.disabled = true;
        submitButton.setAttribute('aria-disabled', 'true');
        submitText.textContent = 'SOLD OUT';

        if (stickySubmitButton && stickySubmitText) {
          stickySubmitButton.disabled = true;
          stickySubmitButton.setAttribute('aria-disabled', 'true');
          stickySubmitText.textContent = 'SOLD OUT';
        }
      }
    }

    function announceSelectedColor() {
      const block = getColorBlock(selectedColor);
      const displayColor = String((block && block.display_name) || selectedColor || '');
      const colorState = {
        color: selectedColor,
        displayColor,
        images: getFitImageMapForColor(selectedColor),
        fabricCloseup: getFabricCloseupForColor(selectedColor),
        featuredImage: fallbackImage
      };

      window.KasyaLPSelectedColor = colorState;
      document.dispatchEvent(new CustomEvent('kasya:hero-color-change', {
        detail: colorState
      }));
    }

    function announceInitialMediaPreview() {
      if (!showInitialMediaPreview || selectedColor) return;

      const previewColor = getInitialPreviewColor();
      if (!previewColor) return;

      const block = getColorBlock(previewColor);
      const displayColor = String((block && block.display_name) || previewColor || '');
      const colorState = {
        color: '',
        previewColor,
        displayColor,
        images: getFitImageMapForColor(previewColor),
        fabricCloseup: getFabricCloseupForColor(previewColor),
        featuredImage: fallbackImage
      };

      window.KasyaLPSelectedColor = colorState;
      document.dispatchEvent(new CustomEvent('kasya:hero-color-change', {
        detail: colorState
      }));
    }

    function initializeStickyVisibility() {
      if (!stickyAtc || !submitButton) return;

      const setStickyVisibility = isVisible => {
        stickyAtc.classList.toggle('is-visible', isVisible);
      };

      if (!('IntersectionObserver' in window)) {
        const updateFromScroll = () => {
          const rect = submitButton.getBoundingClientRect();
          setStickyVisibility(rect.bottom <= 0);
        };

        updateFromScroll();
        window.addEventListener('scroll', updateFromScroll, { passive: true });
        window.addEventListener('resize', updateFromScroll);
        return;
      }

      const observer = new IntersectionObserver(entries => {
        const entry = entries[0];
        const buttonAboveViewport = entry.boundingClientRect.bottom <= 0;
        setStickyVisibility(!entry.isIntersecting && buttonAboveViewport);
      }, {
        threshold: 0
      });

      observer.observe(submitButton);
    }

    function selectColor(colorValue) {
      selectedColor = colorValue;

      renderSlider(selectedColor);
      renderSizes();
      updateSelectedClasses();
      updateVariantState();
      announceSelectedColor();
    }

    function selectSize(sizeValue) {
      selectedSize = sizeValue;
      updateSelectedClasses();
      updateVariantState();
    }

    function initializeDefaultSelection() {
      if (requireExplicitVariantSelection) {
        selectedColor = '';
        selectedSize = '';
        return;
      }

      const variantColors = getAvailableColorsFromVariants();
      const hasDefaultVariantColor = variantColors.some(color => lower(color) === lower(defaultColor));
      const hasDefaultBlock = colorBlocks.some(block => lower(block.option_value) === lower(defaultColor));

      if (defaultColor && (hasDefaultVariantColor || hasDefaultBlock)) {
        selectedColor = defaultColor;
      } else if (variantColors.length) {
        selectedColor = variantColors[0];
      } else if (colorBlocks.length) {
        selectedColor = colorBlocks[0].option_value;
      }

      const sizes = getAvailableSizesForColor(selectedColor);
      const firstAvailableSize = sizes.find(size => isSizeAvailable(size));

      selectedSize = firstAvailableSize || sizes[0] || '';
    }

    renderColors();
    initializeDefaultSelection();
    if (selectedColor) {
      selectColor(selectedColor);
    } else {
      renderInitialSlider();
      renderSizes();
      updateSelectedClasses();
      updateVariantState();
      announceInitialMediaPreview();
    }
    initializeStickyVisibility();

    colorSwatchesContainer.addEventListener('click', event => {
      const button = event.target.closest('[data-color-value]');
      if (!button) return;

      selectColor(button.dataset.colorValue);
    });

    sizeOptionsContainer.addEventListener('click', event => {
      const button = event.target.closest('[data-size-value]');
      if (!button || button.classList.contains('is-disabled')) return;

      selectSize(button.dataset.sizeValue);
    });

    slider.addEventListener('scroll', () => {
      window.requestAnimationFrame(updateDots);
    });

    if (prevButton) {
      prevButton.addEventListener('click', () => {
        scrollToSlide(getCurrentSlideIndex() - 1);
      });
    }

    if (nextButton) {
      nextButton.addEventListener('click', () => {
        scrollToSlide(getCurrentSlideIndex() + 1);
      });
    }

    dots.addEventListener('click', event => {
      const dot = event.target.closest('[data-dot-index]');
      if (!dot) return;

      const index = Number(dot.dataset.dotIndex);
      scrollToSlide(index);
    });

    if (sizeChartToggle && sizeChartPanel) {
      sizeChartToggle.addEventListener('click', () => {
        const isExpanded = sizeChartToggle.getAttribute('aria-expanded') === 'true';

        sizeChartToggle.setAttribute('aria-expanded', String(!isExpanded));
        sizeChartPanel.hidden = isExpanded;

        if (!isExpanded && sizeChartImage && !sizeChartImage.getAttribute('src')) {
          sizeChartImage.setAttribute('src', sizeChartImage.dataset.sizeChartSrc);
        }

        if (sizeChartToggleText) {
          sizeChartToggleText.textContent = isExpanded ? sizeChartTriggerText : sizeChartHideText;
        }
      });
    }

    if (reviewsLink) {
      reviewsLink.addEventListener('click', event => {
        const reviewsSection = document.querySelector(reviewsLink.getAttribute('href'));
        if (!reviewsSection || !('scrollBehavior' in document.documentElement.style)) return;

        event.preventDefault();
        reviewsSection.scrollIntoView({
          behavior: 'smooth',
          block: 'start'
        });
      });
    }
  })();
</script>

