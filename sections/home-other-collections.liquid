{{ 'homepage-custom.css' | asset_url | stylesheet_tag }}

<style>
  #shopify-section-{{ section.id }} {
    padding-top: 3.2rem;
    background-color: #000000;
    background-image:
      radial-gradient(circle at 88% 18%, rgba(255, 255, 255, 0.1), rgba(255, 255, 255, 0.03) 28%, transparent 55%),
      linear-gradient(90deg, #000000 0%, #080808 45%, #1b1b1b 100%);
  }

  #shopify-section-{{ section.id }} .home-other-collections {
    background-color: #000000;
    background-image:
      radial-gradient(circle at 88% 18%, rgba(255, 255, 255, 0.12), rgba(255, 255, 255, 0.04) 28%, transparent 55%),
      linear-gradient(90deg, #000000 0%, #080808 45%, #1b1b1b 100%);
    color: #ffffff;
  }

  #shopify-section-{{ section.id }} .home-other-collections .home-editorial__inner {
    width: 100%;
    max-width: none;
    padding: 3.8rem 0 0;
  }

  #shopify-section-{{ section.id }} .home-other-collections__header {
    display: block;
    margin: 0;
    padding: 0 2.2rem 2.8rem;
  }

  #shopify-section-{{ section.id }} .home-other-collections__header::after {
    content: "";
    display: block;
    width: 13rem;
    height: 0.1rem;
    margin-top: 1.8rem;
    background: rgba(255, 255, 255, 0.72);
  }

  #shopify-section-{{ section.id }} .home-other-collections__header .home-editorial__kicker,
  #shopify-section-{{ section.id }} .home-other-collections__header .home-editorial__copy {
    display: none;
  }

  #shopify-section-{{ section.id }} .home-other-collections__heading {
    margin: 0;
    max-width: 24rem;
    color: #ffffff;
    font-family: "Helvetica Now Condensed", "Helvetica Neue Condensed", Helvetica, Arial, sans-serif;
    font-size: clamp(3.4rem, 10vw, 5.2rem);
    font-weight: 800;
    letter-spacing: 0;
    line-height: 1.04;
  }

  #shopify-section-{{ section.id }} .home-other-collections__grid {
    display: grid;
    gap: 0;
  }

  #shopify-section-{{ section.id }} .home-other-collections__card {
    position: relative;
    display: block;
    min-height: 13.6rem;
    overflow: hidden;
    background: #101010;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .home-other-collections__card .home-media,
  #shopify-section-{{ section.id }} .home-other-collections__card .home-media--empty {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 13.6rem;
  }

  #shopify-section-{{ section.id }} .home-other-collections__card img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #shopify-section-{{ section.id }} .home-other-collections__card::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(0,0,0,0.42), rgba(0,0,0,0.18), rgba(0,0,0,0.42));
  }

  #shopify-section-{{ section.id }} .home-other-collections__card-content {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.6rem;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .home-other-collections__title {
    display: block;
    margin: 0;
    color: #ffffff;
    font-family: "Helvetica Now Condensed", "Helvetica Neue Condensed", Helvetica, Arial, sans-serif;
    font-size: clamp(2.5rem, 7vw, 3.8rem);
    font-style: italic;
    font-weight: 400;
    letter-spacing: 0;
    line-height: 1;
  }

  #shopify-section-{{ section.id }} .home-other-collections__label {
    display: none;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} {
      padding-top: 4.8rem;
    }

    #shopify-section-{{ section.id }} .home-other-collections .home-editorial__inner {
      padding-top: 5.2rem;
    }

    #shopify-section-{{ section.id }} .home-other-collections__header {
      padding: 0 5.6rem 3.4rem;
    }

    #shopify-section-{{ section.id }} .home-other-collections__heading {
      max-width: 34rem;
      font-size: clamp(4.4rem, 4.5vw, 6.4rem);
    }

    #shopify-section-{{ section.id }} .home-other-collections__card,
    #shopify-section-{{ section.id }} .home-other-collections__card .home-media,
    #shopify-section-{{ section.id }} .home-other-collections__card .home-media--empty {
      min-height: 18rem;
    }
  }
</style>

<section class="home-editorial home-other-collections" style="--home-collections-columns: {{ section.settings.columns_desktop }};">
  <div class="home-editorial__inner">
    <div class="home-other-collections__header">
      {%- if section.settings.heading != blank -%}
        <h2 class="home-other-collections__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
    </div>

    <div class="home-other-collections__grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign collection = block.settings.collection
          assign card_image = block.settings.image | default: collection.image
          assign card_title = block.settings.title | default: collection.title | default: 'Collection'
          assign card_link = block.settings.link | default: collection.url | default: '#'
        -%}
        <a class="home-other-collections__card" href="{{ card_link }}" {{ block.shopify_attributes }}>
          {%- if card_image != blank -%}
            <span class="home-media">
              {{ card_image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '375, 550, 750, 900, 1200', alt: card_title }}
            </span>
          {%- else -%}
            <span class="home-media home-media--empty"></span>
          {%- endif -%}
          <span class="home-other-collections__card-content">
            <span class="home-other-collections__title">{{ card_title | escape }}</span>
            <span class="home-other-collections__label">{{ block.settings.label | escape }}</span>
          </span>
        </a>
      {%- else -%}
        {%- assign fallback_titles = 'Summer Collection|Everyday Edit|Premiere Collection' | split: '|' -%}
        {%- for fallback_title in fallback_titles -%}
          <a class="home-other-collections__card" href="#">
            <span class="home-media home-media--empty"></span>
            <span class="home-other-collections__card-content">
              <span class="home-other-collections__title">{{ fallback_title }}</span>
              <span class="home-other-collections__label">Explore now</span>
            </span>
          </a>
        {%- endfor -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Home other collections",
  "tag": "section",
  "class": "section-home-other-collections",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Keep exploring" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Other Collections" },
    { "type": "richtext", "id": "copy", "label": "Copy", "default": "<p>Move through the edits by mood, fabric, or occasion.</p>" },
    { "type": "range", "id": "columns_desktop", "label": "Desktop columns", "min": 2, "max": 4, "step": 1, "default": 3 }
  ],
  "blocks": [
    {
      "type": "collection_card",
      "name": "Collection card",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "image_picker", "id": "image", "label": "Custom image" },
        { "type": "text", "id": "title", "label": "Custom title" },
        { "type": "text", "id": "label", "label": "Small label", "default": "Explore now" },
        { "type": "url", "id": "link", "label": "Custom link" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Home other collections",
      "blocks": [
        {
          "type": "collection_card",
          "settings": { "title": "Summer Collection" }
        },
        {
          "type": "collection_card",
          "settings": { "title": "Everyday Edit" }
        },
        {
          "type": "collection_card",
          "settings": { "title": "Premiere Collection" }
        }
      ]
    }
  ]
}
{% endschema %}
