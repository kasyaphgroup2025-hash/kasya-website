{{ 'section-footer.css' | asset_url | stylesheet_tag }}

<footer class="kasya-footer" data-section-id="{{ section.id }}">
  <div class="kasya-footer__inner">
    <div class="kasya-footer__main{% unless section.settings.show_newsletter %} kasya-footer__main--without-newsletter{% endunless %}">
      {%- if section.settings.show_newsletter -%}
        <section
          class="kasya-footer__newsletter"
          {% if section.settings.newsletter_heading != blank %}aria-labelledby="KasyaFooterNewsletterHeading-{{ section.id }}"{% endif %}
        >
          {%- if section.settings.newsletter_heading != blank -%}
            <h2 id="KasyaFooterNewsletterHeading-{{ section.id }}" class="kasya-footer__newsletter-heading">
              {{- section.settings.newsletter_heading | escape -}}
            </h2>
          {%- endif -%}

          {%- if section.settings.newsletter_text != blank -%}
            <p class="kasya-footer__newsletter-text">{{ section.settings.newsletter_text | escape }}</p>
          {%- endif -%}

          {%- form 'customer', id: 'KasyaFooterNewsletter', class: 'kasya-footer__newsletter-form' -%}
            <input type="hidden" name="contact[tags]" value="newsletter">

            {%- if form.errors -%}
              <p class="kasya-footer__form-message kasya-footer__form-message--error" id="KasyaFooterNewsletterError-{{ section.id }}">
                {{- form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email -}}
              </p>
            {%- endif -%}

            {%- if form.posted_successfully? -%}
              <p class="kasya-footer__form-message kasya-footer__form-message--success" id="KasyaFooterNewsletterSuccess-{{ section.id }}" tabindex="-1">
                {{- 'newsletter.success' | t -}}
              </p>
            {%- endif -%}

            <div class="kasya-footer__newsletter-fields">
              <div class="kasya-footer__newsletter-field">
                <label class="visually-hidden" for="KasyaFooterEmail-{{ section.id }}">{{ 'newsletter.label' | t }}</label>
                <input
                  id="KasyaFooterEmail-{{ section.id }}"
                  class="kasya-footer__newsletter-input"
                  type="email"
                  name="contact[email]"
                  value="{{ form.email }}"
                  autocomplete="email"
                  autocorrect="off"
                  autocapitalize="off"
                  aria-required="true"
                  {% if form.errors %}
                    autofocus
                    aria-invalid="true"
                    aria-describedby="KasyaFooterNewsletterError-{{ section.id }}"
                  {% elsif form.posted_successfully? %}
                    aria-describedby="KasyaFooterNewsletterSuccess-{{ section.id }}"
                  {% endif %}
                  placeholder="Email address"
                  required
                >
              </div>
              <button class="kasya-footer__newsletter-button" type="submit" name="commit">
                Sign Up
              </button>
            </div>
          {%- endform -%}
        </section>
      {%- endif -%}

      <nav class="kasya-footer__navigation" aria-label="Footer navigation">
        <ul class="kasya-footer__links" role="list">
          {%- if section.settings.footer_menu != blank -%}
            {%- for link in section.settings.footer_menu.links -%}
              <li>
                <a class="kasya-footer__link" href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>
                  {{- link.title | escape -}}
                </a>
              </li>
            {%- endfor -%}
          {%- else -%}
            {%- for block in section.blocks -%}
              {%- if block.type == 'footer_link' and block.settings.label != blank and block.settings.link != blank -%}
                <li {{ block.shopify_attributes }}>
                  <a class="kasya-footer__link" href="{{ block.settings.link }}">
                    {{- block.settings.label | escape -}}
                  </a>
                </li>
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}
        </ul>
      </nav>

      <div class="kasya-footer__right">
        <div class="kasya-footer__social" role="group" aria-label="Connect with Kasya">
          {%- assign footer_facebook_url = section.settings.facebook_url | default: settings.social_facebook_link -%}
          {%- assign footer_tiktok_url = section.settings.tiktok_url | default: settings.social_tiktok_link -%}

          {%- if footer_facebook_url != blank -%}
            <a
              class="kasya-footer__social-link"
              href="{{ footer_facebook_url }}"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Visit Kasya on Facebook"
              data-no-instant
            >
              {%- render 'icon-facebook', icon_width: 24 -%}
            </a>
          {%- endif -%}

          {%- if footer_tiktok_url != blank -%}
            <a
              class="kasya-footer__social-link"
              href="{{ footer_tiktok_url }}"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Visit Kasya on TikTok"
              data-no-instant
            >
              {%- render 'icon-tiktok', icon_width: 24 -%}
            </a>
          {%- endif -%}

          {%- if section.settings.viber_url != blank -%}
            <a
              class="kasya-footer__social-link"
              href="{{ section.settings.viber_url }}"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Contact Kasya on Viber"
              data-no-instant
            >
              <svg
                class="kasya-footer__social-icon kasya-footer__social-icon--viber"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
                aria-hidden="true"
                focusable="false"
                role="presentation"
              >
                <path
                  d="M18.2 2.9c-4.12-.76-8.28-.76-12.4 0A4.47 4.47 0 0 0 2.2 7.3v5.82a4.47 4.47 0 0 0 3.6 4.4l.77.14v3.47l4.2-3.22c2.49.1 4.97-.1 7.43-.55a4.47 4.47 0 0 0 3.6-4.4V7.3a4.47 4.47 0 0 0-3.6-4.4Z"
                  stroke="currentColor"
                  stroke-width="1.45"
                  stroke-linejoin="round"
                />
                <path
                  d="M7.6 7.2a.74.74 0 0 1 1.08.06L9.9 8.78c.23.29.22.7-.03.98l-.7.75a6.44 6.44 0 0 0 3.25 3.25l.75-.7a.75.75 0 0 1 .98-.03l1.52 1.22c.35.28.38.8.06 1.12l-.66.66c-.75.75-1.86 1-2.85.65a9.68 9.68 0 0 1-5.9-5.9c-.35-.99-.1-2.1.65-2.85l.63-.73Z"
                  fill="currentColor"
                />
                <path
                  d="M12.72 7.38a3.85 3.85 0 0 1 3.85 3.85M12.72 5.3a5.93 5.93 0 0 1 5.93 5.93"
                  stroke="currentColor"
                  stroke-width="1.3"
                  stroke-linecap="round"
                />
              </svg>
            </a>
          {%- endif -%}
        </div>

        <div class="kasya-footer__brand">
          {%- if section.settings.footer_logo != blank -%}
            <a class="kasya-footer__logo-link" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }} home">
              {{- section.settings.footer_logo
                | image_url: width: 600
                | image_tag:
                  class: 'kasya-footer__logo',
                  widths: '160, 240, 360, 480, 600',
                  sizes: '(min-width: 990px) 14vw, 180px',
                  loading: 'lazy',
                  alt: section.settings.footer_logo.alt | default: shop.name
              -}}
            </a>
          {%- endif -%}

          <small class="kasya-footer__copyright">
            &copy; {{ 'now' | date: '%Y' }}, <a href="{{ routes.root_url }}">{{ shop.name | escape }}</a>
            {%- if section.settings.show_powered_by_shopify %} {{ powered_by_link }}{% endif -%}
          </small>
        </div>
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Kasya footer",
  "max_blocks": 6,
  "settings": [
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "Show newsletter signup",
      "default": true
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Newsletter heading",
      "default": "Subscribe to our emails"
    },
    {
      "type": "textarea",
      "id": "newsletter_text",
      "label": "Newsletter supporting text",
      "default": "Be the first to know about new collections and exclusive offers."
    },
    {
      "type": "header",
      "content": "Navigation"
    },
    {
      "type": "link_list",
      "id": "footer_menu",
      "label": "Footer menu",
      "info": "When selected, this menu replaces the individual footer link blocks."
    },
    {
      "type": "header",
      "content": "Social links"
    },
    {
      "type": "paragraph",
      "content": "When left blank, Facebook and TikTok use the URLs configured in Theme settings > Social media."
    },
    {
      "type": "url",
      "id": "facebook_url",
      "label": "Facebook URL"
    },
    {
      "type": "url",
      "id": "tiktok_url",
      "label": "TikTok URL"
    },
    {
      "type": "url",
      "id": "viber_url",
      "label": "Viber URL"
    },
    {
      "type": "header",
      "content": "Brand"
    },
    {
      "type": "image_picker",
      "id": "footer_logo",
      "label": "Footer Kasya logo"
    },
    {
      "type": "checkbox",
      "id": "show_powered_by_shopify",
      "label": "Show Powered by Shopify",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "footer_link",
      "name": "Footer link",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Footer link"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Destination"
        }
      ]
    }
  ],
  "enabled_on": {
    "groups": ["footer"]
  }
}
{% endschema %}
