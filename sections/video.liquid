{%-liquid
  assign hide_section = false
  if section.settings.video_hosted == nil and section.settings.video_url == nil and section.settings.hide_when_empty_video and request.design_mode == false
    assign hide_section = true
  endif
-%}
{%- unless hide_section -%}
  {%-liquid
    assign video_ratio = '16 / 9'
    if section.settings.video_hosted != nil
      if section.settings.aspect_ratio == 'portrait'
        assign video_ratio = '4 / 5'
      elsif section.settings.aspect_ratio == 'square'
        assign video_ratio = '1 / 1'  
      elsif section.settings.aspect_ratio == 'adapt'
        assign video_ratio = section.settings.video_hosted.aspect_ratio
      endif
    endif
  -%}
  {{ 'video-section.css' | asset_url | stylesheet_tag }}
  {{ 'component-deferred-media.css' | asset_url | stylesheet_tag }}

  <style>
    .section-{{ section.id }}-padding {
      --aspect-ratio: {{ video_ratio }};
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    }

    @media screen and (min-width: 750px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }

    {%- render 'section-heading-styles' -%}
  </style>

  <div class="section-{{ section.id }}-padding {% unless section.settings.enable_section_box_layout %}color-{{ section.settings.color_scheme }} gradient{% else %}page-width{% if section.settings.full_width %}--full{% endif %}{% endunless %}">
    <div class="video-section isolate{% unless section.settings.enable_section_box_layout %}{% unless section.settings.full_width %} page-width{% endunless %}{% else %} section__box color-{{ section.settings.color_scheme }} gradient{% endunless %}">
      {%- unless section.settings.enable_section_box_layout -%}
        <div{% if section.settings.full_width %} class="page-width"{% endif %}>
          {%- render 'section-heading' -%}
        </div>
      {%- else -%}
        {%- render 'section-heading' -%}  
      {%- endunless -%}  
      
      {%- liquid
        assign video_from_url = false
        if section.settings.video_hosted == blank and section.settings.video_url != blank
          assign video_from_url = true
        endif
      -%}
      {% unless video_from_url %}
        {% render 'video',
          video_from_url: false,
          video: section.settings.video_hosted,
          video_autoplay: section.settings.autoplay,
          enable_sound: section.settings.enable_sound,
          video_loop: section.settings.enable_video_looping,
          enable_controls: section.settings.enable_controls,
          preview_image: section.settings.cover_image,
          is_full_width: section.settings.full_width,
          video_class: 'card-radius',
          button_class: 'global-settings-popup'
        %}
      {% else %}
        {% render 'video',
          video_from_url: true,
          video: section.settings.video_url.id,
          video_type: section.settings.video_url.type,
          video_autoplay: section.settings.autoplay,
          enable_sound: section.settings.enable_sound,
          video_loop: section.settings.enable_video_looping,
          enable_controls: section.settings.enable_controls,
          preview_image: section.settings.cover_image,
          is_full_width: section.settings.full_width,
          video_class: 'card-radius',
          button_class: 'global-settings-popup'
        %}
      {% endunless %}
    </div>
  </div>
{%- endunless -%}
{% schema %}
{
  "name": "t:sections.video.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "default": "Video",
      "label": "t:sections.video.settings.title.label"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "t:sections.video.settings.subtitle.label"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h0",
          "label": "t:sections.all.heading_size.options__3.label"
        }
      ],
      "default": "h1",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "image_picker",
      "id": "cover_image",
      "label": "t:sections.video.settings.cover_image.label"
    },
    {
      "type": "video",
      "id": "video_hosted",
      "label": "t:sections.video.settings.video_hosted.label",
      "info": "t:sections.video.settings.video_hosted.info"
    },
    {
      "type": "video_url",
      "id": "video_url",
      "accept": [
        "youtube",
        "vimeo"
      ],
      "default": "https://www.youtube.com/watch?v=_9VUPq3SxOc",
      "label": "t:sections.video.settings.video_url.label",
      "placeholder": "Use a YouTube or Vimeo URL",
      "info": "t:sections.video.settings.video_url.info"
    },
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "t:settings.aspect_ratio",
      "visible_if": "{{ section.settings.video_hosted != nil }}",
      "options": [
        {
          "value": "adapt",
          "label": "t:options.auto"
        },
        {
          "value": "square",
          "label": "t:sections.all.image_ratio.option_2.label"
        },
        {
          "value": "portrait",
          "label": "t:sections.all.image_ratio.option_3.label"
        },
        {
          "value": "landscape",
          "label": "t:sections.all.image_ratio.option_4.label"
        }
      ],
      "default": "adapt"
    },
    {
      "type": "text",
      "id": "description",
      "label": "t:sections.video.settings.description.label",
      "info": "t:sections.video.settings.description.info"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "t:sections.video.settings.autoplay.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "enable_sound",
      "label": "t:settings.enable_sound",
      "info": "t:info.sound_not_work_on_vimeo",
      "default": false,
      "visible_if": "{{ section.settings.autoplay == false }}"
    },
    {
      "type": "checkbox",
      "id": "enable_controls",
      "label": "t:sections.video.settings.enable_controls.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "enable_video_looping",
      "label": "t:sections.video.settings.enable_video_looping.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "t:sections.video.settings.full_width.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_when_empty_video",
      "label": "t:sections.video.settings.hide_when_empty_video.label",
      "info": "t:sections.video.settings.hide_when_empty_video.info",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "enable_section_box_layout",
      "label": "t:sections.all.enable_section_box_layout.label",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "background-1",
      "label": "t:sections.all.colors.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "t:sections.video.presets.name",
      "category": "t:categories.storytelling"
    }
  ]
}
{% endschema %}
