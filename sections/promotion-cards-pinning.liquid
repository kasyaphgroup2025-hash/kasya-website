{%- style -%}
  .pcp-wrapper--{{ section.id }} {
    --color-background-1: {{ section.settings.stage_1_background.red }},{{ section.settings.stage_1_background.green }},{{ section.settings.stage_1_background.blue }};
    --color-background-2: {{ section.settings.stage_2_background.red }},{{ section.settings.stage_2_background.green }},{{ section.settings.stage_2_background.blue }};
    --color-background-3: {{ section.settings.stage_3_background.red }},{{ section.settings.stage_3_background.green }},{{ section.settings.stage_3_background.blue }};
  }

  .section-{{ section.id }}-padding {
    --column-count: {{ section.settings.columns_mobile }};
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  {%- for block in section.blocks -%}
    .pcp__card--{{ section.id }}-{{ block.id }} {
      --color-foreground: {{ block.settings.text_color.red }},{{ block.settings.text_color.green }},{{ block.settings.text_color.blue }};
      --color-icon: {{ block.settings.icon_color.red }},{{ block.settings.icon_color.green }},{{ block.settings.icon_color.blue }};
      {%- if section.settings.enable_overlay -%}
        --color-overlay: {{ block.settings.overlay_color.red }},{{ block.settings.overlay_color.green }},{{ block.settings.overlay_color.blue }};
      {%- endif -%}  
    }
  {%- endfor -%}

  {%- if section.settings.caption != blank -%}
    .pcp__caption--{{ section.id }} {
      --color-foreground: {{ section.settings.caption_color.red }}, {{ section.settings.caption_color.green }}, {{ section.settings.caption_color.blue }};
    }
  {%- endif -%}

  {%- if section.settings.title != blank -%}
    .pcp__heading__text--{{ section.id }} {
      --color-foreground: {{ section.settings.title_color.red }}, {{ section.settings.title_color.green }}, {{ section.settings.title_color.blue }};
      {%- if section.settings.heading_italic_color != blank -%}
        --color-heading-italic: {{ section.settings.heading_italic_color }};
      {%- endif -%}  
    }
  {%- endif -%}

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      --column-count: {{ section.settings.columns_tablet }};
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
    {% unless section.settings.image_ratio_desktop == 'adapt' %}
      {% if section.settings.image_ratio_desktop != section.settings.image_ratio %}
        {% liquid
          assign ratio_percent_desktop = 100
          case section.settings.image_ratio_desktop
          when 'portrait'
            assign ratio_percent_desktop = 125
          when 'long-portrait'
            assign ratio_percent_desktop = 165
          when 'landscape'
            assign ratio_percent_desktop = 66.6
          endcase
        %}
        .pcp__card--{{ section.id }} .media {
          padding-bottom: {{ ratio_percent_desktop }}%;
        }
        {% if section.settings.image_ratio == 'adapt' %}
          .pcp__card--{{ section.id }} .media:before {
            display: none;
          }
        {% endif %}  
      {% endif %}  
    {% else %}
      {% if section.settings.image_ratio != 'adapt' %}
        .pcp__card--{{ section.id }} .media {
          display: flex;
          position: relative;
          align-items: stretch;
          padding-bottom: 0;
        }
        .pcp__card--{{ section.id }} .media:before {
          content: '';
          width: 0;
          height: 0;
        }
      {% endif %}
      {% for block in section.blocks %}
        {% if block.settings.image_mobile != blank or section.settings.image_ratio != 'adapt' %}
          {% liquid
            assign ratio_percent = 125
            if block.settings.image != blank
              assign ratio_percent = 1 | divided_by: block.settings.image.aspect_ratio | times: 100
            endif
          %}
          .pcp__card--{{ section.id }}-{{ block.id }} .media:before {
            padding-bottom: {{ ratio_percent }}%;
          }
        {% endif %}
      {% endfor %}    
    {% endunless %}
  }

  @media screen and (min-width: 990px) {
    .section-{{ section.id }}-padding {
      --column-count: {{ section.settings.columns_desktop }};
    }
  }

  {%- render 'section-heading-styles' -%}
{%- endstyle -%}

{{ 'section-promotion-cards-pinning.css' | asset_url | stylesheet_tag }}
{% unless request.design_mode %}
  <script src="{{ 'pinning-list.js' | asset_url }}" defer="defer"></script>
{% endunless %}
<div class="section-{{ section.id }}-padding">
  <div class="pcp-wrapper isolate pcp-wrapper--{{ section.id }}">
    <appear-animate-list class="pcp flex flex-column justify-center overflow-hidden" data-delay="0.3">
      <div class="page-width pcp__heading w100 {{ section.settings.heading_alignment }}{% if section.settings.enable_heading_animation %} pcp__heading--animation{% endif %}">
        {%- if section.settings.caption != blank -%}
          <div class="pcp__caption pcp__caption--{{ section.id }} caption-with-letter-spacing--medium font-body-semi-bold uppercase color-foreground appear-animate-item-in-list">
            {{ section.settings.caption }}
          </div>
        {%- endif -%} 
        {%- if section.settings.title != blank -%}
          <h2 class="pcp__heading__text pcp__heading__text--{{ section.id }} color-foreground font-heading-extra-bold lh1 {{ section.settings.heading_size }} margin0 appear-animate-item-in-list{% if section.settings.heading_italic_color != blank %} pcp__heading__text--has-italic-style{% endif %}{% if section.settings.caption != blank %} margin-top-1rem{% endif %}">
            {{ section.settings.title }}
          </h2>
        {%- endif -%}
      </div>
      <div class="por pcp__content overflow-hidden">
        <pinning-list class="db pcp__wrapper-list"{% if section.settings.enable_heading_animation %} data-heading-animation="true"{% endif %}>
          <ul class="pcp__list grid">
            {% for block in section.blocks %}
              <li class="pcp__item appear-animate-item-in-list">
                <div class="pcp__card por pcp__card--{{ section.id }} pcp__card--{{ section.id }}-{{ block.id }} overflow-hidden w100">
                  <div class="media media--transparent media--{{ section.settings.image_ratio }}{% if block.settings.image == blank %} placeholder{% endif %}{% if section.settings.image_ratio == 'adapt' %} ratio{% endif %}"{% if section.settings.image_ratio == 'adapt' %} style="--ratio-percent: {% if block.settings.image != blank %}{{ 1 | divided_by: block.settings.image.aspect_ratio | times: 100 }}{% else %}125{% endif %}%;"{% endif %}>
                    {%- if block.settings.image != blank -%}
                      {%- capture sizes -%}(min-width: 990px) {% if section.blocks.size <= 2 %}710px{% else %}550px{% endif %}, (min-width: 750px) {% if section.blocks.size == 1 %}710px{% else %}550px{% endif %}, calc(100vw - 30px){%- endcapture -%}
                      {%-liquid
                        assign image_classes = 'pcp__card__image'
                        if block.settings.image_mobile != blank
                          assign image_classes = image_classes | append: ' small-hide'
                        endif
                      -%}  
                      {{ block.settings.image | image_url: width: 1420 | image_tag:
                        loading: 'lazy',
                        sizes: sizes,
                        widths: '275, 550, 710, 1420',
                        class: image_classes
                      }}
                      {%- if block.settings.image_mobile != blank -%}
                        {{ block.settings.image_mobile | image_url: width: 1420 | image_tag:
                          loading: 'lazy',
                          sizes: '100vw',
                          widths: '275, 550, 750, 900',
                          class: 'pcp__card__image medium-hide large-up-hide'
                        }}
                      {%- endif -%}  
                    {%- else -%}
                      {{ 'detailed-apparel-1' | placeholder_svg_tag: 'placeholder-svg w100 h100 pcp__card__image' }}
                    {%- endif -%}  
                  </div>
                  <div class="pcp__card__content flex align-end{% if section.settings.enable_overlay %} pcp__card__content--has-overlay{% endif %}">
                    <div class="pcp__card__content-inner w100 flex justify-space-between align-center">
                      <div class="pcp__card__text">
                        <h3 class="pcp__card__title card__heading margin0 {{ section.settings.card_heading_size }}{% if section.settings.enable_bold_heading %} font-heading-extra-bold{% endif %}">
                          {%- if block.settings.link != blank -%}
                            <a href="{{ block.settings.link }}" class="full-unstyled-link">{{ block.settings.title }}</a>
                          {%- else -%}
                            {{ block.settings.title }}
                          {%- endif -%}
                        </h3>
                        {%- if block.settings.subtitle != blank -%}
                          <small class="pcp__card__subtitle color-foreground text-small db overflow-hidden">{{ block.settings.subtitle }}</small>
                        {%- endif -%}  
                      </div>
                      <span class="pcp__card__icon">
                        {% render 'icon-picker', icon: block.settings.icon, icon_width: 18 %}
                      </span>
                    </div>
                  </div>
                </div>
              </li>
            {% endfor %}  
          </ul>
        </pinning-list>
      </div>
    </appear-animate-list>
  </div>
</div>
