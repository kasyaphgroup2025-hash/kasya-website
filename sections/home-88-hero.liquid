{{ 'home-88.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign mobile_image = section.settings.mobile_image | default: section.settings.desktop_image
  assign desktop_image = section.settings.desktop_image | default: section.settings.mobile_image
  assign image_alt = section.settings.image_alt | escape
  assign secondary_button_link = section.settings.secondary_button_link | default: '#home-88-shop-the-look'
-%}

<section
  id="Home88Hero-{{ section.id }}"
  class="home-88-hero"
  data-home-88-hero
  style="--home-88-mobile-position: {{ section.settings.mobile_image_position }}; --home-88-desktop-position: {{ section.settings.desktop_image_position }};"
>
  <div class="home-88-hero__media">
    {%- if mobile_image != blank -%}
      <picture class="home-88-hero__picture">
        {%- if desktop_image != blank -%}
          <source
            media="(min-width: 750px)"
            srcset="
              {{ desktop_image | image_url: width: 750 }} 750w,
              {{ desktop_image | image_url: width: 1100 }} 1100w,
              {{ desktop_image | image_url: width: 1500 }} 1500w,
              {{ desktop_image | image_url: width: 2000 }} 2000w,
              {{ desktop_image | image_url: width: 2400 }} 2400w
            "
            sizes="100vw"
          >
        {%- endif -%}
        {{- mobile_image
          | image_url: width: 1500
          | image_tag:
            class: 'home-88-hero__image',
            widths: '320, 375, 550, 750, 900, 1200, 1500',
            sizes: '100vw',
            loading: 'eager',
            fetchpriority: 'high',
            alt: image_alt
        -}}
      </picture>
    {%- else -%}
      <div class="home-88-hero__placeholder" aria-hidden="true"></div>
    {%- endif -%}
  </div>

  {%- if section.settings.secondary_button_label != blank -%}
    <div class="home-88-hero__inner">
      <a class="home-88-hero__button home-88-hero__button--secondary" href="{{ secondary_button_link | escape }}">
        {{ section.settings.secondary_button_label | escape | upcase }}
      </a>
    </div>
  {%- endif -%}
</section>

<script>
  (() => {
    const section = document.getElementById('Home88Hero-{{ section.id }}');
    if (!section || !document.body) return;

    if (window.home88HeroController) window.home88HeroController.destroy();

    document.body.classList.add('home-88-header-enabled');

    const onClick = (event) => {
      const link = event.target.closest('a[href^="#"]');
      if (!link || !section.contains(link)) return;

      const targetId = link.getAttribute('href');
      if (targetId !== '#home-88-product-grid' && targetId !== '#home-88-shop-the-look') return;

      const target = document.querySelector(targetId);
      if (!target) return;

      event.preventDefault();
      target.scrollIntoView({
        behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',
        block: 'start'
      });
    };

    const onSectionUnload = (event) => {
      if (event.target.contains(section)) destroy();
    };

    const destroy = () => {
      section.removeEventListener('click', onClick);
      document.removeEventListener('shopify:section:unload', onSectionUnload);
      document.body.classList.remove('home-88-header-enabled', 'home-88-header-hidden', 'home-88-header-solid');
      if (window.home88HeroController && window.home88HeroController.section === section) {
        delete window.home88HeroController;
      }
    };

    section.addEventListener('click', onClick);
    document.addEventListener('shopify:section:unload', onSectionUnload);
    window.home88HeroController = { section, destroy };
  })();
</script>

{% schema %}
{
  "name": "Home 8.8 hero",
  "tag": "section",
  "class": "section-home-88-hero",
  "settings": [
    { "type": "image_picker", "id": "mobile_image", "label": "Mobile hero image", "info": "Recommended: 1200 × 1500 px (4:5), WebP." },
    { "type": "image_picker", "id": "desktop_image", "label": "Desktop hero image", "info": "Recommended: 1200 × 1500 px (4:5), WebP." },
    { "type": "text", "id": "image_alt", "label": "Image alt text", "default": "The Interlude Edit by Kasya" },
    {
      "type": "select",
      "id": "mobile_image_position",
      "label": "Mobile image position",
      "default": "center center",
      "options": [
        { "value": "left top", "label": "Top left" },
        { "value": "center top", "label": "Top center" },
        { "value": "right top", "label": "Top right" },
        { "value": "left center", "label": "Middle left" },
        { "value": "center center", "label": "Middle center" },
        { "value": "right center", "label": "Middle right" },
        { "value": "left bottom", "label": "Bottom left" },
        { "value": "center bottom", "label": "Bottom center" },
        { "value": "right bottom", "label": "Bottom right" }
      ]
    },
    {
      "type": "select",
      "id": "desktop_image_position",
      "label": "Desktop image position",
      "default": "center center",
      "options": [
        { "value": "left top", "label": "Top left" },
        { "value": "center top", "label": "Top center" },
        { "value": "right top", "label": "Top right" },
        { "value": "left center", "label": "Middle left" },
        { "value": "center center", "label": "Middle center" },
        { "value": "right center", "label": "Middle right" },
        { "value": "left bottom", "label": "Bottom left" },
        { "value": "center bottom", "label": "Bottom center" },
        { "value": "right bottom", "label": "Bottom right" }
      ]
    },
    { "type": "textarea", "id": "headline", "label": "Headline", "default": "EASE, EVEN\nWHEN THE DAY\nSHIFTS" },
    { "type": "header", "content": "Headline sizing" },
    { "type": "range", "id": "headline_size_mobile", "label": "Mobile headline size", "min": 24, "max": 52, "step": 1, "unit": "px", "default": 38 },
    { "type": "range", "id": "headline_size_desktop", "label": "Desktop headline size", "min": 32, "max": 80, "step": 1, "unit": "px", "default": 52 },
    { "type": "range", "id": "headline_line_height", "label": "Headline line height", "min": 80, "max": 130, "step": 1, "unit": "%", "default": 100 },
    { "type": "range", "id": "headline_max_width", "label": "Headline content width", "min": 220, "max": 600, "step": 10, "unit": "px", "default": 420 },
    { "type": "text", "id": "collection_name", "label": "Collection name", "default": "THE INTERLUDE EDIT" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Polished silhouettes and easy comfort for the moments between rain and sun, work and rest, plans and unexpected turns." },
    { "type": "text", "id": "primary_button_label", "label": "Primary button label", "default": "View Collection" },
    { "type": "url", "id": "primary_button_link", "label": "Primary button link", "info": "Defaults to #home-88-product-grid." },
    { "type": "text", "id": "secondary_button_label", "label": "Secondary button label", "default": "Shop The Look" },
    { "type": "url", "id": "secondary_button_link", "label": "Secondary button link", "info": "Defaults to #home-88-shop-the-look." }
  ],
  "presets": [
    { "name": "Home 8.8 hero" }
  ]
}
{% endschema %}
