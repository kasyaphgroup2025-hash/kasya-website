{{ 'homepage-custom.css' | asset_url | stylesheet_tag }}

<section class="home-editorial home-campaign-story">
  <div class="home-editorial__inner">
    <div class="home-campaign-story__grid">
      <div class="home-campaign-story__image">
        {%- if section.settings.mobile_image != blank or section.settings.desktop_image != blank -%}
          {%- assign mobile_image = section.settings.mobile_image | default: section.settings.desktop_image -%}
          {%- assign desktop_image = section.settings.desktop_image | default: section.settings.mobile_image -%}
          <picture class="home-media">
            {%- if desktop_image != blank -%}
              <source media="(min-width: 750px)" srcset="{{ desktop_image | image_url: width: 1600 }}">
            {%- endif -%}
            {{ mobile_image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '375, 550, 750, 900, 1100, 1400', alt: section.settings.image_alt }}
          </picture>
        {%- else -%}
          <div class="home-media home-media--empty"></div>
        {%- endif -%}
      </div>

      <div class="home-campaign-story__content">
        {%- if section.settings.kicker != blank -%}
          <p class="home-editorial__kicker">{{ section.settings.kicker | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="home-editorial__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.copy != blank -%}
          <div class="home-editorial__rte">{{ section.settings.copy }}</div>
        {%- endif -%}
        {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
          <div class="home-campaign-story__button-row">
            <a class="home-editorial__button home-editorial__button--outline" href="{{ section.settings.button_link }}">{{ section.settings.button_label | escape }}</a>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Home campaign story",
  "tag": "section",
  "class": "section-home-campaign-story",
  "settings": [
    { "type": "image_picker", "id": "mobile_image", "label": "Mobile image" },
    { "type": "image_picker", "id": "desktop_image", "label": "Desktop image" },
    { "type": "text", "id": "image_alt", "label": "Image alt text", "default": "Campaign story image" },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "The story" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Made for movement" },
    { "type": "richtext", "id": "copy", "label": "Story copy", "default": "<p>A mobile-first campaign space for editorial copy, launch notes, fabric stories, or collection inspiration.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Read more" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [
    { "name": "Home campaign story" }
  ]
}
{% endschema %}
