{{ 'homepage-custom.css' | asset_url | stylesheet_tag }}

<style>
  .home-campaign-story {
    background: linear-gradient(90deg, #030303 0%, #171717 58%, #030303 100%);
    color: #ffffff;
    overflow: hidden;
  }

  .home-campaign-story .home-editorial__inner {
    width: 100%;
    max-width: none;
    padding: 4.8rem 0 0;
  }

  .home-campaign-story__headline-wrap {
    display: flex;
    justify-content: flex-end;
    padding: 0 2rem 2.8rem 8.8rem;
  }

  .home-campaign-story__headline {
    margin: 0;
    max-width: 28rem;
    color: #ffffff;
    font-family: "Helvetica Now Condensed", "Helvetica Neue Condensed", "Arial Narrow", sans-serif;
    font-size: clamp(4rem, 12vw, 6.2rem);
    font-weight: 900;
    letter-spacing: 0;
    line-height: 1.04;
    text-align: right;
    text-shadow: 0 0.28rem 1rem rgba(0, 0, 0, 0.42);
  }

  .home-campaign-story__content-row {
    display: grid;
    grid-template-columns: minmax(0, 58%) minmax(0, 42%);
    align-items: start;
    background: #030303;
  }

  .home-campaign-story__media-column,
  .home-campaign-story__copy-column {
    min-width: 0;
  }

  .home-campaign-story__image {
    aspect-ratio: 1 / 1;
    width: min(100%, 24rem);
    overflow: hidden;
    background: #111111;
  }

  .home-campaign-story__image .home-media,
  .home-campaign-story__image .home-media--empty {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 0;
  }

  .home-campaign-story__image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
  }

  .home-campaign-story__caption {
    width: min(100%, 24rem);
    margin: 0;
    padding: 0.55rem 0.8rem 0.65rem;
    color: rgba(255, 255, 255, 0.9);
    font-family: Optima, "Palatino Linotype", serif;
    font-size: clamp(0.82rem, 2.35vw, 1rem);
    font-weight: 400;
    letter-spacing: 0;
    line-height: 1.2;
    background: #030303;
  }

  .home-campaign-story__copy-column {
    padding: 1.15rem 1.05rem 1rem 1.2rem;
    background: #030303;
  }

  .home-campaign-story__copy {
    color: #ffffff;
    font-family: Optima, "Palatino Linotype", serif;
    font-size: clamp(0.98rem, 2.78vw, 1.18rem);
    font-weight: 400;
    line-height: 1.28;
  }

  .home-campaign-story__copy p {
    margin: 0 0 1rem;
  }

  .home-campaign-story__copy p:last-child {
    margin-bottom: 0;
  }

  .home-campaign-story__copy strong {
    color: #ffffff;
    font-weight: 800;
  }

  @media screen and (max-width: 374px) {
    .home-campaign-story .home-editorial__inner {
      padding-top: 4.2rem;
    }

    .home-campaign-story__headline-wrap {
      padding: 0 1.6rem 2.2rem 6rem;
    }

    .home-campaign-story__headline {
      font-size: clamp(3.4rem, 11.4vw, 5rem);
    }

    .home-campaign-story__content-row {
      grid-template-columns: minmax(0, 54%) minmax(0, 46%);
    }

    .home-campaign-story__image,
    .home-campaign-story__caption {
      width: min(100%, 19.5rem);
    }

    .home-campaign-story__copy-column {
      padding: 0.9rem 0.75rem 0.9rem 0.9rem;
    }

    .home-campaign-story__copy {
      font-size: 0.9rem;
      line-height: 1.23;
    }

    .home-campaign-story__copy p {
      margin-bottom: 0.72rem;
    }
  }

  @media screen and (min-width: 480px) and (max-width: 749px) {
    .home-campaign-story__headline-wrap {
      padding-left: 14rem;
    }

    .home-campaign-story__content-row {
      grid-template-columns: minmax(0, 52%) minmax(0, 48%);
    }

    .home-campaign-story__image,
    .home-campaign-story__caption {
      width: min(100%, 26rem);
    }
  }

  @media screen and (min-width: 750px) {
    .home-campaign-story .home-editorial__inner {
      padding-top: 6.4rem;
    }

    .home-campaign-story__headline-wrap {
      padding: 0 7vw 4rem 46vw;
    }

    .home-campaign-story__headline {
      max-width: 46rem;
      font-size: clamp(5.8rem, 6vw, 9.2rem);
    }

    .home-campaign-story__content-row {
      grid-template-columns: minmax(0, 50%) minmax(0, 50%);
    }

    .home-campaign-story__image,
    .home-campaign-story__caption {
      width: min(42vw, 48rem);
    }

    .home-campaign-story__copy-column {
      padding: 3.2rem 5vw 3rem 3vw;
    }

    .home-campaign-story__copy {
      max-width: 31rem;
      font-size: clamp(1.45rem, 1.25vw, 1.85rem);
      line-height: 1.36;
    }

    .home-campaign-story__copy p {
      margin-bottom: 1.45rem;
    }

    .home-campaign-story__caption {
      padding-inline: 1.4rem;
      font-size: 1.15rem;
    }
  }
</style>

<section class="home-editorial home-campaign-story">
  <div class="home-editorial__inner">
    <div class="home-campaign-story__headline-wrap">
      <h2 class="home-campaign-story__headline">Routine,<br>Refined.</h2>
    </div>

    <div class="home-campaign-story__content-row">
      <div class="home-campaign-story__media-column">
        <div class="home-campaign-story__image">
          {%- if section.settings.mobile_image != blank or section.settings.desktop_image != blank -%}
            {%- assign mobile_image = section.settings.mobile_image | default: section.settings.desktop_image -%}
            {%- assign desktop_image = section.settings.desktop_image | default: section.settings.mobile_image -%}
            <picture class="home-media">
              {%- if desktop_image != blank -%}
                <source media="(min-width: 750px)" srcset="{{ desktop_image | image_url: width: 1200 }}">
              {%- endif -%}
              {{ mobile_image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '220, 260, 375, 550, 750, 800, 1000, 1200', alt: section.settings.image_alt }}
            </picture>
          {%- else -%}
            <div class="home-media home-media--empty"></div>
          {%- endif -%}
        </div>
        <p class="home-campaign-story__caption">A collection for the quiet pace of everyday elegance.</p>
      </div>

      <div class="home-campaign-story__copy-column">
        <div class="home-campaign-story__copy">
          <p><strong>Back to Rhythm</strong><br>is built for the quiet return to structure, the meetings, the movement, the moments in between.</p>
          <p>Pieces that work as hard as you do and feel good on repeat.</p>
          <p>Designed to move with your day. Made to be part of your rhythm.</p>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Home campaign story",
  "tag": "section",
  "class": "section-home-campaign-story",
  "settings": [
    { "type": "image_picker", "id": "mobile_image", "label": "Mobile image" },
    { "type": "image_picker", "id": "desktop_image", "label": "Desktop image" },
    { "type": "text", "id": "image_alt", "label": "Image alt text", "default": "Back to Rhythm campaign story image" }
  ],
  "presets": [
    { "name": "Home campaign story" }
  ]
}
{% endschema %}
